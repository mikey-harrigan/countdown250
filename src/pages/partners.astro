---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * PARTNERS PAGE (LIVE)
 * ----------------------------------------------------------------
 * Promoted from /partners-preview/ on 2026-05-08 after Mike's
 * sign-off. The preview page is preserved at /partners-preview/
 * (excluded from sitemap) for future iteration; both pages share
 * the same data structure so edits made on preview can be
 * promoted here in one shot.
 *
 * Page leads with gratitude (Thank You to Our Partners), shows
 * the 6-card partner grid in a uniform 3-col layout, then drops a
 * quiet 'Sponsorship Opportunities Available' email CTA below.
 *
 * Partners (in render order): ORHF, MikeDrop Events,
 * WhitbeckBeglis, America's Freedom Bell, The BRAINing Center,
 * Highly Rated Local. Grid is sm:2-col / lg:3-col; cards just
 * flow in array order.
 */

// 3-tier sponsor structure (2 + 2 + 4) — restructured 2026-06-17 per Mike.
// Tier 1 (Principal Partners): Space Blue + Operation Renewed Hope Foundation.
// Tier 2 (Key Partners): America's Freedom Bell + The Platform Magazine.
// Tier 3 (Supporting Partners): MikeDrop, WhitbeckBeglis, BRAINing, Highly Rated Local.

const tier1Sponsors = [
  {
    name: "Space Blue",
    img: "/images/partners/space-blue-logo.jpg",
    blurb: "The team behind the Lunaprise &mdash; the first art collection to land on the Moon. Space Blue is anchoring the Space Blue Interactive Zone with the Lunaprise Lunar Museum, lifelike hologram-style exhibits of iconic Americans, certified lunar art collectibles, and an exclusive silent charity auction benefitting American heroes.",
    url: "/space-blue/",
  },
  {
    name: "Operation Renewed Hope Foundation",
    img: "/images/logos/orhf-logo.png",
    blurb: "Ending Veteran homelessness. ORHF has helped more than 1,500 Veterans and their family members out of homelessness since 2011. Proceeds from the Countdown 250 Ball help support ORHF&rsquo;s mission to house U.S. Veterans.",
    url: "https://www.operationrenewedhopefoundation.org",
  },
];

const tier2Sponsors = [
  {
    name: "America&rsquo;s Freedom Bell",
    img: "/images/event/freedom-bell-framed.png",
    blurb: "A national symbol of American liberty making its coast-to-capital journey to Washington, D.C. to ring at midnight at Countdown 250 &mdash; the historic &ldquo;Bell of the Ball.&rdquo;",
    url: "/freedom-bell/",
  },
  {
    name: "The Platform Magazine",
    img: "/images/partners/platform-magazine.png",
    blurb: "A national publication dedicated to military fitness, wellness, and human performance &mdash; advocating for service members, veterans, and military families across the country. Platform Magazine is helping bring complimentary tickets to active and retired military so they can celebrate America&rsquo;s 250th alongside our All-American Heroes.",
    url: "https://fitness.foundation/",
  },
];

const partners = [
  {
    name: "MikeDrop Events",
    img: "/images/partners/mikedrop-events.png",
    blurb: "For over thirty-five years, we have helped shape America&rsquo;s event landscape, producing some of the nation&rsquo;s most groundbreaking, imaginative and impactful live experiences.",
    // url intentionally omitted per Mike — no Visit website link on this card
    wellClass: "p-2", // tighter padding so the round seal renders bigger in the card
  },
  {
    name: "WhitbeckBeglis",
    img: "/images/partners/whitbeckbeglis.png",
    blurb: "<em class='text-navy not-italic font-bold'>Your Family, Our Focus.</em> An aggressive yet compassionate team of attorneys dedicated to the areas of law affecting your family.",
    url: "https://wblaws.com/",
  },
  {
    name: "The BRAINing Center",
    img: "/images/partners/braining-center.png",
    blurb: "Training systems for brain health and real-life skills &mdash; focus, stress management, memory, and visual processing.",
    url: "https://brainingcenter.com",
  },
  {
    name: "Highly Rated Local",
    img: "/images/partners/highly-rated-local.png",
    blurb: "Northern Virginia&rsquo;s only directory and guide for verified 4&ndash;5 star-rated local businesses &mdash; top-rated restaurants, home professionals and contractors, health experts, financial and legal advisors, and more. Every listing is verified, so you find only trusted local businesses.",
    url: "https://www.HighlyRatedLocal.com",
  },
];
---

<BaseLayout title="Partners & Sponsors | America's Biggest 250th Anniversary Gala | Countdown 250 Ball DC 2026" description="The partners helping bring America's biggest 250th anniversary celebration to life — Washington Hilton, July 3, 2026. With heartfelt gratitude to the organizations and industry leaders who stand beside us." ogImage="/images/event/hilton-twilight.jpg">
  <Navbar />
  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >
    <!-- ============================================================ -->
    <!-- HERO — canonical sub-page pattern, American flag close-up      -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-partners-flag-symbol.jpg"
          alt="A close-up of the American flag with a centered navy and gold partnership symbol — a stylized handshake icon — pinned dead-center over the rippling stars and stripes"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              Partners &amp; Sponsors
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- LEAD: THANK YOU TO OUR PARTNERS                                 -->
    <!-- Page rebuilt 2026-05-08 to lead with gratitude. Partners are   -->
    <!-- the headline; the sponsorship-opportunities pitch was demoted -->
    <!-- to a secondary section near the bottom of the page.            -->
    <!-- ============================================================ -->
    <section class="pt-16 pb-10 sm:pt-20 sm:pb-12">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-6">
          With Heartfelt Gratitude
        </p>
        <div class="text-center mb-10">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold mb-5 font-heading leading-tight">
            Thank You to Our Partners
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-white/85 text-base sm:text-lg leading-relaxed space-y-5 max-w-3xl mx-auto text-center">
          <p>
            None of this happens without the mission-driven organizations and industry leaders who stand
            beside us. Their generosity, expertise, and shared commitment to honoring America&rsquo;s 250th anniversary
            are the foundation on which the Countdown 250 Ball is being built.
          </p>
          <p class="text-white/75">
            We are deeply grateful to each of the partners listed below.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- TIER 1 — PRINCIPAL PARTNERS: Space Blue + ORHF. Largest      -->
    <!-- cards on the page, gold ring + largest logo well + largest   -->
    <!-- type. Restructured 2026-06-17 per Mike — ORHF promoted up   -->
    <!-- from the regular grid; Freedom Bell moved down to Tier 2.   -->
    <!-- ============================================================ -->
    <section class="pb-10 sm:pb-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-6">
          Principal Partners
        </p>
        <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
          {tier1Sponsors.map((p) => (
            <div class="bg-cream rounded-xl overflow-hidden border-2 border-gold/70 shadow-2xl flex flex-col">
              <div class="bg-white flex items-center justify-center h-64 sm:h-80 p-10">
                <img src={p.img} alt={p.name} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async" />
              </div>
              <div class="p-7 sm:p-8 flex-1 flex flex-col">
                <h3 class="font-heading font-bold text-2xl sm:text-3xl text-navy mb-3 leading-tight" set:html={p.name} />
                <p class="text-slate/80 text-base sm:text-lg leading-relaxed flex-1" set:html={p.blurb} />
                {p.url && (
                  <a href={p.url} target={p.url.startsWith('/') ? '_self' : '_blank'} rel={p.url.startsWith('/') ? undefined : 'noopener noreferrer'} class="inline-block mt-5 text-red font-semibold uppercase tracking-wider text-xs sm:text-sm hover:text-red-light">
                    Learn more &nearr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- TIER 2 — KEY PARTNERS: Freedom Bell + Platform Magazine.    -->
    <!-- Clearly larger than the supporting partner cards but a step  -->
    <!-- smaller than the Tier 1 principals. Platform Magazine added  -->
    <!-- 2026-06-17.                                                  -->
    <!-- ============================================================ -->
    <section class="pb-10 sm:pb-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-6">
          Key Partners
        </p>
        <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
          {tier2Sponsors.map((p) => (
            <div class="bg-cream rounded-xl overflow-hidden border-2 border-gold/60 shadow-xl flex flex-col">
              <div class="bg-white flex items-center justify-center h-56 sm:h-72 p-8">
                <img src={p.img} alt={p.name} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async" />
              </div>
              <div class="p-6 sm:p-7 flex-1 flex flex-col">
                <h3 class="font-heading font-bold text-xl sm:text-2xl text-navy mb-3 leading-tight" set:html={p.name} />
                <p class="text-slate/80 text-sm sm:text-base leading-relaxed flex-1" set:html={p.blurb} />
                {p.url && (
                  <a href={p.url} target={p.url.startsWith('/') ? '_self' : '_blank'} rel={p.url.startsWith('/') ? undefined : 'noopener noreferrer'} class="inline-block mt-5 text-red font-semibold uppercase tracking-wider text-xs sm:text-sm hover:text-red-light">
                    Learn more &nearr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- TIER 3 — SUPPORTING PARTNERS: 4 cards in a uniform           -->
    <!-- sm:2-col / lg:4-col grid. ORHF promoted to Tier 1 2026-06-17;-->
    <!-- this section now has 4 cards. Each card: white logo well +   -->
    <!-- name + short blurb + optional 'Visit website ↗' link.        -->
    <!-- ============================================================ -->
    <section class="pb-16 sm:pb-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-6">
          Supporting Partners
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {partners.map((p) => (
            <div class={`bg-cream rounded-xl overflow-hidden border border-gold/20 shadow-md flex flex-col ${p.gridClass ?? ''}`}>
              <div class={`bg-white flex items-center justify-center h-36 sm:h-40 ${p.wellClass ?? 'p-6'}`}>
                <img src={p.img} alt={p.name} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async" />
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <h3 class="font-heading font-bold text-base sm:text-lg text-navy mb-2 leading-tight" set:html={p.name} />
                <p class="text-slate/70 text-sm leading-relaxed flex-1" set:html={p.blurb} />
                {p.url && (
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-red font-semibold uppercase tracking-wider text-xs hover:text-red-light">
                    Visit website &nearr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- DIVIDER + SECONDARY: SPONSORSHIP OPPORTUNITIES                  -->
    <!-- Demoted from the lead. Short pitch + email CTA. Benefits grid -->
    <!-- removed to keep this section quiet vs. the gratitude lead.    -->
    <!-- ============================================================ -->
    <section class="pt-4 pb-16 sm:pb-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="w-16 h-1 bg-gold mx-auto mb-10 sm:mb-12"></div>

        <div class="bg-navy rounded-2xl p-8 sm:p-10 text-center">
          <svg class="w-10 h-10 text-gold mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
          <h3 class="text-xl sm:text-2xl font-bold text-gold mb-3 font-heading">Sponsorship Opportunities Available</h3>
          <p class="text-white/80 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-6">
            A select number of sponsorship opportunities remain across multiple tiers. We welcome
            conversations with organizations whose missions align with the spirit of America&rsquo;s 250th.
          </p>

          <p class="text-white/85 text-sm sm:text-base mb-3">To inquire, email us at:</p>
          <a
            href="mailto:CountdownAmerica250@gmail.com?subject=Sponsorship%20Inquiry%20-%20Countdown%20250%20Ball"
            class="email-cta-btn inline-block bg-red hover:bg-red-light text-white px-6 sm:px-8 py-3 text-sm sm:text-base font-semibold tracking-wide transition-all rounded shadow-lg hover:-translate-y-0.5 break-all"
            data-email="CountdownAmerica250@gmail.com"
          >
            CountdownAmerica250@gmail.com
          </a>
          <p class="email-cta-toast text-gold text-sm font-semibold mt-3 opacity-0 transition-opacity duration-300">
            &#10003; Copied! Paste into your email app.
          </p>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Email-CTA helper: on click, try the mailto link AND copy the
    // address to clipboard with a 'Copied!' toast. Keeps the click
    // from feeling dead for users with no default email client.
    document.querySelectorAll<HTMLAnchorElement>('.email-cta-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const email = btn.dataset.email;
        if (email && navigator.clipboard) {
          navigator.clipboard.writeText(email).catch(() => {});
        }
        const toast = btn.parentElement?.querySelector<HTMLElement>('.email-cta-toast');
        if (toast) {
          toast.style.opacity = '1';
          setTimeout(() => { toast.style.opacity = '0'; }, 3000);
        }
      });
    });
  </script>

  <Footer />
</BaseLayout>
