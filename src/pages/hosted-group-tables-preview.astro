---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { hostedTables, FEATURED_THRESHOLD } from '../data/hosted-groups';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";

// Same Form-URL placeholders as the live page — Mike replaces these with real
// Google Form URLs once they're built. Until then, mailto: fallback works.
const CREATE_FORM_URL = "mailto:CountdownAmerica250@gmail.com?subject=Create%20a%20Hosted%20Table&body=I%27d%20like%20to%20create%20a%20Hosted%20Table.%20Please%20send%20me%20the%20signup%20form.";
const JOIN_FORM_URL   = "mailto:CountdownAmerica250@gmail.com?subject=Join%20a%20Hosted%20Table&body=I%27d%20like%20to%20join%20a%20Hosted%20Table.%20Please%20send%20me%20the%20signup%20form.";
---

<BaseLayout
  title="Hosted Tables Program — Preview | The Official Countdown 250 Ball | July 3, 2026"
  description="PREVIEW — Tighter, simplified version of the Hosted Tables Program page. For internal review before going live."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- Internal-preview banner so we never confuse this with the live page -->
  <div class="bg-gold/15 border-b border-gold/40 text-navy py-2.5 text-center text-xs">
    <p class="font-semibold tracking-wide">
      PREVIEW &middot; Tightened/simplified version. Live page is at
      <a href="/hosted-group-tables/" class="underline hover:text-red ml-1">/hosted-group-tables/</a>
    </p>
  </div>

  <!-- ============================================================ -->
  <!-- HERO -->
  <!-- ============================================================ -->
  <section class="pt-24 pb-12 sm:pb-14 bg-navy text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-4">
        Maximize Your Statesman&rsquo;s Pass Experience
      </p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-5 font-heading text-gold leading-tight">
        Hosted Tables Program
      </h1>
      <p class="text-lg sm:text-xl text-white italic font-light mb-6 leading-snug">
        Host your own &ldquo;Party Inside the Party&rdquo;<br class="hidden sm:block" />
        &mdash; or join one already in motion.
      </p>
      <div class="w-24 h-px bg-gold mx-auto"></div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- INTRO + OPTIONAL REASSURANCE -->
  <!-- ============================================================ -->
  <section class="py-10 sm:py-12 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="space-y-5 text-white/90 text-base sm:text-lg leading-relaxed">
        <p>
          The <strong class="text-gold">Hosted Tables Program</strong> is an exclusive amenity for Statesman&rsquo;s Pass holders. It lets you reserve a private table (or tables) for your Group inside the Statesman&rsquo;s Concierge Area &mdash; it&rsquo;s a &ldquo;Party Inside the Party&rdquo; with personalized recognition, signage, and amenities. You and your guests can buy your Statesman&rsquo;s Pass tickets separately, and still be seated together in your Group.
        </p>
        <p>
          Hosting or joining a Group is <strong class="text-white">completely optional</strong>. Do it if it suits you. Skip it if it doesn&rsquo;t. Your Statesman&rsquo;s Pass experience is exceptional either way.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- HOW IT WORKS — HOSTING / JOINING side-by-side -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">How It Works</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading mb-4 leading-tight">
          Creating or Joining a Group Is Simple
        </h2>
        <div class="w-20 h-px bg-gold mx-auto"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-5 sm:gap-6">

        <!-- HOSTING -->
        <div class="bg-cream rounded-xl p-6 sm:p-7 flex flex-col">
          <p class="text-red font-bold tracking-[0.2em] uppercase text-xs mb-3">Hosting a Group</p>
          <h3 class="font-heading font-bold text-xl text-navy mb-4 leading-tight">
            You bring the people. We do the rest.
          </h3>
          <ol class="space-y-3 text-slate/85 text-sm sm:text-base leading-snug list-none">
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">1.</span><span>Purchase your Statesman&rsquo;s Pass ticket(s) on Eventbrite.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">2.</span><span>Your confirmation email includes a Hosted Tables link &mdash; click <em>Host a Group</em>.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">3.</span><span>Fill out the online form (takes under a minute).</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">4.</span><span>Invite others to join you at your &ldquo;Party Inside the Party.&rdquo;</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">5.</span><span><strong class="text-navy">WE</strong> set it all up &mdash; signage, recognition, party favors, gifts.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">6.</span><span><strong class="text-navy">YOU</strong> enjoy the night of your life at <strong class="text-navy">YOUR</strong> party.</span></li>
          </ol>
          <a
            href={CREATE_FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark text-xs font-bold tracking-[0.18em] uppercase px-5 py-3 rounded shadow-md hover:shadow-lg transition-all"
          >
            Create a Group &rarr;
          </a>
        </div>

        <!-- JOINING -->
        <div class="bg-cream rounded-xl p-6 sm:p-7 flex flex-col">
          <p class="text-red font-bold tracking-[0.2em] uppercase text-xs mb-3">Joining a Group</p>
          <h3 class="font-heading font-bold text-xl text-navy mb-4 leading-tight">
            Find your people. Sit together.
          </h3>
          <ol class="space-y-3 text-slate/85 text-sm sm:text-base leading-snug list-none">
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">1.</span><span>Purchase your Statesman&rsquo;s Pass ticket(s) on Eventbrite.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">2.</span><span>Your confirmation email includes a Hosted Tables link &mdash; click <em>Join a Group</em>.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">3.</span><span>Click the Group you want to join from the list (takes under a minute).</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">4.</span><span>Invite others to join the Group also, if you like.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">5.</span><span>Come enjoy the night of your life with your Group.</span></li>
          </ol>
          <a
            href={JOIN_FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark text-xs font-bold tracking-[0.18em] uppercase px-5 py-3 rounded shadow-md hover:shadow-lg transition-all"
          >
            Join a Group &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- PERFECT FOR ANY GROUP -->
  <!-- ============================================================ -->
  <section class="py-12 sm:py-14 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">Perfect for Any Group</p>
      <p class="text-white/90 text-base sm:text-lg leading-relaxed">
        School alumni &middot; professional groups &middot; companies &middot; birthday parties &middot; reunions &middot; families &middot; neighborhoods &middot; faith communities &middot; civic associations
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- HELPFUL TIPS / ASSETS -->
  <!-- ============================================================ -->
  <section class="py-12 sm:py-14 bg-navy text-white border-t border-gold/15">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Helpful Tips &amp; Assets</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">We&rsquo;ll Help You Get the Word Out</h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
        <div class="bg-cream rounded-xl p-5 sm:p-6">
          <p class="text-red font-bold tracking-[0.18em] uppercase text-xs mb-2">Sample Invitation Email</p>
          <p class="text-slate/85 text-sm leading-relaxed">
            We&rsquo;ll send you a ready-to-forward email template you can share with friends, family, or colleagues you want at your table.
          </p>
        </div>
        <div class="bg-cream rounded-xl p-5 sm:p-6">
          <p class="text-red font-bold tracking-[0.18em] uppercase text-xs mb-2">Sample Invitation Text</p>
          <p class="text-slate/85 text-sm leading-relaxed">
            Prefer to text? We&rsquo;ll provide a short, paste-ready text-message version too.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- LIVE ROSTER -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Live Roster</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 font-heading leading-tight">
          Hosted Tables in Motion
        </h2>
        <div class="w-20 h-px bg-gold mx-auto mb-5"></div>
        <p class="max-w-2xl mx-auto text-white/85 text-base sm:text-lg leading-relaxed">
          Browse the active Hosted Tables. Don&rsquo;t see your Group? Start your own.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {hostedTables.map((t) => (
          <div class="relative bg-cream rounded-xl p-5 sm:p-6 flex flex-col">
            {t.count >= FEATURED_THRESHOLD && (
              <span class="absolute -top-2.5 -right-2.5 bg-red text-white text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded shadow-md">&#9733; Featured</span>
            )}
            <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-1 leading-tight">{t.name}</h3>
            <p class="text-red font-bold text-sm tracking-wide mb-4">
              {t.count} confirmed members
            </p>
            <a
              href={JOIN_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto inline-block text-center bg-navy hover:bg-navy-light text-white text-xs font-bold tracking-[0.15em] uppercase px-4 py-2.5 rounded transition-colors"
            >
              Join This Group &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- DEADLINES (condensed) -->
  <!-- ============================================================ -->
  <section class="py-10 sm:py-12 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">Don&rsquo;t Wait &mdash; Recruit Early</p>
      <p class="text-white/85 text-sm sm:text-base leading-relaxed">
        <strong class="text-white">T-60 days:</strong> Hosts named in the printed program. &nbsp;
        <strong class="text-white">T-30 days:</strong> Personalized signage cuts off. &nbsp;
        <strong class="text-white">T-7 days:</strong> Final seating chart locked.
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FAQ — trimmed to 3 -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Common Questions</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">Quick Answers</h2>
      </div>

      <div class="space-y-3">
        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Do I have to be in a Group to buy a Statesman&rsquo;s Pass?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> The Hosted Tables Program is a Statesman&rsquo;s Pass amenity, not a requirement. You&rsquo;ll be seated with other distinguished and honored guests in the Statesman&rsquo;s Concierge Area &mdash; same elevated experience, same premium section.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">My friends and I just want to sit together. Do we need a formal Group?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> Buy your tickets at the same time and we&rsquo;ll seat you together automatically. Hosting is for groups who want the public recognition (named in program, named on website, signage at your table).
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Does the Host or anyone in the Group pay extra?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> No extra cost. Each person pays only for their own Statesman&rsquo;s Concierge Pass.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- CLOSING CTA -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold mb-5 font-heading leading-tight">
        Be A Part Of History.
      </h2>
      <p class="text-white/90 text-base sm:text-lg leading-relaxed mb-8">
        Reserve your Statesman&rsquo;s Concierge Pass &mdash; then host or join your &ldquo;Party Inside the Party.&rdquo;
      </p>
      <a
        href={ticketUrl}
        class="eventbrite-checkout inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-sm font-bold tracking-[0.2em] uppercase transition-all rounded shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
      >
        Get Your Statesman&rsquo;s Pass &rarr;
      </a>
      <div class="mt-8">
        <a href="/" class="text-white/60 hover:text-white text-sm transition-colors">
          &larr; Back to homepage
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
