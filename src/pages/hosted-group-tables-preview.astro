---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { hostedTables, FEATURED_THRESHOLD } from '../data/hosted-groups';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";

// Same Form-URL placeholders as the live page — Mike replaces these with real
// Google Form URLs once they're built. Until then, mailto: fallback works.
const CREATE_FORM_URL = "mailto:CountdownAmerica250@gmail.com?subject=Create%20a%20Hosted%20Table&body=I%27d%20like%20to%20create%20a%20Hosted%20Table.%20Please%20send%20me%20the%20signup%20form.";
const JOIN_FORM_URL   = "mailto:CountdownAmerica250@gmail.com?subject=Join%20a%20Hosted%20Table&body=I%27d%20like%20to%20join%20a%20Hosted%20Table.%20Please%20send%20me%20the%20signup%20form.";
---

<BaseLayout
  title="Hosted Tables Program — Preview | The Official Countdown 250 Ball | July 3, 2026"
  description="PREVIEW — Tighter, simplified version of the Hosted Tables Program page. For internal review before going live."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- Internal-preview banner so we never confuse this with the live page -->
  <div class="bg-gold/15 border-b border-gold/40 text-navy py-2.5 text-center text-xs">
    <p class="font-semibold tracking-wide">
      PREVIEW &middot; Tightened/simplified version. Live page is at
      <a href="/hosted-group-tables/" class="underline hover:text-red ml-1">/hosted-group-tables/</a>
    </p>
  </div>

  <!-- ============================================================ -->
  <!-- HERO -->
  <!-- ============================================================ -->
  <!-- Italianno script font for the festive H1 below — high-end invitation style -->
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Italianno&display=swap" rel="stylesheet" slot="head" />

  <section class="pt-24 pb-12 sm:pb-14 bg-navy text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <!-- Two-line eyebrow stack -->
      <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-1">
        Maximize Your Statesman&rsquo;s Pass Experience
      </p>
      <p class="text-white italic text-sm sm:text-base font-light mb-6 tracking-wide">
        with your very own &ldquo;Party Inside the Party&rdquo;
      </p>

      <!-- Festive script H1 — Italianno (Google Font) for elegant invitation feel -->
      <h1 class="hero-script-headline text-gold mb-10 sm:mb-12 leading-none">
        Hosted Tables
      </h1>

      <!-- 3-fact reassurance bar — gold stars between the three facts -->
      <p class="text-white font-bold tracking-[0.15em] uppercase text-xs sm:text-sm mb-8">
        No Extra Cost &nbsp;<span class="text-gold">&#9733;</span>&nbsp; Takes Under a Minute &nbsp;<span class="text-gold">&#9733;</span>&nbsp; Completely Optional
      </p>

      <div class="w-24 h-px bg-gold mx-auto"></div>
    </div>
  </section>

  <style>
    /* Festive script headline — Italianno is a flowing italic script in the
       upscale-invitation tradition. Sized just slightly larger than the
       homepage section H2s (which max at 48px / text-5xl on desktop). */
    .hero-script-headline {
      font-family: 'Italianno', 'Playfair Display', cursive, serif;
      font-weight: 400;
      font-size: clamp(3rem, 5.5vw, 4.5rem);
      letter-spacing: 0.01em;
    }
  </style>

  <!-- ============================================================ -->
  <!-- INTRO + OPTIONAL REASSURANCE -->
  <!-- ============================================================ -->
  <section class="pt-6 pb-12 sm:pt-8 sm:pb-14 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="space-y-5 text-white/90 text-base sm:text-lg leading-relaxed">
        <p>
          The Hosted Tables experience is a <strong class="text-gold">complimentary option</strong> available to Statesman&rsquo;s Pass ticket holders.
        </p>
        <p>
          Host a private group &mdash; or join an existing group &mdash; at your very own &ldquo;Party Inside the Party&rdquo; within the historic Countdown 250 Gala.
        </p>
        <p>
          All Hosted Tables are seated within the exclusive Statesman&rsquo;s Concierge Area alongside our distinguished guests, and <strong class="text-gold">group members are seated together</strong> &mdash; even if tickets are purchased separately.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- HOW IT WORKS — HOSTING / JOINING side-by-side -->
  <!-- ============================================================ -->
  <section id="how-it-works" class="scroll-mt-24 py-14 sm:py-16 bg-navy text-white border-t border-gold/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">How It Works</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading mb-4 leading-tight">
          Creating or Joining a Group Is Simple
        </h2>
        <div class="w-20 h-px bg-gold mx-auto"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-5 sm:gap-6">

        <!-- HOSTING -->
        <div class="bg-cream rounded-xl p-6 sm:p-7 flex flex-col">
          <p class="text-red font-bold tracking-[0.2em] uppercase text-xs mb-3">Hosting a Group</p>
          <h3 class="font-heading font-bold text-xl text-navy mb-4 leading-tight">
            You invite the people. We handle the rest.
          </h3>
          <ol class="space-y-3 text-slate/85 text-sm sm:text-base leading-snug list-none">
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">1.</span><span>Purchase your Statesman&rsquo;s Concierge Pass on Eventbrite.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">2.</span><span>Use the Hosted Tables link on this page or in your confirmation email.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">3.</span><span>Create your group &mdash; it takes less than a minute.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">4.</span><span>Invite others to join your Hosted Table.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">5.</span><span>We handle setup, signage, coordination, and details.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">6.</span><span>You enjoy an unforgettable evening at your own private celebration within the Ball.</span></li>
          </ol>
          <a
            href={CREATE_FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark text-xs font-bold tracking-[0.18em] uppercase px-5 py-3 rounded shadow-md hover:shadow-lg transition-all"
          >
            Create a Group &rarr;
          </a>
        </div>

        <!-- JOINING -->
        <div class="bg-cream rounded-xl p-6 sm:p-7 flex flex-col">
          <p class="text-red font-bold tracking-[0.2em] uppercase text-xs mb-3">Joining a Group</p>
          <h3 class="font-heading font-bold text-xl text-navy mb-4 leading-tight">
            Find your people. Sit together.
          </h3>
          <ol class="space-y-3 text-slate/85 text-sm sm:text-base leading-snug list-none">
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">1.</span><span>Purchase your Statesman&rsquo;s Concierge Pass on Eventbrite.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">2.</span><span>Use the Hosted Tables link on this page or in your confirmation email.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">3.</span><span>Select the group you&rsquo;d like to join.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">4.</span><span>Enter your Eventbrite order number for verification.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">5.</span><span>We coordinate seating and group placement.</span></li>
            <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">6.</span><span>You enjoy the evening with your group.</span></li>
          </ol>
          <a
            href={JOIN_FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark text-xs font-bold tracking-[0.18em] uppercase px-5 py-3 rounded shadow-md hover:shadow-lg transition-all"
          >
            Join a Group &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- PERFECT FOR ANY GROUP -->
  <!-- ============================================================ -->
  <section class="py-12 sm:py-14 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">Perfect for Any Group</p>
      <p class="text-white/90 text-base sm:text-lg leading-relaxed">
        School alumni &middot; professional groups &middot; companies &middot; birthday celebrations &middot; reunions &middot; families &middot; neighborhoods &middot; faith communities &middot; civic associations &middot; common-interest groups
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- HELPFUL TIPS / ASSETS -->
  <!-- ============================================================ -->
  <section class="py-12 sm:py-14 bg-navy text-white border-t border-gold/15">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Helpful Tips &amp; Assets</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">We&rsquo;ll Help You Get the Word Out</h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
        <div class="bg-cream rounded-xl p-5 sm:p-6">
          <p class="text-red font-bold tracking-[0.18em] uppercase text-xs mb-2">Sample Invitation Email</p>
          <p class="text-slate/85 text-sm leading-relaxed">
            Copy-and-paste email language Hosts can send to friends, family, colleagues, or alumni groups.
          </p>
        </div>
        <div class="bg-cream rounded-xl p-5 sm:p-6">
          <p class="text-red font-bold tracking-[0.18em] uppercase text-xs mb-2">Sample Invitation Text</p>
          <p class="text-slate/85 text-sm leading-relaxed">
            Short text-message copy Hosts can send quickly by phone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- LIVE ROSTER -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Live Roster</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 font-heading leading-tight">
          Hosted Tables in Motion
        </h2>
        <div class="w-20 h-px bg-gold mx-auto mb-5"></div>
        <p class="max-w-2xl mx-auto text-white/85 text-base sm:text-lg leading-relaxed">
          Browse current Hosted Tables. Don&rsquo;t see your group? Start your own.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {hostedTables.map((t) => (
          <div class="relative bg-cream rounded-xl p-5 sm:p-6 flex flex-col">
            {t.count >= FEATURED_THRESHOLD && (
              <span class="absolute -top-2.5 -right-2.5 bg-red text-white text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded shadow-md">&#9733; Featured</span>
            )}
            <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-1 leading-tight">{t.name}</h3>
            <p class="text-red font-bold text-sm tracking-wide mb-4">
              {t.count} confirmed members
            </p>
            <a
              href={JOIN_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto inline-block text-center bg-navy hover:bg-navy-light text-white text-xs font-bold tracking-[0.15em] uppercase px-4 py-2.5 rounded transition-colors"
            >
              Join This Group &rarr;
            </a>
          </div>
        ))}
      </div>

      <!-- Start-a-new button below the roster grid -->
      <div class="text-center mt-10">
        <a
          href={CREATE_FORM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-8 py-3.5 text-sm font-bold tracking-[0.18em] uppercase transition-all rounded shadow-lg hover:shadow-xl hover:-translate-y-0.5"
        >
          Start a New Hosted Table &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- DEADLINES (condensed) -->
  <!-- ============================================================ -->
  <section class="py-10 sm:py-12 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-5">Don&rsquo;t Wait &mdash; Recruit Early</p>
      <ul class="space-y-2 text-white/90 text-sm sm:text-base leading-relaxed inline-block text-left">
        <li><strong class="text-gold">T-60 days:</strong> Hosts named in the printed program</li>
        <li><strong class="text-gold">T-30 days:</strong> Personalized signage deadline</li>
        <li><strong class="text-gold">T-7 days:</strong> Final seating chart locked</li>
      </ul>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FAQ — trimmed to 3 -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Common Questions</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">Quick Answers</h2>
      </div>

      <div class="space-y-3">
        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Do I have to be in a group to buy a Statesman&rsquo;s Concierge Pass?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> Hosted Tables are completely optional. Independent guests are warmly welcomed and will be seated in the Statesman&rsquo;s Concierge Area.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Does it cost anything extra to host or join a group?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> Hosting or joining a Hosted Table is included at no additional cost.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Can I start or join a group after buying my ticket?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">Yes.</strong> Use the Hosted Tables link on this page or in your confirmation email.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Will I need my Eventbrite order number?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">Yes.</strong> We use your order number to verify your ticket and coordinate seating.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">If I buy multiple tickets at one time, will we be seated together?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">Yes.</strong> Tickets purchased together in one order will be seated together whenever possible.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">If my friend and I purchase tickets separately, can we still sit together?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">Yes.</strong> The easiest way is to create or join a Hosted Table. It&rsquo;s quick, free, and groups can be as small as two people.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Can I join a group even if I don&rsquo;t know everyone in it?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">Yes.</strong> Many groups are formed around shared interests, affiliations, schools, neighborhoods, or communities.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Will my email address or order number be shown publicly?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> Email addresses, phone numbers, Eventbrite order numbers, and private notes are only visible to the event team.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- CLOSING CTA -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold mb-5 font-heading leading-tight">
        Be A Part Of History.
      </h2>
      <p class="text-white/90 text-base sm:text-lg leading-relaxed mb-8">
        Reserve your Statesman&rsquo;s Concierge Pass &mdash; then host or join your &ldquo;Party Inside the Party.&rdquo;
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href={ticketUrl}
          class="eventbrite-checkout inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-sm font-bold tracking-[0.2em] uppercase transition-all rounded shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
        >
          Get Your Statesman&rsquo;s Pass &rarr;
        </a>
        <a
          href="#how-it-works"
          class="inline-block border-2 border-gold text-gold hover:bg-gold hover:text-navy-dark px-10 py-3.5 text-sm font-bold tracking-[0.2em] uppercase transition-all rounded"
        >
          Start or Join a Hosted Table &rarr;
        </a>
      </div>
      <div class="mt-8">
        <a href="/" class="text-white/60 hover:text-white text-sm transition-colors">
          &larr; Back to homepage
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
