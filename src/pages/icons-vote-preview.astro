---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * ALL-AMERICAN ICONS — PUBLIC VOTING PREVIEW PAGE (2026-05-28)
 * ----------------------------------------------------------------
 * STANDALONE PREVIEW — direct-URL only at /icons-vote-preview/.
 * Excluded from the sitemap (filter token: icons-vote-preview);
 * NOT linked from the main navigation. Built from copy supplied
 * by Mike (originally drafted in a Google Form).
 *
 * TODO before going live:
 *   - Replace `voteFormUrl` placeholder with the real Google
 *     Form URL (used by both "Vote Now" and "Submit a Nomination"
 *     buttons; split if the write-in form is a separate URL).
 *   - Confirm "All-American Ball Committee" vs "Countdown 250 Ball
 *     Committee" naming with Mike.
 *   - Verify 2026 Olympic claims (US Men's/Women's Hockey gold).
 *   - Confirm two cleanups applied to the user's source list:
 *       1. Tom Brady — filled in a neutral description (was blank).
 *       2. Dean Cain — softened "all around super man" to a
 *          standard polished one-liner.
 *
 * Categories are collapsible via native <details>/<summary> so the
 * page reads as a clean list of categories on first load (not a
 * wall of 89 names). No JavaScript required.
 */

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";

// Placeholder — replace with the real Google Form URL once available.
const voteFormUrl = "https://forms.gle/REPLACE-WITH-GOOGLE-FORM-URL";
const writeInFormUrl = voteFormUrl; // same form unless write-ins are a separate URL

const orhfUrl = "https://www.operationrenewedhopefoundation.org";
const facebookUrl = "https://www.facebook.com/profile.php?id=61577494264900";

const categories = [
  {
