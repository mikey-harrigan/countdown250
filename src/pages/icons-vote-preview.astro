  {
    name: "Olympic & International Sports Icons",
    nominees: [
      { name: "Michael Phelps", desc: "Most decorated Olympian in history and one of the greatest athletes of all time" },
      { name: "Simone Biles", desc: "Most decorated American gymnast in history and global symbol of excellence and resilience" },
