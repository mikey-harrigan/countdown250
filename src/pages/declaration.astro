---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
---

<BaseLayout
  title="Statesman's Pass | Countdown 250 Ball"
  description="Welcome to the Statesman's Pass info page — for guests who expect the very best."
  ogImage="/images/event/hero-countdown250-toast.png"
>
  <Navbar />

  <!-- ============================================================ -->
  <!-- SVG filter defs — real paper grain + blotchy aging stains -->
  <!-- ============================================================ -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <!-- Fine paper-fiber grain -->
      <filter id="paper-grain" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" seed="3"/>
        <feColorMatrix values="0 0 0 0 0.32
                               0 0 0 0 0.22
                               0 0 0 0 0.10
                               0 0 0 0.55 0"/>
      </filter>
      <!-- Larger irregular aging blotches -->
      <filter id="paper-stains" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="3" seed="11"/>
        <feColorMatrix values="0 0 0 0 0.50
                               0 0 0 0 0.30
                               0 0 0 0 0.10
                               0 0 0 0.5 0"/>
      </filter>
      <!-- Subtle fiber threads -->
      <filter id="paper-fibers" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04 0.6" numOctaves="2" seed="5"/>
        <feColorMatrix values="0 0 0 0 0.40
                               0 0 0 0 0.26
                               0 0 0 0 0.10
                               0 0 0 0.35 0"/>
      </filter>
    </defs>
  </svg>

  <!-- ============================================================ -->
  <!-- Dark wood / candle-lit room — the surface holding the page  -->
  <!-- ============================================================ -->
  <main class="declaration-room relative min-h-screen pt-28 pb-16 sm:pt-32 sm:pb-20 overflow-hidden flex items-center justify-center">

    <!-- Warm candle glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[44rem] h-[28rem] pointer-events-none opacity-50" style="background: radial-gradient(ellipse, rgba(220,170,80,0.40) 0%, transparent 70%); filter: blur(50px);"></div>

    <!-- ============================================================ -->
    <!-- The Parchment Document -->
    <!-- ============================================================ -->
    <article class="parchment-page relative mx-auto max-w-2xl px-10 sm:px-16 md:px-20 py-20 sm:py-28 md:py-32 my-6 sm:my-8 z-10">

      <!-- Real paper-fiber grain (SVG turbulence) -->
      <svg class="paper-overlay paper-overlay-grain" preserveAspectRatio="none" viewBox="0 0 800 1000" aria-hidden="true">
        <rect width="800" height="1000" filter="url(#paper-grain)" />
      </svg>
      <!-- Larger aging stains (lower frequency turbulence) -->
      <svg class="paper-overlay paper-overlay-stains" preserveAspectRatio="none" viewBox="0 0 800 1000" aria-hidden="true">
        <rect width="800" height="1000" filter="url(#paper-stains)" />
      </svg>
      <!-- Long fiber threads (anisotropic noise) -->
      <svg class="paper-overlay paper-overlay-fibers" preserveAspectRatio="none" viewBox="0 0 800 1000" aria-hidden="true">
        <rect width="800" height="1000" filter="url(#paper-fibers)" />
      </svg>

      <!-- Content -->
      <div class="relative z-10 text-center">

        <!-- Headline (Broadway stage copy, exact) -->
        <h1 class="font-heading font-black text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] text-[#2A1808] leading-[1.15] tracking-tight mb-10 sm:mb-12">
          Welcome to the<br />
          <span class="text-[#7A1A1A]">Statesman&rsquo;s Pass</span><br />
          Info Page
        </h1>

        <!-- Ornamental divider -->
        <div class="flex items-center justify-center gap-4 mb-10 sm:mb-12">
          <div class="w-16 sm:w-20 h-px bg-[#6B3F1A]/60"></div>
          <span class="text-[#6B3F1A] text-xl leading-none">&#10047;</span>
          <div class="w-16 sm:w-20 h-px bg-[#6B3F1A]/60"></div>
        </div>

        <!-- Subhead -->
        <p class="font-heading italic text-[#3A2410] text-xl sm:text-2xl md:text-3xl font-medium tracking-wide mb-14 sm:mb-16">
          For guests who expect the very best.
        </p>

        <!-- Two buttons -->
        <div class="grid sm:grid-cols-2 gap-3 sm:gap-4 max-w-xl mx-auto">
          <a
            href="#statesman"
            class="group inline-flex items-center justify-center gap-3 bg-[#7A1A1A] hover:bg-[#5C1010] text-[#F4E8C3] border-2 border-[#7A1A1A] hover:border-[#5C1010] px-5 py-4 text-[12px] sm:text-[13px] font-semibold tracking-[0.18em] uppercase transition-all hover:-translate-y-0.5 shadow-md leading-snug"
          >
            <span>What Is the Statesman&rsquo;s Pass?</span>
            <svg class="w-3.5 h-3.5 flex-shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#hosted-tables"
            class="group inline-flex items-center justify-center gap-3 bg-[#7A1A1A] hover:bg-[#5C1010] text-[#F4E8C3] border-2 border-[#7A1A1A] hover:border-[#5C1010] px-5 py-4 text-[12px] sm:text-[13px] font-semibold tracking-[0.18em] uppercase transition-all hover:-translate-y-0.5 shadow-md leading-snug"
          >
            <span>Party Inside the Party?</span>
            <svg class="w-3.5 h-3.5 flex-shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ============================================================
     REAL PARCHMENT — SVG noise + layered aging
     ============================================================ */

  /* Dark room backdrop — the surface holding the document */
  .declaration-room {
    background:
      radial-gradient(ellipse at center top, #3a2210 0%, #1f1208 60%, #100804 100%),
      #100804;
  }

  /* The parchment page itself — base color + corner stains + edge vignette.
     SVG noise overlays sit on top of this to provide real paper grain. */
  .parchment-page {
    background:
      /* Aged stains in the four corners (irregular sizes per corner) */
      radial-gradient(ellipse 30% 25% at 0% 0%,   rgba(140,90,30,0.20) 0%, transparent 70%),
      radial-gradient(ellipse 38% 30% at 100% 0%, rgba(160,100,30,0.18) 0%, transparent 70%),
      radial-gradient(ellipse 42% 35% at 100% 100%, rgba(150,95,30,0.22) 0%, transparent 70%),
      radial-gradient(ellipse 35% 28% at 0% 100%, rgba(140,85,25,0.20) 0%, transparent 70%),
      /* Edge vignette */
      radial-gradient(ellipse at center, transparent 55%, rgba(100,60,15,0.30) 100%),
      /* Base parchment color — slightly cooler than before, more authentic */
      linear-gradient(to bottom, #EBDDA8 0%, #E5D29A 50%, #DEC68B 100%);

    box-shadow:
      0 35px 90px rgba(0,0,0,0.75),
      0 12px 35px rgba(0,0,0,0.55),
      0 2px 6px rgba(0,0,0,0.4),
      inset 0 0 90px rgba(120,80,30,0.15);
    /* Subtle imperfect rotation so the document isn't perfectly square */
    transform: rotate(-0.3deg);
  }

  /* The SVG noise overlays cover the full parchment.
     Each layer contributes a different scale of texture. */
  .paper-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* Fine paper grain — the dominant fiber texture */
  .paper-overlay-grain {
    mix-blend-mode: multiply;
    opacity: 0.55;
  }
  /* Larger blotchy aging stains — irregular tea-stained look */
  .paper-overlay-stains {
    mix-blend-mode: multiply;
    opacity: 0.40;
  }
  /* Long thin fiber threads — runs like real linen-paper fibers */
  .paper-overlay-fibers {
    mix-blend-mode: multiply;
    opacity: 0.30;
  }
</style>
