---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { updates } from '../data/updates';

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout
  title="News & Updates | America's 250th Anniversary Gala | Countdown 250 Ball Washington DC"
  description="Latest announcements for America's premier 250th anniversary gala in Washington DC. Performers, honorees & event news. July 3, 2026. Only 90 days away!"
  ogImage="/images/event/ballroom-stage.jpg"
>
  <Navbar />
  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >
    <!-- Header -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-updates-pony-express.jpg"
          alt="A gold-rendered Pony Express rider with a U.S. MAIL satchel galloping at full speed across a faded American flag background — a classic 'news and updates' motif"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              News & Announcements
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- Updates list -->
    <section class="py-16 sm:py-24 ">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <!-- Eyebrow (moved here from the hero overlay 2026-05-06 when
             the hero adopted the image-led pattern). -->
        <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-8">
          Stay Informed
        </p>

        <div class="space-y-0">
          {updates.map((update, i) => (
            <article class={`py-8 ${i > 0 ? 'border-t border-white/15' : ''}`}>
              <time class="text-sm text-gold font-medium tracking-wider uppercase">{formatDate(update.date)}</time>
              <h2 class="text-2xl font-bold text-gold mt-2 mb-4 font-heading">{update.headline}</h2>
              <p class="text-white/70 text-lg leading-relaxed">{update.body}</p>
            </article>
          ))}
        </div>

        <div class="text-center mt-12 pt-8 border-t border-white/15">
          <p class="text-white/50 text-sm italic mb-6">More updates will be posted as the event approaches.</p>
          <a
            href="/"
            class="inline-block bg-red hover:bg-red-light text-white px-8 py-3 text-sm font-semibold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
          >
            Back to Home
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
