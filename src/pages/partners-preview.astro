---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * PARTNERS PREVIEW PAGE
 * ----------------------------------------------------------------
 * Adds the 7 inaugural-ball partners back into the page, between
 * the intro copy and the sponsorship-benefits grid. Otherwise
 * matches the live /partners/ page structure (same hero, intro,
 * benefits grid, sponsorship-opportunities CTA, back-to-home).
 *
 * Partner list pulled from allamericanball.com/partners/ on
 * 2026-05-08 — same partners as the inaugural ball, no tier
 * designations on that page so we render them as a single
 * uniform grid with logo + name + short description.
 *
 * Logos:
 *   - ORHF, GTG, USVets TV — already in /images/logos/ or /misc/
 *   - Homes For Our Troops, BRAINing Center, TV Worldwide,
 *     GoCity Events — pulled from allamericanball.com and saved
 *     into /images/partners/ on 2026-05-08.
 *
 * Excluded from sitemap via astro.config.mjs filter.
 */

const partners = [
  {
    name: "Operation Renewed Hope Foundation",
    img: "/images/logos/operation-renewed-hope.jpg",
    blurb: "Ending Veteran homelessness. ORHF has helped more than 1,500 Veterans and their family members out of homelessness since 2011.",
    url: "https://www.operationrenewedhopefoundation.org",
  },
  {
    name: "Getting The Gig (GTG)",
    img: "/images/logos/getting-the-gig.png",
    blurb: "Maryland, Virginia, and DC&rsquo;s leading booking agency for professional artists and DJs.",
    url: "https://gettingthegig.com",
  },
  {
    name: "Homes For Our Troops",
    img: "/images/partners/homes-for-our-troops.png",
    blurb: "Nonprofit that builds and donates specially adapted custom homes for severely injured post-9/11 Veterans.",
    url: "https://www.hfotusa.org",
  },
  {
    name: "The BRAINing Center",
    img: "/images/partners/braining-center.png",
    blurb: "Training systems for brain health and real-life skills &mdash; focus, stress management, memory, and visual processing.",
    url: "https://thebrainingcenter.com",
  },
  {
    name: "TV Worldwide",
    img: "/images/partners/tv-worldwide.jpg",
    blurb: "Leading provider of online Internet video delivery solutions, powering live broadcasts of major events.",
    url: "https://www.tvworldwide.com",
  },
  {
    name: "USVets TV",
    img: "/images/misc/usvets-logo.jpg",
    blurb: "Official Webcaster of the event &mdash; an Internet TV channel on the TV Worldwide network dedicated to U.S. Veterans.",
    url: "https://usvets.tv",
  },
  {
    name: "GoCity Events",
    img: "/images/partners/gocity-events.png",
    blurb: "One of America&rsquo;s leading event production companies, with over thirty-five years of experience.",
    url: "https://www.gocityevents.com",
  },
];
---

<BaseLayout title="Partners & Sponsors (Preview) | Countdown 250 Ball DC 2026" description="Sponsor America's biggest 250th anniversary celebration. 3,000 guests at Washington Hilton, July 3, 2026. Premium brand visibility at America's Ball." ogImage="/images/event/hilton-twilight.jpg">
  <Navbar />
  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >
    <!-- ============================================================ -->
    <!-- HERO — matches live /partners/ page                           -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-partners-flag-symbol.jpg"
          alt="A close-up of the American flag with a centered navy and gold partnership symbol — a stylized handshake icon — pinned dead-center over the rippling stars and stripes"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              Partners &amp; Sponsors
            </h1>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 ">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-8">
          Supporting America&rsquo;s Celebration
        </p>
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-gold mb-6 font-heading">Join Us in Making History</h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-white/70 text-lg leading-relaxed space-y-6 mb-16">
          <p>
            The All-American Countdown 250 Ball offers a unique opportunity for organizations and brands to
            align with one of the most prestigious patriotic celebrations in the nation's capital. With an
            expected audience of 3,000 distinguished guests &mdash; including leaders, dignitaries, media personalities,
            and influencers &mdash; your brand will be front and center at a historic, once-in-a-generation event.
          </p>
        </div>

        <!-- ============================================================ -->
        <!-- OUR PARTNERS — grid of 7 partner cards                        -->
        <!-- Same partners as the inaugural ball. Each card: white logo   -->
        <!-- well at top (centered), name, short blurb, and a small       -->
        <!-- 'Visit website ↗' link. No tier hierarchy on inaugural site, -->
        <!-- so grid is uniform.                                          -->
        <!-- ============================================================ -->
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-gold mb-3 font-heading">Our Partners</h2>
          <p class="text-white/70 text-base sm:text-lg max-w-3xl mx-auto">
            We are proud to partner with these mission-driven organizations and industry leaders.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
          {partners.map((p) => (
            <div class="bg-cream rounded-xl overflow-hidden border border-gold/20 shadow-md flex flex-col">
              <div class="bg-white p-6 flex items-center justify-center h-36 sm:h-40">
                <img src={p.img} alt={p.name} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async" />
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <h3 class="font-heading font-bold text-base sm:text-lg text-navy mb-2 leading-tight" set:html={p.name} />
                <p class="text-slate/70 text-sm leading-relaxed flex-1" set:html={p.blurb} />
                {p.url && (
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-red font-semibold uppercase tracking-wider text-xs hover:text-red-light">
                    Visit website &nearr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- ============================================================ -->
        <!-- SPONSORSHIP BENEFITS — same as live page                      -->
        <!-- ============================================================ -->
        <div class="grid sm:grid-cols-2 gap-6 mb-16">
          <div class="bg-cream rounded-xl p-6">
            <div class="text-3xl mb-3">📣</div>
            <h3 class="text-lg font-bold text-navy mb-2">Brand Visibility</h3>
            <p class="text-slate/60 text-sm">Premium placement in front of thousands of influential guests and national media coverage.</p>
          </div>
          <div class="bg-cream rounded-xl p-6">
            <div class="text-3xl mb-3">🤝</div>
            <h3 class="text-lg font-bold text-navy mb-2">VIP Access</h3>
            <p class="text-slate/60 text-sm">Exclusive networking opportunities with leaders, dignitaries, and distinguished guests.</p>
          </div>
          <div class="bg-cream rounded-xl p-6">
            <div class="text-3xl mb-3">🇺🇸</div>
            <h3 class="text-lg font-bold text-navy mb-2">Patriotic Alignment</h3>
            <p class="text-slate/60 text-sm">Associate your brand with America's 250th anniversary &mdash; a once-in-a-lifetime milestone.</p>
          </div>
          <div class="bg-cream rounded-xl p-6">
            <div class="text-3xl mb-3">📺</div>
            <h3 class="text-lg font-bold text-navy mb-2">Media Exposure</h3>
            <p class="text-slate/60 text-sm">National media coverage and digital reach across event platforms and social channels.</p>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- SPONSORSHIP OPPORTUNITIES CTA — same as live page             -->
        <!-- ============================================================ -->
        <div class="bg-navy rounded-2xl p-10 text-center">
          <svg class="w-12 h-12 text-gold mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
          <h3 class="text-xl font-bold text-gold mb-3">Sponsorship Opportunities Available</h3>
          <p class="text-white/70 text-lg mb-6">
            We are currently accepting partnership and sponsorship inquiries. Multiple tiers of sponsorship are available to match your goals and budget.
          </p>

          <p class="text-white/85 text-sm sm:text-base mb-3">To inquire, email us at:</p>
          <a
            href="mailto:CountdownAmerica250@gmail.com?subject=Sponsorship%20Inquiry%20-%20Countdown%20250%20Ball"
            class="email-cta-btn inline-block bg-red hover:bg-red-light text-white px-6 sm:px-8 py-3 text-sm sm:text-base font-semibold tracking-wide transition-all rounded shadow-lg hover:-translate-y-0.5 break-all"
            data-email="CountdownAmerica250@gmail.com"
          >
            CountdownAmerica250@gmail.com
          </a>
          <p class="email-cta-toast text-gold text-sm font-semibold mt-3 opacity-0 transition-opacity duration-300">
            &#10003; Copied! Paste into your email app.
          </p>
          <p class="text-white/40 text-sm mt-4">Official sponsor announcements coming soon.</p>
        </div>

        <div class="text-center mt-12">
          <a href="/" class="inline-block bg-white border-2 border-navy text-gold hover:bg-navy hover:text-white px-8 py-3 text-sm font-semibold tracking-wider uppercase transition-all rounded hover:-translate-y-0.5">
            Back to Home
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Email-CTA helper: on click, try the mailto link AND copy the
    // address to clipboard with a 'Copied!' toast. Keeps the click
    // from feeling dead for users with no default email client.
    document.querySelectorAll<HTMLAnchorElement>('.email-cta-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const email = btn.dataset.email;
        if (email && navigator.clipboard) {
          navigator.clipboard.writeText(email).catch(() => {});
        }
        const toast = btn.parentElement?.querySelector<HTMLElement>('.email-cta-toast');
        if (toast) {
          toast.style.opacity = '1';
          setTimeout(() => { toast.style.opacity = '0'; }, 3000);
        }
      });
    });
  </script>

  <Footer />
</BaseLayout>
