---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { hostedTables, FEATURED_THRESHOLD } from '../data/hosted-groups';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";

// TODO: Mike — replace these placeholder URLs after creating the two
// Google Forms. The "Create" form is for Hosts; the "Join" form is for
// Guests joining an existing Hosted Group. Until replaced, both buttons
// fall back to a prefilled mailto: so visitors can still reach Mike.
const CREATE_FORM_URL = "mailto:CountdownAmerica250@gmail.com?subject=Create%20a%20Hosted%20Group&body=I%27d%20like%20to%20create%20a%20Hosted%20Group.%20Please%20send%20me%20the%20signup%20form.";
const JOIN_FORM_URL   = "mailto:CountdownAmerica250@gmail.com?subject=Join%20a%20Hosted%20Group&body=I%27d%20like%20to%20join%20a%20Hosted%20Group.%20Please%20send%20me%20the%20signup%20form.";
---

<BaseLayout
  title="The Hosted Groups Program — Statesman's Pass Amenity | The Official Countdown 250 Ball | July 3, 2026"
  description="Host your own Party Inside the Party at the Countdown 250 Ball — or join one already in motion. Reserved private tables, named recognition, public toast. A Statesman's Concierge Pass amenity."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <main>

    <!-- ============================================================ -->
    <!-- HERO — navy bg, mirrors the Partners page hero pattern -->
    <!-- ============================================================ -->
    <section class="relative pt-20 pb-16 sm:pt-24 bg-navy text-white overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-navy-dark/90 to-navy"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <!-- Eyebrow -->
        <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-7">
          Maximize Your Statesman&rsquo;s Pass Experience
        </p>

        <!-- H1 — same font and styling family as the Partners page H1 -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-gold mb-3 font-heading leading-tight">
          Hosted Groups
        </h1>

        <!-- Tagline directly under the title -->
        <p class="text-white italic text-base sm:text-lg font-light mb-7 tracking-wide">
          Your &ldquo;Party Inside the Party&rdquo;
        </p>

        <div class="w-20 h-1 bg-red mx-auto"></div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- INTRO — white bg starts here, same as Partners body sections -->
    <!-- ============================================================ -->
    <section class="pt-12 pb-10 sm:pt-14 sm:pb-12 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="space-y-5 text-slate/80 text-base sm:text-lg leading-relaxed">
          <p>
            The Hosted Groups experience is a <strong class="text-red">complimentary option</strong> available to Statesman&rsquo;s Pass ticket holders. It lets you host a private group &mdash; or join an existing group &mdash; at your very own &ldquo;Party Inside the Party&rdquo; within the historic Countdown 250 Gala.
          </p>
          <p>
            Each group enjoys a <strong class="text-red">dedicated gathering space</strong> in the exclusive Statesman&rsquo;s Concierge Area, with reserved seating, custom signage, and coordinated details designed to create your own special &ldquo;Party Inside the Party.&rdquo; <strong class="text-red">Group members are seated together</strong> even if tickets are purchased separately.
          </p>
          <p class="text-slate/70 text-sm sm:text-base italic">
            Groups of 6 or more, contact us at <a href="mailto:CountdownAmerica250@gmail.com?subject=Hosted%20Group%20%E2%80%94%20Group%20of%206%2B" class="text-red font-semibold not-italic hover:underline">CountdownAmerica250@gmail.com</a> for enhanced accommodations.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- BENEFITS — compact two-column card on white -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">
          <!-- Gold header bar -->
          <div class="bg-gold py-3 sm:py-4 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-xs sm:text-sm leading-tight">
              Benefits of Hosted Groups
            </p>
          </div>
          <!-- Two columns: Hosts | Guests -->
          <div class="grid md:grid-cols-2">
            <!-- HOSTS PANEL — navy gradient stays as a feature panel even on white page bg -->
            <div class="relative bg-gradient-to-br from-navy-dark via-navy to-navy-dark p-5 sm:p-6 text-white overflow-hidden">
              <div class="hidden md:block absolute top-0 right-0 bottom-0 w-px bg-gradient-to-b from-transparent via-gold/40 to-transparent"></div>
              <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs mb-3">Hosts&rsquo; Benefits</p>
              <ul class="space-y-2 text-white/90 text-sm sm:text-[15px] leading-snug">
                <li class="flex items-start"><span class="text-gold mr-2.5 flex-shrink-0 mt-1 text-xs">&#10022;</span><span>We do the work &mdash; you enjoy <strong class="font-semibold text-white">YOUR</strong> party</span></li>
                <li class="flex items-start"><span class="text-gold mr-2.5 flex-shrink-0 mt-1 text-xs">&#10022;</span><span>Premium party favors, decorations, and amenities</span></li>
                <li class="flex items-start"><span class="text-gold mr-2.5 flex-shrink-0 mt-1 text-xs">&#10022;</span><span>Public &ldquo;Toast to the Hosts&rdquo;</span></li>
                <li class="flex items-start"><span class="text-gold mr-2.5 flex-shrink-0 mt-1 text-xs">&#10022;</span><span>Named in event program &amp; website</span></li>
                <li class="flex items-start"><span class="text-gold mr-2.5 flex-shrink-0 mt-1 text-xs">&#10022;</span><span>Personalized table signage</span></li>
              </ul>
            </div>
            <!-- GUESTS PANEL — cream now contrasts against the white page bg -->
            <div class="bg-cream p-5 sm:p-6">
              <p class="text-navy/80 font-bold tracking-[0.25em] uppercase text-xs mb-3">Guests&rsquo; Benefits</p>
              <ul class="space-y-2 text-slate/85 text-sm sm:text-[15px] leading-snug">
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>Reserved premium seating</span></li>
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>Seated with your group, even if tickets are bought separately</span></li>
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>Seated near our distinguished guests</span></li>
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>No additional cost beyond your ticket</span></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- PERFECT FOR ANY GROUP — boxed, mirrors the Benefits card pattern -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">
          <!-- Gold header bar -->
          <div class="bg-gold py-3 sm:py-4 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-xs sm:text-sm leading-tight">
              Perfect for Any Group
            </p>
          </div>
          <!-- Body — cream, gold-star separators -->
          <div class="bg-cream p-6 sm:p-7 text-center">
            <p class="text-slate/85 text-base sm:text-lg leading-relaxed">
              Company Parties &nbsp;<span class="text-gold">&#9733;</span>&nbsp; School Alumni &nbsp;<span class="text-gold">&#9733;</span>&nbsp; Professional Groups &nbsp;<span class="text-gold">&#9733;</span>&nbsp; Birthday Celebrations &nbsp;<span class="text-gold">&#9733;</span>&nbsp; Reunions &nbsp;<span class="text-gold">&#9733;</span>&nbsp; Neighborhood Groups &nbsp;<span class="text-gold">&#9733;</span>&nbsp; Civic Associations &nbsp;<span class="text-gold">&#9733;</span>&nbsp; Common-interest Groups
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- HOW IT WORKS — HOSTING / JOINING side-by-side on white -->
    <!-- ============================================================ -->
    <section id="how-it-works" class="scroll-mt-24 py-14 sm:py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <!-- One unified graphic, mirroring the Benefits-of-Hosted-Groups card -->
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">

          <!-- Gold header bar — 3-line stack -->
          <div class="bg-gold py-4 sm:py-5 px-6 text-center">
            <p class="text-navy-dark/80 font-bold tracking-[0.3em] uppercase text-[10px] sm:text-xs mb-1">
              Instructions
            </p>
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-base sm:text-lg leading-tight">
              Creating or Joining a Group
            </p>
            <p class="text-navy-dark/85 font-semibold italic text-sm sm:text-base mt-1">
              Easy as 1&mdash;2&mdash;3
            </p>
          </div>

          <!-- Two-column inner grid: Hosting (cream) | Joining (navy) -->
          <div class="grid md:grid-cols-2">

            <!-- HOSTING PANEL — cream -->
            <div class="relative bg-cream p-6 sm:p-7 flex flex-col border-b md:border-b-0 md:border-r border-navy/10">
              <p class="text-red font-bold tracking-[0.2em] uppercase text-xs mb-3">Create Your Hosted Group</p>
              <h3 class="font-heading font-bold text-xl text-navy mb-4 leading-tight">
                You invite guests. We handle the rest.
              </h3>
              <ol class="space-y-3 text-slate/85 text-sm sm:text-base leading-snug list-none mb-5">
                <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">1.</span><span>Purchase your Statesman&rsquo;s Concierge Pass.</span></li>
                <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">2.</span><span>Use Hosted Groups link on this page or in your confirmation email to register your group &mdash; it takes less than 2 minutes.</span></li>
                <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">3.</span><span>Invite others to join your Hosted Group.</span></li>
              </ol>
              <div class="border-t border-navy/10 pt-4 mb-5 space-y-2 text-slate/80 text-sm sm:text-base leading-snug italic">
                <p>We handle setup, custom signage, decor, favors, coordination, and details.</p>
                <p>You enjoy an unforgettable evening at your own private celebration within the Ball.</p>
              </div>
              <a
                href={CREATE_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-auto inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark text-xs font-bold tracking-[0.18em] uppercase px-5 py-3 rounded shadow-md hover:shadow-lg transition-all"
              >
                Create a Group &rarr;
              </a>
            </div>

            <!-- JOINING PANEL — navy gradient -->
            <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark p-6 sm:p-7 flex flex-col text-white">
              <p class="text-gold font-bold tracking-[0.2em] uppercase text-xs mb-3">Join an Existing Group</p>
              <h3 class="font-heading font-bold text-xl text-white mb-4 leading-tight">
                Get ready to celebrate!
              </h3>
              <ol class="space-y-3 text-white/90 text-sm sm:text-base leading-snug list-none mb-5">
                <li class="flex gap-3"><span class="font-bold text-gold flex-shrink-0">1.</span><span>Purchase your Statesman&rsquo;s Concierge Pass.</span></li>
                <li class="flex gap-3"><span class="font-bold text-gold flex-shrink-0">2.</span><span>Use the Hosted Groups link on this page or in your confirmation email to select the group you&rsquo;d like to join.</span></li>
                <li class="flex gap-3"><span class="font-bold text-gold flex-shrink-0">3.</span><span>Register for that group &ndash; it takes less than 2 minutes.</span></li>
              </ol>
              <div class="border-t border-gold/30 pt-4 mb-5 space-y-2 text-white/80 text-sm sm:text-base leading-snug italic">
                <p>We coordinate group accommodation and amenities.</p>
                <p>You enjoy this historic event with your people!</p>
              </div>
              <a
                href={JOIN_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-auto inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark text-xs font-bold tracking-[0.18em] uppercase px-5 py-3 rounded shadow-md hover:shadow-lg transition-all"
              >
                Join a Group &rarr;
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- LIVE ROSTER — wrapped in a gold-header / navy-body box -->
    <!-- ============================================================ -->
    <section class="py-14 sm:py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">
          <!-- Gold header bar -->
          <div class="bg-gold py-3 sm:py-4 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-xs sm:text-sm leading-tight">
              Live Roster
            </p>
          </div>
          <!-- Navy body -->
          <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark p-6 sm:p-10">
            <div class="text-center mb-10">
              <h2 class="text-3xl sm:text-4xl font-bold text-gold mb-4 font-heading leading-tight">
                Hosted Groups in Motion
              </h2>
              <div class="w-16 h-1 bg-gold mx-auto mb-5"></div>
              <p class="max-w-2xl mx-auto text-white/85 text-base sm:text-lg leading-relaxed">
                Browse current Hosted Groups. Don&rsquo;t see your group? Start your own.
              </p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
              {hostedTables.map((t) => (
                <div class="relative bg-cream rounded-xl p-5 sm:p-6 flex flex-col">
                  {t.count >= FEATURED_THRESHOLD && (
                    <span class="absolute -top-2.5 -right-2.5 bg-red text-white text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded shadow-md">&#9733; Featured</span>
                  )}
                  <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-1 leading-tight">{t.name}</h3>
                  <p class="text-red font-bold text-sm tracking-wide mb-4">
                    {t.count} confirmed members
                  </p>
                  <a
                    href={JOIN_FORM_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-auto inline-block text-center bg-navy hover:bg-navy-light text-white text-xs font-bold tracking-[0.15em] uppercase px-4 py-2.5 rounded transition-colors"
                  >
                    Join This Group &rarr;
                  </a>
                </div>
              ))}
            </div>

            <!-- Start-a-new button below the roster grid, inside the navy box -->
            <div class="text-center mt-10">
              <a
                href={CREATE_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-8 py-3.5 text-sm font-bold tracking-[0.18em] uppercase transition-all rounded shadow-lg hover:shadow-xl hover:-translate-y-0.5"
              >
                Start a New Hosted Group &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FAQ — wrapped in gold-header / cream-body box, condensed -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">
          <!-- Gold header bar -->
          <div class="bg-gold py-3 sm:py-4 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-xs sm:text-sm leading-tight">
              Common Questions
            </p>
          </div>
          <!-- Cream body — divider lines instead of individual cards -->
          <div class="bg-cream px-5 sm:px-7 divide-y divide-navy/10">
            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Do I have to be in a group to buy a Statesman&rsquo;s Concierge Pass?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">No.</strong> Hosted Groups are completely optional. Independent guests are warmly welcomed and will be seated in the Statesman&rsquo;s Concierge Area.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Does it cost anything extra to host or join a group?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">No.</strong> Hosting or joining a Hosted Group is included at no additional cost.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Can I start or join a group after buying my ticket?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">Yes.</strong> Use the Hosted Groups link on this page or in your confirmation email.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Will I need my Eventbrite order number?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">Yes.</strong> We use your order number to verify your ticket and coordinate seating.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">If I buy multiple tickets at one time, will we be seated together?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">Yes.</strong> Tickets purchased together in one order will be seated together whenever possible.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">If my friend and I purchase tickets separately, can we still sit together?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">Yes.</strong> The easiest way is to create or join a Hosted Group. It&rsquo;s quick, free, and groups can be as small as two people.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Can I join a group even if I don&rsquo;t know everyone in it?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">Yes.</strong> Many groups are formed around shared interests, affiliations, schools, neighborhoods, or communities.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Will my email address or order number be shown publicly?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">No.</strong> Email addresses, phone numbers, Eventbrite order numbers, and private notes are only visible to the event team.
              </p>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- HELPFUL TIPS / ASSETS — moved to bottom (de-emphasized for now) -->
    <!-- ============================================================ -->
    <section class="py-12 sm:py-14 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">
          <!-- Gold header bar -->
          <div class="bg-gold py-3 sm:py-4 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-xs sm:text-sm leading-tight">
              Helpful Tips &amp; Assets
            </p>
          </div>
          <!-- Cream body -->
          <div class="bg-cream p-6 sm:p-8">
            <div class="text-center mb-6">
              <h2 class="text-2xl sm:text-3xl font-bold text-navy font-heading">We&rsquo;ll Help You Get the Word Out</h2>
            </div>
            <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
