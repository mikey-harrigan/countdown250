---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { hostedTables, FEATURED_THRESHOLD } from '../data/hosted-groups';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";

// Live Google Forms (shortened forms.gle links).
//   CREATE_FORM_URL → for Hosts who want to start a new Hosted Group
//   JOIN_FORM_URL   → for Guests joining an existing Hosted Group
const CREATE_FORM_URL = "https://forms.gle/yT1YbicTbS3i1CNn9";
const JOIN_FORM_URL   = "https://forms.gle/J8v9jHB5ENqvYbaw5";
---

<BaseLayout
  title="The Hosted Groups Program — Statesman's Pass Amenity | The Official Countdown 250 Ball | July 3, 2026"
  description="Host your own Party Inside the Party at the Countdown 250 Ball — or join one already in motion. Reserved private tables, named recognition, public toast. A Statesman's Concierge Pass amenity."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <main>

    <!-- ============================================================ -->
    <!-- HERO — navy bg, mirrors the Partners page hero pattern -->
    <!-- (tightened: tagline moved into white intro, red divider removed) -->
    <!-- ============================================================ -->
    <section class="relative pt-20 pb-10 sm:pt-24 sm:pb-12 bg-navy text-white overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-navy-dark/90 to-navy"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <!-- Eyebrow -->
        <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-7">
          Maximize Your Statesman&rsquo;s Pass Experience
        </p>

        <!-- H1 — same font and styling family as the Partners page H1 -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-gold font-heading leading-tight">
          Hosted Groups
        </h1>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- INTRO — white bg starts here, same as Partners body sections -->
    <!-- ============================================================ -->
    <section class="pt-10 pb-10 sm:pt-12 sm:pb-12 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <!-- Tagline moved here from the hero — italic navy, slightly larger -->
        <p class="text-navy italic text-xl sm:text-2xl font-light tracking-wide text-center mb-8">
          Your &ldquo;Party Inside the Party&rdquo;
        </p>
        <div class="space-y-5 text-slate/80 text-base sm:text-lg leading-relaxed">
          <p>
            Are you planning a <strong class="text-red">company event</strong>, <strong class="text-red">reunion</strong>, <strong class="text-red">birthday celebration</strong>, <strong class="text-red">alumni gathering</strong> &mdash; or simply a <strong class="text-red">night out with friends</strong>?
          </p>
          <p>
            <strong class="text-red font-bold tracking-wide">HOSTED GROUPS</strong> lets you celebrate together at your private &ldquo;Party Inside the Party&rdquo; &mdash; within one of the <strong class="text-red">most anticipated events in America</strong>.
          </p>
          <p>
            <strong class="text-red font-bold tracking-wide">HOSTED GROUPS</strong> is an <strong class="text-red">exclusive, no-cost benefit</strong> for Statesman&rsquo;s Concierge Pass holders that allows you to <strong class="text-red">host your own private group</strong> &mdash; or <strong class="text-red">join an existing group</strong> &mdash; and enjoy a <strong class="text-red">once-in-a-lifetime shared experience within the historic Countdown 250 Gala.</strong>
          </p>
          <p>
            Each Hosted Group enjoys a <strong class="text-red">dedicated gathering space</strong> in the exclusive Statesman&rsquo;s Concierge Area, with reserved seating, custom signage, and coordinated details designed to create your special &ldquo;Party Inside the Party.&rdquo; And group members are seated together even if tickets are purchased separately.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- HOSTED GROUPS PICTURE MARQUEE — full-width auto-scrolling -->
    <!-- (Option A: scroller between Intro and Benefits) -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8 bg-white overflow-hidden">
      <div class="hosted-marquee relative">
        <!-- Edge fade overlays so images appear to dissolve into the white page -->
        <div class="hosted-marquee-fade hosted-marquee-fade-left"></div>
        <div class="hosted-marquee-fade hosted-marquee-fade-right"></div>

        <!-- The track holds TWO copies of every image so the animation loops seamlessly -->
        <div class="hosted-marquee-track flex gap-3 sm:gap-4">
          <!-- First copy -->
          <img src="/images/event/vip-dinner-table-group.jpg" alt="A Hosted Group seated together at their reserved round table with American flags glowing on the back wall" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-jmu-alumni-signage.jpg" alt="JMU Alumni Hosted Group toasting at their reserved table beneath custom JMU Alumni signage" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-formal-dinner.jpg" alt="Five guests sharing dinner at a candlelit round table beneath an American flag" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event-photos/aab-2025-hosted-table-ballroom.jpg" alt="Friends gathered around a candlelit round table at a recent All-American Inaugural Ball" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-hightop-conversation.jpg" alt="Four guests in formal attire sharing an intimate conversation at a high-top cocktail table" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-vip-bar.jpg" alt="Guests gathered at the premium open bar in formal attire" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-hightop-mingling.jpg" alt="A group mingling at a reserved high-top table in the ballroom" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-hors-doeuvres.jpg" alt="A server presenting passed hors d'oeuvres to two guests in formal attire" class="hosted-marquee-img" loading="lazy" />
          <!-- Second copy (aria-hidden because it's a visual duplicate) -->
          <img src="/images/event/vip-dinner-table-group.jpg" alt="" aria-hidden="true" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-jmu-alumni-signage.jpg" alt="" aria-hidden="true" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-formal-dinner.jpg" alt="" aria-hidden="true" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event-photos/aab-2025-hosted-table-ballroom.jpg" alt="" aria-hidden="true" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-hightop-conversation.jpg" alt="" aria-hidden="true" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-vip-bar.jpg" alt="" aria-hidden="true" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-hightop-mingling.jpg" alt="" aria-hidden="true" class="hosted-marquee-img" loading="lazy" />
          <img src="/images/event/reserved-table-hors-doeuvres.jpg" alt="" aria-hidden="true" class="hosted-marquee-img" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- BENEFITS — long pre-edit home-page version, ported per Mike   -->
    <!-- 2026-05-05. Header reads 'Benefits of Hosting Your Party     -->
    <!-- Inside the Party'. Asymmetric host (5fr) / guest (4fr) grid; -->
    <!-- host panel is navy + gold + 9 bullets + 'WE do the work…    -->
    <!-- YOU get the credit!' tagline; guest panel is cream + 5       -->
    <!-- supporting bullets. Bottom info bar for 6+ groups kept.      -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <!-- Outer rounded shell with gold border + soft glow -->
        <div class="rounded-xl overflow-hidden border border-gold/40 shadow-[0_0_28px_rgba(197,164,78,0.20)]">

          <!-- Classy header bar over the two benefits boxes -->
          <div class="bg-gold py-4 sm:py-5 px-6 text-center border-b border-navy-dark/30">
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-xs sm:text-sm leading-tight">
              Benefits of Hosting Your &ldquo;Party Inside the Party&rdquo;
            </p>
          </div>

          <!-- Asymmetric two-column grid: Host (dominant) | Guest (supporting) -->
          <div class="grid md:grid-cols-[5fr_4fr]">

            <!-- HOST PANEL: dark navy + gold = premium, aspirational -->
            <div class="relative bg-gradient-to-br from-navy-dark via-navy to-navy-dark p-7 sm:p-8 md:p-10 text-white overflow-hidden">
              <!-- Gold accent edges -->
              <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/70 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent"></div>

              <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-2">Benefits to Hosts</p>
              <p class="font-heading italic text-gold/85 text-base sm:text-lg leading-snug mb-6">
                <strong class="font-bold not-italic">WE</strong> do the work&hellip; <strong class="font-bold not-italic">YOU</strong> get the credit!
              </p>

              <ul class="space-y-2.5 text-white/85 text-[15px] sm:text-base leading-snug">
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Fast and easy &mdash; we handle every detail</span></li>
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>No additional cost to you or your guests</span></li>
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Your group can purchase Statesman&rsquo;s Pass tix in one order, or separate orders</span></li>
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Reserved private tables for your group in same VIP area as honored guests</span></li>
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span><strong class="font-semibold text-white">Public &ldquo;Toast to the Hosts&rdquo;</strong> ceremony at the event</span></li>
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span><strong class="font-semibold text-white">You are named in the official event program</strong></span></li>
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span><strong class="font-semibold text-white">You are named on the event website</strong></span></li>
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span><strong class="font-semibold text-white">Personalized table signage</strong> with your name &amp; group name</span></li>
                <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span><strong class="font-semibold text-white">Premium favors, decorations,</strong> and perks</span></li>
              </ul>
            </div>

            <!-- GUEST PANEL: cream + understated = supporting -->
            <div class="bg-cream p-6 sm:p-7 md:p-8">
              <p class="text-navy/80 font-bold tracking-[0.25em] uppercase text-xs mb-5">Benefits to Guests</p>

              <ul class="space-y-2 text-slate/75 text-[14px] sm:text-[15px] leading-snug">
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>Reserved premium gathering place/tables with your group</span></li>
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>Your group is seated with/among the event&rsquo;s honored guests</span></li>
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>Simple to register for your group</span></li>
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>No additional cost beyond the Statesman&rsquo;s Pass ticket</span></li>
                <li class="flex items-start"><span class="text-navy/40 mr-2.5 font-bold flex-shrink-0 mt-0.5">&bull;</span><span>Shared memories with your group and honored guests, to last a lifetime</span></li>
              </ul>
            </div>
          </div>

          <!-- Bottom info bar — full-width add-on clause for groups of 6+ -->
          <div class="bg-navy-dark py-3 px-6 text-center border-t border-gold/30">
            <p class="text-white/85 text-xs sm:text-sm italic leading-snug">
              Groups of 6 or more, contact us at <a href="mailto:CountdownAmerica250@gmail.com?subject=Hosted%20Group%20%E2%80%94%20Group%20of%206%2B" class="text-gold not-italic font-semibold hover:underline">CountdownAmerica250@gmail.com</a> for enhanced accommodations.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 'PERFECT FOR ANY GROUP' section removed 2026-05-05.
         Archived in docs/asset-library/sections/hosted-group-tables-removed-2026-05-05.astro -->

    <!-- ============================================================ -->
    <!-- HOW IT WORKS — HOSTING / JOINING side-by-side on white -->
    <!-- ============================================================ -->
    <section id="how-it-works" class="scroll-mt-24 py-14 sm:py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <!-- One unified graphic, mirroring the Benefits-of-Hosted-Groups card -->
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">

          <!-- Gold header bar — 3-line stack -->
          <div class="bg-gold py-4 sm:py-5 px-6 text-center">
            <p class="text-navy-dark/80 font-bold tracking-[0.3em] uppercase text-[10px] sm:text-xs mb-1">
              Instructions
            </p>
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-base sm:text-lg leading-tight">
              Creating or Joining a Group
            </p>
            <p class="text-navy-dark/85 font-semibold italic text-sm sm:text-base mt-1">
              Easy as 1&mdash;2&mdash;3
            </p>
          </div>

          <!-- Two-column inner grid: Hosting (cream) | Joining (navy) -->
          <div class="grid md:grid-cols-2">

            <!-- HOSTING PANEL — cream -->
            <div class="relative bg-cream p-6 sm:p-7 flex flex-col border-b md:border-b-0 md:border-r border-navy/10">
              <p class="text-red font-bold tracking-[0.2em] uppercase text-xs mb-4">Create Your Hosted Group</p>
              <ol class="space-y-3 text-slate/85 text-sm sm:text-base leading-snug list-none mb-5">
                <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">1.</span><span>Purchase your Statesman&rsquo;s Concierge Pass.</span></li>
                <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">2.</span><span>Register your Hosted Group using the quick link in the confirmation email we&rsquo;ll send you. It takes 2 minutes.</span></li>
                <li class="flex gap-3"><span class="font-bold text-navy flex-shrink-0">3.</span><span>Invite others to join your group.</span></li>
              </ol>
              <div class="border-t border-navy/10 pt-4 mb-5 space-y-2 text-slate/80 text-sm sm:text-base leading-snug italic">
                <p>We handle setup, custom signage, decor, favors, coordination, and details.</p>
                <p>You enjoy an unforgettable evening at your own private celebration within the Ball.</p>
              </div>
              <a
                href={CREATE_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-auto inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark text-xs font-bold tracking-[0.18em] uppercase px-5 py-3 rounded shadow-md hover:shadow-lg transition-all"
              >
                Create a Group &rarr;
              </a>
            </div>

            <!-- JOINING PANEL — navy gradient -->
            <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark p-6 sm:p-7 flex flex-col text-white">
              <p class="text-gold font-bold tracking-[0.2em] uppercase text-xs mb-4">Join an Existing Group</p>
              <ol class="space-y-3 text-white/90 text-sm sm:text-base leading-snug list-none mb-5">
                <li class="flex gap-3"><span class="font-bold text-gold flex-shrink-0">1.</span><span>Purchase your Statesman&rsquo;s Concierge Pass.</span></li>
                <li class="flex gap-3"><span class="font-bold text-gold flex-shrink-0">2.</span><span>Select the Hosted Group you&rsquo;d like to join using the quick link in the confirmation email we&rsquo;ll send you.</span></li>
                <li class="flex gap-3"><span class="font-bold text-gold flex-shrink-0">3.</span><span>Register for that group &ndash; it takes 2 minutes.</span></li>
              </ol>
              <div class="border-t border-gold/30 pt-4 mb-5 space-y-2 text-white/80 text-sm sm:text-base leading-snug italic">
                <p>We coordinate group accommodation and amenities.</p>
                <p>You enjoy this historic event with your people!</p>
              </div>
              <a
                href={JOIN_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-auto inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark text-xs font-bold tracking-[0.18em] uppercase px-5 py-3 rounded shadow-md hover:shadow-lg transition-all"
              >
                Join a Group &rarr;
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- LIVE ROSTER — wrapped in a gold-header / navy-body box -->
    <!-- ============================================================ -->
    <section class="py-14 sm:py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">
          <!-- Gold header bar -->
          <div class="bg-gold py-3 sm:py-4 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-xs sm:text-sm leading-tight">
              Live Roster
            </p>
          </div>
          <!-- Navy body -->
          <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark p-6 sm:p-10">
            <div class="text-center mb-10">
              <h2 class="text-3xl sm:text-4xl font-bold text-gold mb-4 font-heading leading-tight">
                Hosted Groups in Motion
              </h2>
              <div class="w-16 h-1 bg-gold mx-auto mb-5"></div>
              <p class="max-w-2xl mx-auto text-white/85 text-base sm:text-lg leading-relaxed">
                Browse current Hosted Groups. Don&rsquo;t see your group? Start your own.
              </p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
              {hostedTables.map((t) => (
                <div class="relative bg-cream rounded-xl p-5 sm:p-6 flex flex-col">
                  {t.count >= FEATURED_THRESHOLD && (
                    <span class="absolute -top-2.5 -right-2.5 bg-red text-white text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded shadow-md">&#9733; Featured</span>
                  )}
                  <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-1 leading-tight">{t.name}</h3>
                  <p class="text-red font-bold text-sm tracking-wide mb-4">
                    {t.count} confirmed members
                  </p>
                  <a
                    href={JOIN_FORM_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-auto inline-block text-center bg-navy hover:bg-navy-light text-white text-xs font-bold tracking-[0.15em] uppercase px-4 py-2.5 rounded transition-colors"
                  >
                    Join This Group &rarr;
                  </a>
                </div>
              ))}
            </div>

            <!-- Start-a-new button below the roster grid, inside the navy box -->
            <div class="text-center mt-10">
              <a
                href={CREATE_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-8 py-3.5 text-sm font-bold tracking-[0.18em] uppercase transition-all rounded shadow-lg hover:shadow-xl hover:-translate-y-0.5"
              >
                Start a New Hosted Group &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FAQ — wrapped in gold-header / cream-body box, condensed -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-navy/15 shadow-md">
          <!-- Gold header bar -->
          <div class="bg-gold py-3 sm:py-4 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.25em] uppercase text-xs sm:text-sm leading-tight">
              Common Questions
            </p>
          </div>
          <!-- Cream body — divider lines instead of individual cards -->
          <div class="bg-cream px-5 sm:px-7 divide-y divide-navy/10">
            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Do I have to be in a group to buy a Statesman&rsquo;s Concierge Pass?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">No.</strong> Hosted Groups are completely optional. Independent guests are warmly welcomed and will be seated in the Statesman&rsquo;s Concierge Area.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Does it cost anything extra to host or join a group?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">No.</strong> Hosting or joining a Hosted Group is included at no additional cost.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Can I start or join a group after buying my ticket?</h3>
                <svg class="w-4 h-4 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="text-slate/80 leading-relaxed mt-2 text-sm">
                <strong class="text-navy font-bold">Yes.</strong> Use the Hosted Groups link on this page or in your confirmation email.
              </p>
            </details>

            <details class="group py-3 sm:py-3.5 cursor-pointer">
              <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
                <h3 class="text-sm sm:text-base font-semibold text-navy font-heading">Will I need my Eventbrite order number?</h3>
