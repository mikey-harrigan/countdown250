<style>
  /* ============================================================ */
  /* Hosted Groups picture marquee                                */
  /* ------------------------------------------------------------ */
  /* Pure-CSS infinite horizontal scroll. Track contains two      */
  /* copies of each image and translates -50% over one cycle so   */
  /* the loop is seamless. Pauses on hover so visitors can see    */
  /* a specific shot. Respects prefers-reduced-motion.            */
  /* ============================================================ */

  .hosted-marquee {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .hosted-marquee-track {
    width: max-content;
    animation: hosted-marquee-scroll 50s linear infinite;
    will-change: transform;
  }

  .hosted-marquee:hover .hosted-marquee-track {
    animation-play-state: paused;
  }

  .hosted-marquee-img {
    height: 180px;
    width: auto;
    aspect-ratio: 4 / 3;
    border-radius: 0.625rem;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: 0 10px 24px -10px rgba(0, 40, 104, 0.32);
  }

  @media (min-width: 640px) {
    .hosted-marquee-img { height: 220px; }
  }
  @media (min-width: 1024px) {
    .hosted-marquee-img { height: 260px; }
  }

  /* Edge fades so images dissolve into the white page background  */
  .hosted-marquee-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60px;
    z-index: 2;
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .hosted-marquee-fade { width: 100px; }
  }
  .hosted-marquee-fade-left {
    left: 0;
    background: linear-gradient(to right, #ffffff 0%, rgba(255,255,255,0) 100%);
  }
  .hosted-marquee-fade-right {
    right: 0;
    background: linear-gradient(to left, #ffffff 0%, rgba(255,255,255,0) 100%);
  }

  @keyframes hosted-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Accessibility: respect users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hosted-marquee-track {
      animation: none;
    }
  }
</style>
