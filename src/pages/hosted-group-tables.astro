---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { hostedTables, FEATURED_THRESHOLD } from '../data/hosted-groups';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";

// TODO: Mike — replace these placeholder URLs after creating the two
// Google Forms. The "Create" form is for Hosts; the "Join" form is for
// Guests joining an existing Hosted Group. Until replaced, both buttons
// fall back to a prefilled mailto: so visitors can still reach Mike.
const CREATE_FORM_URL = "mailto:CountdownAmerica250@gmail.com?subject=Create%20a%20Hosted%20Table&body=I%27d%20like%20to%20create%20a%20Hosted%20Table.%20Please%20send%20me%20the%20signup%20form.";
const JOIN_FORM_URL   = "mailto:CountdownAmerica250@gmail.com?subject=Join%20a%20Hosted%20Table&body=I%27d%20like%20to%20join%20a%20Hosted%20Table.%20Please%20send%20me%20the%20signup%20form.";
---

<BaseLayout
  title="The Hosted Groups Program — Statesman's Pass Amenity | The Official Countdown 250 Ball | July 3, 2026"
  description="Host your own Party Inside the Party at the Countdown 250 Ball — or join one already in motion. Reserved private tables, named recognition, public toast. A Statesman's Concierge Pass amenity."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- ============================================================ -->
  <!-- HERO -->
  <!-- ============================================================ -->
  <section class="pt-32 pb-14 sm:pb-16 bg-navy text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-4">
        Maximize Your Statesman&rsquo;s Pass Experience
      </p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-5 font-heading text-gold leading-tight">
        The Hosted Groups Program
      </h1>
      <p class="text-xl sm:text-2xl text-white italic font-light mb-7 leading-snug">
        Host your own &ldquo;Party Inside the Party&rdquo;<br class="hidden sm:block" />
        &mdash; or join one already in motion.
      </p>
      <div class="w-24 h-px bg-gold mx-auto"></div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- WHAT IT IS (concise, with reassurance baked in) -->
  <!-- ============================================================ -->
  <section class="py-12 sm:py-14 bg-navy text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="space-y-5 text-white/90 text-base sm:text-lg leading-relaxed">
        <p>
          The <strong class="text-gold">Hosted Groups Program</strong> is an exclusive amenity for Statesman&rsquo;s Concierge Pass holders. It lets you reserve a private table for your group inside the Statesman&rsquo;s Concierge Area &mdash; a &ldquo;Party Inside the Party&rdquo; with personalized recognition, signage, and amenities.
        </p>
        <p>
          Hosting and joining are both <strong class="text-white">completely optional</strong>. Use it if it suits you. Skip it if it doesn&rsquo;t. Your Statesman&rsquo;s Pass experience is exceptional either way.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 3-STEP FLOW -->
  <!-- ============================================================ -->
  <section class="py-10 sm:py-12 bg-navy">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <p class="text-center text-base sm:text-lg lg:text-xl leading-relaxed text-white/90 whitespace-nowrap overflow-x-auto">
        <strong class="font-bold text-gold">You</strong> invite guests
        <span class="text-gold font-black text-lg sm:text-xl lg:text-2xl mx-2 sm:mx-3 align-middle">&rarr;</span>
        <strong class="font-bold text-gold">Guests</strong> purchase Statesman&rsquo;s Pass tix
        <span class="text-gold font-black text-lg sm:text-xl lg:text-2xl mx-2 sm:mx-3 align-middle">&rarr;</span>
        <strong class="font-bold text-gold">We</strong> handle the rest.
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- THREE WAYS — the no-pressure / don't-dissuade reassurance -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">No Wrong Way</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4 font-heading leading-tight">
          Three Ways to Enjoy Your Statesman&rsquo;s Pass
        </h2>
        <div class="w-20 h-px bg-gold mx-auto"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-5 sm:gap-6">

        <!-- Option 1: Host -->
        <div class="bg-cream rounded-xl p-6 sm:p-7 flex flex-col">
          <p class="text-red font-bold tracking-wider uppercase text-xs mb-3">Option 1</p>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 leading-tight">
            Host your own Hosted Group
          </h3>
          <p class="text-slate/80 text-sm sm:text-base leading-relaxed flex-grow">
            Bring your group, get the spotlight. Featured Hosted Groups (6+ guests) earn the public Toast to the Hosts and personalized table signage.
          </p>
        </div>

        <!-- Option 2: Join -->
        <div class="bg-cream rounded-xl p-6 sm:p-7 flex flex-col">
          <p class="text-red font-bold tracking-wider uppercase text-xs mb-3">Option 2</p>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 leading-tight">
            Join an existing Hosted Group
          </h3>
          <p class="text-slate/80 text-sm sm:text-base leading-relaxed flex-grow">
            Sit with your tribe. Affinity tables (alumni, professional, family, neighborhood) are open to any Statesman&rsquo;s Pass holder. Browse the live roster below.
          </p>
        </div>

        <!-- Option 3: Independent -->
        <div class="bg-cream rounded-xl p-6 sm:p-7 flex flex-col">
          <p class="text-red font-bold tracking-wider uppercase text-xs mb-3">Option 3</p>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 leading-tight">
            Sit independently
          </h3>
          <p class="text-slate/80 text-sm sm:text-base leading-relaxed flex-grow">
            <strong class="font-bold text-navy">Not in a group? That&rsquo;s OK.</strong> We&rsquo;ll seat you with other independent and honored guests in the Statesman&rsquo;s Concierge Area. Buying tickets together at the same time? You&rsquo;ll be seated together automatically &mdash; no formal group needed.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- BENEFITS LADDER — Hosted Group vs Featured Hosted Group -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Benefits</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4 font-heading leading-tight">
          Bring 5 Friends. Get the Spotlight.
        </h2>
        <div class="w-20 h-px bg-gold mx-auto mb-5"></div>
        <p class="max-w-2xl mx-auto text-white/85 text-base sm:text-lg leading-relaxed">
          Every Hosted Group gets reserved seating + named in the official program. Hosts who bring 5 or more guests (6+ total) earn full public recognition.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 sm:gap-6">

        <!-- Tier 1: Hosted Group -->
        <div class="bg-cream rounded-xl p-6 sm:p-8">
          <p class="text-navy/70 font-bold tracking-[0.25em] uppercase text-xs mb-3">Hosted Group &mdash; any size</p>
          <p class="text-slate/85 text-sm italic mb-5">For any group of 2 or more.</p>
          <ul class="space-y-2.5 text-slate/85 text-base leading-snug">
            <li class="flex items-start"><span class="text-gold mr-3 font-bold flex-shrink-0 mt-1.5 text-[8px]">&#9679;</span><span>Reserved private table for your group inside the Statesman&rsquo;s Concierge Area</span></li>
            <li class="flex items-start"><span class="text-gold mr-3 font-bold flex-shrink-0 mt-1.5 text-[8px]">&#9679;</span><span><strong class="font-bold text-navy">Host named</strong> in the official event program</span></li>
            <li class="flex items-start"><span class="text-gold mr-3 font-bold flex-shrink-0 mt-1.5 text-[8px]">&#9679;</span><span><strong class="font-bold text-navy">Host named</strong> on the event website</span></li>
            <li class="flex items-start"><span class="text-gold mr-3 font-bold flex-shrink-0 mt-1.5 text-[8px]">&#9679;</span><span>We handle every detail &mdash; you enjoy <strong class="font-bold text-navy">YOUR party</strong></span></li>
          </ul>
        </div>

        <!-- Tier 2: Featured Hosted Group -->
        <div class="relative bg-gradient-to-br from-gold to-[#B8954A] rounded-xl p-6 sm:p-8">
          <span class="absolute -top-3 right-6 bg-red text-white text-[10px] font-bold tracking-wider uppercase px-3 py-1 rounded shadow-lg">&#9733; Featured</span>
          <p class="text-navy-dark/80 font-bold tracking-[0.25em] uppercase text-xs mb-3">Featured Hosted Group &mdash; 6+ guests</p>
          <p class="text-navy-dark text-sm italic mb-5">Everything above, plus:</p>
          <ul class="space-y-2.5 text-navy-dark text-base leading-snug">
            <li class="flex items-start"><span class="mr-3 font-bold flex-shrink-0 mt-1.5 text-[8px]">&#9679;</span><span><strong class="font-bold">Public &ldquo;Toast to the Hosts&rdquo;</strong> ceremony at the event</span></li>
            <li class="flex items-start"><span class="mr-3 font-bold flex-shrink-0 mt-1.5 text-[8px]">&#9679;</span><span><strong class="font-bold">Personalized table signage</strong> with your name &amp; group name</span></li>
            <li class="flex items-start"><span class="mr-3 font-bold flex-shrink-0 mt-1.5 text-[8px]">&#9679;</span><span>Premium recognition during stage announcements</span></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- DEADLINES -->
  <!-- ============================================================ -->
  <section class="py-12 sm:py-14 bg-navy text-white border-t border-gold/20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Production Deadlines</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">Don&rsquo;t Wait &mdash; Recruit Early</h2>
      </div>
      <ul class="space-y-3 text-white/85 text-base sm:text-lg leading-relaxed">
        <li class="flex items-start gap-3">
          <span class="text-gold font-bold flex-shrink-0 w-20">T-60 days</span>
          <span>Official event program goes to print &mdash; Hosts confirmed by this date are named.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold font-bold flex-shrink-0 w-20">T-30 days</span>
          <span>Personalized table signage cuts off &mdash; Featured Hosted Groups must finalize details.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-gold font-bold flex-shrink-0 w-20">T-7 days</span>
          <span>Final seating chart is locked.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- LIVE ROSTER OF HOSTED TABLES -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Live Roster</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4 font-heading leading-tight">
          Hosted Groups in Motion
        </h2>
        <div class="w-20 h-px bg-gold mx-auto mb-5"></div>
        <p class="max-w-2xl mx-auto text-white/85 text-base sm:text-lg leading-relaxed">
          Browse the active Hosted Groups. Don&rsquo;t see your tribe? Start your own &mdash; it takes 30 seconds.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {hostedTables.map((t) => (
          <div class="relative bg-cream rounded-xl p-5 sm:p-6 flex flex-col">
            {t.count >= FEATURED_THRESHOLD && (
              <span class="absolute -top-2.5 -right-2.5 bg-red text-white text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded shadow-md">&#9733; Featured</span>
            )}
            <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-1 leading-tight">{t.name}</h3>
            {t.description && (
              <p class="text-slate/70 text-xs sm:text-sm italic mb-2">{t.description}</p>
            )}
            <p class="text-red font-bold text-sm tracking-wide mb-4">
              {t.count} confirmed members
            </p>
            <a
              href={JOIN_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto inline-block text-center bg-navy hover:bg-navy-light text-white text-xs font-bold tracking-[0.15em] uppercase px-4 py-2.5 rounded transition-colors"
            >
              Join This Table &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- TWO BIG CTAs: Create / Join -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Get Started</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 font-heading leading-tight">
          Ready to Host or Join?
        </h2>
        <div class="w-20 h-px bg-gold mx-auto mb-5"></div>
        <p class="max-w-2xl mx-auto text-white/85 text-base sm:text-lg leading-relaxed">
          You&rsquo;ll need a Statesman&rsquo;s Concierge Pass. Already have one? Pick your path below.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 sm:gap-6 mb-10">

        <!-- Create -->
        <a
          href={CREATE_FORM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark rounded-xl p-6 sm:p-8 transition-all shadow-md hover:shadow-xl hover:-translate-y-0.5 ring-1 ring-gold/30 ring-offset-2 ring-offset-navy"
        >
          <p class="font-bold tracking-[0.18em] uppercase text-xs mb-3 opacity-80">Hosts</p>
          <h3 class="font-heading font-extrabold text-2xl sm:text-3xl mb-3 leading-tight">
            Create a Hosted Group &rarr;
          </h3>
          <p class="text-sm sm:text-base font-medium leading-snug">
            Takes 30 seconds. Tell us your group name, expected size, and a few details. We&rsquo;ll send a sample invitation you can forward to your guests.
          </p>
        </a>

        <!-- Join -->
        <a
          href={JOIN_FORM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark rounded-xl p-6 sm:p-8 transition-all shadow-md hover:shadow-xl hover:-translate-y-0.5 ring-1 ring-gold/30 ring-offset-2 ring-offset-navy"
        >
          <p class="font-bold tracking-[0.18em] uppercase text-xs mb-3 opacity-80">Guests</p>
          <h3 class="font-heading font-extrabold text-2xl sm:text-3xl mb-3 leading-tight">
            Join a Hosted Group &rarr;
          </h3>
          <p class="text-sm sm:text-base font-medium leading-snug">
            Pick from the roster above (or write in your host&rsquo;s name). We&rsquo;ll match you to your group and seat you together at the event.
          </p>
        </a>

      </div>

      <p class="text-center text-white/60 text-xs sm:text-sm italic">
        Don&rsquo;t have a Statesman&rsquo;s Pass yet? <a href={ticketUrl} class="text-gold hover:text-gold/80 underline font-medium">Get yours first &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FAQ -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">Common Questions</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading">Quick Answers</h2>
      </div>

      <div class="space-y-3">
        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Do I have to be in a group to buy a Statesman&rsquo;s Pass?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> The Hosted Groups Program is a Statesman&rsquo;s Pass amenity, not a requirement. You&rsquo;ll be seated with other distinguished and honored guests in the Statesman&rsquo;s Concierge Area &mdash; same elevated experience, same premium section.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">My friends and I just want to sit together. Do we need a formal group?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> Buy your tickets at the same time and we&rsquo;ll seat you together automatically. Hosting is for groups of any size who want the public recognition (named in program, named on website, and at 6+ guests, the public Toast to the Hosts).
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">How do I host? What does it actually involve?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            Three steps: (1) Buy your Statesman&rsquo;s Pass on Eventbrite. (2) Click <em>Create a Hosted Group</em> on this page and fill out the 30-second form. (3) We&rsquo;ll email you a sample invitation you can forward to your guests. Each guest buys their own Statesman&rsquo;s Pass and joins your group on this same page. We handle every detail at the event.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">What if my group doesn&rsquo;t reach 6 people?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No problem.</strong> You&rsquo;re still a Hosted Group with full base benefits &mdash; reserved private seating for your group, host named in the official event program, and host named on the event website. The two perks reserved for Featured Hosted Groups (public Toast to the Hosts and personalized table signage) carry meaningful production cost, which is why they kick in at 6+ guests.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">Does the Host pay anything extra?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            <strong class="text-navy font-bold">No.</strong> No extra cost to the Host. No extra cost to the guests. Each person pays only for their own Statesman&rsquo;s Concierge Pass.
          </p>
        </details>

        <details class="group bg-cream rounded-xl p-5 sm:p-6 cursor-pointer">
          <summary class="flex items-start justify-between gap-4 list-none cursor-pointer">
            <h3 class="text-base sm:text-lg font-bold text-navy font-heading">When do I need to confirm my group?</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-gold mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="text-slate/80 leading-relaxed mt-4 text-sm sm:text-base">
            Hosts are named in the printed program if confirmed by <strong class="text-navy font-bold">T-60 days (early May 2026)</strong>. Personalized signage cuts off at <strong class="text-navy font-bold">T-30 days</strong>. Final seating is locked at <strong class="text-navy font-bold">T-7 days</strong>. Earlier is always better.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- CLOSING CTA -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold mb-5 font-heading leading-tight">
        Be A Part Of History.
      </h2>
      <p class="text-white/90 text-base sm:text-lg leading-relaxed mb-8">
        Reserve your Statesman&rsquo;s Concierge Pass &mdash; then host or join your &ldquo;Party Inside the Party.&rdquo;
      </p>
      <a
        href={ticketUrl}
        class="eventbrite-checkout inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-sm font-bold tracking-[0.2em] uppercase transition-all rounded shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
      >
        Get Your Statesman&rsquo;s Pass &rarr;
      </a>
