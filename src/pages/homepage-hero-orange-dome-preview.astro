---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Hero Dome — ORANGE DEBUG Preview | Countdown 250 Ball"
  description="PREVIEW — same hero as live, but the dark dome is painted bright orange so we can see exactly where it sits. NOT LIVE."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- Internal preview banner -->
  <div class="bg-gold/15 border-b border-gold/40 text-navy py-2.5 text-center text-xs">
    <p class="font-semibold tracking-wide">
      PREVIEW &middot; orange-dome debug. Live hero is at
      <a href="/" class="underline hover:text-red ml-1">/</a>
    </p>
  </div>

  <main>

    <!-- ============================================================ -->
    <!-- ORANGE-DOME DEBUG HERO                                       -->
    <!-- Three distinct background layers, each painted in a clearly  -->
    <!-- different debug color so Mike can tell them apart:           -->
    <!--   (1) BRIGHT BLUE — the full-hero photo overlay (covers the  -->
    <!--       entire hero, lives behind the dome). Live = black 0.55.-->
    <!--   (2) BRIGHT ORANGE — the feathered ball/dome.               -->
    <!--       Live = dark grey.                                      -->
    <!--   (3) BRIGHT YELLOW — the per-letter halos behind each glyph -->
    <!--       in the arched text (these merge into one blob per      -->
    <!--       text line). Live = black.                              -->
    <!-- All other geometry / blur / sizing matches live.             -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">
      <!-- Background image with FULL-HERO BLUE OVERLAY (debug color) -->
      <div class="absolute inset-0">
        <img
          src="/images/event/hero-countdown250-toast.jpg"
          alt="Black-tie guests toasting with champagne as Countdown 250 reaches 00:00:01 on stage"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0" style="background: rgba(40,120,255,0.55);"></div>
      </div>

      <!-- Content -->
      <div class="relative z-10 text-center px-4 sm:px-6 max-w-5xl mx-auto pt-28 pb-20">
        <!-- Seal logo (same as live) -->
        <div class="flex justify-center mb-10 animate-fade-in">
          <picture>
            <source srcset="/images/logos/countdown250-seal-navy-blue.webp" type="image/webp" />
            <img
              src="/images/logos/countdown250-seal-navy-blue.png"
              alt="The Official Countdown 250 Ball — July 3, 2026 — Washington, D.C."
              class="w-[340px] sm:w-[440px] md:w-[520px] h-auto drop-shadow-2xl"
            />
          </picture>
        </div>

        <!-- Wrapper: relative so the absolute dome stacks correctly -->
        <div class="relative mb-10">

          <!-- ===== DOME — painted BRIGHT ORANGE for debugging =====
               Geometry / blur kept in sync with what's currently
               LIVE on /index.astro so this orange visualization
               accurately represents where the dome covers the
               photo. Only the fill color is bright orange — every
               other attribute matches live.
                 ellipse: cx=500 cy=915 rx=500 ry=785
                          (top at viewBox y=130, bottom at y=1700)
                 blur: stdDeviation="80 70" (heavy horizontal blur
                       on sides, moderate vertical on top/bottom)
                 SVG: top: -30, height: 670, viewBox 0 0 1000 1500
          -->
          <svg
            class="absolute pointer-events-none z-0"
            style="top: -30px; height: 670px; left: 50%; transform: translateX(-50%); width: min(820px, calc(100vw - 1rem)); overflow: visible;"
            viewBox="0 0 1000 1500"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <defs>
              <filter id="orange-dome-feather" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur in="SourceGraphic" stdDeviation="80 70"/>
              </filter>
            </defs>
            <ellipse
              cx="500"
              cy="915"
              rx="500"
              ry="785"
              fill="rgba(255,102,0,0.90)"
              filter="url(#orange-dome-feather)"
            />
          </svg>

          <!-- All the text + button sit ABOVE the dome on z-10 -->
          <div class="relative z-10">

            <!-- DESKTOP arched SVG (md and up) — halos painted YELLOW for debugging -->
            <svg
              viewBox="0 -65 1000 295"
              class="hidden md:block mx-auto h-auto mb-8"
              style="width: min(1024px, calc(100vw - 2rem));"
              aria-label="Where will you be… when the clock strikes 250?"
              role="img"
            >
              <defs>
                <filter id="orange-arch-halo-desk" x="-50%" y="-50%" width="200%" height="200%">
                  <feMorphology in="SourceAlpha" operator="dilate" radius="12" result="expanded"/>
                  <feGaussianBlur in="expanded" stdDeviation="18" result="blurred"/>
                  <feFlood flood-color="yellow" flood-opacity="0.85" result="haloFill"/>
                  <feComposite in="haloFill" in2="blurred" operator="in" result="halo"/>
                  <feMerge>
                    <feMergeNode in="halo"/>
                    <feMergeNode in="SourceGraphic"/>
                  </feMerge>
                </filter>
                <path id="orange-arch-line1-desk" d="M 50 130 Q 500 0 950 130" fill="none" />
                <path id="orange-arch-line2-desk" d="M 50 215 Q 500 85 950 215" fill="none" />
              </defs>
              <text
                fill="rgba(255,255,255,0.92)"
                font-size="30"
                font-weight="300"
                font-style="italic"
                font-family="'Playfair Display', Georgia, serif"
                filter="url(#orange-arch-halo-desk)"
              >
                <textPath href="#orange-arch-line1-desk" startOffset="50%" text-anchor="middle">
                  Where will you be&#8230;
                </textPath>
              </text>
              <text
                fill="#ffffff"
                font-size="47"
                font-weight="400"
                font-style="italic"
                font-family="'Playfair Display', Georgia, serif"
                filter="url(#orange-arch-halo-desk)"
              >
                <textPath href="#orange-arch-line2-desk" startOffset="50%" text-anchor="middle">
                  when the clock strikes 250?
                </textPath>
              </text>
            </svg>

            <!-- MOBILE arched SVG (under md) -->
            <svg
              viewBox="0 -40 600 200"
              class="block md:hidden w-full max-w-md mx-auto h-auto mb-8"
              aria-hidden="true"
              role="img"
            >
              <defs>
                <filter id="orange-arch-halo-mob" x="-50%" y="-50%" width="200%" height="200%">
                  <feMorphology in="SourceAlpha" operator="dilate" radius="7" result="expanded"/>
                  <feGaussianBlur in="expanded" stdDeviation="11" result="blurred"/>
                  <feFlood flood-color="yellow" flood-opacity="0.85" result="haloFill"/>
                  <feComposite in="haloFill" in2="blurred" operator="in" result="halo"/>
                  <feMerge>
                    <feMergeNode in="halo"/>
                    <feMergeNode in="SourceGraphic"/>
                  </feMerge>
                </filter>
                <path id="orange-arch-line1-mob" d="M 30 95 Q 300 25 570 95" fill="none" />
                <path id="orange-arch-line2-mob" d="M 30 150 Q 300 80 570 150" fill="none" />
              </defs>
              <text fill="rgba(255,255,255,0.92)" font-size="34" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif" filter="url(#orange-arch-halo-mob)">
                <textPath href="#orange-arch-line1-mob" startOffset="50%" text-anchor="middle">Where will you be&#8230;</textPath>
              </text>
              <text fill="#ffffff" font-size="40" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif" filter="url(#orange-arch-halo-mob)">
                <textPath href="#orange-arch-line2-mob" startOffset="50%" text-anchor="middle">when the clock strikes 250?</textPath>
              </text>
            </svg>

            <p class="font-heading italic font-bold text-lg sm:text-xl md:text-2xl text-gold mb-2 tracking-wide">
              The Official
            </p>

            <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] text-white leading-[1.05] mb-6 tracking-tight">
              Countdown 250 Ball
            </h1>

            <div class="w-20 h-px bg-gold/70 mx-auto mb-5"></div>

            <p class="font-heading italic font-light text-lg sm:text-xl md:text-2xl text-gold/95 mb-8">
              A once-in-a-lifetime moment.
            </p>

            <div class="flex justify-center">
              <a
                href="/#tickets"
                class="bg-red hover:bg-red-light text-white px-10 py-4 text-sm font-semibold tracking-[0.2em] uppercase transition-all rounded shadow-lg hover:shadow-xl hover:-translate-y-0.5"
              >
                Compare Ticket Options
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

