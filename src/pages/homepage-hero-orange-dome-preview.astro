    </section>

    <!-- ============================================================ -->
    <!-- V4 — third NEW pic, NO overlays, NO halos                    -->
    <!-- 'Countdown Pic_3' from Downloads.                            -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden border-t-4 border-gold/40">
      <div class="absolute inset-0">
        <img
          src="/images/event/hero-countdown-pic-3.jpg"
          alt="Countdown 250 Ball — alternative hero photo (Countdown Pic 3)"
          class="w-full h-full object-cover object-center"
        />
