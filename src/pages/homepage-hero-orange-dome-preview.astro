    <!-- ============================================================ -->
    <!-- V5 — fourth NEW pic, NO overlays, NO halos                   -->
    <!-- 'Countdown Pic_5' from Downloads.                            -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden border-t-4 border-gold/40">
      <div class="absolute inset-0">
        <img
          src="/images/event/hero-countdown-pic-5.jpg"
