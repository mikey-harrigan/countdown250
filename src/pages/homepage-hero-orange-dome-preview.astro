              </defs>
              <text fill="rgba(255,255,255,0.92)" font-size="34" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
                <textPath href="#v3-arch-line1-mob" startOffset="50%" text-anchor="middle">Where will you be&#8230;</textPath>
              </text>
              <text fill="#ffffff" font-size="40" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
