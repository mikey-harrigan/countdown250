---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Hero Arched Header — Preview | Countdown 250 Ball"
  description="PREVIEW — testing arched typography for the home page hero ('Where will you be… when the clock strikes 250?'). NOT LIVE."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- Internal preview banner — never confuse this with the live home page -->
  <div class="bg-gold/15 border-b border-gold/40 text-navy py-2.5 text-center text-xs">
    <p class="font-semibold tracking-wide">
      PREVIEW &middot; arched header experiment for the home page HERO. Live home is at
      <a href="/" class="underline hover:text-red ml-1">/</a>
    </p>
  </div>

  <main>

    <!-- ============================================================ -->
    <!-- VERSION A — gentler arc                                      -->
    <!-- Hero recreated as faithfully as possible (same image, same  -->
    <!-- dark overlay, same seal, same masthead/headline copy below) -->
    <!-- so the arched text reads in real context.                   -->
    <!-- Only the TWO italic lines are arched. Everything else is the -->
    <!-- exact markup from src/pages/index.astro.                     -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/event/hero-countdown250-toast.jpg"
          alt="Hero background"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
      </div>

      <div class="relative z-10 text-center px-4 sm:px-6 max-w-5xl mx-auto pt-28 pb-20">

        <!-- Version label inside the hero -->
        <p class="text-gold/85 font-bold tracking-[0.3em] uppercase text-[10px] sm:text-xs mb-6">
          Version A &middot; gentler arc
        </p>

        <!-- Seal logo (unchanged from live) -->
        <div class="flex justify-center mb-10">
          <picture>
            <source srcset="/images/logos/countdown250-seal-navy-blue.webp" type="image/webp" />
            <img
              src="/images/logos/countdown250-seal-navy-blue.png"
              alt="The Official Countdown 250 Ball — July 3, 2026 — Washington, D.C."
              class="w-[340px] sm:w-[440px] md:w-[520px] h-auto drop-shadow-2xl"
            />
          </picture>
        </div>

        <!-- Soft-edged dark backdrop (unchanged from live) -->
        <div class="inline-block max-w-full px-6 py-7 sm:px-12 sm:py-9 rounded-3xl mb-10" style="background: radial-gradient(ellipse at center, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 70%, rgba(0,0,0,0.15) 100%);">

          <!-- ===== ARCHED HEADER — Version A =====
               Two SVG lines, both following matching arc curves.

               DESKTOP SVG (hidden on mobile): viewBox 1000 wide so font
               sizes in SVG units render at desktop sizes that closely
               match the live hero (line 1 ~30px @ md+, line 2 ~48px @ lg+).

               MOBILE SVG (hidden on md+): viewBox 600 wide so the text
               doesn't shrink to unreadable on a phone — text renders
               around xl/2xl size (matching live mobile hero sizes).

               VERSION A uses a GENTLER arc — Q control offsets are 80
               SVG units above the baseline. Subtle elegant bow.
          -->

          <!-- DESKTOP arched SVG (md and up) -->
          <svg
            viewBox="0 -30 1000 260"
            class="hidden md:block w-full max-w-3xl mx-auto h-auto mb-8"
            aria-label="Where will you be… when the clock strikes 250?"
            role="img"
          >
            <defs>
              <path id="hero-line1-A-desk" d="M 50 130 Q 500 50 950 130" fill="none" />
              <path id="hero-line2-A-desk" d="M 50 210 Q 500 130 950 210" fill="none" />
            </defs>
            <!-- Line 1: 'Where will you be…' — italic light, white/85, ~30px target -->
            <text fill="rgba(255,255,255,0.85)" font-size="32" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line1-A-desk" startOffset="50%" text-anchor="middle">
                Where will you be&#8230;
              </textPath>
            </text>
            <!-- Line 2: 'when the clock strikes 250?' — italic normal, white, ~48px target -->
            <text fill="#ffffff" font-size="50" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line2-A-desk" startOffset="50%" text-anchor="middle">
                when the clock strikes 250?
              </textPath>
            </text>
          </svg>

          <!-- MOBILE arched SVG (under md) -->
          <svg
            viewBox="0 -20 600 180"
            class="block md:hidden w-full max-w-md mx-auto h-auto mb-8"
            aria-hidden="true"
            role="img"
          >
            <defs>
              <path id="hero-line1-A-mob" d="M 30 95 Q 300 55 570 95" fill="none" />
              <path id="hero-line2-A-mob" d="M 30 150 Q 300 110 570 150" fill="none" />
            </defs>
            <text fill="rgba(255,255,255,0.85)" font-size="34" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line1-A-mob" startOffset="50%" text-anchor="middle">
                Where will you be&#8230;
              </textPath>
            </text>
            <text fill="#ffffff" font-size="40" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line2-A-mob" startOffset="50%" text-anchor="middle">
                when the clock strikes 250?
              </textPath>
            </text>
          </svg>

          <!-- Masthead presentational line (unchanged from live) -->
          <p class="font-heading italic font-bold text-lg sm:text-xl md:text-2xl text-gold mb-2 tracking-wide">
            The Official
          </p>

          <!-- Display headline (unchanged from live) -->
          <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] text-white leading-[1.05] mb-6 tracking-tight">
            Countdown 250 Ball
          </h1>

          <!-- Gold flourish divider (mimic live) -->
          <div class="flex items-center justify-center gap-3 mb-6">
            <span class="h-px w-12 bg-gold/70"></span>
            <span class="text-gold text-sm">&#9733;</span>
            <span class="h-px w-12 bg-gold/70"></span>
          </div>

          <p class="text-white/85 text-sm sm:text-base tracking-wide">
            July 3, 2026 &middot; Washington, D.C.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- VERSION B — more dramatic arc                                -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/event/hero-countdown250-toast.jpg"
          alt="Hero background"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
      </div>

      <div class="relative z-10 text-center px-4 sm:px-6 max-w-5xl mx-auto pt-28 pb-20">

        <p class="text-gold/85 font-bold tracking-[0.3em] uppercase text-[10px] sm:text-xs mb-6">
          Version B &middot; more dramatic arc
        </p>

        <div class="flex justify-center mb-10">
          <picture>
            <source srcset="/images/logos/countdown250-seal-navy-blue.webp" type="image/webp" />
            <img
              src="/images/logos/countdown250-seal-navy-blue.png"
              alt="The Official Countdown 250 Ball — July 3, 2026 — Washington, D.C."
              class="w-[340px] sm:w-[440px] md:w-[520px] h-auto drop-shadow-2xl"
            />
          </picture>
        </div>

        <div class="inline-block max-w-full px-6 py-7 sm:px-12 sm:py-9 rounded-3xl mb-10" style="background: radial-gradient(ellipse at center, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 70%, rgba(0,0,0,0.15) 100%);">

          <!-- ===== ARCHED HEADER — Version B =====
               Same font sizes / colors / spacing as Version A.
               ONLY change: Q control offset is now 130 (vs 80) — about
               60% deeper bow. More architectural / wedding-invitation
               feel.
          -->

          <!-- DESKTOP arched SVG (md and up) -->
          <svg
            viewBox="0 -50 1000 280"
            class="hidden md:block w-full max-w-3xl mx-auto h-auto mb-8"
            aria-label="Where will you be… when the clock strikes 250?"
            role="img"
          >
            <defs>
              <path id="hero-line1-B-desk" d="M 50 130 Q 500 0 950 130" fill="none" />
              <path id="hero-line2-B-desk" d="M 50 210 Q 500 80 950 210" fill="none" />
            </defs>
            <text fill="rgba(255,255,255,0.85)" font-size="32" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line1-B-desk" startOffset="50%" text-anchor="middle">
                Where will you be&#8230;
              </textPath>
            </text>
            <text fill="#ffffff" font-size="50" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line2-B-desk" startOffset="50%" text-anchor="middle">
                when the clock strikes 250?
              </textPath>
            </text>
          </svg>

          <!-- MOBILE arched SVG (under md) -->
          <svg
            viewBox="0 -35 600 200"
            class="block md:hidden w-full max-w-md mx-auto h-auto mb-8"
            aria-hidden="true"
            role="img"
          >
            <defs>
              <path id="hero-line1-B-mob" d="M 30 95 Q 300 25 570 95" fill="none" />
              <path id="hero-line2-B-mob" d="M 30 150 Q 300 80 570 150" fill="none" />
            </defs>
            <text fill="rgba(255,255,255,0.85)" font-size="34" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line1-B-mob" startOffset="50%" text-anchor="middle">
                Where will you be&#8230;
              </textPath>
            </text>
            <text fill="#ffffff" font-size="40" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line2-B-mob" startOffset="50%" text-anchor="middle">
                when the clock strikes 250?
              </textPath>
            </text>
          </svg>

          <p class="font-heading italic font-bold text-lg sm:text-xl md:text-2xl text-gold mb-2 tracking-wide">
            The Official
          </p>

          <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] text-white leading-[1.05] mb-6 tracking-tight">
            Countdown 250 Ball
          </h1>

          <div class="flex items-center justify-center gap-3 mb-6">
            <span class="h-px w-12 bg-gold/70"></span>
            <span class="text-gold text-sm">&#9733;</span>
            <span class="h-px w-12 bg-gold/70"></span>
          </div>

          <p class="text-white/85 text-sm sm:text-base tracking-wide">
            July 3, 2026 &middot; Washington, D.C.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- VERSION C — same arc depth as B (130) but BIGGER text       -->
    <!-- Desktop SVG font sizes bumped to match live hero exactly:    -->
    <!--   line 1 renders ~30 px (matches md:text-3xl)                -->
    <!--   line 2 renders ~48 px (matches lg:text-5xl)                -->
    <!-- Container also widened to max-w-4xl so the bigger arched     -->
    <!-- text has room to breathe inside the curve.                   -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/event/hero-countdown250-toast.jpg"
          alt="Hero background"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
      </div>

      <div class="relative z-10 text-center px-4 sm:px-6 max-w-5xl mx-auto pt-28 pb-20">

        <p class="text-gold/85 font-bold tracking-[0.3em] uppercase text-[10px] sm:text-xs mb-6">
          Version C &middot; B&rsquo;s arc + bigger text (matches live size)
        </p>

        <div class="flex justify-center mb-10">
          <picture>
            <source srcset="/images/logos/countdown250-seal-navy-blue.webp" type="image/webp" />
            <img
              src="/images/logos/countdown250-seal-navy-blue.png"
              alt="The Official Countdown 250 Ball — July 3, 2026 — Washington, D.C."
              class="w-[340px] sm:w-[440px] md:w-[520px] h-auto drop-shadow-2xl"
            />
          </picture>
        </div>

        <div class="inline-block max-w-full px-6 py-7 sm:px-12 sm:py-9 rounded-3xl mb-10" style="background: radial-gradient(ellipse at center, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 70%, rgba(0,0,0,0.15) 100%);">

          <!-- ===== ARCHED HEADER — Version C =====
               Same arc shape as B (Q control at 0 / 80, depth 130).
               BIGGER text: SVG font sizes bumped from 32→40 (line 1)
               and 50→64 (line 2) so they render at ~30 px / ~48 px
               on a typical desktop, matching the live hero sizes.
               Container widened from max-w-3xl (768px) to max-w-4xl
               (896px) so the larger text has room inside the arc.
               viewBox vertical extent also bumped to keep ascenders
               and descenders inside the canvas.
          -->

          <!-- DESKTOP arched SVG (md and up) -->
          <svg
            viewBox="0 -60 1000 300"
            class="hidden md:block w-full max-w-4xl mx-auto h-auto mb-8"
            aria-label="Where will you be… when the clock strikes 250?"
            role="img"
          >
            <defs>
              <path id="hero-line1-C-desk" d="M 50 130 Q 500 0 950 130" fill="none" />
              <path id="hero-line2-C-desk" d="M 50 220 Q 500 90 950 220" fill="none" />
            </defs>
            <!-- Line 1: 'Where will you be…' — italic light, white/85, ~30px target -->
            <text fill="rgba(255,255,255,0.85)" font-size="40" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line1-C-desk" startOffset="50%" text-anchor="middle">
                Where will you be&#8230;
              </textPath>
            </text>
            <!-- Line 2: 'when the clock strikes 250?' — italic normal, white, ~48px target -->
            <text fill="#ffffff" font-size="64" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line2-C-desk" startOffset="50%" text-anchor="middle">
                when the clock strikes 250?
              </textPath>
            </text>
          </svg>

          <!-- MOBILE arched SVG (under md) — same as Version B (already
               matches live xl/2xl mobile sizes ~20px / ~24px) -->
          <svg
            viewBox="0 -35 600 200"
            class="block md:hidden w-full max-w-md mx-auto h-auto mb-8"
            aria-hidden="true"
            role="img"
          >
            <defs>
              <path id="hero-line1-C-mob" d="M 30 95 Q 300 25 570 95" fill="none" />
              <path id="hero-line2-C-mob" d="M 30 150 Q 300 80 570 150" fill="none" />
            </defs>
            <text fill="rgba(255,255,255,0.85)" font-size="34" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line1-C-mob" startOffset="50%" text-anchor="middle">
                Where will you be&#8230;
              </textPath>
            </text>
            <text fill="#ffffff" font-size="40" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line2-C-mob" startOffset="50%" text-anchor="middle">
                when the clock strikes 250?
              </textPath>
            </text>
          </svg>

          <p class="font-heading italic font-bold text-lg sm:text-xl md:text-2xl text-gold mb-2 tracking-wide">
            The Official
          </p>

          <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] text-white leading-[1.05] mb-6 tracking-tight">
            Countdown 250 Ball
          </h1>

          <div class="flex items-center justify-center gap-3 mb-6">
            <span class="h-px w-12 bg-gold/70"></span>
            <span class="text-gold text-sm">&#9733;</span>
            <span class="h-px w-12 bg-gold/70"></span>
          </div>

          <p class="text-white/85 text-sm sm:text-base tracking-wide">
            July 3, 2026 &middot; Washington, D.C.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- VERSION D — exact live size                                  -->
    <!-- The reason C looked smaller than live: the dark backdrop is  -->
    <!-- an inline-block, which SHRINKS to its widest content. The    -->
    <!-- 'Countdown 250 Ball' h1 ended up being narrower than max-w-  -->
    <!-- 4xl, so the SVG could only fill that narrower width — and    -->
    <!-- the arched text rendered correspondingly smaller.            -->
    <!--                                                              -->
    <!-- Fix: force the SVG to take a fixed pixel width via inline    -->
    <!-- style so it ALWAYS renders at the target size, regardless    -->
    <!-- of the inline-block parent's shrink behavior. This makes the -->
    <!-- inline-block grow to accommodate the SVG, and the arched     -->
    <!-- text now renders at the same pixel size as the live hero.    -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/event/hero-countdown250-toast.jpg"
          alt="Hero background"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
      </div>

      <div class="relative z-10 text-center px-4 sm:px-6 max-w-5xl mx-auto pt-28 pb-20">

        <p class="text-gold/85 font-bold tracking-[0.3em] uppercase text-[10px] sm:text-xs mb-6">
          Version D &middot; B&rsquo;s arc + EXACT live text size (forced width)
        </p>

        <div class="flex justify-center mb-10">
          <picture>
            <source srcset="/images/logos/countdown250-seal-navy-blue.webp" type="image/webp" />
            <img
              src="/images/logos/countdown250-seal-navy-blue.png"
              alt="The Official Countdown 250 Ball — July 3, 2026 — Washington, D.C."
              class="w-[340px] sm:w-[440px] md:w-[520px] h-auto drop-shadow-2xl"
            />
          </picture>
        </div>

        <div class="inline-block max-w-full px-6 py-7 sm:px-12 sm:py-9 rounded-3xl mb-10" style="background: radial-gradient(ellipse at center, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 70%, rgba(0,0,0,0.15) 100%);">

          <!-- ===== ARCHED HEADER — Version D =====
               Same arc shape as B and C (depth 130).
               KEY DIFFERENCE: SVG width is FORCED via inline style to
               896 px (or full viewport width on smaller screens).
               This breaks the inline-block shrink-to-fit constraint
               that was making C render at only ~700-720 px wide.

               With width FORCED to 896 px, scale = 896/1000 = 0.896.
               To hit the live hero text sizes:
                 line 1 target 30 px → SVG font 34 (renders 30.5 px)
                 line 2 target 48 px → SVG font 54 (renders 48.4 px)
               Bumped slightly to 36 / 56 (renders 32 / 50 px) so the
               match looks bigger than C — easier to judge if it now
               matches live.
          -->

          <!-- DESKTOP arched SVG (md and up) — width FORCED to 896 px -->
          <svg
            viewBox="0 -50 1000 260"
            class="hidden md:block mx-auto h-auto mb-8"
            style="width: min(896px, 100%);"
            aria-label="Where will you be… when the clock strikes 250?"
            role="img"
          >
            <defs>
              <path id="hero-line1-D-desk" d="M 50 130 Q 500 0 950 130" fill="none" />
              <path id="hero-line2-D-desk" d="M 50 215 Q 500 85 950 215" fill="none" />
            </defs>
            <!-- Line 1: 'Where will you be…' — italic light, white/85, target 30 px -->
            <text fill="rgba(255,255,255,0.85)" font-size="36" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line1-D-desk" startOffset="50%" text-anchor="middle">
                Where will you be&#8230;
              </textPath>
            </text>
            <!-- Line 2: 'when the clock strikes 250?' — italic normal, white, target 48 px -->
            <text fill="#ffffff" font-size="56" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line2-D-desk" startOffset="50%" text-anchor="middle">
                when the clock strikes 250?
              </textPath>
            </text>
          </svg>

          <!-- MOBILE arched SVG (under md) — same as B and C -->
          <svg
            viewBox="0 -35 600 200"
            class="block md:hidden w-full max-w-md mx-auto h-auto mb-8"
            aria-hidden="true"
            role="img"
          >
            <defs>
              <path id="hero-line1-D-mob" d="M 30 95 Q 300 25 570 95" fill="none" />
              <path id="hero-line2-D-mob" d="M 30 150 Q 300 80 570 150" fill="none" />
            </defs>
            <text fill="rgba(255,255,255,0.85)" font-size="34" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line1-D-mob" startOffset="50%" text-anchor="middle">
                Where will you be&#8230;
              </textPath>
            </text>
            <text fill="#ffffff" font-size="40" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
              <textPath href="#hero-line2-D-mob" startOffset="50%" text-anchor="middle">
                when the clock strikes 250?
              </textPath>
            </text>
          </svg>

          <p class="font-heading italic font-bold text-lg sm:text-xl md:text-2xl text-gold mb-2 tracking-wide">
            The Official
          </p>

          <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] text-white leading-[1.05] mb-6 tracking-tight">
            Countdown 250 Ball
          </h1>

          <div class="flex items-center justify-center gap-3 mb-6">
            <span class="h-px w-12 bg-gold/70"></span>
            <span class="text-gold text-sm">&#9733;</span>
            <span class="h-px w-12 bg-gold/70"></span>
          </div>

          <p class="text-white/85 text-sm sm:text-base tracking-wide">
            July 3, 2026 &middot; Washington, D.C.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- VERSION E — no backdrop, text halo                           -->
    <!-- Mike's idea: drop the dark backdrop box (you could see its   -->
    <!-- rounded outline against the photo) and instead give every    -->
    <!-- piece of text a faint dark halo for legibility.              -->
    <!--                                                              -->
    <!-- Bonus: dropping the inline-block backdrop also fixes the     -->
    <!-- shrink-to-fit problem that was constraining the SVG. Now the -->
    <!-- arched SVG fills max-w-4xl naturally and renders at the      -->
    <!-- EXACT live hero size (line 1 ~30 px, line 2 ~48 px).         -->
    <!--                                                              -->
    <!-- Halo: triple-stacked drop-shadow on each text element. One   -->
    <!-- tight (2 px) layer for crisp edge against bright photo bits, -->
    <!-- one medium (8 px) for depth, one wide (24 px) for ambient    -->
    <!-- darkening. Crispness preserved — drop-shadow does not blur   -->
    <!-- the text itself, only adds shadow underneath.                -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/event/hero-countdown250-toast.jpg"
          alt="Hero background"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
      </div>

