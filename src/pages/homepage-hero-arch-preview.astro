                <feGaussianBlur in="expanded" stdDeviation="10" result="blurred"/>
                <feFlood flood-color="black" flood-opacity="0.95" result="darkfill"/>
                <feComposite in="darkfill" in2="blurred" operator="in" result="halo"/>
                <feMerge>
                  <feMergeNode in="halo"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
