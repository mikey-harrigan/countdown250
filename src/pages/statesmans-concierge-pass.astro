<style>
  /* Native details/summary marker removal */
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }

  /* Smooth scroll for in-page anchor jumps */
  html {
    scroll-behavior: smooth;
  }

  /* ==========================================================
     BROADWAY STAGE — full theatrical treatment.
     Components: red velvet curtains, bright moving spotlight
     cones, "hot spots" where cones land, marquee shimmer.
     ========================================================== */

  /* ==========================================================
     RED VELVET CURTAINS — convincingly draped fabric.
     Layered gradients build the velvet look:
     - Base: deep crimson with vertical depth
     - Wave layer: irregular fold highlights and shadows
     - Pleat layer: fine repeating vertical lines (the velvet "nap")
     Plus inward inner-shadow for fabric weight.
     ========================================================== */
  .curtain-velvet {
    background-blend-mode: overlay, multiply, normal;
    /* Velvet "nap" stripes (very fine, the texture of pile fabric) */
    background-image:
      repeating-linear-gradient(90deg,
        rgba(0,0,0,0.18) 0px,
        rgba(0,0,0,0.18) 1px,
        transparent 1px,
        transparent 4px,
        rgba(255,255,255,0.04) 4px,
        rgba(255,255,255,0.04) 5px,
        transparent 5px,
        transparent 9px),
      /* Major fold pattern — irregular spacing for organic look */
      linear-gradient(90deg,
        rgba(35,6,12,1) 0%,
        rgba(75,15,24,1) 4%,
        rgba(110,22,34,1) 9%,
        rgba(60,12,20,1) 15%,
        rgba(135,28,42,1) 22%,
        rgba(70,15,24,1) 30%,
        rgba(120,24,38,1) 38%,
        rgba(55,10,18,1) 46%,
        rgba(140,30,46,1) 54%,
        rgba(75,16,26,1) 62%,
        rgba(125,26,40,1) 70%,
        rgba(60,12,20,1) 78%,
        rgba(110,22,36,1) 86%,
        rgba(70,14,24,1) 92%,
        rgba(38,7,14,1) 100%),
      /* Base crimson gradient (top-to-bottom depth) */
      linear-gradient(180deg,
        #4f0c18 0%,
        #6b1422 30%,
        #5c1020 65%,
        #2e0710 100%);
  }

  .curtain-left {
    box-shadow:
      inset -25px 0 40px rgba(0,0,0,0.55),  /* inner edge fade */
      inset 0 -30px 40px rgba(0,0,0,0.4),   /* bottom weight */
      inset 0 20px 30px rgba(0,0,0,0.3);    /* top shadow */
    animation: curtain-open-left 2.4s cubic-bezier(0.25, 0.1, 0.25, 1) 0.4s forwards;
    will-change: transform;
  }
  .curtain-right {
    box-shadow:
      inset 25px 0 40px rgba(0,0,0,0.55),
      inset 0 -30px 40px rgba(0,0,0,0.4),
      inset 0 20px 30px rgba(0,0,0,0.3);
    animation: curtain-open-right 2.4s cubic-bezier(0.25, 0.1, 0.25, 1) 0.4s forwards;
    will-change: transform;
  }

  @keyframes curtain-open-left {
    0%   { transform: translateX(0);     }
    100% { transform: translateX(-72%);  }
  }
  @keyframes curtain-open-right {
    0%   { transform: translateX(0);     }
    100% { transform: translateX(72%);   }
  }

  /* (Prior CSS-built spotlight cones, screen-wash, and wood-plank
     stage-floor styles removed — the real ballroom-stage photo
     provides the actual rigging, lights, and stage. No need to
     simulate them in CSS anymore.) */

  /* SCREEN shimmer — extremely subtle warm pulse on the headline
     "screen" so it feels backlit and alive. */
  .stage-screen {
    animation: screen-pulse 6s ease-in-out infinite;
  }
  @keyframes screen-pulse {
    0%, 100% { filter: brightness(1.0); }
    50%      { filter: brightness(1.04); }
  }

  /* Ticket cards — soft white shimmer on hover */
  .ticket-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .ticket-card:hover::before {
    opacity: 1;
  }

  /* Respect prefers-reduced-motion — show curtains already-open and
     kill all animation. */
  @media (prefers-reduced-motion: reduce) {
    .stage-screen,
    .ticket-card::before {
      animation: none !important;
      transition: none !important;
    }
    .curtain-left  { transform: translateX(-72%) !important; animation: none !important; }
    .curtain-right { transform: translateX(72%)  !important; animation: none !important; }
  }
</style>
