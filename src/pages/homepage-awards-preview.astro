        <div class="grid md:grid-cols-[3fr_2fr] gap-10 lg:gap-14 items-center mb-14 sm:mb-16">

          <!-- Image: 8-slide carousel with rich premium treatment.
               Slides 4–5 are drawn from the Hosted Groups page marquee
