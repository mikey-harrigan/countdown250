---

<BaseLayout
  title="The Official Countdown 250 Ball | America 250 Gala | July 3, 2026 | Washington, D.C."
  description="The Official Countdown 250 Ball — Washington's premier America 250 stylish patriotic gala at the legendary Washington Hilton. July 3, 2026. Live entertainment, premium open bars, and a midnight countdown to America's 250th birthday."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <main>
    <!-- ============================================================ -->
    <!-- 1. HERO  — desktop/mobile SPLIT                                -->
    <!--   DESKTOP (md and up): V9 — new hero photo (Countdown Pic_8), -->
    <!--     light full-hero overlay at rgba 0,0,0,0.25, arched lines  -->
    <!--     with NO per-letter halos, masthead/h1/closing line as     -->
    <!--     plain text (no text-shadow stacks).                       -->
    <!--   MOBILE (under md): reverted to the previous setup — original-->
    <!--     toast hero photo (hero-countdown250-toast.jpg), full-hero -->
    <!--     overlay at rgba 0,0,0,0.55, arched lines WITH per-letter  -->
    <!--     halos, masthead/h1/closing line WITH text-shadow stacks.  -->
    <!--   Seal logo + #tickets CTA anchor + section structure         -->
    <!--     preserved across both.                                    -->
    <!-- ============================================================ -->
    <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">

      <!-- DESKTOP background (md and up): new pic + light 0.25 overlay -->
      <div class="absolute inset-0 hidden md:block">
        <img
          src="/images/event/hero-countdown-pic-8.jpg"
          alt="Black-tie guests at the Countdown 250 Ball — Washington Hilton, July 3, 2026"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0" style="background: rgba(0,0,0,0.25);"></div>
      </div>

      <!-- MOBILE background (under md): original toast photo + 0.55 overlay -->
      <div class="absolute inset-0 block md:hidden">
        <img
          src="/images/event/hero-countdown250-toast.jpg"
          alt="Black-tie guests toasting with champagne as Countdown 250 reaches 00:00:01 on stage"
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
      </div>

      <!-- Content -->
      <div class="relative z-10 text-center px-4 sm:px-6 max-w-5xl mx-auto pt-28 pb-20">
        <!-- Seal logo (unchanged on both: same image, animate-fade-in,
             drop-shadow-2xl, responsive widths) -->
        <div class="flex justify-center mb-10 animate-fade-in">
          <picture>
            <source srcset="/images/logos/countdown250-seal-navy-blue.webp" type="image/webp" />
            <img
              src="/images/logos/countdown250-seal-navy-blue.png"
              alt="The Official Countdown 250 Ball — July 3, 2026 — Washington, D.C."
              class="w-[340px] sm:w-[440px] md:w-[520px] h-auto drop-shadow-2xl"
            />
          </picture>
        </div>

        <div class="relative mb-10">
          <div class="relative z-10">

            <!-- DESKTOP arched SVG (md and up) — NO per-letter halo filter (V9)
                 plus a dark ellipse behind 'Where will you be…' (V11). -->
            <svg
              viewBox="0 -65 1000 295"
              class="hidden md:block mx-auto h-auto mb-8"
              style="width: min(1024px, calc(100vw - 2rem));"
              aria-label="Where will you be… when the clock strikes 250?"
              role="img"
            >
              <defs>
                <path id="hero-arch-line1-desk" d="M 50 130 Q 500 0 950 130" fill="none" />
                <path id="hero-arch-line2-desk" d="M 50 215 Q 500 85 950 215" fill="none" />
              </defs>

              <!-- Dark rounded ellipse behind line 1 only.
                   cx/cy/rx/ry from V11; fill rgba(0,0,0,0.80). -->
              <ellipse cx="500" cy="85" rx="145" ry="91" fill="rgba(0,0,0,0.80)" />

              <text fill="rgba(255,255,255,0.92)" font-size="30" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif">
                <textPath href="#hero-arch-line1-desk" startOffset="50%" text-anchor="middle">
                  Where will you be&#8230;
                </textPath>
              </text>
              <text fill="#ffffff" font-size="47" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif">
                <textPath href="#hero-arch-line2-desk" startOffset="50%" text-anchor="middle">
                  when the clock strikes 250?
                </textPath>
              </text>
            </svg>

            <!-- MOBILE arched SVG (under md) — per-letter halo filter RESTORED -->
            <svg
              viewBox="0 -40 600 200"
              class="block md:hidden w-full max-w-md mx-auto h-auto mb-8"
              aria-hidden="true"
              role="img"
            >
              <defs>
                <filter id="hero-arch-halo-mob" x="-50%" y="-50%" width="200%" height="200%">
                  <feMorphology in="SourceAlpha" operator="dilate" radius="7" result="expanded"/>
                  <feGaussianBlur in="expanded" stdDeviation="11" result="blurred"/>
                  <feFlood flood-color="black" flood-opacity="1.0" result="darkfill"/>
                  <feComposite in="darkfill" in2="blurred" operator="in" result="halo"/>
                  <feMerge>
                    <feMergeNode in="halo"/>
                    <feMergeNode in="SourceGraphic"/>
                  </feMerge>
                </filter>
                <path id="hero-arch-line1-mob" d="M 30 95 Q 300 25 570 95" fill="none" />
                <path id="hero-arch-line2-mob" d="M 30 150 Q 300 80 570 150" fill="none" />
              </defs>
              <text fill="rgba(255,255,255,0.92)" font-size="34" font-weight="300" font-style="italic" font-family="'Playfair Display', Georgia, serif" filter="url(#hero-arch-halo-mob)">
                <textPath href="#hero-arch-line1-mob" startOffset="50%" text-anchor="middle">
                  Where will you be&#8230;
                </textPath>
              </text>
              <text fill="#ffffff" font-size="40" font-weight="400" font-style="italic" font-family="'Playfair Display', Georgia, serif" filter="url(#hero-arch-halo-mob)">
                <textPath href="#hero-arch-line2-mob" startOffset="50%" text-anchor="middle">
                  when the clock strikes 250?
                </textPath>
              </text>
            </svg>

            <!-- Masthead presentational line. text-shadow applied on
                 mobile ONLY via .hero-mobile-shadow CSS rule below. -->
            <p class="hero-mobile-shadow font-heading italic font-bold text-lg sm:text-xl md:text-2xl text-gold mb-2 tracking-wide">
              The Official
            </p>

            <!-- Display headline. Visually still the big hero
                 headline, but the page <h1> is now the thin event-
                 identity bar in the Navbar (per Mike). Downgraded
                 from <h1> to <p> so the page has only ONE h1.
                 All visual classes + mobile text-shadow preserved. -->
            <p class="hero-mobile-shadow-h1 font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] text-white leading-[1.05] mb-6 tracking-tight">
              Countdown 250 Ball
            </p>

            <!-- Gold flourish divider -->
            <div class="w-20 h-px bg-gold/70 mx-auto mb-5"></div>

            <!-- Italic close. text-shadow on mobile ONLY. -->
            <p class="hero-mobile-shadow font-heading italic font-light text-lg sm:text-xl md:text-2xl text-gold/95 mb-8">
              A once-in-a-lifetime moment.
            </p>

            <!-- CTA: anchor unchanged (#tickets) -->
            <div class="flex justify-center">
              <a
                href="#tickets"
                class="bg-red hover:bg-red-light text-white px-10 py-4 text-sm font-semibold tracking-[0.2em] uppercase transition-all rounded shadow-lg hover:shadow-xl hover:-translate-y-0.5"
              >
                See Ticket Options
              </a>
            </div>

          </div>
        </div>
      </div>

      <!-- Mobile-only text-shadow stacks. Tailwind doesn't ship a
           text-shadow utility, so we declare these via CSS scoped
           to widths under md (768 px). On md and up the text-shadow
           is suppressed back to none, leaving the V9 desktop look. -->
      <style>
        @media (max-width: 767px) {
          .hero-mobile-shadow {
            text-shadow:
              0 0 4px rgba(0,0,0,1),
              0 0 10px rgba(0,0,0,0.9);
          }
          .hero-mobile-shadow-h1 {
            text-shadow:
              0 0 6px rgba(0,0,0,1),
              0 0 16px rgba(0,0,0,0.9),
              0 0 28px rgba(0,0,0,0.6);
          }
        }
      </style>
    </section>

    <!-- ============================================================ -->
    <!-- 1.5 TRUST BAND — three-line hierarchy: lead-in + hero + trust line -->
    <!-- ============================================================ -->
    <section class="relative bg-white border-y border-gold/30">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 text-center">
        <!-- Line 1: supportive lead-in (italic, lighter) -->
        <p class="text-navy/70 text-base sm:text-lg md:text-xl font-medium italic tracking-wide mb-1.5">
          America&rsquo;s Grand Kickoff to the
        </p>
        <!-- Line 2: hero positioning statement (bolder, slightly bigger) -->
        <p class="font-extrabold text-navy text-lg sm:text-xl md:text-2xl leading-tight tracking-tight mb-4">
          Biggest Celebration in American History
        </p>
        <!-- Line 3: trust / credentials line (tracked editorial uppercase) -->
        <p class="text-navy/70 text-[11px] sm:text-xs font-semibold tracking-[0.25em] uppercase">
          Washington Hilton <span class="text-gold mx-3">&#10022;</span> Supporting Operation Renewed Hope Foundation
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 1.6 COUNTDOWN TIMER — premium, static-feeling band -->
    <!-- ============================================================ -->
    <Countdown />

    <!-- ============================================================ -->
    <!-- 2. ALL-INCLUSIVE EXPERIENCE -->
    <!-- Background uses the "liquid blue" treatment (Variant D) sampled  -->
    <!-- from the seal logo: diagonal #052058 → #002B77 → #043D9C plus    -->
    <!-- a soft top-left radial sheen overlay. See                        -->
    <!-- /liquid-blue-preview/ for the side-by-side comparison.           -->
    <!-- ============================================================ -->
    <section
      id="experience"
      class="scroll-mt-24 relative pt-12 pb-8 sm:pt-16 sm:pb-10 text-white overflow-hidden"
      style="background: linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%);"
    >
      <!-- Soft radial sheen overlay — gives the section its liquid-blue feel -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%);"
      ></div>

      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Header + value-establishing copy (tightened spacing) -->
        <div class="text-center mb-10 sm:mb-12 max-w-3xl mx-auto">
          <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-3">Be A Part Of History</p>
          <h2 class="text-[2.15rem] sm:text-[2.6rem] md:text-[3.45rem] font-bold text-gold mb-4 font-heading leading-tight">
            Your All-Inclusive Experience
          </h2>
          <div class="w-20 h-px bg-gold mx-auto mb-6"></div>
          <p class="text-white/85 text-lg leading-relaxed mb-5">
            On July 3, the iconic Washington Hilton ballroom complex will transform into an extraordinary celebration of American heritage &mdash; an evening of world-class entertainment, refined elegance, and memories that will last forever.
          </p>
          <p class="text-white/85 text-lg leading-relaxed">
            Mix and mingle with decorated veterans and first responders, professional athletes and celebrities, C-suite business leaders, policymakers, media personalities, influencers, and proud Americans from across the country at this once-in-a-lifetime celebration.
          </p>
        </div>

        <!-- Image carousel (left) + ribbon feature cards (right). On mobile
             they stack with image on top so the section stays compact.
             12-slide fade carousel — auto-advance 6.5s, pauses on hover and
             when off-screen, respects prefers-reduced-motion. -->
        <div class="grid lg:grid-cols-[7fr_5fr] gap-6 lg:gap-8 items-stretch">

          <!-- Experience carousel — 12 slides of real ball moments -->
          <div class="experience-carousel relative rounded-lg overflow-hidden ring-2 ring-[#C5A44E]/40 aspect-[4/3] lg:aspect-auto lg:min-h-0" style="box-shadow: 0 25px 60px -12px rgba(0,0,0,0.65), 0 10px 25px -10px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08) inset;">
            <div class="carousel-slide active">
              <img src="/images/event/hilton-twilight.jpg" alt="Guests entering the Washington Hilton at twilight, lit in red, white, and blue" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
              <div class="carousel-caption">A grand arrival at the Washington Hilton</div>
            </div>
            <div class="carousel-slide">
              <img src="/images/event/ballroom-crowd.jpg" alt="A grand ballroom packed with celebrating guests" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
              <div class="carousel-caption">Six grand ballrooms, one unforgettable night</div>
            </div>
            <div class="carousel-slide">
              <img src="/images/event/piano-player.jpg" alt="Pianist performing on stage at the All-American Inaugural Ball" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
              <div class="carousel-caption">Intimate music, world-class talent</div>
            </div>
