<script>
  // Statesman benefits modal
  const sBTrigger = document.getElementById('statesman-benefits-trigger');
  const sBModal = document.getElementById('statesman-benefits-modal');
  const sBClose = document.getElementById('statesman-benefits-close');

  function sBOpen() {
    sBModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function sBCloseFn() {
    sBModal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  sBTrigger?.addEventListener('click', sBOpen);
  sBClose?.addEventListener('click', sBCloseFn);

  // Click backdrop to close
  sBModal?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.hasAttribute('data-modal-backdrop')) {
      sBCloseFn();
    }
  });

  // ESC key to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sBModal && !sBModal.classList.contains('hidden')) {
      sBCloseFn();
    }
  });

  // =====================================================
  // HEROES SCROLLER — fade slideshow on the All-American
  // Heroes section. Slow auto-advance, pauses on hover,
  // pauses when off-screen, respects reduced-motion.
  // =====================================================
  function initFadeCarousel(selector: string, intervalMs: number) {
    const carousel = document.querySelector(selector);
    if (!carousel) return;

    const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
    const dots = carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('.carousel-prev');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('.carousel-next');
    if (slides.length < 2) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(idx: number) {
      slides[current]?.classList.remove('active');
      dots[current]?.classList.remove('active');
      current = ((idx % slides.length) + slides.length) % slides.length;
      slides[current]?.classList.add('active');
      dots[current]?.classList.add('active');
    }
    function next() { show(current + 1); }
    function prev() { show(current - 1); }
    function start() { stop(); timer = setInterval(next, intervalMs); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { show(i); start(); });
    });
    prevBtn?.addEventListener('click', () => { prev(); start(); });
    nextBtn?.addEventListener('click', () => { next(); start(); });

    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) start();
          else stop();
        });
      }, { threshold: 0.1 });
      io.observe(carousel);
    } else {
      start();
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      stop();
    }
  }

  initFadeCarousel('.heroes-carousel', 6500);
  initFadeCarousel('.experience-carousel', 5500);
  initFadeCarousel('.hosted-groups-carousel', 6000);
</script>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }

  /* FAQ default marker removal */
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }

  /* ==========================================================
     HEROES SCROLLER — fade slideshow under the body copy in
     the All-American Heroes section. Used by .heroes-carousel.
     ========================================================== */
  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
    pointer-events: none;
  }
  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
  }
  .carousel-caption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 0.75rem 1rem;
    background: linear-gradient(to top, rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.40) 60%, transparent 100%);
    color: rgba(255,255,255,0.95);
    font-size: 0.75rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0.025em;
    text-align: center;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .carousel-caption { font-size: 0.875rem; }
  }
  .carousel-dots {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 0.5rem;
    display: flex;
    gap: 0.4rem;
    z-index: 10;
  }
  .carousel-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgba(255,255,255,0.45);
    border: 1px solid rgba(255,255,255,0.6);
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
    padding: 0;
  }
  .carousel-dot:hover { background: rgba(255,255,255,0.85); }
  .carousel-dot.active {
    background: #C5A44E;
    border-color: #C5A44E;
    transform: scale(1.25);
  }

  /* ==========================================================
     CAROUSEL PREV / NEXT ARROWS
     Sit absolutely on the left and right inside-edges of each
     carousel. Subtle dark pill with a chevron, fades in stronger
     on carousel hover so they don't dominate the photo at rest.
     ========================================================== */
  .carousel-prev,
  .carousel-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.55);
    color: #ffffff;
    border-radius: 9999px;
    cursor: pointer;
    padding: 0;
    opacity: 0.95;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    transition: opacity 0.2s ease, background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .carousel-prev { left: 0.6rem; }
  .carousel-next { right: 0.6rem; }
  .carousel-prev:hover,
  .carousel-next:hover {
    opacity: 1;
    background: rgba(0, 0, 0, 0.85);
    border-color: #C5A44E;  /* gold ring on hover for premium feel */
  }
  .carousel-prev:active,
  .carousel-next:active {
    transform: translateY(-50%) scale(0.92);
  }
  /* Bigger touch targets on small screens */
  @media (max-width: 640px) {
    .carousel-prev,
    .carousel-next {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-slide { transition: none; }
    .carousel-dot { transition: none; }
    .carousel-prev,
    .carousel-next { transition: none; }
  }

  /* ==========================================================
     AWARDS MARQUEE — auto-scrolling multi-image scroller.
     Shows 3 images on desktop, 2 on tablet/mobile. CSS-only
     animation, pauses on hover. 4:3 aspect ratio per image so
     faces aren't cropped. Track is duplicated for seamless loop.
     ========================================================== */
