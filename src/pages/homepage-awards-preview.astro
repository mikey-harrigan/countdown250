        <!-- 3-column ticket grid (md+); stacks on mobile -->
        <div class="grid md:grid-cols-3 gap-6 sm:gap-8 lg:gap-10 mb-14 items-start">
          {tickets.map((ticket) => (
            <div id={ticket.id} class={`relative rounded-2xl overflow-hidden flex flex-col h-full transition-transform ${
              ticket.highlight
                ? 'bg-white text-slate ring-4 ring-gold shadow-[0_20px_60px_-15px_rgba(197,164,78,0.55)]'
                : 'bg-white/[0.04] border-2 border-white/15 text-white shadow-xl'
            }`}>
              {/* Tier header bar */}
              <div class={`py-2.5 text-center text-[11px] sm:text-xs font-bold tracking-widest uppercase ${
                ticket.highlight ? 'bg-gold text-navy-dark' : 'bg-white/10 text-white/60'
              }`}>
                {ticket.badge}
              </div>

              <div class="p-6 sm:p-7 flex flex-col flex-grow">
                {/* Time + Name. Time is OPTIONAL — when a tier
                    omits the `time` field the small uppercase
                    eyebrow label disappears and the name sits
                    directly below the tier badge. */}
                <div class="mb-4">
                  {ticket.time && (
                    <p class={`text-[11px] font-medium tracking-wider uppercase mb-2 ${ticket.highlight ? 'text-slate/50' : 'text-white/40'}`}>
                      {ticket.time}
                    </p>
                  )}
                  <h3 class={`text-2xl font-bold mb-1 font-heading ${ticket.highlight ? 'text-navy' : 'text-white'}`}>
                    {ticket.name}
                  </h3>
                </div>

                {/* Pricing block — original (strike) + current (big) + future (small) all on one baseline */}
                <div class={`mb-4 pb-4 border-b ${ticket.highlight ? 'border-slate/10' : 'border-white/10'}`}>
                  <div class="flex items-baseline gap-3 flex-wrap">
                    <span class={`text-base line-through ${ticket.highlight ? 'text-slate/30' : 'text-white/25'}`}>
                      {ticket.originalPrice}
                    </span>
                    <span class={`text-4xl font-bold ${ticket.highlight ? 'text-navy' : 'text-white'}`}>
                      {ticket.price}
                    </span>
                    {ticket.futurePrice.split(' / ').map((fp) => (
                      <span class={`text-sm ${ticket.highlight ? 'text-slate/30' : 'text-white/25'}`}>{fp}</span>
                    ))}
                  </div>
                </div>

                {/* "Best for..." description */}
                {ticket.description && (
                  <p class={`text-sm mb-4 italic ${ticket.highlight ? 'text-slate/60' : 'text-white/55'}`}>
                    {ticket.description}
                  </p>
                )}

                {/* "Includes everything in the previous tier" callout (Patriot + Statesman) */}
                {ticket.inheritsFrom && (
                  <div class={`flex items-start gap-2.5 mb-3 px-3 py-2 rounded-md ${ticket.highlight ? 'bg-red/8 ring-1 ring-red/15' : 'bg-gold/10 ring-1 ring-gold/25'}`}>
                    <svg class={`w-5 h-5 mt-0 flex-shrink-0 ${ticket.highlight ? 'text-red' : 'text-gold'}`} fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <p class={`text-sm font-bold leading-snug ${ticket.highlight ? 'text-navy' : 'text-white'}`}>
                      Everything in the <span class={ticket.highlight ? 'text-red' : 'text-gold'}>{ticket.inheritsFrom}</span>
                    </p>
                  </div>
                )}

                {/* Umbrella heading above the categorized sections.
                    Rendered with set:html so a tier can supply
                    multi-line markup via <span class="block">. */}
                {ticket.sectionIntro && (
                  <p class={`text-sm font-extrabold tracking-wider uppercase mb-3 leading-snug ${ticket.highlight ? 'text-red' : 'text-gold'}`} set:html={ticket.sectionIntro} />
                )}

                {/* Detail sections.
                    section.heading is OPTIONAL — only rendered when
                    a tier provides one (e.g. the Statesman's tier
                    has sub-section headings like 'Private Service –
                    All Night'). Liberty and Patriot tiers use only
                    the umbrella sectionIntro above and have no
                    per-section headings. */}
                <div class="space-y-3 mb-6 flex-grow">
                  {ticket.sections.map((section, si) => (
                    <div>
                      {section.heading && (
                        <p
                          class={`text-xs font-bold tracking-wider uppercase mb-1.5 ${
                            ticket.highlight ? 'text-navy/70' : 'text-gold/90'
                          } ${si > 0 ? 'pt-2.5 border-t ' + (ticket.highlight ? 'border-slate/10' : 'border-white/10') : ''}`}
                          set:html={section.heading}
                        />
                      )}
                      <ul class="space-y-1.5">
                        {section.items.map((f) => (
                          <li class="flex items-start gap-2">
                            <svg class={`w-3.5 h-3.5 mt-0.5 flex-shrink-0 ${ticket.highlight ? 'text-gold' : 'text-gold/80'}`} fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                            </svg>
                            <span class={`text-sm leading-snug ${ticket.highlight ? 'text-slate/80' : 'text-white/70'}`} set:html={f} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>

                {/* Statesman-only: big gold CTA to Hosted Groups */}
                {ticket.highlight && (
                  <a
                    href="#hosted-tables"
                    class="block w-full text-center mb-4 px-5 py-4 rounded-lg bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
                  >
                    <p class="font-heading font-extrabold text-base sm:text-lg leading-tight tracking-tight mb-1.5">
                      <span class="block">Host your Own</span>
                      <span class="block">&ldquo;Party Inside the Party&rdquo; &rarr;</span>
                    </p>
                    <ul class="text-xs sm:text-[13px] font-semibold space-y-0.5">
                      <li>No extra cost</li>
                    </ul>
                  </a>
                )}

                {/* Footnote (e.g., "Reception-style", "Extremely limited") */}
                {ticket.note && (
                  <p class={`text-xs mb-4 italic ${ticket.highlight ? 'text-slate/55' : 'text-white/40'}`}>
                    {ticket.note}
                  </p>
                )}

                {/* Availability tag — sits directly above the Get
                    Tickets CTA. Each tier supplies its own copy via
                    the data field (e.g. 'Limited availability' on
                    Liberty, 'Very limited availability' on the others). */}
                {ticket.availability && (
                  <p class={`text-xs mb-2 italic text-center ${ticket.highlight ? 'text-slate/55' : 'text-white/45'}`}>
                    {ticket.availability}
                  </p>
                )}

                {/* CTA */}
                <a
                  href={ticketUrl}
                  class={`eventbrite-checkout block w-full text-center py-3.5 px-6 rounded-lg font-semibold text-sm tracking-[0.18em] uppercase transition-all hover:-translate-y-0.5 ${
                    ticket.highlight
                      ? 'bg-[#1a56db] text-white hover:bg-[#1a56db]/90 shadow-lg'
                      : 'bg-white/10 text-white hover:bg-white/20 border border-white/20'
                  }`}
                >
                  Get Tickets
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
