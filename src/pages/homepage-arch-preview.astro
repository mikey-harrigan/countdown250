---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Arched Header — Preview | Countdown 250 Ball"
  description="PREVIEW — testing arched headline typography for the Hosted Groups section. NOT LIVE."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- Internal preview banner — never confuse this with the live home page -->
  <div class="bg-gold/15 border-b border-gold/40 text-navy py-2.5 text-center text-xs">
    <p class="font-semibold tracking-wide">
      PREVIEW &middot; arched header experiment for Hosted Groups section. Live page is at
      <a href="/" class="underline hover:text-red ml-1">/</a>
    </p>
  </div>

  <main>

    <!-- Spacer so we're not flush with the navbar -->
    <div class="bg-white pt-20"></div>

    <!-- ============================================================ -->
    <!-- The actual section being previewed — navy bg matches the live -->
    <!-- 'Maximize Your Statesman's Pass' section on the home page.    -->
    <!-- Only the HEADER (the two arched lines) is the experiment;     -->
    <!-- the No Extra Costs sub-line is included for context.          -->
    <!-- ============================================================ -->
    <section class="bg-gradient-to-b from-navy-dark via-navy to-navy-dark text-white py-16 sm:py-20 relative overflow-hidden">
      <!-- Top + bottom gold accent lines, same as live section -->
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <div class="text-center mb-10 sm:mb-12">

          <!-- ===== ARCHED HEADER =====
               Two SVG lines, both following matching arc curves so they read
               as a parallel-arch architectural shape.

               viewBox is generously wide (1400) so the text-on-path NEVER
               gets clipped at the start or end of the arc, even with the
               longer eyebrow line ('Maximize Your Statesman's Pass Experience'
               — 41 characters).

               Each line gets its own SVG so:
                 - Line 1 (eyebrow) can use small sans-serif with letter-spacing
                 - Line 2 (headline) can use large italic serif (Playfair-style)
                 - Vertical spacing between them is controlled by margins
                 - Both arcs use the same Q control offset so they curve identically
          -->

          <!-- Both SVGs use the SAME viewBox width (1400) and container width
               (max-w-6xl) so they scale identically. Both arc paths use the
               SAME bow depth (110 units) for matching curvature. Font-size
               ratio is tuned to match the live site (eyebrow ~26% of
               headline, vs the live site's ~23%). -->

          <!-- Arched eyebrow — small white uppercase, proportionally tiny -->
          <svg
            viewBox="0 0 1400 140"
            class="block w-full max-w-6xl mx-auto h-auto -mb-2"
            aria-label="Maximize Your Statesman's Pass Experience"
            role="img"
          >
            <defs>
              <!-- Bow depth = 110 (steeper than first preview's 80) -->
              <path id="arch-pre-eyebrow" d="M 70 130 Q 700 20 1330 130" fill="none" />
            </defs>
            <text
              fill="#ffffff"
              font-size="19"
              font-weight="700"
              letter-spacing="8"
              font-family="ui-sans-serif, system-ui, sans-serif"
              style="text-transform: uppercase;"
            >
              <textPath href="#arch-pre-eyebrow" startOffset="50%" text-anchor="middle">
                Maximize Your Statesman&#8217;s Pass Experience
              </textPath>
            </text>
          </svg>

          <!-- Arched headline — large gold italic serif -->
          <svg
            viewBox="0 0 1400 220"
            class="block w-full max-w-6xl mx-auto h-auto"
            aria-label="Host a Party Inside the Party"
            role="img"
          >
            <defs>
              <!-- Same bow depth (110) as eyebrow — true parallel arches -->
              <path id="arch-pre-headline" d="M 70 200 Q 700 90 1330 200" fill="none" />
            </defs>
            <text
              fill="#fdd835"
              font-size="73"
              font-weight="700"
              font-style="italic"
              font-family="'Playfair Display', Georgia, serif"
            >
              <textPath href="#arch-pre-headline" startOffset="50%" text-anchor="middle">
                Host a &#8220;Party Inside the Party&#8221;
              </textPath>
            </text>
          </svg>

          <!-- Sub-line under the arches (kept from the live section for context) -->
          <p class="text-white font-semibold text-base sm:text-lg md:text-xl mt-3 mb-5 leading-tight">
            <span class="block">No Extra Costs</span>
            <span class="block">Easy to set up (takes 2 minutes)</span>
          </p>
        </div>

        <!-- Notes for review -->
        <div class="max-w-3xl mx-auto bg-white/5 border border-gold/30 rounded-lg p-6 mt-12 text-left">
          <p class="text-gold font-semibold tracking-[0.2em] uppercase text-xs mb-3">Preview notes</p>
          <ul class="space-y-2 text-white/85 text-sm leading-relaxed list-disc pl-5">
            <li><strong class="text-white">Updated 2026-05-02 round 2:</strong></li>
            <li>Both lines now use the SAME container width (max-w-6xl, ~1152px on desktop) so they stretch the same horizontal distance.</li>
            <li>Both arc paths use the SAME bow depth (110 SVG units) for true parallel arches — and steeper than the first preview's 80.</li>
            <li>Font-size ratio tuned to match the live site (eyebrow ~26% the size of the headline, vs the live site's ~23%): eyebrow 19 SVG units, headline 73 SVG units.</li>
            <li>Eyebrow letter-spacing bumped to 8 so the small text spreads farther across the arc.</li>
            <li>SVG viewBox stays 1400 wide — well clear of any letter-cutoff risk for the 41-character eyebrow.</li>
            <li>Sub-line ('No Extra Costs / Easy to set up') retained for context.</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- Spacer so the section doesn't slam into the footer -->
    <div class="bg-white py-12"></div>

  </main>
  <Footer />
</BaseLayout>
