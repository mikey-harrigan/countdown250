---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Arched Header — Preview | Countdown 250 Ball"
  description="PREVIEW — testing arched headline typography for the Hosted Groups section. NOT LIVE."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- Internal preview banner — never confuse this with the live home page -->
  <div class="bg-gold/15 border-b border-gold/40 text-navy py-2.5 text-center text-xs">
    <p class="font-semibold tracking-wide">
      PREVIEW &middot; arched header experiment for Hosted Groups section. Live page is at
      <a href="/" class="underline hover:text-red ml-1">/</a>
    </p>
  </div>

  <main>

    <!-- Spacer so we're not flush with the navbar -->
    <div class="bg-white pt-20"></div>

    <!-- ============================================================ -->
    <!-- The actual section being previewed — navy bg matches the live -->
    <!-- 'Maximize Your Statesman's Pass' section on the home page.    -->
    <!-- Only the HEADER (the two arched lines) is the experiment;     -->
    <!-- the No Extra Costs sub-line is included for context.          -->
    <!-- ============================================================ -->
    <section class="bg-gradient-to-b from-navy-dark via-navy to-navy-dark text-white py-16 sm:py-20 relative overflow-hidden">
      <!-- Top + bottom gold accent lines, same as live section -->
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <div class="text-center mb-10 sm:mb-12">

          <!-- ===== ARCHED HEADER =====
               Two SVG lines, both following matching arc curves so they read
               as a parallel-arch architectural shape.

               viewBox is generously wide (1400) so the text-on-path NEVER
               gets clipped at the start or end of the arc, even with the
               longer eyebrow line ('Maximize Your Statesman's Pass Experience'
               — 41 characters).

               Each line gets its own SVG so:
                 - Line 1 (eyebrow) can use small sans-serif with letter-spacing
                 - Line 2 (headline) can use large italic serif (Playfair-style)
                 - Vertical spacing between them is controlled by margins
                 - Both arcs use the same Q control offset so they curve identically
          -->

          <!-- Both SVGs use the SAME viewBox width (1400) and container width
               (max-w-6xl) so they scale identically and use parallel arcs.
               Font sizes are tuned in SVG units so the rendered px sizes at
               desktop EXACTLY MATCH the live site (text-sm eyebrow at 14 px,
               text-6xl headline base at 60 px, 'Host a' span at 51.2 px =
               85% of base, italic 'Party Inside the Party' inside straight
               curly quotes). On smaller viewports the SVG scales down
               proportionally — eyebrow text simply spans less of the arc. -->

          <!-- BOTH lines in a SINGLE SVG so the vertical shift between them is
               precisely controlled (and uniform — same gap at edges and at the
               peak). Two arc paths, both bow depth 110 (true parallel arches),
               with the headline shifted DOWN by 83 SVG units relative to the
               eyebrow. That shift = 16 px target gap (matches live mb-4) +
               eyebrow descender + headline cap height. Result: ~16 px clear
               distance between eyebrow text bottom and headline text top
               throughout, NOT just at the center. -->
          <svg
            viewBox="0 0 1400 240"
            class="block w-full max-w-6xl mx-auto h-auto"
            aria-label="Maximize Your Statesman's Pass Experience — Host a Party Inside the Party"
            role="img"
          >
            <defs>
              <!-- Eyebrow arc: baseline Y=130, peak Y=20, depth 110 -->
              <path id="arch-pre-eyebrow" d="M 70 130 Q 700 20 1330 130" fill="none" />
              <!-- Headline arc: same shape, shifted down 83 units (baseline Y=213, peak Y=103) -->
              <path id="arch-pre-headline" d="M 70 213 Q 700 103 1330 213" fill="none" />
            </defs>

            <!-- Eyebrow text -->
            <text
              fill="#ffffff"
              font-size="17"
              font-weight="700"
              letter-spacing="4.25"
              font-family="ui-sans-serif, system-ui, sans-serif"
              style="text-transform: uppercase;"
            >
              <textPath href="#arch-pre-eyebrow" startOffset="50%" text-anchor="middle">
                Maximize Your Statesman&#8217;s Pass Experience
              </textPath>
            </text>

            <!-- Headline text — mixed sizing via tspans for exact match to live H2 -->
            <text
              fill="#fdd835"
              font-size="73"
              font-weight="700"
              font-family="'Playfair Display', Georgia, serif"
            >
              <textPath href="#arch-pre-headline" startOffset="50%" text-anchor="middle">
                <tspan font-size="62">Host a </tspan>&#8220;<tspan font-style="italic">Party Inside the Party</tspan>&#8221;
              </textPath>
            </text>
          </svg>

          <!-- Sub-line under the arches (kept from the live section for context) -->
          <p class="text-white font-semibold text-base sm:text-lg md:text-xl mt-3 mb-5 leading-tight">
            <span class="block">No Extra Costs</span>
            <span class="block">Easy to set up (takes 2 minutes)</span>
          </p>
        </div>

        <!-- Notes for review -->
        <div class="max-w-3xl mx-auto bg-white/5 border border-gold/30 rounded-lg p-6 mt-12 text-left">
          <p class="text-gold font-semibold tracking-[0.2em] uppercase text-xs mb-3">Preview notes</p>
          <ul class="space-y-2 text-white/85 text-sm leading-relaxed list-disc pl-5">
            <li><strong class="text-white">Updated 2026-05-02 round 3 — exact font/size match to live site:</strong></li>
            <li><strong class="text-white">Eyebrow:</strong> font-size 17 SVG units → renders ~14 px at desktop (matches live <code>text-sm</code>). letter-spacing 4.25 (matches live tracking-[0.25em]). Shorter text, doesn&rsquo;t fill the whole arc.</li>
            <li><strong class="text-white">Headline:</strong> font-size 73 SVG units base → renders ~60 px at desktop (matches live <code>text-6xl</code>). 'Host a' tspan at 62 (85% = matches live's smaller <code>text-[3.2rem]</code>). 'Party Inside the Party' inside non-italic curly quotes — italic only on the words inside, just like live.</li>
            <li>Both lines use SAME container (max-w-6xl) and SAME arc curvature (bow depth 110) — true parallel arches.</li>
            <li>Eyebrow only fills the middle ~45% of its arc (correct — it&rsquo;s short text); headline fills ~90% of its arc (correct — it&rsquo;s longer).</li>
            <li>SVG scales proportionally on mobile — text becomes smaller across the board, NOT bigger like the live site's responsive HTML typography. Trade-off of using SVG for the arched effect.</li>
            <li>No letters cut off at any breakpoint — texts fit comfortably in the 1400-wide viewBox.</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- Spacer so the section doesn't slam into the footer -->
    <div class="bg-white py-12"></div>

  </main>
  <Footer />
</BaseLayout>
