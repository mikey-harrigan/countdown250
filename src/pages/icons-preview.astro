---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * ALL-AMERICAN ICON AWARDS — PREVIEW (2026-05-28)
 * ----------------------------------------------------------------
 * STANDALONE PREVIEW — direct-URL only at /icons-preview/.
 * Excluded from the sitemap (filter token: icons-preview),
 * NOT linked from the main navigation. Built to be reviewed and
 * promoted to /icons/ (replacing the current live page) when
 * approved.
 *
 * Differences vs the current live /icons/ page:
 *   1. Polished intro definition (the broader "athlete, artist,
 *      entertainer, scientist..." framing used on the voting page).
 *   2. NEW prominent "Help Select America's Icons" public-voting
 *      CTA, between intro and honorees, linking to the voting page
 *      (/icons-vote-preview/ — swap to the live Google Form / final
 *      voting destination when ready).
 *   3. Honorees, "What Makes an All-American Icon" criteria, and
 *      the existing "Submit a Nomination" form are all preserved.
 */

const iconHonorees = [
  {
    name: "Bob Anderson",
    img: "/images/event/bob-anderson.jpg",
    role: "World’s Greatest Singing Impressionist",
    bio: "Hailed by <em>People</em> magazine as &ldquo;America&rsquo;s Greatest Singing Impressionist,&rdquo; Bob Anderson has spent five decades as one of the most celebrated entertainers on the Las Vegas Strip.",
    bioExpanded: "<p>A Vietnam veteran from a musical family, Anderson arrived in Las Vegas in his early twenties and was on stage at the famed Sahara within hours. His extraordinary gift for recreating the voices of the world&rsquo;s greatest singers &mdash; most famously Frank Sinatra &mdash; has earned standing ovations at Carnegie Hall and performances for two U.S. Presidents and the Royal Family.</p><p>He is an inductee of both the Casino Legends Hall of Fame and the Las Vegas Entertainers Hall of Fame, was praised by Simon Cowell as the best on the planet, and was summed up by Frank Sinatra himself: &ldquo;Bob Anderson has a hell of an act.&rdquo;</p>",
  },
  {
    name: "Tony Orlando",
    img: "/images/event/tony-orlando.jpg",
    imgFit: "object-contain",
    role: "Legendary Entertainer",
    bio: "Tony Orlando is one of America&rsquo;s most beloved entertainers &mdash; a Grammy-nominated, Hollywood Walk of Fame icon celebrating more than six decades in show business, with five #1 hits and millions of records sold.",
    bioExpanded: "<p>He has sold millions of records, including five #1 hits &mdash; &ldquo;Tie a Yellow Ribbon &rsquo;Round the Ole Oak Tree,&rdquo; &ldquo;Knock Three Times,&rdquo; &ldquo;Candida,&rdquo; &ldquo;My Sweet Gypsy Rose,&rdquo; and &ldquo;He Don&rsquo;t Love You (Like I Love You)&rdquo; &mdash; plus two platinum and three gold albums and 15 Top 40 hits. &ldquo;Tie a Yellow Ribbon&rdquo; was Billboard&rsquo;s #1 Song of the Year in 1973 and grew into an American anthem of hope, homecoming, and renewal.</p><p>The enormously popular <em>Tony Orlando and Dawn</em> variety show ran for four seasons on CBS (1973&ndash;1977) &mdash; the first television show to feature a multi-racial singing group, with Tony the first and only Latin American to host a network variety series. Tony Orlando and Dawn rank among Billboard&rsquo;s Top 100 artists of all time.</p><p>Few entertainers have excelled in so many realms: recording artist, songwriter, concert headliner, network television star, motion-picture actor, Broadway performer, and author. As VP of CBS&rsquo;s April-Blackwood Music (1966&ndash;1970) he signed and produced Barry Manilow&rsquo;s first recordings and represented songwriters including James Taylor, Laura Nyro, and Blood, Sweat &amp; Tears alongside the legendary Clive Davis. He first reached the charts in 1961 as the first pop vocalist signed to Epic Records, with &ldquo;Halfway to Paradise.&rdquo;</p><p>His honors include a star on the Hollywood Walk of Fame, the American Eagle Lifetime Achievement Award, the Ellis Island Medal of Honor, the Lee Greenwood Patriot Award, induction into the New Jersey Hall of Fame (2023) and the East Coast Music Hall of Fame (2022), two American Music Awards, and the People&rsquo;s Choice Award for Best Male Entertainer.</p><p>A devoted champion of America&rsquo;s veterans, Tony has performed for troops around the world and for several U.S. Presidents, from Carnegie Hall to the White House, and received the Bob Hope Award for excellence in entertainment from the Congressional Medal of Honor Society. In 2023 he marked the 50th anniversary of &ldquo;Tie a Yellow Ribbon&rdquo; and the return of America&rsquo;s Vietnam POWs &mdash; whom he first honored at Bob Hope&rsquo;s invitation at the 1973 Cotton Bowl &mdash; and for two decades welcomed some 175,000 veterans each year to his Yellow Ribbon Music Theatre in Branson, Missouri.</p><p>For 33 years he co-hosted the Muscular Dystrophy Telethon alongside Jerry Lewis, and today hosts &ldquo;Saturday Nights with Tony Orlando&rdquo; on 77WABC Music Radio, streaming worldwide. Tony and his wife, Francine, are the parents of Jenny and Jon.</p>",
  },
];

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
const voteUrl = "/icons-vote-preview/"; // swap to live voting page / Google Form once ready
const nominationFormUrl = "https://forms.gle/SXdwyqMqNnu1Y4Kj6"; // existing committee nomination form (live)
---

<BaseLayout
  title="All-American Icons (Preview) | Honor America's Greatest Achievers | Countdown 250 Ball, July 3, 2026"
  description="The All-American Icon Award honors individuals whose achievements, leadership, service, creativity, and influence have helped shape the American story. Review the nominees, cast your vote, and submit your own nomination."
  ogImage="/images/event/header-icons-flag-medal.jpg"
>
  <Navbar />
  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >
    <!-- ============================================================ -->
    <!-- HERO — canonical sub-page pattern.                             -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-icons-flag-medal.jpg"
          alt="The All-American Icon Award medal — gold circle with an eagle and torch, encircled by the words 'ALL-AMERICAN ICON' and 'EXCELLENCE · INFLUENCE · INSPIRATION' — resting on the rippling stars and stripes of the American flag"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              All-American Icons
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- About the Award -->
    <section class="py-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-8">
          Honoring the American Dream
        </p>

        <div class="text-center mb-12">
          <picture>
            <source srcset="/images/misc/all-amer-icon-medal.webp" type="image/webp" />
            <img
              src="/images/misc/all-amer-icon-medal.png"
              alt="All-American Icon Award medal"
              class="w-32 sm:w-40 md:w-48 h-auto mx-auto mb-6"
              style="filter: drop-shadow(0 14px 28px rgba(0,0,0,0.18)) drop-shadow(0 4px 10px rgba(197,164,78,0.32));"
              loading="eager"
            />
          </picture>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold font-heading leading-tight mb-2">All-American Icon</h2>
          <p class="text-2xl sm:text-3xl md:text-4xl font-bold text-gold font-heading leading-tight mb-5">Award</p>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-white/80 text-lg leading-relaxed space-y-6">
          <p>
            An <strong class="text-gold">All-American Icon</strong> is someone whose life, work,
            accomplishments, or leadership has helped shape their field, define their generation,
            or leave a lasting mark on the American story.
          </p>
          <p>
            They may be an athlete, artist, entertainer, scientist, entrepreneur, public servant,
            humanitarian, military leader, or cultural figure. Some are household names; others
            may be less widely known. But each has made a meaningful contribution to the larger
            American tapestry.
          </p>
          <p class="text-white font-semibold">
            They are not just successful &mdash; they are significant. They inspire admiration,
            represent excellence, and reflect something special and enduring about the American
            spirit.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- PUBLIC VOTING CTA — "Help Select America's Icons"              -->
    <!-- Prominent navy/gold banner inviting public voting. Links to    -->
    <!-- the voting page (/icons-vote-preview/) — swap destination when -->
    <!-- the live voting URL / Google Form is finalized.                -->
    <!-- ============================================================ -->
    <section class="py-12 sm:py-14">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark rounded-2xl border-2 border-gold/55 p-7 sm:p-10 md:p-12 text-center shadow-[0_20px_44px_-16px_rgba(0,0,0,0.55)]">
          <p class="text-gold font-bold tracking-[0.28em] uppercase text-xs sm:text-sm mb-4">Public Voting Now Open</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white font-heading leading-tight mb-5">
            Help Select America&rsquo;s Icons
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-7"></div>
          <div class="text-white/85 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto space-y-4 mb-8">
            <p>
              Be part of history by helping us recognize the individuals whose achievements,
              service, creativity, leadership, and character have left a lasting mark on the
              American story.
            </p>
            <p>
              Cast your vote, submit a nomination, and share the campaign with others who should
              have a voice in selecting the All-American Icons.
            </p>
          </div>
          <a
            href={voteUrl}
            class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
          >
            Vote Now &amp; Share
          </a>
          <p class="text-white/55 text-xs sm:text-sm mt-4 italic">Browse nominees by category and cast your vote.</p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- HONOREES — feature cards (Bob Anderson, Tony Orlando).         -->
    <!-- ============================================================ -->
    <section class="py-12 sm:py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-10">
          <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-3">Honorees</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-gold font-heading leading-tight">Celebrating American Icons</h2>
          <div class="w-16 h-1 bg-gold mx-auto mt-5"></div>
        </div>

        <div class="space-y-8">
          {iconHonorees.map((h) => (
            <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark border border-gold/40 rounded-2xl overflow-hidden shadow-[0_18px_40px_-16px_rgba(0,0,0,0.6)] flex flex-col sm:flex-row">
              <div class="sm:w-2/5 sm:flex-shrink-0 bg-navy/50">
                <div class="aspect-[4/3] sm:aspect-auto sm:h-full overflow-hidden">
                  <img
                    src={h.img}
                    alt={h.name}
                    class={`w-full h-full ${h.imgFit ?? "object-cover"}`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <div class="flex-1 p-6 sm:p-8 md:p-10">
                <h3 class="text-2xl sm:text-3xl font-bold text-gold font-heading leading-tight mb-1">{h.name}</h3>
                <p class="text-white/55 text-xs sm:text-sm uppercase tracking-[0.18em] font-semibold mb-5">{h.role}</p>
                <details class="text-white/75 text-sm sm:text-base leading-relaxed group">
                  <summary class="list-none cursor-pointer marker:hidden">
                    <span class="block" set:html={h.bio} />
                    <span class="mt-3 inline-block text-gold hover:text-gold-light font-bold uppercase tracking-wider text-xs group-open:hidden">Read more &rarr;</span>
                  </summary>
                  <div class="mt-4 space-y-4" set:html={h.bioExpanded} />
                  <span class="mt-3 hidden group-open:inline-block text-gold hover:text-gold-light font-bold uppercase tracking-wider text-xs cursor-pointer" onclick="this.closest('details').open = false">&larr; Show less</span>
                </details>
              </div>
            </div>
          ))}
        </div>

        <p class="text-center text-gold font-bold tracking-[0.25em] uppercase text-sm sm:text-base mt-10 sm:mt-12">
          More Major Announcements Coming Soon
        </p>
      </div>
    </section>

    <!-- What Makes an All-American Icon -->
    <section class="py-12 sm:py-14">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-6">
          <h2 class="text-3xl sm:text-4xl font-bold text-gold mb-3 font-heading">What Makes an All-American Icon?</h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <p class="text-center text-white/70 text-base sm:text-lg leading-snug mb-6">Recipients are chosen based on the following criteria:</p>

        <div class="space-y-3 sm:space-y-4">
          <div class="flex items-start gap-3 sm:gap-4">
            <svg class="w-7 h-7 flex-shrink-0 mt-0.5 drop-shadow" viewBox="0 0 24 24" aria-hidden="true">
              <defs>
                <linearGradient id="iconBlue1" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#6ea0e8"/>
                  <stop offset="50%" style="stop-color:#1a4ba8"/>
                  <stop offset="100%" style="stop-color:#001a45"/>
                </linearGradient>
              </defs>
              <path fill="url(#iconBlue1)" stroke="#C5A44E" stroke-width="0.6" d="M12 2 L14.39 8.45 L21.11 8.45 L15.86 12.55 L18.25 19 L12 14.91 L5.75 19 L8.14 12.55 L2.89 8.45 L9.61 8.45 Z"/>
            </svg>
            <p class="text-white/80 text-sm sm:text-base leading-snug">
              <strong class="text-gold font-bold">Pursuit of the American Dream</strong> &mdash; Built their success from determination, drive, and the willingness to bet on themselves.
            </p>
          </div>
          <div class="flex items-start gap-3 sm:gap-4">
            <svg class="w-7 h-7 flex-shrink-0 mt-0.5 drop-shadow" viewBox="0 0 24 24" aria-hidden="true">
              <defs>
                <linearGradient id="iconBlue2" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#6ea0e8"/>
                  <stop offset="50%" style="stop-color:#1a4ba8"/>
                  <stop offset="100%" style="stop-color:#001a45"/>
                </linearGradient>
              </defs>
              <path fill="url(#iconBlue2)" stroke="#C5A44E" stroke-width="0.6" d="M12 2 L14.39 8.45 L21.11 8.45 L15.86 12.55 L18.25 19 L12 14.91 L5.75 19 L8.14 12.55 L2.89 8.45 L9.61 8.45 Z"/>
            </svg>
            <p class="text-white/80 text-sm sm:text-base leading-snug">
              <strong class="text-gold font-bold">Mastery of Field</strong> &mdash; Reached the highest levels of their profession.
            </p>
          </div>
          <div class="flex items-start gap-3 sm:gap-4">
            <svg class="w-7 h-7 flex-shrink-0 mt-0.5 drop-shadow" viewBox="0 0 24 24" aria-hidden="true">
              <defs>
                <linearGradient id="iconBlue3" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#6ea0e8"/>
                  <stop offset="50%" style="stop-color:#1a4ba8"/>
                  <stop offset="100%" style="stop-color:#001a45"/>
                </linearGradient>
              </defs>
              <path fill="url(#iconBlue3)" stroke="#C5A44E" stroke-width="0.6" d="M12 2 L14.39 8.45 L21.11 8.45 L15.86 12.55 L18.25 19 L12 14.91 L5.75 19 L8.14 12.55 L2.89 8.45 L9.61 8.45 Z"/>
            </svg>
            <p class="text-white/80 text-sm sm:text-base leading-snug">
              <strong class="text-gold font-bold">Impact</strong> &mdash; Helped define their generation and/or field of pursuit. Their work changed what was possible.
            </p>
          </div>
          <div class="flex items-start gap-3 sm:gap-4">
            <svg class="w-7 h-7 flex-shrink-0 mt-0.5 drop-shadow" viewBox="0 0 24 24" aria-hidden="true">
              <defs>
                <linearGradient id="iconBlue4" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#6ea0e8"/>
                  <stop offset="50%" style="stop-color:#1a4ba8"/>
                  <stop offset="100%" style="stop-color:#001a45"/>
                </linearGradient>
              </defs>
              <path fill="url(#iconBlue4)" stroke="#C5A44E" stroke-width="0.6" d="M12 2 L14.39 8.45 L21.11 8.45 L15.86 12.55 L18.25 19 L12 14.91 L5.75 19 L8.14 12.55 L2.89 8.45 L9.61 8.45 Z"/>
            </svg>
            <p class="text-white/80 text-sm sm:text-base leading-snug">
              <strong class="text-gold font-bold">Part of American Life</strong> &mdash; Their name, their work, their story has become woven into the national identity itself.
            </p>
          </div>
          <div class="flex items-start gap-3 sm:gap-4">
            <svg class="w-7 h-7 flex-shrink-0 mt-0.5 drop-shadow" viewBox="0 0 24 24" aria-hidden="true">
              <defs>
                <linearGradient id="iconBlue5" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#6ea0e8"/>
                  <stop offset="50%" style="stop-color:#1a4ba8"/>
                  <stop offset="100%" style="stop-color:#001a45"/>
                </linearGradient>
              </defs>
              <path fill="url(#iconBlue5)" stroke="#C5A44E" stroke-width="0.6" d="M12 2 L14.39 8.45 L21.11 8.45 L15.86 12.55 L18.25 19 L12 14.91 L5.75 19 L8.14 12.55 L2.89 8.45 L9.61 8.45 Z"/>
            </svg>
            <p class="text-white/80 text-sm sm:text-base leading-snug">
              <strong class="text-gold font-bold">Inspiring Greatness</strong> &mdash; Inspire the next generation of Americans to dream bigger, work harder, and pursue their version of the American dream.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Nominations — existing committee nomination form -->
    <section class="py-14 sm:py-16 bg-navy text-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-gold font-medium tracking-[0.2em] uppercase text-sm mb-3">Nominations Now Open</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-5 font-heading">Nominate an All-American Icon</h2>
        <div class="w-16 h-1 bg-gold mx-auto mb-6"></div>

        <div class="text-white/75 text-base sm:text-lg leading-relaxed space-y-4 text-left max-w-4xl mx-auto mb-7">
          <p>
            We are now accepting nominations for the inaugural 2026 All-American Icon Awards. Do you know someone whose pursuit of the American Dream has lifted them to the highest levels of their field?
          </p>
          <p>
            We invite you to submit their name for consideration. Nominees can come from any field &mdash; what matters is the height to which they rose, the impact they made, and the way their story exemplifies the American dream.
          </p>
        </div>

        <div class="max-w-4xl mx-auto mb-8 text-left">
          <p class="text-white/70 text-base mb-3 text-center sm:text-left">
            <strong class="text-white/85">To submit a nomination, please include:</strong>
          </p>
          <ul class="text-white/70 text-sm sm:text-base grid sm:grid-cols-2 gap-x-6 gap-y-2 list-none">
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5 flex-shrink-0">★</span>
              <span>Nominee&rsquo;s full name and location</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5 flex-shrink-0">★</span>
              <span>Their field of achievement</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5 flex-shrink-0">★</span>
              <span>A brief description of their body of work and accomplishments (250 words or less)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5 flex-shrink-0">★</span>
              <span>Why you believe they exemplify the spirit of an All-American Icon</span>
            </li>
            <li class="flex items-start gap-3 sm:col-span-2">
              <span class="text-gold mt-0.5 flex-shrink-0">★</span>
              <span>Your name and contact information</span>
            </li>
          </ul>
        </div>

        <a
          href={nominationFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
        >
          Submit a Nomination
        </a>
        <p class="text-white/40 text-sm mt-4">Nominations will be reviewed by our Awards Committee. All submissions are confidential.</p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- EVENT CTA — Countdown 250 Ball / Purchase Tickets              -->
    <!-- ============================================================ -->
    <section class="py-14 sm:py-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
          See the Awards Presented Live
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
          Join Us July 3, 2026
        </h2>
        <div class="w-16 h-1 bg-gold mx-auto mb-7"></div>
        <p class="text-white/80 text-base sm:text-lg leading-relaxed mb-7">
          The All-American Icon Awards will be presented during the historic Countdown 250 Ball at
          the Washington Hilton in Washington, D.C., as America begins its 250th anniversary
          celebration.
        </p>
        <a
          href={ticketUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
        >
          Purchase Tickets
        </a>
      </div>
    </section>

  </main>
  <div class="h-1.5 w-full bg-gradient-to-r from-gold/70 via-gold to-gold/70"></div>
  <Footer />
</BaseLayout>
