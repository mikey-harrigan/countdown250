                                )}
                                <p class="text-white/65 text-sm leading-relaxed mb-5 flex-1">
                                  {n.desc}
                                </p>
                                <a
                                  href={voteFormUrl}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="mt-auto inline-block bg-gold/15 border border-gold/60 hover:bg-gold hover:text-navy-dark text-gold px-6 py-2 text-xs font-bold uppercase tracking-wider rounded transition-colors"
                                  aria-label={`Vote for ${n.name}`}
                                >
                                  Vote
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

