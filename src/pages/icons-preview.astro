                            <span class="text-gold/80 text-[11px] sm:text-xs uppercase tracking-[0.2em] font-bold">
                              {sub.nominees.length} Nominee{sub.nominees.length === 1 ? "" : "s"}
                            </span>
                          </div>
                          <h4 class="font-heading font-bold text-gold text-2xl sm:text-[28px] leading-tight mb-3">
                            {sub.name}
                          </h4>
                          <div class="w-12 h-0.5 bg-gold/60 mb-4"></div>
                          <p class="text-white/75 text-sm sm:text-base leading-relaxed mb-6 flex-1">
                            {sub.desc}
                          </p>
                          <button
                            type="button"
                            data-view-nominees={`${main.anchor}-${sub.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
                            class="self-start inline-flex items-center gap-2 bg-gold/15 border border-gold/60 hover:bg-gold hover:text-navy-dark text-gold px-6 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider rounded transition-colors"
                            aria-expanded="false"
                          >
                            <span data-view-nominees-label>View Nominees</span>
                            <svg class="w-3.5 h-3.5 transition-transform" data-view-nominees-icon fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                          </button>
                        </div>
                      ))}

                      {/* Row expansion slot — one panel per subcategory in this
                          row. Hidden until the matching card's "View Nominees"
                          button is clicked. Spans full grid width on lg+. */}
                      {row.map((sub) => (
                        <div
                          data-sub-expansion={`${main.anchor}-${sub.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
                          class="hidden lg:col-span-2 rounded-2xl border-2 border-gold/40 bg-gradient-to-b from-navy-dark via-navy to-navy-dark p-6 sm:p-8 md:p-10 shadow-[0_18px_46px_-18px_rgba(0,0,0,0.6)]"
                        >
                          <div class="text-center mb-7 sm:mb-8">
                            <p class="text-gold/80 font-bold tracking-[0.22em] uppercase text-xs sm:text-sm mb-2">
                              {sub.name} &middot; {sub.nominees.length} Nominee{sub.nominees.length === 1 ? "" : "s"}
                            </p>
                            <div class="w-12 h-0.5 bg-gold mx-auto"></div>
                          </div>

                          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
                            {sub.nominees.map((n) => (
                              <li class="flex flex-col items-center text-center bg-white/[0.04] border border-gold/30 rounded-xl p-5 sm:p-6 hover:border-gold/60 hover:bg-white/[0.06] transition-colors">
                                <div class="w-24 h-24 sm:w-28 sm:h-28 mb-4 rounded-full overflow-hidden bg-gold/10 border-2 border-gold/50 flex items-center justify-center flex-shrink-0">
                                  {n.photo ? (
                                    <img src={n.photo} alt={n.name} class="w-full h-full object-cover" loading="lazy" decoding="async" />
                                  ) : (
                                    <picture>
                                      <source srcset="/images/misc/all-amer-icon-medal.webp" type="image/webp" />
                                      <img
                                        src="/images/misc/all-amer-icon-medal.png"
                                        alt=""
                                        class="w-2/3 h-2/3 object-contain opacity-70"
                                        loading="lazy"
