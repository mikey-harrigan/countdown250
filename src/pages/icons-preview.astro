    nominees: [
      { name: "Jerry Seinfeld", desc: "Legendary comedian and television creator whose work helped define modern American comedy" },
      { name: "Joe Rogan", desc: "Influential podcaster, comedian, and UFC commentator with one of the largest audiences in digital media" },
