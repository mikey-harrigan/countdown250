---

<BaseLayout
  title="All-American Icons (Preview) | Help Select America's Icons | Countdown 250 Ball, July 3, 2026"
  description="Public voting is now open for the 2026 All-American Icon Awards. Review nominees by category, cast your vote, submit a write-in nomination, and share the campaign. Awards presented at the Countdown 250 Ball on July 3, 2026."
  ogImage="/images/event/header-icons-flag-medal.jpg"
>
  <Navbar />
  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >
    <!-- ============================================================ -->
    <!-- HERO — canonical sub-page pattern (UNCHANGED).                 -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-icons-flag-medal.jpg"
          alt="The All-American Icon Award medal — gold circle with an eagle and torch, encircled by the words 'ALL-AMERICAN ICON' and 'EXCELLENCE · INFLUENCE · INSPIRATION' — resting on the rippling stars and stripes of the American flag"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              All-American Icons
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- "Honoring the American Dream" eyebrow + medal + title block    -->
    <!-- removed 2026-05-31 per Mike to shorten the page vertically.    -->
    <!-- The hero medal image at the top of the page now stands alone.  -->

    <!-- ============================================================ -->
    <!-- 1. PUBLIC VOTING NOW OPEN — campaign hook + primary CTA.       -->
    <!-- ============================================================ -->
    <section class="pt-12 sm:pt-14 pb-8 sm:pb-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark rounded-2xl border-2 border-gold/55 p-6 sm:p-8 md:p-10 text-center shadow-[0_20px_44px_-16px_rgba(0,0,0,0.55)]">
          <p class="text-gold font-bold tracking-[0.28em] uppercase text-xs sm:text-sm mb-3">Public Voting Now Open</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white font-heading leading-tight mb-4">
            Help Select America&rsquo;s Icons
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-5"></div>
          <p class="text-white/90 text-lg sm:text-xl leading-relaxed max-w-6xl mx-auto mb-3 italic font-medium">
            Be part of history by helping recognize the people whose achievements, service,
            creativity, leadership, courage, and character have helped shape the American story.
          </p>
          <p class="text-white/80 text-base sm:text-lg leading-relaxed max-w-6xl mx-auto mb-6">
            The All-American Ball Committee is inviting the public to help recognize individuals
            whose lives and work have left a lasting mark on American life. Review the nominees
            currently under consideration, cast your vote, submit a write-in nomination, and share
            the campaign with others who should have a voice in recognizing America&rsquo;s
            All-American Icons.
          </p>
          <a
            href={voteFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
          >
            Vote, Nominate &amp; Share
          </a>
          <p class="text-white/55 text-xs sm:text-sm mt-4 italic">
            Browse nominees by category, cast your vote, and submit write-in nominations using the official form.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. WHAT IS AN ALL-AMERICAN ICON? — definition.                 -->
    <!-- ============================================================ -->
    <section class="py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-6">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gold font-heading leading-tight mb-3">
            What Is an All-American Icon?
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-white/85 text-base sm:text-lg leading-relaxed space-y-3">
          <p>
            An All-American Icon is someone whose life, work, accomplishments, or leadership has
            helped shape their field, define their generation, or leave a lasting mark on the
            American story.
          </p>
          <p>
            They may be an athlete, artist, entertainer, scientist, entrepreneur, public servant,
            humanitarian, military leader, first responder, business leader, or cultural figure.
            Some are household names; others may be less widely known. But each has made a
            meaningful contribution to the larger American tapestry.
          </p>
          <p class="text-white font-semibold">
            They are not just successful &mdash; they are significant. They inspire admiration,
            represent excellence, and reflect something special and enduring about the American
            spirit.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. REVIEW THE NOMINEE CATEGORIES — accordion (collapsed).      -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12 bg-navy-dark border-y border-gold/25">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-7">
          <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">
            Nominees Under Consideration
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-3">
            Review the Nominee Categories
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-5"></div>
          <p class="text-white/80 text-base sm:text-lg leading-relaxed max-w-5xl mx-auto">
            Choose a category card below to jump to the section. Inside each section, click
            <span class="text-gold font-semibold">View Nominees</span> on any subcategory to see
            the All-American Icons under consideration and cast your vote. Honorees already
            selected are marked <span class="text-gold font-semibold">2026 Honoree</span>.
          </p>
        </div>

        {/* ====================================================== */}
        {/* TWO LARGE NAVIGATION CARDS — Sports vs. Arts.          */}
        {/* Click smoothly scrolls to the matching anchor section.  */}
        {/* ====================================================== */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-7 mb-14 sm:mb-20">
          {mainCategories.map((main) => (
            <a
              href={`#${main.anchor}`}
              data-jump-card
              class="group relative overflow-hidden rounded-2xl border-2 border-gold/55 bg-gradient-to-br from-navy/80 via-navy-dark/90 to-navy/80 hover:border-gold transition-all p-8 sm:p-10 md:p-12 text-center shadow-[0_18px_44px_-18px_rgba(0,0,0,0.55)] hover:-translate-y-1 hover:shadow-[0_24px_52px_-18px_rgba(0,0,0,0.7)] duration-300"
            >
              <span class="block text-gold/70 text-xs sm:text-sm font-bold uppercase tracking-[0.25em] mb-4 group-hover:text-gold transition-colors">
                Browse Category
              </span>
              <h3 class="font-heading font-bold text-white text-2xl sm:text-3xl md:text-4xl leading-tight uppercase tracking-[0.02em] mb-4">
                {main.name}
              </h3>
              <div class="w-12 h-0.5 bg-gold mx-auto mb-4"></div>
              <p class="text-white/65 text-sm sm:text-base leading-relaxed mb-6">
                {main.subcategories.length} subcategories &middot; {main.subcategories.reduce((sum, s) => sum + s.nominees.length, 0)} nominees
              </p>
              <span class="inline-block bg-gold/15 border border-gold/60 group-hover:bg-gold group-hover:text-navy-dark text-gold px-7 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider rounded transition-colors">
                Explore {main.name.split(",")[0]}
              </span>
            </a>
          ))}
        </div>

        {/* ====================================================== */}
        {/* MAIN CATEGORY SECTIONS — large divider, intro, then a   */}
        {/* 2-column grid of subcategory cards. Clicking "View      */}
        {/* Nominees" expands a full-width panel below the row that */}
        {/* lists nominee cards (only ONE panel open at a time      */}
        {/* across the entire page; JS controller at bottom of      */}
