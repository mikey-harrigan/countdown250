<BaseLayout
  title="All-American Icons (Preview) | Help Select America's Icons | Countdown 250 Ball, July 3, 2026"
  description="Public voting is now open for the 2026 All-American Icon Awards. Review nominees by category, cast your vote, submit a write-in nomination, and share the campaign. Awards presented at the Countdown 250 Ball on July 3, 2026."
  ogImage="/images/event/header-icons-flag-medal.jpg"
>
  <Navbar />
  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >
    <!-- ============================================================ -->
    <!-- HERO — canonical sub-page pattern (UNCHANGED).                 -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-icons-flag-medal.jpg"
          alt="The All-American Icon Award medal — gold circle with an eagle and torch, encircled by the words 'ALL-AMERICAN ICON' and 'EXCELLENCE · INFLUENCE · INSPIRATION' — resting on the rippling stars and stripes of the American flag"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              All-American Icons
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- HONORING THE AMERICAN DREAM — medal + title block (UNCHANGED). -->
    <!-- ============================================================ -->
    <section class="pt-16 sm:pt-20 pb-6 sm:pb-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-8">
          Honoring the American Dream
        </p>

        <div class="text-center">
          <picture>
            <source srcset="/images/misc/all-amer-icon-medal.webp" type="image/webp" />
            <img
              src="/images/misc/all-amer-icon-medal.png"
              alt="All-American Icon Award medal"
              class="w-32 sm:w-40 md:w-48 h-auto mx-auto mb-6"
              style="filter: drop-shadow(0 14px 28px rgba(0,0,0,0.18)) drop-shadow(0 4px 10px rgba(197,164,78,0.32));"
              loading="eager"
            />
          </picture>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold font-heading leading-tight mb-2">All-American Icon</h2>
          <p class="text-2xl sm:text-3xl md:text-4xl font-bold text-gold font-heading leading-tight mb-5">Award</p>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 1. PUBLIC VOTING NOW OPEN — campaign hook + primary CTA.       -->
    <!-- ============================================================ -->
    <section class="py-14 sm:py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark rounded-2xl border-2 border-gold/55 p-7 sm:p-10 md:p-12 text-center shadow-[0_20px_44px_-16px_rgba(0,0,0,0.55)]">
          <p class="text-gold font-bold tracking-[0.28em] uppercase text-xs sm:text-sm mb-4">Public Voting Now Open</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white font-heading leading-tight mb-5">
            Help Select America&rsquo;s Icons
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-7"></div>
          <p class="text-white/90 text-lg sm:text-xl leading-relaxed max-w-3xl mx-auto mb-5 italic font-medium">
            Be part of history by helping recognize the people whose achievements, service,
            creativity, leadership, courage, and character have helped shape the American story.
          </p>
          <p class="text-white/80 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto mb-8">
            The All-American Ball Committee is inviting the public to help recognize individuals
            whose lives and work have left a lasting mark on American life. Review the nominees
            currently under consideration, cast your vote, submit a write-in nomination, and share
            the campaign with others who should have a voice in recognizing America&rsquo;s
            All-American Icons.
          </p>
          <a
            href={voteFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
          >
            Vote, Nominate &amp; Share
          </a>
          <p class="text-white/55 text-xs sm:text-sm mt-4 italic">
            Browse nominees by category, cast your vote, and submit write-in nominations using the official form.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. WHAT IS AN ALL-AMERICAN ICON? — definition.                 -->
    <!-- ============================================================ -->
    <section class="py-14 sm:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <h2 class="text-3xl sm:text-4xl font-bold text-gold font-heading leading-tight mb-5">
            What Is an All-American Icon?
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-white/85 text-base sm:text-lg leading-relaxed space-y-5">
          <p>
            An All-American Icon is someone whose life, work, accomplishments, or leadership has
            helped shape their field, define their generation, or leave a lasting mark on the
            American story.
          </p>
          <p>
            They may be an athlete, artist, entertainer, scientist, entrepreneur, public servant,
            humanitarian, military leader, first responder, business leader, or cultural figure.
            Some are household names; others may be less widely known. But each has made a
            meaningful contribution to the larger American tapestry.
          </p>
          <p class="text-white font-semibold">
            They are not just successful &mdash; they are significant. They inspire admiration,
            represent excellence, and reflect something special and enduring about the American
            spirit.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. REVIEW THE NOMINEE CATEGORIES — accordion (collapsed).      -->
    <!-- ============================================================ -->
    <section class="py-14 sm:py-16 bg-navy-dark border-y border-gold/25">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
            Nominees Under Consideration
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
            Review the Nominee Categories
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-7"></div>
          <p class="text-white/80 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto">
            Explore the categories below, review the nominees currently under consideration, and
            cast your vote using the official voting form. Some All-American Icons have already
            been selected and are noted below as <span class="text-gold font-semibold">2026 Honorees</span>.
            Additional nominees remain under consideration, and public voting will help inform the
            final selections.
          </p>
        </div>

        <div class="space-y-3 sm:space-y-4">
          {nomineeCategories.map((cat) => (
            <details class="group rounded-xl border border-gold/40 bg-white/[0.05] overflow-hidden shadow-[0_10px_24px_-12px_rgba(0,0,0,0.45)] open:shadow-[0_16px_36px_-12px_rgba(0,0,0,0.55)]">
              <summary class="cursor-pointer list-none p-5 sm:p-6 hover:bg-white/[0.08] transition-colors marker:hidden">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <h3 class="font-heading font-bold text-gold text-lg sm:text-xl leading-tight mb-1.5">{cat.name}</h3>
                    <p class="text-white/65 text-xs sm:text-sm leading-relaxed">{cat.description}</p>
                  </div>
                  <div class="flex items-center gap-3 flex-shrink-0 pt-1">
                    {cat.nominees.length > 0 && (
                      <span class="text-white/55 text-xs sm:text-sm font-medium">{cat.nominees.length}</span>
                    )}
                    <span class="text-gold text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                  </div>
                </div>
              </summary>
              <div class="px-5 sm:px-7 pb-6 pt-5 border-t border-gold/20">
                {cat.nominees.length > 0 ? (
                  <ul class="space-y-3">
                    {cat.nominees.map((n) => (
                      <li class="text-sm sm:text-base leading-relaxed">
                        <span class="text-white font-bold">{n.name}</span>
                        {n.desc && (
                          <span class="text-white/65"> &mdash; {n.desc}</span>
                        )}
                        {n.selected && (
                          <span class="ml-2 inline-block bg-gold/20 border border-gold/60 text-gold text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.08em] px-2 py-0.5 rounded align-middle whitespace-nowrap">
                            Selected 2026 Honoree
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-white/55 italic text-sm sm:text-base">
                    Nominees in this category will be announced soon.
                  </p>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 4. OFFICIAL VOTING FORM CTA — strong call to action.           -->
    <!-- ============================================================ -->
    <section class="py-14 sm:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
          Official Voting Form
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
          Cast Your Vote. Submit a Nomination. Share the Campaign.
        </h2>
        <div class="w-16 h-1 bg-gold mx-auto mb-7"></div>
        <p class="text-white/85 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto mb-8">
          Use the official All-American Icons voting and nomination form to review current
          nominees, cast your vote, and suggest additional individuals who deserve to be
          considered.
        </p>
        <a
          href={voteFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
