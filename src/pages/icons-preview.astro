    ],
  },
  {
    name: "Women's Basketball & Cultural Impact Icons",
    description: "WNBA stars, college standouts, and cultural figures expanding the visibility of women’s basketball.",
    nominees: [
      { name: "Caitlin Clark", desc: "Record-breaking basketball superstar and cultural phenomenon" },
      { name: "Angel Reese", desc: "National champion and major women’s sports influencer" },
      { name: "A'ja Wilson", desc: "WNBA MVP and Olympic gold medalist" },
      { name: "Paige Bueckers", desc: "College basketball superstar and NIL-era icon" },
      { name: "JuJu Watkins", desc: "Explosive young college basketball superstar" },
      { name: "Sophie Cunningham", desc: "WNBA fan favorite and rising media personality" },
