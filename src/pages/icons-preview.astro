                                </div>
                                <h5 class="font-heading font-bold text-white text-base sm:text-lg leading-tight mb-2">{n.name}</h5>
                                {n.honoree && (
                                  <span class="inline-block bg-gold/20 border border-gold/60 text-gold text-[10px] font-bold uppercase tracking-[0.1em] px-2 py-0.5 rounded mb-3">
                                    2026 Honoree
