  {/* ====================================================== */}
  {/* Subcategory "View Nominees" controller.                 */}
  {/* - Click toggles the matching expansion panel.           */}
  {/* - Only ONE expansion open at a time across whole page.  */}
  {/* - Opening a new one closes the previous.                */}
  {/* - Smooth-scrolls to keep the clicked card in view       */}
  {/*   (offset accounts for the fixed navbar).               */}
  {/* - Button label flips View Nominees <-> Hide Nominees    */}
  {/*   and the chevron rotates 180deg when open.             */}
  {/* ====================================================== */}
  <script is:inline>
    (function () {
      var NAV_OFFSET = 110; // px — navbar + identity bar height cushion

      function getButtons() {
        return document.querySelectorAll("[data-view-nominees]");
      }
      function getExpansions() {
        return document.querySelectorAll("[data-sub-expansion]");
      }

      function closeAll() {
        getExpansions().forEach(function (panel) {
          panel.classList.add("hidden");
        });
        getButtons().forEach(function (btn) {
          btn.setAttribute("aria-expanded", "false");
          var label = btn.querySelector("[data-view-nominees-label]");
          var icon = btn.querySelector("[data-view-nominees-icon]");
          if (label) label.textContent = "View Nominees";
          if (icon) icon.classList.remove("rotate-180");
        });
      }

      function openOne(id) {
        var panel = document.querySelector('[data-sub-expansion="' + id + '"]');
        var btn = document.querySelector('[data-view-nominees="' + id + '"]');
        if (!panel || !btn) return;
        panel.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
        var label = btn.querySelector("[data-view-nominees-label]");
        var icon = btn.querySelector("[data-view-nominees-icon]");
        if (label) label.textContent = "Hide Nominees";
        if (icon) icon.classList.add("rotate-180");

        // Smooth-scroll the clicked card into view (offset for nav).
        var card = document.querySelector('[data-sub-card="' + id + '"]');
        if (card) {
          var rect = card.getBoundingClientRect();
          var targetY = rect.top + window.pageYOffset - NAV_OFFSET;
          window.scrollTo({ top: targetY, behavior: "smooth" });
        }
      }

      function onClick(e) {
        var btn = e.currentTarget;
        var id = btn.getAttribute("data-view-nominees");
        var panel = document.querySelector('[data-sub-expansion="' + id + '"]');
        if (!panel) return;
        var alreadyOpen = !panel.classList.contains("hidden");
        closeAll();
        if (!alreadyOpen) openOne(id);
      }

      getButtons().forEach(function (btn) {
        btn.addEventListener("click", onClick);
      });

      // Smooth-scroll for the top "Browse Category" jump cards.
      document.querySelectorAll("[data-jump-card]").forEach(function (link) {
        link.addEventListener("click", function (e) {
          var href = link.getAttribute("href") || "";
          if (!href.startsWith("#")) return;
          var target = document.querySelector(href);
          if (!target) return;
          e.preventDefault();
          var rect = target.getBoundingClientRect();
          var targetY = rect.top + window.pageYOffset - NAV_OFFSET;
          window.scrollTo({ top: targetY, behavior: "smooth" });
        });
      });
    })();
  </script>
</BaseLayout>
