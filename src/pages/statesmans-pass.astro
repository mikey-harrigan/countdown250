---
/*
 * /statesmans-pass/ — REDIRECT STUB (2026-05-13)
 * ----------------------------------------------------------------
 * The Statesman's tier is a single product: the Statesman's
 * Concierge Pass. We previously had two near-duplicate pages
 * (/statesmans-pass/ and /statesmans-concierge-pass/) describing
 * the same tier, which split SEO equity and risked the two pages
 * drifting out of sync. We standardised on
 * /statesmans-concierge-pass/ as the canonical URL and replaced
 * this page with a meta-refresh + JS redirect so any inbound
 * traffic (search results, old links, cached pages) lands on the
 * live page automatically.
 *
 * Sitemap: excluded via astro.config.mjs filter so search engines
 * stop indexing this URL going forward.
 *
 * Canonical link tag points to the live page so any crawler that
 * lands here before the redirect fires understands the merge.
 */
const target = "/statesmans-concierge-pass/";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://countdown250.allamericanball.com${target}`} />
    <title>Redirecting to the Statesman&rsquo;s Concierge Pass &mdash; Countdown 250 Ball</title>
    <style>
      html, body { margin: 0; padding: 0; background: #002B77; color: #ffffff; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      .wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; text-align: center; }
      a { color: #C5A44E; font-weight: 600; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p>
        Redirecting to the Statesman&rsquo;s Concierge Pass&hellip;<br />
        If you are not redirected automatically, <a href={target}>click here</a>.
      </p>
    </div>
    <script is:inline define:vars={{ target }}>
      // Fire as soon as JS is parsed; meta-refresh is the fallback.
      window.location.replace(target);
    </script>
  </body>
</html>
