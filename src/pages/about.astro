---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
---

<BaseLayout
  title="About — The Official Countdown 250 Ball | The Can't-Miss Event of a Lifetime | Washington D.C. July 3, 2026"
  description="The Countdown 250 Ball is the formal evening kickoff to America's 250th anniversary — July 3, 2026 at the Washington Hilton. 3,000 guests. 6 grand ballrooms. 4 stages. The stroke of midnight launches America 250."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- ============================================================ -->
  <!-- HERO -->
  <!-- ============================================================ -->
  <section class="relative pt-32 pb-16 bg-navy text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, rgba(197,164,78,0.3) 0%, transparent 70%);"></div>
    </div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10">
      <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-4">July 3, 2026 &middot; Washington Hilton</p>
      <h1 class="text-3xl sm:text-5xl font-bold mb-4 font-heading leading-tight">The Countdown Is On</h1>
      <p class="text-xl sm:text-2xl text-gold/90 italic font-light mb-8">America&rsquo;s Formal Kickoff to the 250th</p>
      <div class="w-24 h-px bg-gold mx-auto"></div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- CREDIBILITY LINE -->
  <!-- ============================================================ -->
  <section class="py-10 bg-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-red text-base md:text-lg font-semibold italic leading-relaxed">
        From inaugural balls to milestone events, the All-American Ball Committee has produced some of America&rsquo;s most historic celebrations &mdash; bringing together leaders, dignitaries, astronauts, world-champion athletes, A-list celebrities, members of Congress, and proud Americans for over three decades.
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- THE MOMENT — Bicentennial parallel -->
  <!-- ============================================================ -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-navy mb-4 font-heading leading-tight">The Moment</h2>
        <div class="w-20 h-px bg-gold mx-auto"></div>
      </div>

      <div class="space-y-6 text-lg text-slate leading-relaxed">
        <p>
          <strong class="text-navy">America 250</strong> &mdash; the 250th anniversary of the United States &mdash; is the most anticipated national milestone of our lifetimes. The entire country marks the occasion this Independence Weekend, and Washington, D.C. is ground zero.
        </p>
        <p>
          People who experienced the Bicentennial in 1976 still talk about it. Half a century on, they remember exactly where they were the night America turned 200. <strong class="text-navy">That moment defined a generation.</strong>
        </p>
        <p class="text-xl font-semibold text-navy text-center pt-4 border-t border-navy/10">
          This is that moment for us.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- BY THE NUMBERS — concrete facts strip -->
  <!-- ============================================================ -->
  <section class="py-14 sm:py-16 bg-navy text-white border-t border-gold/20 border-b border-gold/20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-3">By the Numbers</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">One Night. One Place. One Moment.</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 sm:gap-4 text-center">
        <div>
          <p class="text-gold font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-none mb-2">1</p>
          <p class="text-white/80 text-xs sm:text-sm tracking-[0.15em] uppercase">Historic Night</p>
        </div>
        <div>
          <p class="text-gold font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-none mb-2">3,000</p>
          <p class="text-white/80 text-xs sm:text-sm tracking-[0.15em] uppercase">Guests</p>
        </div>
        <div>
          <p class="text-gold font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-none mb-2">6</p>
          <p class="text-white/80 text-xs sm:text-sm tracking-[0.15em] uppercase">Grand Ballrooms</p>
        </div>
        <div>
          <p class="text-gold font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-none mb-2">4</p>
          <p class="text-white/80 text-xs sm:text-sm tracking-[0.15em] uppercase">Stages</p>
        </div>
        <div class="col-span-2 md:col-span-1">
          <p class="text-gold font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-none mb-2">250</p>
          <p class="text-white/80 text-xs sm:text-sm tracking-[0.15em] uppercase">Years of America</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- THE TEAM & THE VENUE -->
  <!-- ============================================================ -->
  <section class="py-16 sm:py-20 bg-cream">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-navy mb-4 font-heading leading-tight">The Team &amp; The Venue</h2>
        <div class="w-20 h-px bg-gold mx-auto"></div>
      </div>

      <div class="space-y-6 text-lg text-slate leading-relaxed">
        <p>
          For 30+ years our team has produced the events that mark America&rsquo;s most important nights &mdash; Inaugural Balls, milestone anniversaries, and signature Washington galas. Presidents, members of Congress, astronauts, decorated veterans, world-champion athletes, dignitaries, and entertainers from every corner of American life have walked through our doors.
        </p>
        <p>
          A celebration of this magnitude can only take place at one venue: the legendary <a href="/venue" class="text-red font-semibold hover:underline">Washington Hilton</a> &mdash; the iconic site of the White House Correspondents&rsquo; Dinner and over 60 years of presidential history.
        </p>
        <div class="bg-white rounded-xl p-5 sm:p-6 border-l-4 border-gold mt-4">
          <p class="text-sm sm:text-base text-slate/85 leading-relaxed">
            <strong class="text-navy">Make a weekend of it:</strong> Ball week falls during the <a href="/great-american-state-fair-evening" class="text-red font-semibold hover:underline">Great American State Fair</a> on the National Mall &mdash; 16 days bringing all 50 states, territories, and federal agencies to the capital. By day, the Fair. By night, the Ball. Three blocks apart.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- THE NIGHT → THE CRESCENDO (one navy section, one climax) -->
  <!-- ============================================================ -->
  <section class="relative py-20 sm:py-24 bg-gradient-to-b from-navy-dark via-navy to-navy-dark text-white overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">

      <!-- Section heading -->
      <div class="text-center mb-12">
        <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-4">The Event</p>
        <h2 class="font-heading font-bold leading-tight text-3xl sm:text-4xl md:text-5xl text-gold mb-4">
          The Countdown 250 Ball
        </h2>
        <p class="font-heading italic text-white/90 text-xl sm:text-2xl md:text-3xl font-light leading-snug">
          The Can&rsquo;t-Miss Event of a Lifetime
        </p>
        <div class="w-24 h-px bg-gold mx-auto mt-6"></div>
      </div>

      <!-- What happens at the event -->
      <div class="space-y-6 text-lg sm:text-xl text-white/90 leading-relaxed text-left max-w-3xl mx-auto mb-12">
        <p>
          On the evening of July 3, 2026, the Washington Hilton transforms into the largest, most consequential evening kickoff to America 250 weekend.
        </p>
        <p>
          <strong class="text-white">3,000 guests. Open bars all night. World-class entertainment from coast to coast. The <a href="/honorees" class="text-gold hover:text-gold/80 underline">All-American Hero Lifetime Achievement Awards</a>. A Patriotic Tribute to America.</strong>
        </p>
        <p>
          And at the stroke of midnight &mdash; the moment America turns 250 &mdash; a countdown that launches the nation&rsquo;s 250th birthday from the ballroom floor.
        </p>
        <p class="text-base sm:text-lg text-white/75 italic pt-4 border-t border-gold/20">
          Want to bring your network or family? Statesman&rsquo;s Pass holders can host their own &ldquo;Party Inside the Party&rdquo; &mdash; a reserved private space for their group. <a href="/hosted-group-tables" class="text-gold hover:text-gold/80 underline font-medium not-italic">See the Hosted Groups Program &rarr;</a>
        </p>
      </div>

      <!-- The single emotional close — pared back from the prior 4 stacked endings -->
      <div class="text-center pt-10 border-t border-gold/30">
        <p class="text-white/95 text-lg sm:text-xl leading-relaxed mb-6 max-w-2xl mx-auto">
          Forty years from now, you will remember exactly where you were when the clock struck 250.
        </p>
        <p class="font-heading italic text-gold text-2xl sm:text-3xl md:text-4xl font-bold leading-snug">
          Be in the room when it happens.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- CLOSING CTA -->
  <!-- ============================================================ -->
  <section class="py-16 bg-red text-white text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl sm:text-4xl font-bold mb-3 font-heading">Don&rsquo;t Miss It.</h2>
      <p class="text-white/90 text-base sm:text-lg mb-8">Tickets are limited and prices rise as inventory shrinks.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/#tickets" class="bg-white text-red px-10 py-4 text-sm font-bold tracking-[0.2em] uppercase hover:bg-cream transition-colors rounded shadow-lg">Compare Ticket Options</a>
        <a href="/venue" class="border-2 border-white text-white px-10 py-4 text-sm font-semibold tracking-[0.2em] uppercase hover:bg-white hover:text-red transition-colors rounded">About the Venue</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
