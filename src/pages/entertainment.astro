---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * ENTERTAINMENT PAGE (LIVE)
 * ----------------------------------------------------------------
 * Promoted from /entertainment-preview/ on 2026-05-08 after Mike's
 * sign-off. The preview page is preserved at /entertainment-preview/
 * (excluded from sitemap) for future iteration; both pages share
 * the same data structure so edits made on preview can be promoted
 * here in one shot.
 *
 * Major sections:
 *   - Hero (16:9 stage + crowd photo)
 *   - "A celebration for the ages!" intro copy
 *   - Non-Stop Entertainment gold callout
 *   - "7 Party Zones * 4 Stages" — 2-column compact zone grid
 *     (left: Open to All; right: Statesman's Pass with gold cards)
 *   - "Countdown 250 Lineup… so far" — 10 performer/attraction cards
 *     (Bob Anderson, MARCEY, Julian Awari, Deebo, DJ Freedom,
 *      Live Broadcast, Midnight Countdown, Heroes Awards, Tribute
 *      to America, Roving Entertainers)
 *   - Reusable YouTube modal (Bob Anderson's "House I Live In" video)
 */

const zones = [
  // ---- Open to ALL guests ----
  {
    tier: "all",
    name: "All-American Hero Ballroom",
    img: "/images/event/zone-hero-ballroom.jpg",
    summary: "Non-stop programming from 7 PM to 1 AM &mdash; top-notch bands &amp; DJs, patriotic performers, the Hero Awards, the midnight countdown, and a closing set from MARCEY.",
    description: "From 7 PM until 1 AM, the main stage delivers non-stop, can&rsquo;t-miss programming &mdash; top-notch bands and DJs, a powerful program of patriotic performers, the inaugural All-American Heroes Lifetime Achievement Awards, and the signature midnight countdown to America&rsquo;s 250th. The night closes with a final celebration set from MARCEY.",
  },
  {
    tier: "all",
    name: "Decades Dance Club",
    img: "/images/event/dj-party-lights.jpg",
    summary: "70s, 80s, 90s, and 2000s hits all night long.",
    description: "Disco lights, retro vibes, and four decades of crowd-favorite hits, mixed by a high-energy DJ who keeps the floor moving from Donna Summer to Beyoncé.",
  },
  {
    tier: "all",
    name: "Club 250",
    img: "/images/event/zone-club-250.jpg",
    summary: "Modern dance club with today&rsquo;s top hits and club bangers.",
    description: "Modern dance club for current chart hits, EDM, and high-energy club music. Cinematic lighting, immersive sound, and a packed dance floor all night long.",
  },
  {
    tier: "all",
    name: "Interactive Zone",
    img: "/images/event/zone-interactive.jpg",
    summary: "Immersive 250th-anniversary activations, paparazzi photo experience, Media &amp; Press area, interview station &amp; live broadcast studio, roving entertainers.",
    description: "Immersive 250th-anniversary activations, paparazzi photo experience, Media &amp; Press area, interview station &amp; live broadcast studio, roving entertainers.",
  },
  // ---- Statesman's Pass EXCLUSIVE ----
  {
    tier: "statesman",
    name: "Statesman&rsquo;s Balcony",
    img: "/images/event/elegant-dinner-flags.png",
    summary: "Raised area with premium hospitality and a bird&rsquo;s-eye view of the main stage.",
    description: "A large raised area with premium hospitality and a bird&rsquo;s-eye view of the main stage. Reserved seating, top-shelf bar, and the best sightlines in the house.",
  },
  {
    tier: "statesman",
    name: "Presidents Walk",
    img: "/images/event/zone-presidents-walk.jpg",
    summary: "Hidden corridor lined with portraits of every U.S. President and First Lady &mdash; the private passage used by 100+ sitting Presidents.",
    description: "Tucked behind the International Ballroom runs one of Washington&rsquo;s most quietly historic corridors &mdash; the private passageway built into the Washington Hilton&rsquo;s 1965 blueprints to give visiting Presidents a protected route in and out of the building. The walls are lined with portraits of every U.S. President and First Lady, sourced from the Library of Congress. Complimentary guided tours of the Walk and other dignitaries-only spaces will be offered throughout the evening.",
  },
  {
    tier: "statesman",
    name: "Speakeasy Lounge",
    img: "/images/event/zone-speakeasy.jpg",
    summary: "Speakeasy-styled hidden lounge with classic cocktails and vintage ambience.",
    description: "A speakeasy-styled hidden lounge with classic cocktails, vintage music, and intimate ambience. Reserved for Statesman&rsquo;s Pass holders only.",
  },
];

// Entertainment Lineup — Bob Anderson at top per Mike (2026-05-08).
const performers = [
  {
    name: "Bob Anderson",
    role: "American Icon &amp; World&rsquo;s Greatest Singing Impressionist",
    img: "/images/event/bob-anderson.jpg",
    bio: "<em class='block mb-3 text-navy/80 not-italic font-semibold uppercase tracking-wider text-xs'>American Icon and the World&rsquo;s Greatest Singing Impressionist</em>Bob Anderson&rsquo;s career began with the kind of only-in-Las-Vegas moment that becomes legend. A Vietnam veteran from a musical family of six brothers known as &ldquo;The Detroit Osmonds,&rdquo; Anderson arrived in Las Vegas in his early twenties and, within hours, found himself on stage at the famed Sahara Hotel &amp; Casino. What began as an unexpected opportunity to sing with Nancy Sinatra quickly led to an appearance on The Merv Griffin Show, where his remarkable ability to recreate the voices of the world&rsquo;s greatest singers brought him national attention.<br /><a href='https://youtu.be/iGRT3H-XDkM' target='_blank' rel='noopener noreferrer' class='youtube-modal-trigger inline-flex items-center justify-center gap-2 mt-4 bg-navy-dark hover:bg-navy border-2 border-gold text-gold hover:text-gold-light px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider transition-all rounded-lg shadow-md hover:shadow-lg hover:-translate-y-0.5 no-underline' data-yt-id='iGRT3H-XDkM' data-yt-title='Bob Anderson &mdash; &ldquo;The House I Live In&rdquo;'><span class='text-gold'>&#9654;</span> Listen to Bob Anderson&rsquo;s &ldquo;The House I Live In&rdquo;</a>",
    bioExpanded: "Over the next five decades, Anderson became one of the most sought-after entertainers on the Las Vegas Strip, performing in every major casino showroom and earning acclaim for his extraordinary recreations of legendary vocalists, including his celebrated tribute to Frank Sinatra. His career has included performances for two U.S. Presidents, the Royal Family, and audiences at Carnegie Hall, where his Sinatra performance earned multiple standing ovations.<br /><br />Inducted into both the Casino Legends Hall of Fame and the Las Vegas Entertainers Hall of Fame, Bob Anderson has been hailed by <em>People</em> Magazine as &ldquo;America&rsquo;s Greatest Singing Impressionist,&rdquo; praised by Simon Cowell as the best on the planet, and summed up best by Frank Sinatra himself: &ldquo;Bob Anderson has a hell of an act.&rdquo;",
  },
  {
    name: "Tony Orlando",
    role: "American Icon &amp; Legendary Entertainer",
    img: "/images/event/tony-orlando.jpg",
    imgFit: "object-contain",
    bio: "Tony Orlando is one of America&rsquo;s most beloved entertainers &mdash; a Grammy-nominated, Hollywood Walk of Fame icon celebrating more than six decades in show business, with five #1 hits and millions of records sold.",
    bioExpanded: "<p>He has sold millions of records, including five #1 hits &mdash; &ldquo;Tie a Yellow Ribbon &rsquo;Round the Ole Oak Tree,&rdquo; &ldquo;Knock Three Times,&rdquo; &ldquo;Candida,&rdquo; &ldquo;My Sweet Gypsy Rose,&rdquo; and &ldquo;He Don&rsquo;t Love You (Like I Love You)&rdquo; &mdash; plus two platinum and three gold albums and 15 Top 40 hits. &ldquo;Tie a Yellow Ribbon&rdquo; was Billboard&rsquo;s #1 Song of the Year in 1973 and grew into an American anthem of hope, homecoming, and renewal.</p><p>The enormously popular <em>Tony Orlando and Dawn</em> variety show ran for four seasons on CBS (1973&ndash;1977) &mdash; the first television show to feature a multi-racial singing group, with Tony the first and only Latin American to host a network variety series. Tony Orlando and Dawn rank among Billboard&rsquo;s Top 100 artists of all time.</p><p>Few entertainers have excelled in so many realms: recording artist, songwriter, concert headliner, network television star, motion-picture actor, Broadway performer, and author. As VP of CBS&rsquo;s April-Blackwood Music (1966&ndash;1970) he signed and produced Barry Manilow&rsquo;s first recordings and represented songwriters including James Taylor, Laura Nyro, and Blood, Sweat &amp; Tears alongside the legendary Clive Davis. He first reached the charts in 1961 as the first pop vocalist signed to Epic Records, with &ldquo;Halfway to Paradise.&rdquo;</p><p>His honors include a star on the Hollywood Walk of Fame, the American Eagle Lifetime Achievement Award, the Ellis Island Medal of Honor, the Lee Greenwood Patriot Award, induction into the New Jersey Hall of Fame (2023) and the East Coast Music Hall of Fame (2022), two American Music Awards, and the People&rsquo;s Choice Award for Best Male Entertainer.</p><p>A devoted champion of America&rsquo;s veterans, Tony has performed for troops around the world and for several U.S. Presidents, from Carnegie Hall to the White House, and received the Bob Hope Award for excellence in entertainment from the Congressional Medal of Honor Society. In 2023 he marked the 50th anniversary of &ldquo;Tie a Yellow Ribbon&rdquo; and the return of America&rsquo;s Vietnam POWs &mdash; whom he first honored at Bob Hope&rsquo;s invitation at the 1973 Cotton Bowl &mdash; and for two decades welcomed some 175,000 veterans each year to his Yellow Ribbon Music Theatre in Branson, Missouri.</p><p>For 33 years he co-hosted the Muscular Dystrophy Telethon alongside Jerry Lewis, and today hosts &ldquo;Saturday Nights with Tony Orlando&rdquo; on 77WABC Music Radio, streaming worldwide. Tony and his wife, Francine, are the parents of Jenny and Jon.</p>",
  },
  {
    name: "MARCEY",
    role: "DJ &amp; Producer",
    img: "/images/event/dj-marcey.jpg",
    bio: "MARCEY is a Washington, D.C. based DJ and producer known for delivering high-energy sets that blend underground grit with mainstream appeal. He has established a strong presence in the D.C. dance music scene, performing at top venues including Echostage, The Anthem, Soundcheck, and Zebbie&rsquo;s Garden.",
    bioExpanded: "MARCEY has also supported major artists such as Martin Garrix, D.O.D, Ian Asher, and Matt Sassari &mdash; further solidifying his position as a rising act. With additional performances across the East Coast &mdash; including New York City, Tampa, and Fort Lauderdale &mdash; MARCEY continues to build momentum, driven by a passion to recreate the same energy and emotion that first drew him to dance music.<br /><br /><a href='https://www.instagram.com/marcey.mp3' target='_blank' rel='noopener noreferrer' class='inline-block text-red-700 font-bold uppercase tracking-wider text-xs hover:text-red-900'>Follow MARCEY on Instagram &rarr;</a>",
  },
  {
    name: "Julian Awari",
    role: "National Anthem",
    img: "/images/event/julian-awari.jpg",
    bio: "Air Force veteran and powerhouse vocalist. Performs the National Anthem to open the evening&rsquo;s program &mdash; a signature moment that sets the tone for the entire night.",
  },
  {
    name: "Deebo",
    role: "Open-Format DJ",
    img: "/images/event/deebo.jpg",
    bio: "Deebo is a wildly popular, high-energy, open-format DJ known for blending hip-hop, house, Afrobeat, EDM, Latin, Jersey club, and throwback hits into nonstop crowd-driven sets. From college parties and packed club nights to private events and major weekend celebrations, he has built a reputation for reading the crowd and keeping the energy at its peak all night long.",
    bioExpanded: "Known for smooth transitions, creative mixes, and strong stage presence, Deebo brings a unique vibe to every performance. He started his DJ career in early college, quickly gaining notoriety for his energy and creativity. Focused on building a name through consistency, passion, and high-level energy, he continues to grow as one of the East Coast&rsquo;s fastest-rising DJs &mdash; delivering sets that keep people moving from start to finish.",
  },
  {
    name: "DJ Freedom",
    role: "Multi-Genre DJ",
    img: "/images/misc/dj-cartoon.jpg",
    bio: "Set your feet free and dance like no one is watching! DJ Freedom will get you in the mood to celebrate. With a deep catalog of tunes from all genres, DJ Freedom will be taking requests and spinning all your favorite dance tunes.",
  },
  {
    name: "Live Broadcast",
    role: "Television &amp; Webcast Coverage",
    img: "/images/misc/usvets-logo.jpg",
    bio: "The Countdown 250 Ball will be broadcast live to viewers nationwide, capturing every moment of America&rsquo;s premier 250th anniversary celebration. Cameras, hosts, and the interview station inside the Interactive Zone bring the evening to the world.",
  },
  {
    name: "Midnight Countdown to America&rsquo;s 250th",
    role: "The Signature Moment",
    img: "/images/event/countdown-toast.jpg",
    bio: "The signature moment. At the stroke of midnight on July 3rd into July 4th, 3,000 guests count down together to the exact instant America enters its 250th year. Multi-sensory production with patriotic music, lights, and a synchronized confetti cascade.",
  },
  {
    name: "All-American Heroes Lifetime Achievement Awards",
    role: "Awards Ceremony",
    img: "/images/event/hero-medal-presentation.jpg",
    bio: "Inaugural presentation of the All-American Heroes Lifetime Achievement Awards, recognizing extraordinary Americans whose courage, leadership, and selfless service have strengthened our nation. A live ceremony in the All-American Hero Ballroom.",
  },
  {
    name: "Tribute to America &mdash; 250 Years",
    role: "Featured Performance",
    img: "/images/event/color-guard.jpg",
    bio: "An original Tribute to America featuring The Sicilian Tenors, a color guard processional, and a multi-decade musical journey through 250 years of American history. Performed once in the evening.",
  },
  {
    name: "Roving Entertainers &amp; Immersive Experiences",
    role: "Roaming Throughout the Night",
    img: "/images/event/roving-entertainers-patriotic.jpg",
    bio: "Throughout the night, an array of entertaining and mesmerizing performers &mdash; costumed characters, magicians, mentalists, dancers, living statues, and more &mdash; will be dazzling guests across the massive ballroom complex. Every corner of the venue comes alive with surprise, spectacle, and wonder.",
  },
];

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
---

<BaseLayout
  title="Entertainment | The Official Countdown 250 Ball — July 3, 2026, Washington Hilton"
  description="7 entertainment areas, 4 stages, headline performers including Bob Anderson, MARCEY, Julian Awari, and Deebo, the All-American Heroes Lifetime Achievement Awards, and a once-in-a-generation midnight countdown to America's 250th. Washington Hilton, DC. July 3, 2026. Get tickets!"
  ogImage="/images/event/header-entertainment-stage-crowd.jpg"
>
  <Navbar />

  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >

    <!-- ============================================================ -->
    <!-- HERO -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-entertainment-stage-crowd.jpg"
          alt="A live band performing on stage with cascading purple and gold light streamers, the lead vocalist at center mic, and the audience silhouetted in the foreground"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              Entertainment
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- INTRO -->
    <!-- ============================================================ -->
    <section class="pt-12 pb-10 sm:pt-16 sm:pb-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <h2 class="font-body text-3xl sm:text-4xl md:text-5xl font-bold text-gold leading-tight tracking-tight uppercase text-center mb-8">
          A celebration for the ages!
        </h2>

        <div class="space-y-5 text-white/90 text-base sm:text-lg leading-relaxed">
          <p>
            For decades, the <strong class="text-gold">All-American Balls</strong> have been the go-to celebrations for landmark moments in American history &mdash; and the Countdown 250 Ball is set to be our <strong class="text-gold">most spectacular event ever</strong>.
          </p>
          <p>
            On <strong class="text-gold">July 3, 2026</strong>, the renowned <strong class="text-gold">Washington Hilton</strong> will be transformed into a patriotic wonderland of music, energy, celebration, and surprise.
          </p>
          <p>
            Your evening features open bars, delicious cuisine, an extraordinary lineup of live entertainment, and a <strong class="text-gold">once-in-a-generation midnight countdown</strong> to the exact instant America enters its 250th year.
          </p>
          <p>
            From the <strong class="text-gold">National Anthem at 7 PM</strong> to the final notes after midnight, every performance, toast, and unforgettable moment is designed to deliver the <strong class="text-gold">celebration of a lifetime</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- NON-STOP ENTERTAINMENT — gold-bordered callout box -->
    <!-- ============================================================ -->
    <section class="py-8 sm:py-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-gold/40 shadow-[0_0_28px_rgba(197,164,78,0.20)]">
          <div class="bg-gold py-4 sm:py-5 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.3em] uppercase text-xs sm:text-sm">
              Non-Stop Entertainment
            </p>
          </div>
          <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark p-7 sm:p-8 md:p-10 text-white">
            <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-[15px] sm:text-base leading-snug">
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>7 entertainment areas</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>4 stages</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Premium open bars &amp; gourmet cuisine</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Stunning patriotic d&eacute;cor</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>First class service</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Unforgettable midnight countdown</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Renowned bands, DJs, and performers</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Roving entertainers &amp; interactive activities</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Show-stopping Midnight Countdown</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Inspiring All-American Heroes Award Ceremony</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 7 PARTY ZONES * 4 STAGES — 2-column compact zone grid          -->
    <!-- Left column = Open to All; right column = Statesman's Pass    -->
    <!-- (gold cards + asterisk footer).                               -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <h2 class="font-body text-3xl sm:text-4xl md:text-5xl font-bold text-gold leading-tight tracking-tight uppercase mb-8 sm:mb-10 text-center">
          7 Party Zones
          <span class="inline-block mx-2 sm:mx-3 align-middle text-gold">&#9733;</span>
          4 Stages
        </h2>

        <div class="grid lg:grid-cols-2 gap-6 lg:gap-8">
          {/* LEFT COLUMN — Open to All */}
          <div>
            <p class="text-white font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4 text-center lg:text-left">
              Open to All Guests
            </p>
            <div class="space-y-4 sm:space-y-5">
              {zones.filter((z) => z.tier === "all").map((z) => (
                <div class="bg-cream rounded-xl overflow-hidden border border-gold/30 shadow-md flex flex-col sm:flex-row sm:min-h-40">
                  <div class="sm:w-40 sm:flex-shrink-0 bg-navy/50">
                    <div class="aspect-[4/3] sm:aspect-auto sm:h-full overflow-hidden">
                      <img src={z.img} alt={z.name} class="w-full h-full object-cover" loading="lazy" decoding="async" />
                    </div>
                  </div>
                  <div class="flex-1 p-4 sm:p-4 flex flex-col">
                    <h3 class="font-heading font-bold text-base sm:text-lg text-navy mb-2 leading-tight" set:html={z.name} />
                    <details class="text-slate text-xs sm:text-sm leading-relaxed group">
                      <summary class="list-none cursor-pointer marker:hidden">
                        <span set:html={z.summary} />
                        <span class="block mt-2 text-red-700 font-bold uppercase tracking-wider text-[10px] hover:text-red-900 group-open:hidden">Read more &rarr;</span>
                      </summary>
                      <div class="mt-2" set:html={z.description} />
                      <span class="block mt-2 text-red-700 font-bold uppercase tracking-wider text-[10px] hover:text-red-900 hidden group-open:inline-block cursor-pointer" onclick="this.closest('details').open = false">&larr; Show less</span>
                    </details>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* RIGHT COLUMN — Statesman's Pass */}
          <div>
            <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4 text-center lg:text-left">
              Statesman&rsquo;s Pass Exclusive
            </p>
            <div class="space-y-4 sm:space-y-5">
              {zones.filter((z) => z.tier === "statesman").map((z) => (
                <div class="bg-gold rounded-xl overflow-hidden border border-gold shadow-md flex flex-col sm:flex-row sm:min-h-40">
                  <div class="sm:w-40 sm:flex-shrink-0 bg-navy/50">
                    <div class="aspect-[4/3] sm:aspect-auto sm:h-full overflow-hidden">
                      <img src={z.img} alt={z.name} class="w-full h-full object-cover" loading="lazy" decoding="async" />
                    </div>
                  </div>
                  <div class="flex-1 p-4 sm:p-4 flex flex-col">
                    <h3 class="font-heading font-bold text-base sm:text-lg text-navy mb-2 leading-tight" set:html={z.name} />
                    <details class="text-navy-dark text-xs sm:text-sm leading-relaxed group">
                      <summary class="list-none cursor-pointer marker:hidden">
                        <span set:html={z.summary} />
                        <span class="block mt-2 text-red-800 font-bold uppercase tracking-wider text-[10px] hover:text-red-900 group-open:hidden">Read more &rarr;</span>
                      </summary>
                      <div class="mt-2" set:html={z.description} />
                      <span class="block mt-2 text-red-800 font-bold uppercase tracking-wider text-[10px] hover:text-red-900 hidden group-open:inline-block cursor-pointer" onclick="this.closest('details').open = false">&larr; Show less</span>
                    </details>
                    <p class="mt-2 text-navy-dark/80 italic font-bold uppercase tracking-wider text-[10px]">
                      * Statesman&rsquo;s Pass entry only
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- ENTERTAINMENT LINEUP — 9 performer/attraction cards            -->
    <!-- ============================================================ -->
    <section class="py-12 sm:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10 sm:mb-12 max-w-5xl mx-auto">
          {/* Red divider above heading removed 2026-05-11 per Mike. */}
          <h2 class="font-body text-3xl sm:text-4xl md:text-5xl font-bold text-gold leading-tight tracking-tight mb-5">
            <span class="uppercase">Countdown 250 Lineup</span><span class="italic font-normal">&hellip; so far</span>
          </h2>
          <p class="text-white/85 text-base sm:text-lg leading-relaxed">
            Lineup will be updated daily as more performers and attractions are announced&hellip;
          </p>
        </div>

        <div class="space-y-5 sm:space-y-6">
          {performers.map((p) => (
            <div class={`${p.tier === "statesman" ? 'bg-gold border-gold' : 'bg-cream border-gold/30'} rounded-xl overflow-hidden border shadow-md flex flex-col sm:flex-row ${p.bioExpanded ? 'sm:min-h-56' : 'sm:h-56'}`}>
              {p.img ? (
                <div class="sm:w-72 sm:flex-shrink-0 bg-navy/50">
                  <div class="aspect-[4/3] sm:aspect-auto sm:h-full overflow-hidden">
                    <img src={p.img} alt={p.name} class={`w-full h-full ${p.imgFit ?? "object-cover"}`} loading="lazy" decoding="async" />
                  </div>
                </div>
              ) : (
                <div class="sm:w-72 sm:flex-shrink-0 bg-gradient-to-br from-navy-dark via-navy to-navy-light flex items-center justify-center aspect-[4/3] sm:aspect-auto">
                  <span class="text-gold/60 text-5xl font-heading italic">{p.name.charAt(0)}</span>
                </div>
              )}
              <div class={`flex-1 p-5 sm:p-6 flex flex-col ${p.bioExpanded ? '' : 'overflow-hidden'}`}>
                <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-3 leading-tight" set:html={p.name} />
                {p.bioExpanded ? (
                  <details class={`${p.tier === "statesman" ? 'text-navy-dark' : 'text-slate'} text-sm leading-relaxed group`}>
                    <summary class="list-none cursor-pointer marker:hidden">
                      <span set:html={p.bio} />
                      <span class={`block mt-2 ${p.tier === "statesman" ? 'text-red-800 hover:text-red-900' : 'text-red-700 hover:text-red-900'} font-bold uppercase tracking-wider text-xs group-open:hidden`}>Read more &rarr;</span>
                    </summary>
                    <div class="mt-3 space-y-3" set:html={p.bioExpanded} />
                    <span class={`block mt-3 ${p.tier === "statesman" ? 'text-red-800 hover:text-red-900' : 'text-red-700 hover:text-red-900'} font-bold uppercase tracking-wider text-xs hidden group-open:inline-block cursor-pointer`} onclick="this.closest('details').open = false">&larr; Show less</span>
                  </details>
                ) : (
                  <p class={`${p.tier === "statesman" ? 'text-navy-dark' : 'text-slate'} text-sm leading-relaxed line-clamp-4 sm:line-clamp-5`} set:html={p.bio} />
                )}
                {p.tier === "statesman" && (
                  <p class="mt-3 text-navy-dark/80 italic font-bold uppercase tracking-wider text-[11px] sm:text-xs">
                    * Statesman&rsquo;s Pass entry only
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>

        {/* Coming-soon teaser */}
        <div class="text-center mt-12 sm:mt-14">
          <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-2">
            More Announcements Coming Soon
          </p>
          <p class="text-white/85 text-base sm:text-lg max-w-2xl mx-auto">
            Headliner reveals, additional performers, and the full Tribute to America program will be announced in the coming weeks.
          </p>
        </div>
      </div>
    </section>

    <section class="py-10 sm:py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <p class="text-center text-white/60 text-xs sm:text-sm italic">
          * The entertainment lineup is subject to change.
        </p>
      </div>
    </section>

    {/* ============================================================ */}
    {/* YOUTUBE MODAL — reusable on-site video popup. Listens for     */}
    {/* clicks on any `.youtube-modal-trigger` element with a         */}
    {/* `data-yt-id` attribute (the YouTube video ID).                */}
    {/* ============================================================ */}
    <div id="yt-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/80 backdrop-blur-sm p-4 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="yt-modal-title" aria-hidden="true">
      <div class="relative w-full max-w-4xl bg-navy-dark rounded-2xl border-2 border-gold shadow-2xl overflow-hidden">
        <button id="yt-modal-close" type="button" aria-label="Close video" class="absolute top-2 right-2 sm:-top-4 sm:-right-4 z-10 bg-gold hover:bg-gold-light text-navy-dark rounded-full w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center font-bold text-2xl shadow-lg transition-all leading-none">
          &times;
        </button>
        <p id="yt-modal-title" class="px-5 py-3 border-b border-gold/30 text-gold font-heading font-bold text-sm sm:text-base text-center pr-12 sm:pr-5 truncate">Now Playing</p>
        <div class="relative w-full bg-black" style="aspect-ratio: 16 / 9;">
          <iframe id="yt-modal-iframe" class="absolute inset-0 w-full h-full" src="" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
      </div>
    </div>

  </main>

  <script>
    (function () {
      const modal = document.getElementById('yt-modal');
      const iframe = document.getElementById('yt-modal-iframe') as HTMLIFrameElement | null;
      const titleEl = document.getElementById('yt-modal-title');
      const closeBtn = document.getElementById('yt-modal-close');
      if (!modal || !iframe || !titleEl || !closeBtn) return;

      function openModal(id: string, title?: string) {
        if (!iframe || !modal || !titleEl) return;
        iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
        titleEl.textContent = title ?? 'Now Playing';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function closeModal() {
        if (!iframe || !modal) return;
        iframe.src = '';
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      document.querySelectorAll<HTMLAnchorElement>('.youtube-modal-trigger').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = btn.dataset.ytId;
          if (!id) return;
          e.preventDefault();
          e.stopPropagation();
          openModal(id, btn.dataset.ytTitle);
        });
      });

      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
      });
    })();
  </script>

  <Footer />
</BaseLayout>
