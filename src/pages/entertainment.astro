---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * ENTERTAINMENT PAGE (LIVE)
 * ----------------------------------------------------------------
 * Promoted from /entertainment-preview/ on 2026-05-08 after Mike's
 * sign-off. The preview page is preserved at /entertainment-preview/
 * (excluded from sitemap) for future iteration; both pages share
 * the same data structure so edits made on preview can be promoted
 * here in one shot.
 *
 * Major sections:
 *   - Hero (16:9 stage + crowd photo)
 *   - "A celebration for the ages!" intro copy
 *   - Non-Stop Entertainment gold callout
 *   - "7 Party Zones * 4 Stages" — 2-column compact zone grid
 *     (left: Open to All; right: Statesman's Pass with gold cards)
 *   - "Countdown 250 Lineup… so far" — performer/attraction cards (count grows as additions land)
 *     (Bob Anderson, MARCEY, Julian Awari, Deebo, DJ Freedom,
 *      Live Broadcast, Midnight Countdown, Heroes Awards, Tribute
 *      to America, Roving Entertainers)
 *   - Reusable YouTube modal (Bob Anderson's "House I Live In" video)
 */

const zones = [
  // ---- Open to ALL guests ----
  {
    tier: "all",
    name: "All-American Hero Ballroom",
    img: "/images/event/zone-hero-ballroom.jpg",
    summary: "Non-stop programming from 7 PM to 1 AM &mdash; top-notch bands &amp; DJs, patriotic performers, the Hero Awards, the midnight countdown, and a closing set from MARCEY.",
    description: "From 7 PM until 1 AM, the main stage delivers non-stop, can&rsquo;t-miss programming &mdash; top-notch bands and DJs, a powerful program of patriotic performers, the inaugural All-American Heroes Lifetime Achievement Awards, and the signature midnight countdown to America&rsquo;s 250th. The night closes with a final celebration set from MARCEY.",
  },
  {
    tier: "all",
    name: "Decades Dance Club",
    img: "/images/event/dj-party-lights.jpg",
    summary: "70s, 80s, 90s, and 2000s hits all night long.",
    description: "Disco lights, retro vibes, and four decades of crowd-favorite hits, mixed by a high-energy DJ who keeps the floor moving from Donna Summer to Beyoncé.",
  },
  {
    tier: "all",
    name: "Club 250",
    img: "/images/event/zone-club-250.jpg",
    summary: "Modern dance club with today&rsquo;s top hits and club bangers.",
    description: "Modern dance club for current chart hits, EDM, and high-energy club music. Cinematic lighting, immersive sound, and a packed dance floor all night long.",
  },
  {
    tier: "all",
    name: "Space Blue Interactive Zone",
    img: "/images/space-blue/lunaprise-overview.jpg",
    summary: "A Space Blue showcase &mdash; the Lunaprise Lunar Museum, lifelike hologram-style exhibits of iconic American historical figures (speeches and selfies included), lunar art collectibles, and a silent charity auction &mdash; plus the paparazzi photo experience, Studio 250 interview area, and roving entertainers.",
    description: "A one-of-a-kind interactive experience anchored by Space Blue &mdash; the team behind the Lunaprise lunar time capsule that landed on the Moon. The Zone features the Lunaprise Lunar Museum, lifelike hologram-style exhibits bringing pivotal American moments and iconic speeches to life, the chance to grab a selfie alongside historical figures, certified lunar art collectibles, and an exclusive silent charity auction of iconic American art benefitting American heroes. Plus the paparazzi photo experience, the Studio 250 interview area, and roving entertainers throughout the night.",
  },
  // ---- Statesman's Pass EXCLUSIVE ----
  {
    tier: "statesman",
    name: "The Statesman&rsquo;s Reserve",
    img: "/images/event/elegant-dinner-flags.png",
    summary: "Exclusive reserved-seating area for Statesman&rsquo;s Pass holders with premium food, beverage, and a bird&rsquo;s-eye view of the main stage.",
    description: "An exclusive area for Statesman&rsquo;s Pass holders featuring reserved seating, premium food and beverage service, top-shelf bar, and a bird&rsquo;s-eye view of the main stage.",
  },
  {
    tier: "statesman",
    name: "Presidents Walk",
    img: "/images/event/zone-presidents-walk.jpg",
    summary: "Hidden corridor lined with portraits of every U.S. President and First Lady &mdash; the private passage used by 100+ sitting Presidents.",
    description: "Tucked behind the International Ballroom runs one of Washington&rsquo;s most quietly historic corridors &mdash; the private passageway built into the Washington Hilton&rsquo;s 1965 blueprints to give visiting Presidents a protected route in and out of the building. The walls are lined with portraits of every U.S. President and First Lady, sourced from the Library of Congress. Complimentary guided tours of the Walk and other dignitaries-only spaces will be offered throughout the evening.",
  },
  {
    tier: "statesman",
    name: "Speakeasy Lounge",
    img: "/images/event/zone-speakeasy.jpg",
    summary: "Speakeasy-styled hidden lounge with classic cocktails and vintage ambience.",
    description: "A speakeasy-styled hidden lounge with classic cocktails, vintage music, and intimate ambience. Reserved for Statesman&rsquo;s Pass holders only.",
  },
];

// Entertainment Lineup — Bob Anderson at top per Mike (2026-05-08).
const performers = [
  {
    name: "Rock Legends Trio Jam",
    role: "Scott Page, Gerardo Velez &amp; Larry Dvoskin &mdash; First Time On Stage Together. Ever.",
    img: "/images/event/rock-legends-jam.svg",
    imgFit: "object-cover",
    tier: "featured",
    bio: "<em class='block mb-3 text-red-700 not-italic font-extrabold uppercase tracking-[0.3em] text-xs'>&#9733; Holy Smokes &mdash; This Is Amazing &#9733;</em><strong class='text-navy text-base sm:text-lg block mb-3 leading-snug'>Three rock legends. One stage. For the first time ever. And almost certainly the last.</strong>For one night only, three of rock and roll&rsquo;s most accomplished musicians take the same stage for the first time in history. <strong>Scott Page</strong> (Pink Floyd, Supertramp, Toto), <strong>Gerardo Velez</strong> (Jimi Hendrix, Spyro Gyra), and <strong>Larry Dvoskin</strong> (Robert Plant, The Beach Boys, Journey, MGMT) come together at the Countdown 250 Ball for an exclusive collaborative performance during America&rsquo;s Independence Eve celebration.",
    bioExpanded: "<p>Between them, this trio has performed with, recorded with, or collaborated with <strong>some of the most influential names in the history of modern music</strong> &mdash; Pink Floyd, Jimi Hendrix, Robert Plant, Sammy Hagar, Bad Company, Cheap Trick, The Beach Boys, Toto, Supertramp, MGMT, Journey, Spyro Gyra, and Bow Wow Wow. A list that reads like a Rock and Roll Hall of Fame roll call.</p><p><strong>Scott Page</strong> toured the world with Pink Floyd on <em>A Momentary Lapse of Reason</em> and <em>Delicate Sound of Thunder</em> &mdash; some of the highest-grossing concerts of the era. He recorded and toured with Supertramp on <em>Brother Where You Bound</em> and brought his signature sound to Toto and a long arc of rock&rsquo;s most celebrated acts.</p><p><strong>Gerardo Velez</strong> is a master percussionist who performed with Jimi Hendrix &mdash; placing him inside one of the defining sounds of the era. He was a founding rhythmic voice in the jazz-fusion ensemble Spyro Gyra, helping define what jazz fusion could be, and has collaborated for five decades across rock, jazz, and world music.</p><p><strong>Larry Dvoskin</strong> is an award-winning producer, songwriter, keyboardist, and recording artist whose collaborators include Robert Plant, Sammy Hagar, Bad Company, Robin Zander of Cheap Trick, Al Jardine of The Beach Boys, MGMT, Neal Schon of Journey, and Desir&eacute;e &lsquo;Des&rsquo; Annabella Lwin of Bow Wow Wow.</p><p>They have <strong>never performed together as a trio</strong>. And after Countdown 250, they may never perform together again. This is the kind of moment that only happens when a national milestone &mdash; America&rsquo;s historic Semiquincentennial &mdash; brings extraordinary people into the same room at the same time.</p><p>&ldquo;Scott, Gerardo, and Larry have each helped shape the soundtrack of generations,&rdquo; said Mike Harrigan, Founder and Executive Producer of Countdown 250. &ldquo;Seeing them perform together on one stage during America&rsquo;s historic Semiquincentennial celebration is something our guests will never forget.&rdquo;</p>",
  },
  {
    name: "Bob Anderson",
    role: "American Icon &amp; World&rsquo;s Greatest Singing Impressionist",
    img: "/images/event/bob-anderson.jpg",
    bio: "<em class='block mb-3 text-navy/80 not-italic font-semibold uppercase tracking-wider text-xs'>American Icon and the World&rsquo;s Greatest Singing Impressionist</em>Bob Anderson&rsquo;s career began with the kind of only-in-Las-Vegas moment that becomes legend. A Vietnam veteran from a musical family of six brothers known as &ldquo;The Detroit Osmonds,&rdquo; Anderson arrived in Las Vegas in his early twenties and, within hours, found himself on stage at the famed Sahara Hotel &amp; Casino. What began as an unexpected opportunity to sing with Nancy Sinatra quickly led to an appearance on The Merv Griffin Show, where his remarkable ability to recreate the voices of the world&rsquo;s greatest singers brought him national attention.<br /><a href='https://youtu.be/iGRT3H-XDkM' target='_blank' rel='noopener noreferrer' class='youtube-modal-trigger inline-flex items-center justify-center gap-2 mt-4 bg-navy-dark hover:bg-navy border-2 border-gold text-gold hover:text-gold-light px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider transition-all rounded-lg shadow-md hover:shadow-lg hover:-translate-y-0.5 no-underline' data-yt-id='iGRT3H-XDkM' data-yt-title='Bob Anderson &mdash; &ldquo;The House I Live In&rdquo;'><span class='text-gold'>&#9654;</span> Listen to Bob Anderson&rsquo;s &ldquo;The House I Live In&rdquo;</a>",
    bioExpanded: "Over the next five decades, Anderson became one of the most sought-after entertainers on the Las Vegas Strip, performing in every major casino showroom and earning acclaim for his extraordinary recreations of legendary vocalists, including his celebrated tribute to Frank Sinatra. His career has included performances for two U.S. Presidents, the Royal Family, and audiences at Carnegie Hall, where his Sinatra performance earned multiple standing ovations.<br /><br />Inducted into both the Casino Legends Hall of Fame and the Las Vegas Entertainers Hall of Fame, Bob Anderson has been hailed by <em>People</em> Magazine as &ldquo;America&rsquo;s Greatest Singing Impressionist,&rdquo; praised by Simon Cowell as the best on the planet, and summed up best by Frank Sinatra himself: &ldquo;Bob Anderson has a hell of an act.&rdquo;",
  },
  {
    name: "Lee Greenwood",
    role: "All-American Icon Honoree &mdash; Performing &ldquo;God Bless the USA&rdquo;",
    img: "/images/event/lee-greenwood-hero.jpg",
    bio: "Lee Greenwood will be honored with the All-American Icon Award and take the stage for a special performance of his signature anthem, &ldquo;God Bless the USA&rdquo; &mdash; the song that has served as an unofficial anthem of American patriotism for more than four decades.",
    bioExpanded: "<p>A Grammy-winning singer-songwriter and member of the Grand Ole Opry, Greenwood released &ldquo;God Bless the USA&rdquo; in 1984. It became one of the most-played patriotic songs in American history &mdash; resurging powerfully after September 11, 2001 and remaining a defining sound of national pride at inaugurations, military ceremonies, and civic events across the country.</p><p>Over a career spanning more than four decades, he has performed for every U.S. President since Ronald Reagan and become one of the most visible champions of America&rsquo;s veterans and active military, recognized for a lifetime of service to military families.</p>",
  },
  {
    name: "Celeste Kellogg",
    role: "Country Music&rsquo;s Rising Star &mdash; Award-Winning Singer, Songwriter &amp; Actress",
    img: "/images/event/celeste-kellogg.jpg",
    bio: "Celeste Kellogg is one of country music&rsquo;s hottest rising stars &mdash; an award-winning, Nashville-based singer, songwriter, and actress whose powerful voice, magnetic stage presence, and heartfelt storytelling are captivating audiences across the country.",
    bioExpanded: "<p>Blending modern country with the energy of 90s and 2000s pop and the grit of 70s and 80s rock, Kellogg brings a fresh, dynamic sound to today&rsquo;s country music scene. Her singles &ldquo;Country Swagger&rdquo; and &ldquo;There&rsquo;s a Beach Somewhere&rdquo; have been featured on Spotify and CMT playlists and charted on the Music Row Country Airplay charts. She has also shared the stage with major artists including Miley Cyrus, Kelly Clarkson, and Brett Eldredge.</p><p>At the Countdown 250 Ball, Kellogg will bring her passion, patriotism, and unmistakable voice to America&rsquo;s most anticipated Independence Eve celebration. One of the evening&rsquo;s most meaningful musical moments will come when she performs her original patriotic anthem, &ldquo;Faith in Freedom&rdquo; &mdash; a powerful song inspired by her belief that America&rsquo;s strength is found in faith, freedom, courage, truth, and the willingness to love one another across our differences.<br /><a href='https://youtu.be/Z7GX-AVK11Y' target='_blank' rel='noopener noreferrer' class='youtube-modal-trigger inline-flex items-center justify-center gap-2 mt-4 bg-navy-dark hover:bg-navy border-2 border-gold text-gold hover:text-gold-light px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider transition-all rounded-lg shadow-md hover:shadow-lg hover:-translate-y-0.5 no-underline' data-yt-id='Z7GX-AVK11Y' data-yt-title='Celeste Kellogg &mdash; &ldquo;Faith in Freedom&rdquo;'><span class='text-gold'>&#9654;</span> Listen to Celeste Kellogg&rsquo;s &ldquo;Faith in Freedom&rdquo;</a></p><p>With appearances across the country, a scheduled Main Stage performance at the Great American State Fair in Washington, D.C., and a growing reputation as one of country music&rsquo;s most exciting young voices, Celeste Kellogg is poised to deliver a performance worthy of America&rsquo;s historic 250th birthday celebration.</p>",
  },
  {
    name: "Scott Page",
    role: "Saxophonist &amp; Renowned Artist &mdash; Pink Floyd, Supertramp, Toto",
    img: "/images/event/scott-page.jpg",
    bio: "Scott Page is one of rock&rsquo;s most influential and revered musicians &mdash; a saxophonist and celebrated artist whose revolutionary sound and trailblazing creative instincts have helped shape some of the greatest tours and recordings in music history. He toured the world with Pink Floyd on the era-defining <em>A Momentary Lapse of Reason</em> and <em>Delicate Sound of Thunder</em> world tours, recorded and toured with Supertramp on <em>Brother Where You Bound</em>, and has brought his signature sound to Toto and a long list of rock&rsquo;s most celebrated acts.",
    bioExpanded: "<p>Scott Page&rsquo;s career has been one continuous arc through some of the most important moments in modern rock. As Pink Floyd&rsquo;s saxophonist on the <em>A Momentary Lapse of Reason</em> world tour (1987&ndash;1988) and the subsequent <em>Delicate Sound of Thunder</em> tour, he performed on some of the highest-grossing concerts of the era &mdash; his solos captured forever on the live recordings and films that defined a generation of arena rock.</p><p>His collaboration with Supertramp on the 1985 <em>Brother Where You Bound</em> album and the accompanying World Tour cemented his place among rock&rsquo;s most in-demand touring saxophonists. He has also brought his signature sound to Toto and a long list of legendary acts &mdash; the kind of breadth that makes him not just a great musician but a voice that has helped shape how a generation of rock and roll sounds.</p><p>Beyond music, Scott is a renowned artist and creative force whose work and instincts have reached far beyond the stage. From traditional visual art to the cutting edge of multimedia and digital experience, he has built a body of work that has inspired generations of musicians, artists, and creators &mdash; and put him at the front of many of the most important conversations in modern entertainment.</p><p>We are thrilled to welcome Scott Page to the Countdown 250 Ball. His musicianship, artistry, and unmistakable energy will help make America&rsquo;s 250th birthday celebration truly unforgettable.</p>",
  },
  {
    name: "Gerardo Velez",
    role: "Renowned Percussionist &mdash; Jimi Hendrix, Spyro Gyra",
    img: "/images/event/singer-flag-screen.jpg",
    bio: "Gerardo Velez is a master percussionist whose career has carried him through some of the most influential moments in modern music. He performed with Jimi Hendrix, became a founding rhythmic voice in the jazz-fusion ensemble Spyro Gyra, and has collaborated with legendary artists across rock, jazz, and world music.",
    bioExpanded: "<p>Velez&rsquo;s instinct for rhythm has put him on stage and in studios with some of the most innovative musicians of the past five decades. His work with Jimi Hendrix placed him inside one of the defining sounds of the era, and his role in shaping Spyro Gyra&rsquo;s groundbreaking sound helped define what jazz fusion could be.</p><p>At Countdown 250, he joins fellow rock legends Scott Page and Larry Dvoskin for a once-in-a-lifetime trio performance &mdash; bringing the same fire, precision, and joy that has earned him the respect of his peers across genres for generations.</p>",
  },
  {
    name: "Larry Dvoskin",
    role: "Award-Winning Producer, Songwriter &amp; Keyboardist &mdash; Robert Plant, Beach Boys, Journey",
    img: "/images/event/piano-player.jpg",
    bio: "Larry Dvoskin is an award-winning producer, songwriter, keyboardist, and recording artist whose collaborators read like a Rock and Roll Hall of Fame roll call. He has worked with Robert Plant, Sammy Hagar, Bad Company, Robin Zander of Cheap Trick, Al Jardine of The Beach Boys, MGMT, Neal Schon of Journey, and Desir&eacute;e &lsquo;Des&rsquo; Annabella Lwin of Bow Wow Wow.",
    bioExpanded: "<p>Across his career, Dvoskin has built a reputation as one of the music industry&rsquo;s most versatile creative forces &mdash; a producer, songwriter, and musician who is equally at home behind the keyboard, in the studio, or shaping records for some of rock&rsquo;s most enduring voices. His collaboration list is staggering in both depth and breadth: from arena rock royalty (Plant, Schon, Hagar, Cheap Trick) to classic Americana (Beach Boys, Bad Company) to modern alternative artists (MGMT) to genre-defining new wave (Bow Wow Wow).</p><p>At Countdown 250, he joins Scott Page and Gerardo Velez for an exclusive trio performance &mdash; the first time the three have ever shared a stage. With his trademark fluency across rock, soul, and pop, Dvoskin will bring a creative spark to a collaboration built for once-in-a-generation moments.</p>",
  },
  {
    name: "MARCEY",
    role: "DJ &amp; Producer",
    img: "/images/event/dj-marcey.jpg",
    bio: "MARCEY is a Washington, D.C. based DJ and producer known for delivering high-energy sets that blend underground grit with mainstream appeal. He has established a strong presence in the D.C. dance music scene, performing at top venues including Echostage, The Anthem, Soundcheck, and Zebbie&rsquo;s Garden.",
    bioExpanded: "MARCEY has also supported major artists such as Martin Garrix, D.O.D, Ian Asher, and Matt Sassari &mdash; further solidifying his position as a rising act. With additional performances across the East Coast &mdash; including New York City, Tampa, and Fort Lauderdale &mdash; MARCEY continues to build momentum, driven by a passion to recreate the same energy and emotion that first drew him to dance music.<br /><br /><a href='https://www.instagram.com/marcey.mp3' target='_blank' rel='noopener noreferrer' class='inline-block text-red-700 font-bold uppercase tracking-wider text-xs hover:text-red-900'>Follow MARCEY on Instagram &rarr;</a>",
  },
  {
    name: "Julian Awari",
    role: "National Anthem",
    img: "/images/event/julian-awari.jpg",
    bio: "Air Force veteran and powerhouse vocalist. Performs the National Anthem to open the evening&rsquo;s program &mdash; a signature moment that sets the tone for the entire night.",
  },
  {
    name: "Deebo",
    role: "Open-Format DJ",
    img: "/images/event/deebo.jpg",
    bio: "Deebo is a wildly popular, high-energy, open-format DJ known for blending hip-hop, house, Afrobeat, EDM, Latin, Jersey club, and throwback hits into nonstop crowd-driven sets. From college parties and packed club nights to private events and major weekend celebrations, he has built a reputation for reading the crowd and keeping the energy at its peak all night long.",
    bioExpanded: "Known for smooth transitions, creative mixes, and strong stage presence, Deebo brings a unique vibe to every performance. He started his DJ career in early college, quickly gaining notoriety for his energy and creativity. Focused on building a name through consistency, passion, and high-level energy, he continues to grow as one of the East Coast&rsquo;s fastest-rising DJs &mdash; delivering sets that keep people moving from start to finish.",
  },
  {
    name: "DJ Tharp",
    role: "High-Energy Dance Club DJ",
    img: "/images/misc/dj-cartoon.jpg",
    bio: "DJ Tharp will be spinning the hottest dance tunes of today &mdash; packing the floor and keeping the energy at its peak all night long. A veteran of the All-American Inaugural Ball, DJ Tharp is known for reading the crowd, dropping crowd-driven mixes, and turning dance floors into the centerpiece of the celebration.",
  },
  {
    name: "U.S. Army Captain Luis Avila",
    role: "&ldquo;God Bless America&rdquo;",
    img: "/images/event/luis-avila.jpg",
    bio: "U.S. Army Captain Luis Avila is a decorated combat-wounded warrior and one of America&rsquo;s most powerful patriotic vocalists, whose performance of &ldquo;God Bless America&rdquo; will be one of the most stirring moments of the evening. Captain Avila is known nationally for his rendition of &ldquo;God Bless America&rdquo; alongside Ren&eacute;e Fleming and the National Symphony Orchestra at the 2017 Memorial Day Capital Concert, and has now performed more than 100 times in support of America&rsquo;s military and veterans.",
    bioExpanded: "Captain Avila joined the United States Army in 2000 and was commissioned in 2004. As a Military Police Officer he completed five combat tours &mdash; Operation Noble Eagle, three tours in Operation Iraqi Freedom, and Operation Enduring Freedom in Afghanistan. On December 27, 2011, an IED explosion ended his combat career and began an extraordinary journey of recovery and service. The blast cost him his left leg, caused two heart attacks and two strokes, and left him with an anoxic and traumatic brain injury and near-total paralysis. Pronounced dead three times, he could not speak for more than three years &mdash; and today, through music, speech, physical, and occupational therapy, he continues to recover, perform, and inspire.<br /><br />His voice has become one of America&rsquo;s most powerful patriotic instruments. He has performed at the National Intrepid Center of Excellence at Walter Reed, the Supreme Court, the U.S. Capitol, and at memorials, galas, and ceremonies across the country, alongside the Army, Air Force, and Marine Corps bands. He is a recipient of the Bronze Star, the Purple Heart, and The Order of the Marechaussee in Silver. He was a member of Team Army at the 2024 DOD Warrior Games (five gold medals and one bronze) and joined Team USA at the 2025 Invictus Games. Captain Avila lives in Maryland with his family and continues his rehabilitation at Walter Reed National Military Medical Center in Bethesda.",
  },
  {
    name: "Studio 250",
    role: "Media Interviews &amp; On-Camera Coverage",
    img: "/images/event-photos/buzz-aldrin-aab-2017.jpg",
    bio: "Inside the Space Blue Interactive Zone, Studio 250 is where the night&rsquo;s most memorable conversations happen. Press, hosts, and content creators interview guests, dignitaries, and honorees throughout the evening &mdash; capturing the candid stories of America&rsquo;s 250th celebration. Select moments will be filmed and may be broadcast or streamed to viewers around the country.",
  },
  {
    name: "Midnight Countdown to America&rsquo;s 250th",
    role: "The Signature Moment",
    img: "/images/event/countdown-toast.jpg",
    bio: "The signature moment of the evening. At the stroke of midnight, America&rsquo;s Freedom Bell &mdash; the iconic &ldquo;Bell of the Ball,&rdquo; fresh off its historic cross-country journey to Washington &mdash; will ring out from the heart of the ballroom and lead the &ldquo;1,000 Bells of Freedom,&rdquo; joined by a chorus of small commemorative bells rung by guests throughout the room. Patriotic music, cascading lights, and a dazzling spectacle of red, white, and blue mark the exact instant America enters its 250th year &mdash; the midnight celebration of our lifetime.",
  },
  {
    name: "All-American Heroes Lifetime Achievement Awards",
    role: "Awards Ceremony",
    img: "/images/event/hero-medal-presentation.jpg",
    bio: "Inaugural presentation of the All-American Heroes Lifetime Achievement Awards, recognizing extraordinary Americans whose courage, leadership, and selfless service have strengthened our nation. A live ceremony in the All-American Hero Ballroom.",
  },
  {
    name: "All-American Icon Awards",
    role: "Awards Ceremony",
    img: "/images/misc/all-amer-icon-medal.png",
    imgFit: "object-contain",
    bio: "Inaugural presentation of the All-American Icon Awards, honoring iconic Americans whose achievements, talent, and influence have helped shape the American story. 2026 honorees include legendary entertainer Tony Orlando, vocal impressionist Bob Anderson, patriotic music icon Lee Greenwood, renowned saxophonist Scott Page (Pink Floyd, Supertramp), Olympic and World wrestling champion Jordan Burroughs, and National Wrestling Coaches Association Executive Director Mike Moyer.",
  },
  {
    name: "Tribute to America &mdash; 250 Years",
    role: "Featured Performance",
    img: "/images/event/color-guard.jpg",
    bio: "An original Tribute to America featuring The Sicilian Tenors, a color guard processional, and a multi-decade musical journey through 250 years of American history. Performed once in the evening.",
  },
  {
    name: "Roving Entertainers &amp; Immersive Experiences",
    role: "Roaming Throughout the Night",
    img: "/images/event/roving-entertainers-patriotic.jpg",
    bio: "Throughout the night, an array of entertaining and mesmerizing performers &mdash; costumed characters, magicians, mentalists, dancers, living statues, and more &mdash; will be dazzling guests across the massive ballroom complex. Every corner of the venue comes alive with surprise, spectacle, and wonder.",
  },
];

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
---

<BaseLayout
  title="Entertainment | The Official Countdown 250 Ball — July 3, 2026, Washington Hilton"
  description="7 entertainment areas, 4 stages, headline performers including Bob Anderson, MARCEY, Julian Awari, and Deebo, the All-American Heroes Lifetime Achievement Awards, and a once-in-a-generation midnight countdown to America's 250th. Washington Hilton, DC. July 3, 2026. Get tickets!"
  ogImage="/images/event/header-entertainment-stage-crowd.jpg"
>
  <Navbar />

  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >

    <!-- ============================================================ -->
    <!-- HERO -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-entertainment-stage-crowd.jpg"
          alt="A live band performing on stage with cascading purple and gold light streamers, the lead vocalist at center mic, and the audience silhouetted in the foreground"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              Entertainment
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- INTRO -->
    <!-- ============================================================ -->
