---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Live Entertainment | America's Biggest 250th Anniversary Gala | Countdown 250 Ball Washington DC" description="4 stages, 6 party zones & world-class performers at America's Ball — the biggest July 4th celebration ever. Washington Hilton, DC. July 3, 2026. Get tickets!" ogImage="/images/event/diverse-live-band.png">
  <Navbar />
  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >
    <!-- Hero — canonical image-led pattern (concert stage + crowd photo).
         Same image used on entertainment-preview. Hero ONLY swap per Mike;
         body content below is unchanged until preview content is finalized. -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-entertainment-stage-crowd.jpg"
          alt="A live band performing on stage with cascading purple and gold light streamers, the lead vocalist at center mic, and the audience silhouetted in the foreground"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>
        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              Entertainment
            </h1>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 ">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <!-- Eyebrow (moved here from the hero overlay 2026-05-06 when
             the hero adopted the image-led pattern). -->
        <p class="text-white font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-8">
          Bands, DJs & Performers
        </p>

        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-gold mb-6 font-heading">A Night of Unforgettable Entertainment</h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-white/70 text-lg leading-relaxed space-y-6 mb-16">
          <p>
            The All-American Countdown 250 Ball will feature a spectacular lineup of live entertainment
            across <strong class="text-gold">4 stages</strong> and <strong class="text-gold">6 party zones</strong> —
            ensuring an electrifying atmosphere from the moment you arrive until the final note at 1 AM.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 mb-16">
          <div class="bg-cream rounded-xl p-6">
            <div class="text-3xl mb-3">🎵</div>
            <h3 class="text-lg font-bold text-navy mb-2">Multiple Live Bands</h3>
            <p class="text-slate/60 text-sm">Top-tier bands performing across multiple stages throughout the evening.</p>
          </div>
          <div class="bg-cream rounded-xl p-6">
            <div class="text-3xl mb-3">🎧</div>
            <h3 class="text-lg font-bold text-navy mb-2">DJs & Dance Floors</h3>
            <p class="text-slate/60 text-sm">High-energy DJs keeping the dance floors packed all night long.</p>
          </div>
          <div class="bg-cream rounded-xl p-6">
            <div class="text-3xl mb-3">🎭</div>
            <h3 class="text-lg font-bold text-navy mb-2">Immersive Experiences</h3>
            <p class="text-slate/60 text-sm">Roaming entertainers and immersive performances creating unforgettable moments.</p>
          </div>
          <div class="bg-cream rounded-xl p-6">
            <div class="text-3xl mb-3">🇺🇸</div>
            <h3 class="text-lg font-bold text-navy mb-2">Tribute to America</h3>
            <p class="text-slate/60 text-sm">Stirring patriotic performances honoring 250 years of American history.</p>
          </div>
        </div>

        <div class="bg-navy rounded-2xl p-10 text-center">
          <svg class="w-12 h-12 text-gold mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
          <h3 class="text-xl font-bold text-gold mb-3">Major Announcements Coming Soon</h3>
          <p class="text-white/70 text-lg mb-6">
            We are finalizing an extraordinary entertainment lineup. Performer announcements will be made in the coming weeks.
          </p>
          <p class="text-white/40 text-sm">Follow us on social media and check our <a href="/updates/" class="text-gold hover:text-gold/80 underline">News & Updates</a> page for the latest announcements.</p>
        </div>

        {/* Removed page-level 'Get Your Tickets' button — the Footer's
            larger 'Get Tickets' CTA appears right below this section
            already, so the page-level button was duplicate stacking. */}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
