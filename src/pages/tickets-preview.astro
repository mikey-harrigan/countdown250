---
// PREVIEW PAGE — NOT LIVE.
// Draft of the future /tickets/ page. Mike to review before promoting.
// Excluded from the sitemap via astro.config.mjs filter so search
// engines won't index it. Not linked from the navbar.
//
// Source content: ported verbatim from the home page's
// '<section id="tickets">' block (src/pages/index.astro lines 636-792)
// and the supporting `tickets` data array (lines 35-138). When this
// page is approved we'll either:
//   (a) rename to tickets.astro for live URL /tickets/, OR
//   (b) keep this preview file as the new live page (and add the nav
//       link + remove from sitemap exclusion).
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";

// Identical copy of the home page tickets array.
const tickets = [
  {
    name: "Liberty Ticket",
    time: "The Ball: 9 PM – 1 AM",
    originalPrice: "$195",
    price: "$225",
    futurePrice: "$350 / $500",
    id: "ticket-liberty",
    description: "Celebrate the Ball in classic style.",
    sections: [
      {
        heading: "Includes The Ball (9 PM – 1 AM)",
        items: [
          "Admission to the main Ball",
          "<strong>Unforgettable Midnight Countdown</strong>",
          "4 grand ballrooms & 3 dance floors",
          "Open bar all night",
          "Multiple live bands and DJs",
          "Immersive experiences, roaming entertainers & step-and-repeat",
          "Patriotic Tribute & All-American Hero Lifetime Achievement Awards Ceremony",
        ],
      },
    ],
    highlight: false,
    badge: "Tier 1",
    tier: 1,
  },
  {
    name: "Patriot VIP Ticket",
    time: "VIP Reception + Ball: 7 PM – 1 AM",
    originalPrice: "$395",
    price: "$450",
    futurePrice: "$700 / $1,000",
    id: "ticket-patriot-vip",
    description: "Early access, dinner, and a more elevated evening from start to finish (6:30 PM – 1 AM).",
    inheritsFrom: "Liberty Ticket",
    sections: [
      {
        heading: "Plus the Exclusive VIP Reception (7 PM – 9 PM), which features:",
        items: [
          "Early entry beginning at 6:30 PM",
          "Buffet dinner",
          "Premium open bar",
          "Mingle with honored guests, dignitaries, and All-American Heroes",
          "Live entertainment",
          "Immersive experiences",
          "Roving entertainers",
          "Step & repeat",
        ],
      },
    ],
    highlight: false,
    badge: "Tier 2",
    tier: 2,
  },
  {
    name: "Statesman's Concierge Pass",
    time: "Premier Luxury: 7 PM – 1 AM",
    originalPrice: "$1,495",
    price: "$1,700",
    futurePrice: "$3,000 / $5,000",
    id: "ticket-statesmans",
    description: "The Pinnacle Experience at VIP Reception and Ball — Elevated with Exclusive Access, Concierge Service, Personal Recognition, Official Event Gifts, and more.",
    inheritsFrom: "Patriot VIP Ticket",
    sectionIntro: "Plus These Elite Upgrades:",
    sections: [
      {
        heading: "Private Service – All Night",
        items: [
          "Personal ambassador/concierge",
          "Top-shelf open bars & premium cuisine",
        ],
      },
      {
        heading: "Exclusive Access – All Night",
        items: [
          "Reserved VIP seating with special guests",
          "Backstage access",
          "3 additional hospitality/entertainment areas",
          "Historic spaces reserved for POTUS & dignitaries",
        ],
      },
      {
        heading: "Personal Recognition",
        items: [
          "Main Stage announcements",
          "Named in official event program",
        ],
      },
      {
        heading: "Official Event Gifts",
        items: [
          "Limited-edition premium event gift",
          "Statesman's Concierge Pass lanyard",
          "Commemorative event program",
        ],
      },
    ],
    note: "Extremely limited. Expected to sell out.",
    highlight: true,
    badge: "Most Popular Premium Option",
    tier: 3,
  },
];
---

<BaseLayout
  title="Tickets — DRAFT PREVIEW | Countdown 250 Ball"
  description="PREVIEW — draft of the /tickets/ page. Three ticket options for The Official Countdown 250 Ball. NOT LIVE."
  ogImage="/images/event/hero-countdown250-toast.jpg"
>
  <Navbar />

  <!-- Internal preview banner so this is never confused with a live page -->
  <div class="bg-gold/15 border-b border-gold/40 text-navy py-2.5 text-center text-xs">
    <p class="font-semibold tracking-wide">
      DRAFT PREVIEW &middot; tickets sub-page. Not linked from nav. Not indexed. Live tickets section is at
      <a href="/#tickets" class="underline hover:text-red ml-1">/#tickets</a>
    </p>
  </div>

  <main>

    <!-- Top spacer so we're not flush with the fixed navbar (~108 px including the new event-identity bar). -->
    <div class="bg-navy pt-28 sm:pt-32"></div>

    <!-- ============================================================ -->
    <!-- PAGE HEADER                                                  -->
    <!-- ============================================================ -->
    <section class="bg-navy text-white pb-2">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-gold/90 font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-3">
          Get Tickets
        </p>
        <p class="font-heading italic font-light text-2xl sm:text-3xl text-white/85 mb-4">
          The Official Countdown 250 Ball
        </p>
        <p class="text-white/70 text-sm sm:text-base max-w-2xl mx-auto">
          July 3, 2026 &middot; Washington Hilton &middot; Washington, D.C.
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- TICKETS — ported verbatim from src/pages/index.astro #tickets -->
    <!-- ============================================================ -->
    <section id="tickets" class="scroll-mt-32 pt-4 pb-px sm:pt-5 sm:pb-px bg-navy text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-14">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6 font-heading">Three Ticket Options</h2>
          <div class="w-20 h-1 bg-red mx-auto mb-6"></div>
          <p class="text-gold/80 text-sm max-w-xl mx-auto mb-2 font-medium">
            &#9733; Proceeds help support <a href="https://www.operationrenewedhopefoundation.org" target="_blank" rel="noopener noreferrer" class="underline hover:text-gold">Operation Renewed Hope Foundation</a> in their mission to house U.S. Veterans and end veteran homelessness.
          </p>
        </div>

        <!-- Tier indicator -->
        <div class="flex items-center justify-center gap-0 mb-12 max-w-4xl mx-auto">
          <div class="flex-1 h-1 bg-white/20 rounded-l-full"></div>
          {[1, 2, 3].map(() => (
            <div class="flex flex-col items-center mx-2 sm:mx-4">
              <div class="w-4 h-4 rounded-full border-2 bg-gold border-gold"></div>
            </div>
          ))}
          <div class="flex-1 h-1 bg-white/20 rounded-r-full"></div>
        </div>

        <!-- 3-column ticket grid (md+); stacks on mobile -->
        <div class="grid md:grid-cols-3 gap-6 sm:gap-8 lg:gap-10 mb-14 items-start">
          {tickets.map((ticket) => (
            <div id={ticket.id} class={`relative rounded-2xl overflow-hidden flex flex-col h-full transition-transform ${
              ticket.highlight
                ? 'bg-white text-slate ring-4 ring-gold shadow-[0_20px_60px_-15px_rgba(197,164,78,0.55)]'
                : 'bg-white/[0.04] border-2 border-white/15 text-white shadow-xl'
            }`}>
              {/* Tier header bar */}
              <div class={`py-2.5 text-center text-[11px] sm:text-xs font-bold tracking-widest uppercase ${
                ticket.highlight ? 'bg-gold text-navy-dark' : 'bg-white/10 text-white/60'
              }`}>
                {ticket.badge}
              </div>

              <div class="p-6 sm:p-7 flex flex-col flex-grow">
                {/* Time + Name */}
                <div class="mb-4">
                  <p class={`text-[11px] font-medium tracking-wider uppercase mb-2 ${ticket.highlight ? 'text-slate/50' : 'text-white/40'}`}>
                    {ticket.time}
                  </p>
                  <h3 class={`text-2xl font-bold mb-1 font-heading ${ticket.highlight ? 'text-navy' : 'text-white'}`}>
                    {ticket.name}
                  </h3>
                </div>

                {/* Pricing block — original (strike) + current (big) + future (small) all on one baseline */}
                <div class={`mb-4 pb-4 border-b ${ticket.highlight ? 'border-slate/10' : 'border-white/10'}`}>
                  <div class="flex items-baseline gap-3 flex-wrap">
                    <span class={`text-base line-through ${ticket.highlight ? 'text-slate/30' : 'text-white/25'}`}>
                      {ticket.originalPrice}
                    </span>
                    <span class={`text-4xl font-bold ${ticket.highlight ? 'text-navy' : 'text-white'}`}>
                      {ticket.price}
                    </span>
                    {ticket.futurePrice.split(' / ').map((fp) => (
                      <span class={`text-sm ${ticket.highlight ? 'text-slate/30' : 'text-white/25'}`}>{fp}</span>
                    ))}
                  </div>
                  <p class={`text-xs mt-2 italic text-center ${ticket.highlight ? 'text-slate/50' : 'text-white/40'}`}>
                    Very limited availability
                  </p>
                </div>

                {/* "Best for..." description */}
                {ticket.description && (
                  <p class={`text-sm mb-4 italic ${ticket.highlight ? 'text-slate/60' : 'text-white/55'}`}>
                    {ticket.description}
                  </p>
                )}

                {/* "Includes everything in the previous tier" callout (Patriot + Statesman) */}
                {ticket.inheritsFrom && (
                  <div class={`flex items-start gap-2.5 mb-3 px-3 py-2 rounded-md ${ticket.highlight ? 'bg-red/8 ring-1 ring-red/15' : 'bg-gold/10 ring-1 ring-gold/25'}`}>
                    <svg class={`w-5 h-5 mt-0 flex-shrink-0 ${ticket.highlight ? 'text-red' : 'text-gold'}`} fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <p class={`text-sm font-bold leading-snug ${ticket.highlight ? 'text-navy' : 'text-white'}`}>
                      Everything in the <span class={ticket.highlight ? 'text-red' : 'text-gold'}>{ticket.inheritsFrom}</span>
                    </p>
                  </div>
                )}

                {/* Umbrella heading above the categorized sections (e.g. "Plus These Elite Upgrades:") */}
                {ticket.sectionIntro && (
                  <p class={`text-sm font-extrabold tracking-wider uppercase mb-3 leading-snug ${ticket.highlight ? 'text-red' : 'text-gold'}`}>
                    {ticket.sectionIntro}
                  </p>
                )}

                {/* Detail sections */}
                <div class="space-y-3 mb-6 flex-grow">
                  {ticket.sections.map((section, si) => (
                    <div>
                      <p class={`text-xs font-bold tracking-wider uppercase mb-1.5 ${
                        ticket.highlight ? 'text-navy/70' : 'text-gold/90'
                      } ${si > 0 ? 'pt-2.5 border-t ' + (ticket.highlight ? 'border-slate/10' : 'border-white/10') : ''}`}>
                        {section.heading}
                      </p>
                      <ul class="space-y-1.5">
                        {section.items.map((f) => (
                          <li class="flex items-start gap-2">
                            <svg class={`w-3.5 h-3.5 mt-0.5 flex-shrink-0 ${ticket.highlight ? 'text-gold' : 'text-gold/80'}`} fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                            </svg>
                            <span class={`text-sm leading-snug ${ticket.highlight ? 'text-slate/80' : 'text-white/70'}`} set:html={f} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>

                {/* Statesman-only: big gold CTA to Hosted Groups page */}
                {ticket.highlight && (
                  <a
                    href="/hosted-group-tables/"
                    class="block w-full text-center mb-4 px-5 py-4 rounded-lg bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
                  >
                    <p class="font-heading font-extrabold text-base sm:text-lg leading-tight tracking-tight mb-1.5">
                      <span class="block">Host your Own</span>
                      <span class="block">&ldquo;Party Inside the Party&rdquo; &rarr;</span>
                    </p>
                    <ul class="text-xs sm:text-[13px] font-semibold space-y-0.5">
                      <li>&#10003; No cost to you or your guests</li>
                      <li>&#10003; Takes 2 minutes to set up</li>
                    </ul>
                  </a>
                )}

                {/* Footnote (e.g., "Reception-style", "Extremely limited") */}
                {ticket.note && (
                  <p class={`text-xs mb-4 italic ${ticket.highlight ? 'text-slate/55' : 'text-white/40'}`}>
                    {ticket.note}
                  </p>
                )}

                {/* CTA */}
                <a
                  href={ticketUrl}
                  class={`eventbrite-checkout block w-full text-center py-3.5 px-6 rounded-lg font-semibold text-sm tracking-[0.18em] uppercase transition-all hover:-translate-y-0.5 ${
                    ticket.highlight
                      ? 'bg-[#1a56db] text-white hover:bg-[#1a56db]/90 shadow-lg'
                      : 'bg-white/10 text-white hover:bg-white/20 border border-white/20'
                  }`}
                >
                  Get Tickets
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Bottom spacer before footer -->
    <div class="bg-navy pb-16 sm:pb-20"></div>

  </main>
  <Footer />
</BaseLayout>
