    <section class="pt-12 sm:pt-14 pb-8 sm:pb-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark rounded-2xl border-2 border-gold/55 p-6 sm:p-8 md:p-10 text-center shadow-[0_20px_44px_-16px_rgba(0,0,0,0.55)]">
          <p class="text-gold font-bold tracking-[0.28em] uppercase text-xs sm:text-sm mb-3">Public Voting Now Open</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white font-heading leading-tight mb-4">
            Help Select America&rsquo;s Icons
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-5"></div>
          <p class="text-white/90 text-lg sm:text-xl leading-relaxed max-w-6xl mx-auto italic font-medium">
            Be part of history by helping recognize the people whose achievements, leadership,
            dedication, courage, and character have helped shape the American story.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. WHAT IS AN ALL-AMERICAN ICON? — definition.                 -->
    <!-- ============================================================ -->
    <section class="py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-6">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gold font-heading leading-tight mb-3">
            What Is an All-American Icon?
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-white/85 text-base sm:text-lg leading-relaxed">
          <p>
            An All-American Icon is someone whose life, work, accomplishments, or leadership has
            helped shape their field, define their generation, or leave a lasting mark on the
            American story. <span class="text-white font-semibold">They are not just successful
            &mdash; they are significant</span> &mdash; inspiring admiration, representing
            excellence, and reflecting something enduring about the American spirit.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. REVIEW THE NOMINEE CATEGORIES — accordion (collapsed).      -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12 bg-navy-dark border-y border-gold/25">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-9 sm:mb-10">
          <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-3">
            Nominees Under Consideration
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-3">
            Review the Nominee Categories
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-6"></div>
          <p class="text-white/85 text-sm sm:text-base italic mb-7">
            A few icon honorees are already confirmed.
            <a href="#current-honorees" class="not-italic font-semibold text-gold hover:text-gold-light underline underline-offset-4 decoration-gold/60 hover:decoration-gold-light">
              See who&rsquo;s been selected below &darr;
            </a>
          </p>
          <div class="text-white/85 text-base sm:text-lg leading-relaxed max-w-5xl mx-auto space-y-4 mb-7">
            <p>
              <strong class="text-white">Be part of the process.</strong> Explore the individuals
              currently under consideration as All-American Icons. Browse the categories, discover
              the nominees, cast your vote, or suggest additional individuals who deserve to be
              considered.
            </p>
            <p>
              After you vote, please share this page so others can participate as well. Public
              input will help inform the selection process. Final selections will be made at the
              sole discretion of the All-American Ball Committee.
            </p>
          </div>
          <p class="text-white/70 text-sm sm:text-[15px] leading-relaxed max-w-4xl mx-auto mb-6 sm:mb-7">
            <span class="text-gold font-bold uppercase tracking-[0.12em] text-xs sm:text-sm">Voting Note:</span>
            You may vote for as many individuals as you believe deserve consideration. Multiple
            honorees will be selected. Some categories may have multiple honorees, while others
            may have none.
          </p>
          <a
            href={voteFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
          >
            Open the Official Voting Form
          </a>
        </div>

        {/* ====================================================== */}
        {/* Reverted 2026-05-31 per Mike: previous card/expansion    */}
        {/* layout was "way too busy". Restored to the simpler        */}
        {/* accordion format — main category header on top, then a   */}
        {/* vertical list of subcategory accordion bars (each shows  */}
        {/* subcategory name + nominee count + plus icon; expands to */}
        {/* the nominee rows with inline Vote buttons).               */}
        {/* ====================================================== */}
        {/* 2026-06-01 per Mike: laid out the two main category      */}
        {/* groups SIDE BY SIDE on lg+ to cut roughly half the        */}
        {/* vertical scroll. Mobile/tablet stacks vertically as       */}
        {/* before. items-start so the columns stay independent      */}
        {/* heights when a subcategory accordion is expanded.         */}
        {/* ====================================================== */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-start">
          {mainCategories.map((main) => (
            <div>
              <div class="text-center mb-6 sm:mb-7">
                <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white font-heading leading-tight uppercase tracking-[0.05em]">{main.name}</h3>
                <div class="w-24 h-1 bg-gold mx-auto mt-3"></div>
              </div>

              <div class="space-y-3 sm:space-y-4">
                {main.subcategories.map((sub) => (
                  <details class="group rounded-xl border border-gold/40 bg-white/[0.05] overflow-hidden shadow-[0_10px_24px_-12px_rgba(0,0,0,0.45)] open:shadow-[0_16px_36px_-12px_rgba(0,0,0,0.55)]">
                    <summary class="cursor-pointer list-none p-4 sm:p-5 hover:bg-white/[0.08] transition-colors marker:hidden">
                      <div class="flex items-center justify-between gap-4">
                        <h4 class="font-heading font-bold text-gold text-lg sm:text-xl leading-tight">{sub.name}</h4>
                        <div class="flex items-center gap-3 flex-shrink-0">
                          <span class="text-white/55 text-xs sm:text-sm font-medium">{sub.nominees.length} nominee{sub.nominees.length === 1 ? "" : "s"}</span>
                          <span class="text-gold text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                        </div>
                      </div>
                    </summary>
                    <ul class="divide-y divide-white/10 border-t border-gold/20">
                      {sub.nominees.map((n) => (
                        <li class="flex flex-wrap sm:flex-nowrap items-start sm:items-center justify-between gap-3 sm:gap-5 px-4 sm:px-6 py-3.5 sm:py-4 hover:bg-white/[0.03] transition-colors">
                          <div class="flex-1 min-w-0 basis-full sm:basis-auto">
                            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mb-0.5">
                              <span class="text-white font-bold text-base sm:text-[17px] leading-tight">{n.name}</span>
                              {n.honoree && (
                                <span class="inline-block bg-gold/20 border border-gold/60 text-gold text-[10px] font-bold uppercase tracking-[0.1em] px-2 py-0.5 rounded align-middle whitespace-nowrap">
                                  2026 Honoree
                                </span>
                              )}
                            </div>
                            {n.desc && (
                              <p class="text-white/65 text-sm leading-snug">{n.desc}</p>
                            )}
                          </div>
                          <a
                            href={voteFormUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex-shrink-0 inline-block bg-gold/15 border border-gold/60 hover:bg-gold hover:text-navy-dark text-gold px-4 py-1.5 text-xs font-bold uppercase tracking-wider rounded transition-colors"
                            aria-label={`Vote for ${n.name}`}
                          >
                            Vote
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 4 "Official Voting Form" CTA removed 2026-05-31 per   -->
    <!-- Mike: its copy + gold button were merged into the "Review the -->
    <!-- Nominee Categories" intro header above, so visitors see the   -->
    <!-- voting CTA right at the top of the categories section instead -->
    <!-- of as a separate band below it.                                -->

    <!-- ============================================================ -->
    <!-- DIVIDER — slim section break between "Nominees Under          -->
    <!-- Consideration" and "Current Honorees". Tightened 2026-05-31    -->
    <!-- per Mike — previous version was too tall. Now: three small    -->
    <!-- gold stars centered with minimal vertical padding.             -->
    <!-- ============================================================ -->
    <div aria-hidden="true" class="bg-navy-dark py-4 sm:py-5 text-center">
      <span class="inline-flex items-center gap-2 sm:gap-3 text-gold/70 text-xs sm:text-sm leading-none">
        <span>&#9733;</span>
        <span>&#9733;</span>
        <span>&#9733;</span>
      </span>
    </div>

    <!-- ============================================================ -->
    <!-- 5. FEATURED 2026 ALL-AMERICAN ICONS — Bob Anderson + Tony O.   -->
    <!-- "Selected 2026 Honoree" badge on each card.                    -->
    <!-- ============================================================ -->
    <section id="current-honorees" class="scroll-mt-28 sm:scroll-mt-32 py-10 sm:py-12 bg-navy-dark border-y border-gold/25">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8">
          <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm mb-3">Current Honorees</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-gold font-heading leading-tight mb-3">2026 All-American Icon Honorees</h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-5"></div>
          <p class="text-white/80 text-base sm:text-lg leading-relaxed max-w-5xl mx-auto">
            These are the All-American Icons already selected for recognition in 2026. Additional
            honorees will be announced as the event nears &mdash; don&rsquo;t forget to vote for
            your favorites to help shape the final list. All honorees will be celebrated at the
            official All-American Icon Awards presentation on July 3, 2026 at the Countdown 250
            Ball.
          </p>
        </div>

        <div class="space-y-8">
          {iconHonorees.map((h) => (
            <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark border border-gold/40 rounded-2xl overflow-hidden shadow-[0_18px_40px_-16px_rgba(0,0,0,0.6)] flex flex-col sm:flex-row">
              <div class="sm:w-2/5 sm:flex-shrink-0 bg-navy/50">
                <div class="aspect-[4/3] sm:aspect-auto sm:h-full overflow-hidden">
                  {h.img ? (
                    <img
                      src={h.img}
                      alt={h.name}
                      class={`w-full h-full ${h.imgFit ?? "object-cover"}`}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full min-h-[220px] flex items-center justify-center bg-gradient-to-br from-navy via-navy-dark to-navy p-6 text-center">
                      <div>
                        <picture>
                          <source srcset="/images/misc/all-amer-icon-medal.webp" type="image/webp" />
                          <img
                            src="/images/misc/all-amer-icon-medal.png"
                            alt={`All-American Icon Award medal — placeholder for ${h.name}`}
                            class="w-32 sm:w-36 md:w-40 h-auto mx-auto"
                            style="filter: drop-shadow(0 12px 24px rgba(0,0,0,0.32)) drop-shadow(0 4px 10px rgba(197,164,78,0.38));"
                            loading="lazy"
                            decoding="async"
                          />
                        </picture>
                        <p class="text-white/45 text-[10px] sm:text-xs uppercase tracking-[0.2em] mt-5">Photo Coming Soon</p>
                      </div>
                    </div>
                  )}
                </div>
              </div>
              <div class="flex-1 p-6 sm:p-8 md:p-10">
                <div class="flex flex-wrap items-center gap-3 mb-2">
                  <h3 class="text-2xl sm:text-3xl font-bold text-gold font-heading leading-tight">{h.name}</h3>
                  <span class="inline-block bg-gold/20 border border-gold/60 text-gold text-[10px] sm:text-xs font-bold uppercase tracking-[0.1em] px-2.5 py-1 rounded">
                    Selected 2026 Honoree
                  </span>
                </div>
                <p class="text-white/55 text-xs sm:text-sm uppercase tracking-[0.18em] font-semibold mb-5">{h.role}</p>
                <details class="text-white/75 text-sm sm:text-base leading-relaxed group">
                  <summary class="list-none cursor-pointer marker:hidden">
                    <span class="block" set:html={h.bio} />
                    <span class="mt-3 inline-block text-gold hover:text-gold-light font-bold uppercase tracking-wider text-xs group-open:hidden">Read more &rarr;</span>
                  </summary>
                  <div class="mt-4 space-y-4" set:html={h.bioExpanded} />
                  <span class="mt-3 hidden group-open:inline-block text-gold hover:text-gold-light font-bold uppercase tracking-wider text-xs cursor-pointer" onclick="this.closest('details').open = false">&larr; Show less</span>
                </details>
              </div>
            </div>
          ))}
        </div>

        <p class="text-center text-gold font-bold tracking-[0.25em] uppercase text-sm sm:text-base mt-10 sm:mt-12">
          More Major Announcements Coming Soon
        </p>
      </div>
    </section>

    <!-- Sections 6 ("What Makes an All-American Icon?" 5-criteria block)  -->
    <!-- and 7 ("Vote or Submit a Write-In Nomination" duplicate CTA       -->
    <!-- block) removed 2026-05-31 per Mike. Both were redundant with      -->
    <!-- section 2 ("What Is an All-American Icon?") and the section 1 /    -->
    <!-- section 4 voting CTAs already on the page.                        -->

    <!-- ============================================================ -->
    <!-- 8. SEE THE AWARDS PRESENTED LIVE — Event CTA.                  -->
    <!-- ============================================================ -->
    <section class="py-10 sm:py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
          See the Awards Presented Live
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
          Join Us July 3, 2026
        </h2>
        <div class="w-16 h-1 bg-gold mx-auto mb-7"></div>
        <div class="text-white/85 text-base sm:text-lg leading-relaxed space-y-4 mb-8">
          <p>
            The All-American Icon Awards will be presented during the historic Countdown 250 Ball
            at the Washington Hilton in Washington, D.C., as America begins its 250th anniversary
            celebration.
          </p>
          <p class="text-white font-semibold">
            Vote, nominate, share the campaign &mdash; then be in the room when America&rsquo;s
            Icons are recognized.
          </p>
        </div>
        <a
          href={ticketUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
        >
          Purchase Tickets
        </a>
      </div>
    </section>

    <!-- Section 9 "Be in the Room When America Counts Down to 250"   -->
    <!-- final CTA band removed 2026-05-31 per Mike. Redundant with   -->
    <!-- section 8 ticket CTA directly above it (which has the        -->
    <!-- icons-specific framing) and the site-wide Footer below it    -->
    <!-- (which already does the "Be in the Room" closing pitch).     -->

  </main>
  <div class="h-1.5 w-full bg-gradient-to-r from-gold/70 via-gold to-gold/70"></div>
  <Footer />

  {/* Subcategory click-to-expand controller removed 2026-05-31 with */}
  {/* the layout revert. Native <details>/<summary> elements handle  */}
  {/* expand/collapse on their own; no JS required.                   */}
</BaseLayout>
