---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * ALL-AMERICAN ICONS — LIVE (promoted 2026-05-31)
 * ----------------------------------------------------------------
 * Public-voting / nomination / sharing campaign page for the 2026
 * All-American Icon Awards. Nominees organized into TWO main
 * category groups (Sports & Athletics; Arts, Entertainment, Media
 * & Influence). Subcategories render as premium cards with inline
 * "View Nominees" expansion (one open at a time, JS controller at
 * the bottom of the page).
 *
 * All voting buttons point to the existing Google Form used for
 * write-in nominations.
 *
 * Tony Orlando and Bob Anderson are tagged `honoree: true` in the
 * Music subcategory and also appear in the Featured 2026 Honorees
 * bio cards section with a "2026 Honoree" gold badge.
 */

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
const voteFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSfpvYYii5Kq5afy70yWcTrAWMb8pvrcurZ0lDW0aW1vX0ousw/viewform?usp=dialog"; // Google Form — All-American Icon Awards public voting (vote + write-in nominations)

// Order: Music icons first (Tony Orlando, Bob Anderson, Lee Greenwood)
// grouped together as the three patriotic music legends, then Jordan
// Burroughs as the wrestling icon. Lee Greenwood + Jordan Burroughs
// added 2026-06-01 per Mike.
const iconHonorees = [
  {
    name: "Tony Orlando",
    img: "/images/event/tony-orlando.jpg",
    imgFit: "object-contain",
    role: "Legendary Entertainer",
    bio: "Tony Orlando is one of America&rsquo;s most beloved entertainers &mdash; a Grammy-nominated, Hollywood Walk of Fame icon celebrating more than six decades in show business, with five #1 hits and millions of records sold.",
    bioExpanded: "<p>He has sold millions of records, including five #1 hits &mdash; &ldquo;Tie a Yellow Ribbon &rsquo;Round the Ole Oak Tree,&rdquo; &ldquo;Knock Three Times,&rdquo; &ldquo;Candida,&rdquo; &ldquo;My Sweet Gypsy Rose,&rdquo; and &ldquo;He Don&rsquo;t Love You (Like I Love You)&rdquo; &mdash; plus two platinum and three gold albums and 15 Top 40 hits. &ldquo;Tie a Yellow Ribbon&rdquo; was Billboard&rsquo;s #1 Song of the Year in 1973 and grew into an American anthem of hope, homecoming, and renewal.</p><p>The enormously popular <em>Tony Orlando and Dawn</em> variety show ran for four seasons on CBS (1973&ndash;1977) &mdash; the first television show to feature a multi-racial singing group, with Tony the first and only Latin American to host a network variety series. Tony Orlando and Dawn rank among Billboard&rsquo;s Top 100 artists of all time.</p><p>Few entertainers have excelled in so many realms: recording artist, songwriter, concert headliner, network television star, motion-picture actor, Broadway performer, and author. As VP of CBS&rsquo;s April-Blackwood Music (1966&ndash;1970) he signed and produced Barry Manilow&rsquo;s first recordings and represented songwriters including James Taylor, Laura Nyro, and Blood, Sweat &amp; Tears alongside the legendary Clive Davis. He first reached the charts in 1961 as the first pop vocalist signed to Epic Records, with &ldquo;Halfway to Paradise.&rdquo;</p><p>His honors include a star on the Hollywood Walk of Fame, the American Eagle Lifetime Achievement Award, the Ellis Island Medal of Honor, the Lee Greenwood Patriot Award, induction into the New Jersey Hall of Fame (2023) and the East Coast Music Hall of Fame (2022), two American Music Awards, and the People&rsquo;s Choice Award for Best Male Entertainer.</p><p>A devoted champion of America&rsquo;s veterans, Tony has performed for troops around the world and for several U.S. Presidents, from Carnegie Hall to the White House, and received the Bob Hope Award for excellence in entertainment from the Congressional Medal of Honor Society. In 2023 he marked the 50th anniversary of &ldquo;Tie a Yellow Ribbon&rdquo; and the return of America&rsquo;s Vietnam POWs &mdash; whom he first honored at Bob Hope&rsquo;s invitation at the 1973 Cotton Bowl &mdash; and for two decades welcomed some 175,000 veterans each year to his Yellow Ribbon Music Theatre in Branson, Missouri.</p><p>For 33 years he co-hosted the Muscular Dystrophy Telethon alongside Jerry Lewis, and today hosts &ldquo;Saturday Nights with Tony Orlando&rdquo; on 77WABC Music Radio, streaming worldwide. Tony and his wife, Francine, are the parents of Jenny and Jon.</p>",
  },
  {
    name: "Bob Anderson",
    img: "/images/event/bob-anderson.jpg",
    role: "World’s Greatest Singing Impressionist",
    bio: "Hailed by <em>People</em> magazine as &ldquo;America&rsquo;s Greatest Singing Impressionist,&rdquo; Bob Anderson has spent five decades as one of the most celebrated entertainers on the Las Vegas Strip.",
    bioExpanded: "<p>A Vietnam veteran from a musical family, Anderson arrived in Las Vegas in his early twenties and was on stage at the famed Sahara within hours. His extraordinary gift for recreating the voices of the world&rsquo;s greatest singers &mdash; most famously Frank Sinatra &mdash; has earned standing ovations at Carnegie Hall and performances for two U.S. Presidents and the Royal Family.</p><p>He is an inductee of both the Casino Legends Hall of Fame and the Las Vegas Entertainers Hall of Fame, was praised by Simon Cowell as the best on the planet, and was summed up by Frank Sinatra himself: &ldquo;Bob Anderson has a hell of an act.&rdquo;</p>",
  },
  {
    name: "Lee Greenwood",
    img: "/images/event/lee-greenwood-hero.jpg",
    role: "American Patriotic Music Icon",
    bio: "Lee Greenwood is one of America&rsquo;s most beloved country music artists and the voice behind &ldquo;God Bless the USA&rdquo; &mdash; an unofficial national anthem that has defined patriotic American music for more than four decades.",
    bioExpanded: "<p>Greenwood&rsquo;s career spans more than forty years, over 20 studio albums, and 38 Top 40 hits on the country charts. He is a Grammy Award winner for Best Male Country Vocal Performance, a two-time Country Music Association Male Vocalist of the Year, and a member of the Grand Ole Opry.</p><p>Released in 1984, &ldquo;God Bless the USA&rdquo; became one of the most-played patriotic anthems in American history. The song resurged powerfully after the September 11, 2001 attacks and has remained a defining sound of national pride at inaugurations, military ceremonies, civic events, and stadiums across the country.</p><p>Greenwood has performed for every U.S. President since Ronald Reagan and is one of the most consistent and visible champions of America&rsquo;s veterans and active military in American entertainment. Through countless USO tours, military fundraisers, and veterans events, he has spent his career standing alongside those who serve. He is an honorary member of the U.S. Army Special Forces and has been recognized by national veterans organizations for his lifetime of service to military families.</p><p>His honors also include induction into the Music City Walk of Fame, multiple American Music Awards, and a body of patriotic music that has become inseparable from the soundtrack of modern American life.</p>",
  },
  {
    name: "Jordan Burroughs",
    img: null,
    role: "Olympic Gold Medalist · World & NCAA Champion",
    bio: "Jordan Burroughs is one of the most decorated wrestlers in American history &mdash; an Olympic gold medalist, four-time World Champion, and two-time NCAA Division I National Champion who has spent his career redefining what is possible for U.S. wrestling on the world stage.",
    bioExpanded: "<p>Burroughs captured Olympic gold at the 2012 London Olympics, winning the 74 kg freestyle wrestling division and becoming one of the faces of American wrestling for a generation. He has since added four World Championships (2011, 2013, 2015, 2017) along with multiple World silver and bronze medals, ranking him among the most decorated American wrestlers ever to compete on the international stage.</p><p>Before his international dominance, Burroughs was a force in collegiate wrestling. As a Nebraska Cornhusker, he won two NCAA Division I National Championships (2009 and 2011), going undefeated in his senior season. In 2011 he was awarded the Dan Hodge Trophy &mdash; college wrestling&rsquo;s equivalent of the Heisman &mdash; recognizing him as the most outstanding college wrestler in the country.</p><p>His remarkable career also includes Pan American Games gold medals, World Cup championships, and recognition by USA Wrestling as one of the all-time greats of American freestyle wrestling. Known for his trademark &ldquo;All I See Is Gold&rdquo; mantra and his relentless competitive drive, Burroughs has become one of the sport&rsquo;s most prominent ambassadors &mdash; growing American wrestling at every level, from youth programs to international competition, and inspiring the next generation of American wrestlers.</p>",
  },
  {
    name: "Mike Moyer",
    img: null,
    role: "Executive Director, National Wrestling Coaches Association",
    bio: "Mike Moyer has served as Executive Director of the National Wrestling Coaches Association (NWCA) since 1999, leading the most transformative era in American wrestling&rsquo;s modern history &mdash; growing NWCA membership from 1,700 to more than 10,000 and helping launch over 350 new intercollegiate men&rsquo;s and women&rsquo;s wrestling programs nationwide.",
    bioExpanded: "<p>Under Moyer&rsquo;s leadership, the NWCA has become the central force behind the growth, advocacy, and modernization of American wrestling at every level. Beyond expanding NWCA membership and launching hundreds of new collegiate programs since 2000, he founded the NWCA CEO Leadership Program, which has trained more than 900 college coaches and 2,000 high school coaches in the best practices for building and sustaining strong wrestling programs across the country.</p><p>He also expanded the NWCA National Duals from a 16-team event into a national competition that now brings together more than 100 schools across men&rsquo;s and women&rsquo;s wrestling at every collegiate division &mdash; building a stage that has helped grow the sport&rsquo;s reach and elevate its champions.</p><p>Before his work at the NWCA, Moyer was head wrestling coach at George Mason University from 1985 to 1995. He led the Patriots to three Virginia Intercollegiate League team titles, two Colonial Athletic Association team championships, and an East Regional team title, compiling a career record of 126&ndash;29&ndash;2.</p><p>For his lifetime of impact on the sport, Moyer has been recognized with the National Wrestling Hall of Fame&rsquo;s Order of Merit and inducted into the Hall as a Distinguished Member. His vision and tireless work have made him one of the most consequential figures in modern American wrestling.</p>",
  },
];

