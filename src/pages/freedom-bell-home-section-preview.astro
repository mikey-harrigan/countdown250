---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * AMERICA'S FREEDOM BELL — HOME-PAGE SECTION PREVIEW
 * ----------------------------------------------------------------
 * STANDALONE PREVIEW — direct-URL only, not linked in nav, excluded
 * from the sitemap via the astro.config.mjs filter (freedom-bell-).
 * The LIVE home page is NOT touched. This page renders just the
 * proposed "America's Freedom Bell" home-page feature band, in
 * home-page styling (Navbar + the section + Footer), so Mike can
 * judge it in context before it's promoted into index.astro.
 *
 * Copy is verbatim from Mike's spec (2026-05-19):
 *   - Image overlay carries the SHORT version (eyebrow + headline
 *     + tagline / LET FREEDOM RING!).
 *   - The copy column beside it carries "the rest" per Mike's
 *     instruction: subheadline, the emotional line, body copy,
 *     and the two buttons. Eyebrow/headline/tagline are NOT
 *     repeated in the copy column on purpose — they're on the
 *     adjacent image — which is exactly what Mike asked for
 *     ("let the actual website copy ... explain the rest").
 *   - 3 cards below, all centered on the midnight moment.
 *
 * Image: freedom-bell-hero.jpg (the real, text-free photo). At
 * this card size the native 600x400 source reads fine — the
 * earlier softness only showed when it was stretched full-bleed.
 */

const journeyUrl = "/freedom-bell-preview/";
const mediaUrl = "/freedom-bell-preview/#media-partnership";

const cards = [
  { title: "The Bell Rings", copy: "America&rsquo;s Freedom Bell rings at midnight as America turns 250." },
  { title: "The Ballroom Joins In", copy: "Guests raise small bells in a joyful chorus of freedom." },
  { title: "The Nation Turns 250", copy: "A once-in-a-generation moment in Washington, D.C." },
];
---

<BaseLayout
  title="America's Freedom Bell — Home Section Preview | Countdown 250 Ball"
  description="Preview of the proposed America's Freedom Bell home-page section: the Bell of the Ball rings at midnight as America turns 250, joined by a chorus of small bells throughout the ballroom."
  ogImage="/images/event/freedom-bell-hero.jpg"
>
  <Navbar />
  <main>
    <!-- ============================================================ -->
    <!-- AMERICA'S FREEDOM BELL — proposed home-page feature band      -->
    <!-- (this <section> is the unit that would drop into index.astro) -->
    <!-- ============================================================ -->
    <section
      id="freedom-bell"
      class="scroll-mt-24 relative py-16 sm:py-20 border-y border-gold/25 overflow-hidden"
      style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%);"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">

          <!-- Image with short overlaid text -->
          <div class="relative rounded-2xl overflow-hidden border border-gold/40 shadow-[0_18px_40px_-16px_rgba(0,0,0,0.6)]">
            <img
              src="/images/event/freedom-bell-hero.jpg"
              alt="Service members around America's Freedom Bell at the World War II Memorial in Washington, D.C., holding American flags"
              class="w-full h-full object-cover aspect-[3/2]"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-dark/95 via-navy-dark/55 to-navy-dark/20 pointer-events-none"></div>
            <div class="absolute inset-3 sm:inset-4 border border-gold/30 rounded-xl pointer-events-none"></div>

            <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
              <p class="text-white font-bold tracking-[0.18em] uppercase text-[10px] sm:text-xs mb-2">
                America&rsquo;s Freedom Bell <span class="text-red">&times;</span> Countdown 250
              </p>
              <p class="text-gold font-heading font-bold uppercase leading-[1.1] tracking-tight text-xl sm:text-2xl md:text-3xl mb-3">
                The Bell of the Ball Rings at Midnight
              </p>
              <p class="text-gold font-heading font-semibold uppercase tracking-wide text-xs sm:text-sm leading-snug">
                The midnight celebration of our lifetime.
              </p>
              <p class="text-white font-heading font-semibold uppercase tracking-wide text-xs sm:text-sm leading-snug">
                Our country. Our bells. Our freedom.
              </p>
              <p class="text-white font-heading font-extrabold uppercase tracking-[0.1em] text-base sm:text-xl mt-2">
                LET FREEDOM RING!
              </p>
            </div>
          </div>

          <!-- Website copy — "the rest" beside the image -->
          <div>
            <p class="text-gold font-bold tracking-[0.22em] uppercase text-xs sm:text-sm mb-5">
              America&rsquo;s Freedom Bell <span class="text-red">&times;</span> Countdown 250
            </p>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white font-heading leading-tight mb-5">
              The Bell of the Ball Rings at Midnight
            </h2>
            <p class="text-white/80 text-base sm:text-lg leading-relaxed mb-5">
              As the clock strikes 250, America&rsquo;s Freedom Bell will ring out at the Official
              Countdown 250 Ball in Washington, D.C. &mdash; marking the moment our nation enters its
              250th birthday.
            </p>
            <p class="text-gold font-heading font-bold text-xl sm:text-2xl leading-snug mb-4">
              Then the ballroom joins in.
            </p>
            <p class="text-white/80 text-base sm:text-lg leading-relaxed mb-8">
              Guests throughout the room will raise and ring small commemorative bells, creating a
              joyful chorus of freedom at the heart of Independence Weekend.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={journeyUrl}
                class="inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-7 py-3.5 text-sm sm:text-base font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
              >
                Learn About the Freedom Bell Journey
              </a>
              <a
                href={mediaUrl}
                class="inline-block text-center border-2 border-gold text-gold hover:bg-gold hover:text-navy-dark px-7 py-3.5 text-sm sm:text-base font-bold tracking-wider uppercase transition-all rounded"
              >
                Media Partnership Inquiries
              </a>
            </div>
          </div>
        </div>

        <!-- Three cards — all centered on the midnight moment -->
        <div class="grid sm:grid-cols-3 gap-5 sm:gap-6 mt-12 sm:mt-14">
          {cards.map((c) => (
            <div class="bg-white/[0.06] border border-gold/25 rounded-xl p-6 backdrop-blur-sm text-center">
              <h3 class="text-lg sm:text-xl font-bold text-gold font-heading mb-2">{c.title}</h3>
              <p class="text-white/75 text-sm sm:text-base leading-relaxed" set:html={c.copy} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <div class="h-1.5 w-full bg-gradient-to-r from-gold/70 via-gold to-gold/70"></div>
  <Footer />
</BaseLayout>
