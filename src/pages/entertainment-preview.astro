---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * ENTERTAINMENT PREVIEW PAGE
 * ----------------------------------------------------------------
 * Format adapted from the All-American Inaugural Ball entertainment
 * page (allamericanball.com/entertainment-2/), re-themed for the
 * Countdown 250 Ball brand:
 *   - Liquid-blue page bg (sampled from the seal logo)
 *   - Gold/navy/red palette
 *   - July 3, 2026 / Washington Hilton / midnight countdown framing
 *
 * Per Mike (2026-05-05): "assume we have all the same performers,
 * entertainment zones, etc for this event as we had for the
 * inaugural ball." — using inaugural lineup as placeholder content
 * so the structure can be reviewed before swapping in final names.
 *
 * Excluded from sitemap via astro.config.mjs filter.
 */

// Entertainment Zones — 7 areas split into 2 access tiers per Mike
// 2026-05-07: 4 open to all guests + 3 Statesman's Pass exclusive.
//
// `summary` is the short one-liner shown in the inaugural-style
// text-list layout. `description` is the longer card version — kept
// in the data so we can swap back to a card grid easily later.
const zones = [
  // ---- Open to ALL guests ----
  {
    tier: "all",
    name: "All-American Hero Ballroom",
    summary: "Live music, DJs, the All-American Hero Awards, and the signature midnight countdown.",
    description: "The flagship room. Multiple live bands rotate across the main stage, the All-American Hero Lifetime Achievement Awards are presented here, and the signature midnight countdown unfolds beneath a 30-foot gold seal.",
  },
  {
    tier: "all",
    name: "Decades Dance Club",
    summary: "70s, 80s, 90s, and 2000s hits all night long.",
    description: "Disco lights, retro vibes, and four decades of crowd-favorite hits, mixed by a high-energy DJ who keeps the floor moving from Donna Summer to Beyoncé.",
  },
  {
    tier: "all",
    name: "Studio 250",
    summary: "Modern dance club with today&rsquo;s top hits and club bangers.",
    description: "Modern dance club for current chart hits, EDM, and high-energy club music. Cinematic lighting, immersive sound, and a packed dance floor all night long.",
  },
  {
    tier: "all",
    name: "Interactive Zone",
    summary: "Immersive 250th-anniversary activations, paparazzi photo experience, Media &amp; Press area, interview station &amp; live broadcast studio, roving entertainers.",
    description: "Immersive 250th-anniversary activations, paparazzi photo experience, Media &amp; Press area, interview station &amp; live broadcast studio, roving entertainers.",
  },
  // ---- Statesman's Pass EXCLUSIVE ----
  {
    tier: "statesman",
    name: "Statesman&rsquo;s Balcony",
    summary: "Raised area with premium hospitality and a bird&rsquo;s-eye view of the main stage.",
    description: "A large raised area with premium hospitality and a bird&rsquo;s-eye view of the main stage. Reserved seating, top-shelf bar, and the best sightlines in the house.",
  },
  {
    tier: "statesman",
    name: "Presidents Walk",
    summary: "Exclusive promenade with intimate sitting areas.",
    description: "An exclusive promenade with intimate sitting areas for quiet conversation away from the main floor. Reserved for Statesman&rsquo;s Pass holders.",
  },
  {
    tier: "statesman",
    name: "Speakeasy Lounge",
    summary: "Speakeasy-styled hidden lounge with classic cocktails and vintage ambience.",
    description: "A speakeasy-styled hidden lounge with classic cocktails, vintage music, and intimate ambience. Reserved for Statesman&rsquo;s Pass holders only.",
  },
];

// Entertainment Lineup — confirmed announcements + key attractions.
// 1 confirmed performer + 2 signature attractions + 7 entertainment
// zones = 10 cards, one per row. Updated 2026-05-07 per Mike.
const performers = [
  {
    name: "Julian Awari",
    role: "National Anthem",
    img: "/images/misc/flag-singers.jpg",
    bio: "Air Force veteran and powerhouse vocalist. Performs the National Anthem to open the evening&rsquo;s formal program &mdash; a signature moment that sets the tone for the entire night.",
  },
  {
    name: "DJ Freedom",
    role: "Multi-Genre DJ",
    img: "/images/misc/dj-cartoon.jpg",
    bio: "Set your feet free and dance like no one is watching! DJ Freedom will get you in the mood to celebrate. With a deep catalog of tunes from all genres, DJ Freedom will be taking requests and spinning all your favorite dance tunes.",
  },
  {
    name: "Live Broadcast",
    role: "Television &amp; Webcast Coverage",
    img: "/images/misc/usvets-logo.jpg",
    bio: "The Countdown 250 Ball will be broadcast live to viewers nationwide, capturing every moment of America&rsquo;s premier 250th anniversary celebration. Cameras, hosts, and the interview station inside the Interactive Zone bring the evening to millions.",
  },
  {
    name: "Midnight Countdown to America&rsquo;s 250th",
    role: "The Signature Moment",
    img: "/images/event/countdown-toast.jpg",
    bio: "The signature moment. At the stroke of midnight on July 3rd into July 4th, 3,000 guests count down together to the exact instant America enters its 250th year. Multi-sensory production with patriotic music, lights, and a synchronized confetti cascade.",
  },
  {
    name: "All-American Hero Lifetime Achievement Awards",
    role: "Awards Ceremony",
    img: "/images/event/hero-medal-presentation.jpg",
    bio: "Inaugural presentation of the All-American Hero Lifetime Achievement Awards, recognizing extraordinary Americans whose courage, leadership, and selfless service have strengthened our nation. A live ceremony in the All-American Hero Ballroom.",
  },
  {
    name: "Tribute to America &mdash; 250 Years",
    role: "Featured Performance",
    img: "/images/event/color-guard.jpg",
    bio: "An original Tribute to America featuring The Sicilian Tenors, a color guard processional, and a multi-decade musical journey through 250 years of American history. Performed once in the evening.",
  },
  {
    name: "Roaming Entertainers &amp; Immersive Experiences",
    role: "Roaming Throughout the Night",
    img: "/images/misc/paparazzi.jpg",
    bio: "Throughout the night, roaming entertainers, a paparazzi photo experience, and immersive 250th-anniversary activations bring the event to life across all six ballrooms.",
  },
  {
    name: "All-American Hero Ballroom",
    role: "Entertainment Zone",
    img: "/images/event/ballroom-stage.jpg",
    bio: "The flagship room. Multiple live bands rotate across the main stage, the All-American Hero Lifetime Achievement Awards are presented here, and the signature midnight countdown unfolds beneath a 30-foot gold seal.",
  },
  {
    name: "Decades Dance Club",
    role: "Entertainment Zone",
    img: "/images/event/dj-party-lights.jpg",
    bio: "Disco lights, retro vibes, and four decades of crowd-favorite hits &mdash; 70s, 80s, 90s, and 2000s &mdash; mixed by a high-energy DJ who keeps the floor moving all night long.",
  },
  {
    name: "Studio 250",
    role: "Entertainment Zone",
    img: "/images/event/dj-dance-floor.png",
    bio: "Modern dance club for current chart hits, EDM, and high-energy club music. Cinematic lighting, immersive sound, and a packed dance floor.",
  },
  {
    name: "Interactive Zone",
    role: "Entertainment Zone",
    img: "/images/event/diverse-immersive.png",
    bio: "Immersive 250th-anniversary activations, paparazzi photo experience, Media &amp; Press area, interview station &amp; live broadcast studio, and roving entertainers throughout.",
  },
  {
    name: "Statesman&rsquo;s Balcony",
    role: "Statesman&rsquo;s Pass Exclusive",
    img: "/images/event/elegant-dinner-flags.png",
    bio: "A large raised area with premium hospitality and a bird&rsquo;s-eye view of the main stage. Reserved seating, top-shelf bar, and the best sightlines in the house. Reserved for Statesman&rsquo;s Pass holders only.",
  },
  {
    name: "Presidents Walk",
    role: "Statesman&rsquo;s Pass Exclusive",
    img: "/images/event/guests-cocktail-mingling.png",
    bio: "An exclusive promenade with intimate sitting areas for quiet conversation away from the main floor. Reserved for Statesman&rsquo;s Pass holders only.",
  },
  {
    name: "Speakeasy Lounge",
    role: "Statesman&rsquo;s Pass Exclusive",
    img: "/images/event/formal-dinner-table.png",
    bio: "A speakeasy-styled hidden lounge with classic cocktails, vintage music, and intimate ambience. Reserved for Statesman&rsquo;s Pass holders only.",
  },
];

// Special Features — the moments that make this event unique vs.
// any other gala. These get prominent treatment near the bottom.
const specialFeatures = [
  {
    icon: "&#10022;",
    title: "Midnight Countdown to America&rsquo;s 250th",
    blurb: "The signature moment. At the stroke of midnight on July 3rd into July 4th, 3,000 guests count down together to the exact instant America enters its 250th year. Multi-sensory production with patriotic music, lights, and a synchronized confetti cascade.",
  },
  {
    icon: "&#9733;",
    title: "All-American Hero Lifetime Achievement Awards",
    blurb: "Inaugural presentation of the All-American Hero Lifetime Achievement Awards, recognizing extraordinary Americans whose courage, leadership, and selfless service have strengthened our nation. A live ceremony in the All-American Hero Ballroom.",
  },
  {
    icon: "&#9836;",
    title: "Tribute to America &mdash; 250 Years",
    blurb: "An original Tribute to America featuring The Sicilian Tenors, a color guard processional, and a multi-decade musical journey through 250 years of American history. Performed once in the evening.",
  },
  {
    icon: "&#9728;",
    title: "Roaming Entertainers &amp; Immersive Experiences",
    blurb: "Throughout the night, roaming entertainers, a paparazzi photo experience, and immersive 250th-anniversary activations bring the event to life across all six ballrooms.",
  },
];

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
---

<BaseLayout
  title="Entertainment Preview &mdash; The Official Countdown 250 Ball | July 3, 2026"
  description="Preview of the entertainment lineup for the Countdown 250 Ball — six ballrooms, four stages, headline performers, the All-American Hero Lifetime Achievement Awards, and the signature midnight countdown to America's 250th."
  ogImage="/images/event/ballroom-crowd.jpg"
>
  <Navbar />

  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >

    <!-- ============================================================ -->
    <!-- HERO — canonical sub-page pattern (same as hosted-group-tables). -->
    <!-- 16:9 image bleeds to all viewport edges, gold title ribbon       -->
    <!-- anchored bottom-left, soft top scrim for navbar legibility.      -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <!-- Hero container — viewport-HEIGHT based so the hero always fits
           the user's screen (see hosted-group-tables for full notes). -->
      <div class="relative w-full h-[55vh] sm:h-[60vh] min-h-[320px] max-h-[680px]">
        <img
          src="/images/event/header-entertainment-stage-crowd.jpg"
          alt="A live band performing on stage with cascading purple and gold light streamers, the lead vocalist at center mic, and the audience silhouetted in the foreground"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              Entertainment
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- INTRO — sets the scene -->
    <!-- ============================================================ -->
    <section class="pt-12 pb-10 sm:pt-16 sm:pb-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        {/* 'A celebration for the ages!' — first of three uniform
            section headers on this page. Same size/font/weight/color/
            case as '7 Entertainment Areas ★ 4 Stages' and
            'Countdown 250 Lineup… so far'. */}
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold leading-tight tracking-tight text-center mb-8">
          A celebration for the ages!
        </h2>

        <div class="space-y-5 text-white/90 text-base sm:text-lg leading-relaxed">
          <p>
            For decades, the <strong class="text-gold">All-American Balls</strong> have been the go-to celebrations for landmark moments in American history &mdash; and the Countdown 250 Ball is set to be our <strong class="text-gold">most spectacular event ever</strong>.
          </p>
          <p>
            On <strong class="text-gold">July 3, 2026</strong>, the renowned <strong class="text-gold">Washington Hilton</strong> will be transformed into a patriotic wonderland of music, energy, celebration, and surprise.
          </p>
          <p>
            Your evening features open bars, delicious cuisine, an extraordinary lineup of live entertainment, and a <strong class="text-gold">once-in-a-generation midnight countdown</strong> to the exact instant America enters its 250th year.
          </p>
          <p>
            From the <strong class="text-gold">National Anthem at 7 PM</strong> to the final notes after midnight, every performance, toast, and unforgettable moment is designed to deliver the <strong class="text-gold">celebration of a lifetime</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- NON-STOP ENTERTAINMENT — gold-bordered callout box -->
    <!-- ============================================================ -->
    <section class="py-8 sm:py-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="rounded-xl overflow-hidden border border-gold/40 shadow-[0_0_28px_rgba(197,164,78,0.20)]">
          <div class="bg-gold py-4 sm:py-5 px-6 text-center">
            <p class="text-navy-dark font-bold tracking-[0.3em] uppercase text-xs sm:text-sm">
              Non-Stop Entertainment
            </p>
          </div>
          <div class="bg-gradient-to-br from-navy-dark via-navy to-navy-dark p-7 sm:p-8 md:p-10 text-white">
            <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-[15px] sm:text-base leading-snug">
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>7 entertainment areas</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>4 stages</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Premium open bars &amp; gourmet cuisine</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Stunning patriotic d&eacute;cor</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>First class service</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Unforgettable midnight countdown</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Renowned bands, DJs, and performers</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Roving entertainers &amp; interactive activities</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Show-stopping Midnight Countdown</span></li>
              <li class="flex items-start"><span class="text-gold mr-3 flex-shrink-0 mt-1 text-sm">&#10022;</span><span>Inspiring All-American Hero Award Ceremony</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 6 PARTY ZONES — grid of zone cards -->
    <!-- ============================================================ -->
    <!-- ============================================================ -->
    <!-- 7 ENTERTAINMENT AREAS ★ 4 STAGES                             -->
    <!-- Red divider above the heading. Gold star between the two     -->
    <!-- halves of the heading. Centered list of zones below — first  -->
    <!-- 4 in red, last 3 in gold with an asterisk. Footnote at the   -->
    <!-- bottom calls out the Statesman's Pass requirement.           -->
    <!-- ============================================================ -->
    <section class="py-12 sm:py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
        {/* Red divider ABOVE the heading per Mike */}
        <div class="w-16 h-1 bg-red mx-auto mb-6"></div>

        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold leading-tight tracking-tight mb-8 sm:mb-10">
          7 Entertainment Areas
          <span class="inline-block mx-2 sm:mx-3 align-middle text-gold">&#9733;</span>
          4 Stages
        </h2>

        <ul class="space-y-2 sm:space-y-3 text-lg sm:text-xl md:text-2xl font-medium tracking-wide leading-snug">
          {zones.map((z) => (
            <li class={z.tier === "all" ? "text-white" : "text-gold"}>
              <span set:html={z.name} />
              {z.tier === "statesman" && <span> *</span>}
            </li>
          ))}
        </ul>

        <p class="text-white/65 text-sm sm:text-base italic mt-8">
          *Statesman&rsquo;s Pass Required
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- ENTERTAINMENT LINEUP — performer card grid -->
    <!-- ============================================================ -->
    <section class="py-12 sm:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10 sm:mb-12 max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gold leading-tight tracking-tight mb-5">
            Countdown 250 Lineup&hellip; so far
          </h2>
          <div class="w-16 h-1 bg-red mx-auto mb-6"></div>
          <p class="text-white/85 text-base sm:text-lg leading-relaxed">
            Lineup will be updated daily as more performers and attractions are announced&hellip;
          </p>
        </div>

        {/* HORIZONTAL CARDS — uniform dimensions per Mike. All cards
            share the same fixed height and image width on tablet+,
            with bios clamped to 3 lines so content boxes line up.
            On mobile (< sm), cards stack vertically and use natural
            height (aspect-[4/3] image on top, content below). */}
        <div class="space-y-5 sm:space-y-6">
          {performers.map((p) => (
            <div class="bg-cream rounded-xl overflow-hidden border border-gold/30 shadow-md flex flex-col sm:flex-row sm:h-56">
              {/* Image area (LEFT on sm+, TOP on mobile) — fixed width
                  on tablet+ so all card images are identical size. */}
              {p.img ? (
                <div class="sm:w-72 sm:flex-shrink-0 bg-navy/50">
                  <div class="aspect-[4/3] sm:aspect-auto sm:h-full overflow-hidden">
                    <img src={p.img} alt={p.name} class="w-full h-full object-cover" loading="lazy" decoding="async" />
                  </div>
                </div>
              ) : (
                <div class="sm:w-72 sm:flex-shrink-0 bg-gradient-to-br from-navy-dark via-navy to-navy-light flex items-center justify-center aspect-[4/3] sm:aspect-auto">
                  <span class="text-gold/60 text-5xl font-heading italic">{p.name.charAt(0)}</span>
                </div>
              )}
              {/* Content area (RIGHT on sm+, BELOW on mobile). Overflow
                  is hidden on the card; bio is line-clamped to 3 lines. */}
              <div class="flex-1 p-5 sm:p-6 flex flex-col overflow-hidden">
                <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-1 leading-tight" set:html={p.name} />
                <p class="text-red font-semibold text-xs tracking-[0.12em] uppercase mb-3" set:html={p.role} />
                <p class="text-slate text-sm leading-relaxed line-clamp-3 sm:line-clamp-4" set:html={p.bio} />
              </div>
            </div>
          ))}
        </div>

        {/* Coming-soon teaser */}
        <div class="text-center mt-12 sm:mt-14">
          <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-2">
            More Announcements Coming Soon
          </p>
          <p class="text-white/85 text-base sm:text-lg max-w-2xl mx-auto">
            Headliner reveals, additional performers, and the full Tribute to America program will be announced in the coming weeks.
          </p>
        </div>
      </div>
    </section>

    {/* SIGNATURE MOMENTS section removed 2026-05-07 — its 4 items
        (Midnight Countdown, Hero Awards, Tribute to America, Roaming
        Entertainers) were merged into the Lineup card list above per
        Mike, so keeping them here would be a duplicate. The
        `specialFeatures` array at the top of the file is now unused
        but harmless; safe to delete in a future cleanup. */}

    <!-- ============================================================ -->
    <!-- CLOSING CTA — navy rounded card on liquid blue (Partners pattern) -->
    <!-- ============================================================ -->
    <section class="py-14 sm:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="bg-navy rounded-2xl p-8 sm:p-10 text-center">
          <svg class="w-12 h-12 text-gold mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
          <h3 class="text-2xl sm:text-3xl font-bold text-gold mb-3 font-heading">Be in the Room When It Happens</h3>
          <p class="text-white/85 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-7">
            Three thousand seats. Six ballrooms. One unforgettable night. Reserve your place at the celebration of a lifetime.
          </p>
          <a
            href={ticketUrl}
            class="eventbrite-checkout inline-block bg-red hover:bg-red-light text-white px-8 py-3 text-sm sm:text-base font-semibold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
          >
            Get Your Tickets
          </a>
        </div>

        <p class="text-center text-white/60 text-xs sm:text-sm italic mt-8">
          * The entertainment lineup is subject to change.
        </p>

        <div class="text-center mt-10">
          <a href="/" class="inline-block bg-white border-2 border-navy text-navy hover:bg-navy hover:text-white px-8 py-3 text-sm font-semibold tracking-wider uppercase transition-all rounded hover:-translate-y-0.5">
            Back to Home
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
