---
/**
 * KNOW BEFORE YOU GO — Countdown 250 Ball Guest Guide.
 *
 * Rebuilt 2026-06-30 (v2). v1 was low-contrast white-on-blue with
 * near-invisible glass cards — unreadable. v2 uses the cream-card /
 * dark-navy-text pattern from /partners/ and /venue/: every content
 * block sits on a cream card with proper dark type, and the blue
 * gradient is used only as the surrounding page background.
 *
 * Same content as v1, same section order, same copy verbatim from
 * Mike's brief — only the presentation changed.
 */

import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
const parkingMapUrl = "/downloads/countdown250-parking-metro-map.pdf";

const pageTitle = "Know Before You Go | Guest Guide | The Official Countdown 250 Ball";
const pageDesc = "Must-know info before you arrive at the Countdown 250 Ball on July 3, 2026 — parking, Metro, drop-off, dress code, security, what to bring, and check-in details for the Washington Hilton.";
---

<BaseLayout title={pageTitle} description={pageDesc} ogImage="/images/event/countdown250-midnight-ball.jpg">
  <Navbar />
  <main
    class="relative"
    style="background: radial-gradient(circle at 30% 30%, rgba(4, 61, 156, 0.45) 0%, transparent 55%), linear-gradient(135deg, #052058 0%, #002B77 50%, #043D9C 100%); background-attachment: fixed;"
  >
    <!-- ============================================================ -->
    <!-- HERO — canonical sub-page pattern, gold ribbon over patriotic  -->
    <!-- image.                                                        -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div class="relative w-full h-[45vh] sm:h-[55vh] min-h-[280px] max-h-[560px]">
        <img
          src="/images/event/header-faq-question-mark.jpg"
          alt="A gold question-mark emblem framed by laurel wreath and stars, centered on a vintage-toned American flag — Know Before You Go guest guide header"
          class="absolute inset-0 w-full h-full object-cover"
          decoding="async"
        />
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/55 to-transparent pointer-events-none"></div>

        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-12 lg:pb-16 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              Know Before You Go
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- INTRO + QUICK-LINK CTA BUTTONS                                -->
    <!-- Single cream card sets the tone. Two big buttons for Parking  -->
    <!-- Map PDF + Eventbrite tickets sit inside the card so they're   -->
    <!-- the first thing a rushed guest can act on.                    -->
    <!-- ============================================================ -->
    <section class="pt-14 sm:pt-20 pb-8 sm:pb-10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border-2 border-gold/40 shadow-2xl p-6 sm:p-10">
          <p class="text-gold font-bold tracking-[0.3em] uppercase text-xs sm:text-sm text-center mb-3">
            Countdown 250 Ball Guest Guide
          </p>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-navy text-center font-heading mb-3 leading-tight">
            Washington Hilton &middot; July 3, 2026
          </h2>
          <p class="text-slate-800 text-base sm:text-lg leading-relaxed text-center max-w-2xl mx-auto mb-8">
            For the best experience, we encourage all guests to review the information below before traveling to the Official Countdown 250 Ball.
          </p>

          <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
            <a
              href={parkingMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-center gap-3 bg-navy hover:bg-navy-dark text-white font-bold py-4 sm:py-5 px-5 rounded-xl shadow-lg hover:-translate-y-0.5 transition-all text-center border-2 border-navy-dark/40"
            >
              <span class="text-2xl sm:text-3xl" aria-hidden="true">📍</span>
              <span class="text-sm sm:text-base tracking-wide">
                <span class="block text-[10px] sm:text-xs uppercase tracking-[0.15em] text-gold font-bold">Download</span>
                Parking &amp; Metro Map (PDF)
              </span>
            </a>
            <a
              href={ticketUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-center gap-3 bg-red hover:bg-red-light text-white font-bold py-4 sm:py-5 px-5 rounded-xl shadow-lg hover:-translate-y-0.5 transition-all text-center border-2 border-white/40"
            >
              <span class="text-2xl sm:text-3xl" aria-hidden="true">🎟️</span>
              <span class="text-sm sm:text-base tracking-wide">
                <span class="block text-[10px] sm:text-xs uppercase tracking-[0.15em] text-gold font-bold">Access</span>
                View My Tickets
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: GETTING HERE — venue, drop-off, parking, Metro           -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">📍</span> Getting Here
            </h2>
          </div>
          <div class="p-6 sm:p-8">
            <div class="text-center mb-6 pb-6 border-b border-gold/30">
              <p class="text-navy font-heading font-bold text-xl sm:text-2xl mb-1">Washington Hilton</p>
              <p class="text-slate-700 text-sm sm:text-base">1919 Connecticut Avenue NW &middot; Washington, DC 20009</p>
            </div>

            <!-- Drop-off callout: the single most-asked question -->
            <div class="bg-navy text-white rounded-xl p-5 sm:p-6 mb-6">
              <p class="text-gold font-bold tracking-[0.18em] uppercase text-[11px] sm:text-xs mb-2">Rideshare &amp; Drop-Off (Recommended)</p>
              <p class="text-white/90 text-sm sm:text-base leading-relaxed mb-3">
                For the quickest and most convenient access to the Countdown 250 Ball, rideshare services, taxis, and guest drop-offs should use:
              </p>
              <p class="text-gold font-heading font-bold text-2xl sm:text-3xl mb-2 leading-tight">1901 Connecticut Avenue NW</p>
              <p class="text-white/85 text-sm sm:text-base leading-relaxed">
                This is the <strong class="text-white">Ballroom Entrance</strong> and the recommended guest arrival location.
              </p>
            </div>

            <!-- Parking pair -->
            <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-4 flex items-center gap-2">
              <span aria-hidden="true">🅿️</span> Parking
            </h3>
            <div class="grid sm:grid-cols-2 gap-4 mb-8">
              <div class="bg-white rounded-lg border border-gold/30 p-5">
                <p class="text-navy font-bold text-base mb-3">Washington Hilton Self-Parking</p>
                <ul class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-1.5">
                  <li>Open 24 hours</li>
                  <li>Approximately <strong class="text-navy">$59 plus tax</strong></li>
                  <li>Garage entrance: <strong class="text-navy">1998 19th Street NW</strong></li>
                  <li>Limited availability</li>
                </ul>
              </div>
              <div class="bg-white rounded-lg border border-gold/30 p-5">
                <p class="text-navy font-bold text-base mb-3">Nearby Alternate Parking</p>
                <p class="text-navy font-bold text-sm sm:text-base mb-1">ONE Parking</p>
                <p class="text-slate-700 text-sm sm:text-base mb-2">1666 Connecticut Avenue NW</p>
                <p class="text-slate-700 text-sm sm:text-base">Approximately <strong class="text-navy">$22 flat rate</strong> (subject to change).</p>
              </div>
            </div>

            <!-- Metro -->
            <h3 class="font-heading font-bold text-lg sm:text-xl text-navy mb-4 flex items-center gap-2">
              <span aria-hidden="true">🚇</span> Metro (Recommended)
            </h3>
            <p class="text-slate-800 text-sm sm:text-base leading-relaxed mb-4">
              Metro is one of the easiest ways to reach the Washington Hilton.
            </p>
            <div class="space-y-3 text-slate-800 text-sm sm:text-base leading-relaxed mb-4">
              <p><strong class="text-navy">Dupont Circle Station (Red Line)</strong> &mdash; approximately a four-block walk to the hotel.</p>
              <p><strong class="text-navy">U Street Station (Green Line)</strong> &mdash; approximately 0.9 miles from the hotel.</p>
            </div>
            <p class="text-slate-700 text-sm sm:text-base italic">
              Complete Metro directions and parking information are available in the <a href={parkingMapUrl} target="_blank" rel="noopener noreferrer" class="text-red hover:text-red-light font-bold underline">Parking &amp; Metro Map</a> at the top of this page.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: TRAVEL & TRAFFIC UPDATES                                 -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">🚦</span> Travel &amp; Traffic Updates
            </h2>
          </div>
          <div class="p-6 sm:p-8">
            <p class="text-slate-800 text-sm sm:text-base leading-relaxed mb-4">
              Washington, D.C. will experience significant traffic, road closures, security zones, and increased visitor activity throughout Independence Day weekend.
            </p>
            <p class="text-slate-800 text-sm sm:text-base leading-relaxed mb-6">
              Guests are encouraged to stay informed by signing up for the District of Columbia&rsquo;s official <strong class="text-navy">AlertDC</strong> notifications.
            </p>
            <div class="bg-red text-white rounded-xl p-6 sm:p-7 text-center">
              <p class="text-white/90 text-sm sm:text-base mb-2">Text</p>
              <p class="font-heading font-bold text-2xl sm:text-3xl mb-1 leading-tight">
                &ldquo;DC250&rdquo; to <a href="sms:888777" class="underline hover:text-gold transition-colors">888-777</a>
              </p>
              <p class="text-white/95 text-sm sm:text-base">
                to receive free traffic, transit, public safety, and special event updates from the District of Columbia.
              </p>
            </div>
            <p class="text-slate-700 text-sm sm:text-base mt-4 text-center italic">
              Please allow extra travel time when arriving and departing from the event.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: ARRIVAL & CHECK-IN                                       -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">⏰</span> Arrival &amp; Check-In
            </h2>
          </div>
          <div class="p-6 sm:p-8">
            <div class="grid sm:grid-cols-2 gap-4 mb-6">
              <div class="bg-gold/25 border-2 border-gold rounded-xl p-5">
                <p class="text-navy font-bold tracking-[0.18em] uppercase text-[11px] sm:text-xs mb-3">Statesman &amp; Patriot VIP</p>
                <p class="text-slate-800 text-sm sm:text-base leading-relaxed mb-3">
                  Early check-in begins at <strong class="text-navy">6:30 PM</strong>.
                </p>
                <p class="text-slate-800 text-sm sm:text-base leading-relaxed">
                  VIP Reception, dinner, premium bars, entertainment, and all VIP services begin promptly at <strong class="text-navy">7:00 PM</strong>.
                </p>
              </div>
              <div class="bg-white border border-gold/30 rounded-xl p-5">
                <p class="text-navy font-bold tracking-[0.18em] uppercase text-[11px] sm:text-xs mb-3">Liberty Admission</p>
                <p class="text-slate-800 text-sm sm:text-base leading-relaxed">
                  Doors open at <strong class="text-navy">9:00 PM</strong>.
                </p>
              </div>
            </div>
            <p class="text-slate-800 text-sm sm:text-base leading-relaxed text-center">
              To ensure a smooth arrival, we recommend arriving <strong class="text-navy">30&ndash;45 minutes early</strong>, particularly during peak arrival times.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: CHECK-IN — ticket scanning + Statesman concierge         -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">🎟️</span> Check-In
            </h2>
          </div>
          <div class="p-6 sm:p-8">
            <div class="text-slate-800 text-sm sm:text-base leading-relaxed space-y-3 mb-6">
              <p>Please have your Eventbrite ticket ready before arriving at the entrance.</p>
              <p>Mobile tickets are recommended, although printed tickets are also accepted.</p>
              <p>Guests wishing to consume alcoholic beverages must present a valid government-issued photo ID.</p>
            </div>
            <div class="bg-gold/25 border-2 border-gold rounded-xl p-5 sm:p-6">
              <p class="text-navy font-bold tracking-[0.18em] uppercase text-[11px] sm:text-xs mb-3">Statesman Pass Holders</p>
              <p class="text-slate-800 text-sm sm:text-base leading-relaxed mb-2">
                Upon entering, please ask for a member of our <strong class="text-navy">Statesman Concierge Team</strong>.
              </p>
              <p class="text-slate-800 text-sm sm:text-base leading-relaxed">
                Your concierge will personally escort you to your reserved seating area and assist you with your arrival.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: DRESS CODE                                               -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">👔</span> Dress Code
            </h2>
          </div>
          <div class="p-6 sm:p-8 text-center">
            <p class="text-red font-heading font-bold text-2xl sm:text-3xl md:text-4xl mb-4 leading-tight">Stylish Patriotic Attire</p>
            <p class="text-slate-800 text-base sm:text-lg leading-relaxed mb-2">Festive, polished, and photo-ready.</p>
            <p class="text-slate-700 text-sm sm:text-base leading-relaxed max-w-xl mx-auto">
              Guests are encouraged to celebrate America&rsquo;s 250th Anniversary with tasteful patriotic attire.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: SECURITY INFORMATION                                     -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">🔒</span> Security Information
            </h2>
          </div>
          <div class="p-6 sm:p-8">
            <p class="text-slate-800 text-sm sm:text-base leading-relaxed mb-3">
              The safety and comfort of our guests are our highest priorities.
            </p>
            <p class="text-slate-800 text-sm sm:text-base leading-relaxed mb-5">
              Professional event security will be present throughout the evening to help ensure a safe, welcoming, and enjoyable celebration for everyone.
            </p>
            <p class="text-navy font-bold text-sm sm:text-base mb-3">To help speed entry into the event:</p>
            <ul class="text-slate-800 text-sm sm:text-base leading-relaxed space-y-2 mb-5 pl-6 list-disc marker:text-gold">
              <li>Please allow extra time for security screening.</li>
              <li>All bags are subject to inspection.</li>
              <li>Small purses and handbags are welcome.</li>
              <li><strong class="text-navy">Backpacks, luggage, and oversized bags are not permitted.</strong></li>
              <li>Weapons of any kind are strictly prohibited.</li>
              <li>Illegal drugs or prohibited substances are not permitted.</li>
              <li>Guests who appear visibly intoxicated may be denied admission.</li>
            </ul>
            <p class="text-slate-700 text-sm sm:text-base italic">
              Thank you for helping us create a safe and memorable celebration for everyone.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARDS: WHAT TO BRING / PLEASE LEAVE AT HOME — side-by-side     -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-cream rounded-2xl border-2 border-gold shadow-lg overflow-hidden">
            <div class="bg-gold px-6 py-4">
              <h2 class="text-xl sm:text-2xl font-bold text-navy font-heading flex items-center gap-2">
                <span aria-hidden="true">🎒</span> What to Bring
              </h2>
            </div>
            <div class="p-6">
              <p class="text-navy font-bold text-sm sm:text-base mb-3">Please bring:</p>
              <ul class="text-slate-800 text-sm sm:text-base leading-relaxed space-y-2 pl-6 list-disc marker:text-gold">
                <li>Your Eventbrite ticket (mobile or printed)</li>
                <li>A valid government-issued photo ID if you plan to consume alcoholic beverages</li>
                <li>A fully charged mobile phone</li>
                <li>A portable phone charger (strongly recommended)</li>
                <li>Comfortable shoes if you plan to explore the many experiences throughout the evening</li>
              </ul>
            </div>
          </div>
          <div class="bg-cream rounded-2xl border-2 border-red shadow-lg overflow-hidden">
            <div class="bg-red px-6 py-4">
              <h2 class="text-xl sm:text-2xl font-bold text-white font-heading flex items-center gap-2">
                <span aria-hidden="true">🚫</span> Please Leave at Home
              </h2>
            </div>
            <div class="p-6">
              <p class="text-navy font-bold text-sm sm:text-base mb-3">Please do not bring:</p>
              <ul class="text-slate-800 text-sm sm:text-base leading-relaxed space-y-2 pl-6 list-disc marker:text-red">
                <li>Weapons of any kind</li>
                <li>Illegal drugs or prohibited substances</li>
                <li>Backpacks</li>
                <li>Luggage</li>
                <li>Oversized bags</li>
                <li>Outside food or beverages</li>
                <li>Professional photography or video equipment without media credentials</li>
                <li>Drones</li>
                <li>Fireworks</li>
                <li>Laser pointers</li>
                <li>Any item deemed unsafe by event security</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: PHOTOGRAPHY & VIDEO                                      -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">📸</span> Photography &amp; Video
            </h2>
          </div>
          <div class="p-6 sm:p-8">
            <div class="text-slate-800 text-sm sm:text-base leading-relaxed space-y-3">
              <p>Professional photographers and videographers will be covering the event throughout the evening.</p>
              <p>By attending Countdown 250, you acknowledge that photographs and video may be taken and used for promotional, marketing, news, documentary, and archival purposes.</p>
              <p>Guests are encouraged to capture and share their own experience on social media.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: ACCESSIBILITY                                            -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">♿</span> Accessibility
            </h2>
          </div>
          <div class="p-6 sm:p-8">
            <div class="text-slate-800 text-sm sm:text-base leading-relaxed space-y-3">
              <p>Accessible entrances, elevators, and ADA seating are available.</p>
              <p>If you require assistance during the evening, please notify a member of our Guest Services team.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARD: CELL SERVICE & CONNECTIVITY                              -->
    <!-- ============================================================ -->
    <section class="py-6 sm:py-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-cream rounded-2xl border border-gold/30 shadow-lg overflow-hidden">
          <div class="bg-navy px-6 sm:px-8 py-4 sm:py-5">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading flex items-center gap-3">
              <span aria-hidden="true">📱</span> Cell Service &amp; Connectivity
            </h2>
          </div>
          <div class="p-6 sm:p-8">
            <p class="text-slate-800 text-sm sm:text-base leading-relaxed mb-4">
              Because of the hotel&rsquo;s construction and the large number of guests attending the event:
            </p>
            <ul class="text-slate-800 text-sm sm:text-base leading-relaxed space-y-2.5 mb-5 pl-6 list-disc marker:text-red">
              <li><strong class="text-navy">Cellular service will be limited in the lower-level areas of the hotel, including the Main Ballroom and several of the other entertainment areas.</strong></li>
              <li><strong class="text-navy">Public Wi-Fi is not available for event guests.</strong></li>
              <li>Please download your Eventbrite ticket to your phone before arriving.</li>
              <li>Bringing a portable phone charger is strongly recommended.</li>
            </ul>
            <p class="text-slate-700 text-sm sm:text-base italic">
              Planning ahead will help ensure a smooth check-in experience.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
