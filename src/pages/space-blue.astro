---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

/*
 * SPACE BLUE AT COUNTDOWN 250 — LIVE PAGE (went live 2026-05-22)
 * ----------------------------------------------------------------
 * Live URL: /space-blue/. Included in the sitemap and linked from
 * the main navigation ("More" dropdown). Promoted from the
 * /space-blue-preview/ build, which is preserved (sitemap-excluded)
 * as a backup/staging reference.
 *
 * Premium experience page for guests / media / sponsors / partners.
 * Copy is provided verbatim by Mike and must not be embellished.
 *
 * Guardrails baked into the copy: no NASA/SpaceX/government
 * endorsement language, no '×' symbol, no emojis, no prices /
 * product listings / cart, no embedded video (placeholder only),
 * named historic figures are always hedged with 'expected to
 * include'. First 'Space Blue' in the hero body links to
 * spaceblue.club (new tab); all external links open in a new tab.
 */

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
const spaceBlueUrl = "https://www.spaceblue.club";

const heroChips = [
  "Lunaprise Lunar Museum",
  "Hologram-Style Exhibits",
  "Certified Lunar Art Collectibles",
  "Iconic Art & American Heroes",
];

const historyFacts = [
  { title: "Lunaprise Lunar Museum", copy: "A lunar museum experience curated by Space Blue and connected to art reproductions sent to the Moon." },
  { title: "February 22, 2024", copy: "The IM-1 mission landed near the Moon&rsquo;s south polar region." },
  { title: "First U.S. Soft Lunar Landing Since 1972", copy: "A modern milestone in America&rsquo;s return to the lunar surface." },
];

const activations = [
  { title: "Lunaprise Lunar Museum", copy: "Explore a lunar museum experience curated by Space Blue and connected to certified art reproductions sent to the Moon. This activation celebrates exploration, creativity, preservation, and the American drive to reach beyond what seems possible." },
  { title: "Historic Hologram-Style Exhibits", copy: "Experience lifelike hologram-style exhibits bringing pivotal American moments, iconic speeches, and cultural milestones to life. These exhibits are designed to make history feel present, personal, and unforgettable." },
  { title: "Certified Lunar Art Collectibles", copy: "Discover certified prints, canvas works, and digital art tied to reproductions sent to the Moon. These collectibles connect art, technology, history, and the extraordinary story of America&rsquo;s return to the lunar surface." },
  { title: "Iconic Art & American Heroes", copy: "Encounter music, sports, space, modern, and classic art connected to a mission to support American heroes. This activation brings together creativity, patriotism, culture, and purpose." },
];

// Hologram-style display-case figures (approved Space Blue assets).
const holograms = [
  { img: "/images/space-blue/holo-washington.jpg", name: "George Washington" },
  { img: "/images/space-blue/holo-jfk.jpg", name: "John F. Kennedy" },
  { img: "/images/space-blue/holo-elvis.jpg", name: "Elvis" },
  { img: "/images/space-blue/holo-astronaut.jpg", name: "American Astronaut" },
];

const lunarItems = [
  { title: "Certified Prints", copy: "Collectible works tied to art reproductions sent to the Moon." },
  { title: "Canvas Works", copy: "Display-ready pieces connected to the Lunaprise lunar story." },
  { title: "Digital Art", copy: "Digital collectibles connected to Space Blue&rsquo;s lunar art experience." },
];

const heroesCards = [
  { title: "Service", copy: "Honoring those who serve and sacrifice for the freedoms America celebrates." },
  { title: "Creativity", copy: "Celebrating artists, innovators, explorers, and storytellers who help shape culture." },
  { title: "Discovery", copy: "Connecting guests to the American spirit of exploration, imagination, and possibility." },
];
---

<BaseLayout
  title="Space Blue at Countdown 250 | Lunaprise Lunar Museum & Immersive Experiences | July 3, 2026"
  description="Space Blue made history with the Lunaprise lunar time capsule that landed on the Moon — and brings that spirit of exploration to the Official Countdown 250 Ball: the Lunaprise Lunar Museum, lifelike hologram-style exhibits, certified lunar art collectibles, and iconic American moments brought to life."
  ogImage="/images/event/header-flag.jpg"
>
  <Navbar />
  <main
    class="relative text-white"
    style="background: radial-gradient(circle at 30% 20%, rgba(4, 61, 156, 0.5) 0%, transparent 55%), linear-gradient(135deg, #04143f 0%, #021a4d 50%, #04205a 100%); background-attachment: fixed;"
  >
    <!-- ============================================================ -->
    <!-- 1. HERO BANNER — canonical sub-page pattern (matches /icons/, -->
    <!-- /honorees/, /partners/, /freedom-bell/): full-width navy band  -->
    <!-- + flush-left gold ribbon with the page H1. The Space Blue logo -->
    <!-- is a square brand mark on navy, so it is shown as a centered,  -->
    <!-- gold-framed card (object-contain) rather than a cropped        -->
    <!-- full-bleed photo, to keep the wordmark and star intact.        -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <div
        class="relative w-full h-[56vh] sm:h-[60vh] min-h-[360px] max-h-[620px]"
        style="background: radial-gradient(120% 90% at 50% 40%, rgba(40, 88, 172, 0.5) 0%, rgba(10, 22, 58, 0.85) 46%, #070f2b 80%);"
      >
        <!-- top scrim behind the transparent fixed navbar -->
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-navy-dark/70 to-transparent pointer-events-none"></div>

        <!-- logo card, centered & contained -->
        <div class="absolute inset-0 flex items-center justify-center px-6 pt-16 pb-20">
          <img
            src="/images/partners/space-blue-logo.jpg"
            alt="Space Blue logo"
            class="h-full w-auto max-h-[300px] sm:max-h-[360px] lg:max-h-[400px] object-contain rounded-2xl ring-1 ring-gold/25 shadow-[0_18px_50px_-12px_rgba(0,0,0,0.6)]"
            decoding="async"
          />
        </div>

        <!-- flush-left gold ribbon with the page H1 -->
        <div class="absolute inset-y-0 left-0 flex items-end pb-4 sm:pb-8 md:pb-10 pointer-events-none">
          <div class="bg-gradient-to-r from-gold to-[#f4d847] py-2.5 sm:py-3.5 md:py-4 lg:py-5 pl-3 sm:pl-8 md:pl-14 lg:pl-20 xl:pl-28 pr-5 sm:pr-8 md:pr-12 lg:pr-14 border-y-2 border-r-2 border-navy-dark/35 rounded-r-2xl shadow-[0_14px_32px_-10px_rgba(0,0,0,0.55)] pointer-events-auto">
            <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-navy font-heading leading-none tracking-tight">
              Space Blue Interactive Experience
            </h1>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 1a. ENTER THE EXPERIENCE — high-impact intro right below the   -->
    <!-- hero. Sells the attendee's first-person experience: holograms, -->
    <!-- art collaboration, lunar mission keepsake, immersive          -->
    <!-- environments. Sits before the longer Space-Blue-as-a-partner  -->
    <!-- intro at section 1b.                                          -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden pt-14 sm:pt-20 pb-4 sm:pb-6">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

        <p class="text-gold font-bold tracking-[0.35em] uppercase text-xs sm:text-sm mb-6">
          Enter the Experience
        </p>

        <h2 class="font-heading font-extrabold text-white leading-[1.05] text-3xl sm:text-4xl md:text-5xl mb-3">
          This isn&rsquo;t an exhibit.
        </h2>
        <h2 class="font-heading font-extrabold text-gold leading-[1.05] text-3xl sm:text-4xl md:text-5xl mb-7">
          It&rsquo;s an unforgettable journey into America&rsquo;s past, present, and future.
        </h2>

        <div class="w-24 h-px bg-gold/60 mx-auto mb-8 sm:mb-10"></div>

        <div class="text-white/90 text-base sm:text-lg leading-relaxed space-y-5 text-left max-w-3xl mx-auto">
          <p>
            From the moment you step inside, you&rsquo;ll be immersed in a breathtaking world of <strong class="text-gold-light">dynamic lighting, larger-than-life visuals, interactive technology, music, and stunning artistic experiences</strong> that transform the room into a celebration of American innovation and imagination.
          </p>
          <p>
            Meet <strong class="text-gold-light">lifelike holographic historical figures</strong> who seem to come to life before your eyes. Capture unforgettable selfies with emerging holographic icons from throughout American history. Then <strong class="text-gold-light">become part of history yourself</strong> as you collaborate with renowned artists to create an original work of art &mdash; one you can take home as a keepsake. <strong class="text-gold-light">Selected creations will even become part of a future lunar mission</strong>, giving guests the extraordinary opportunity to help create artwork that will literally travel to the Moon.
          </p>
          <p>
            Every corner of the experience is designed to <strong>surprise, inspire, and invite participation</strong>. From immersive visual environments and interactive displays to spectacular photo opportunities and one-of-a-kind artistic collaborations, the Space Blue Interactive Experience is unlike anything you&rsquo;ve experienced at a gala before.
          </p>
        </div>

        <div class="mt-10 sm:mt-12 max-w-2xl mx-auto">
          <p class="text-white font-heading font-bold text-xl sm:text-2xl md:text-3xl leading-tight">
            It&rsquo;s not just something you&rsquo;ll see.
          </p>
          <p class="text-gold font-heading font-bold text-xl sm:text-2xl md:text-3xl leading-tight mt-2">
            It&rsquo;s something you&rsquo;ll step inside, interact with, and remember for the rest of your life.
          </p>
        </div>

      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 1b. INTRO — two-column (left copy + 2 CTAs, right visual      -->
    <!-- card). Mobile stacks: eyebrow, headline, subhead, body,       -->
    <!-- buttons, visual card, chips.                                  -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden pt-12 sm:pt-16 pb-16 sm:pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">

          <!-- LEFT -->
          <div>
            <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-5">
              Immersive Experiences at Countdown 250
            </p>
            <h2 class="font-heading font-bold text-white leading-tight text-3xl sm:text-4xl lg:text-5xl mb-5">
              <span class="block">Space Blue Makes History...</span>
              <span class="block text-gold">And Brings It to Life at Countdown 250</span>
            </h2>
            <div class="w-20 h-1 bg-gold mb-7"></div>

            <p class="text-white/90 text-lg sm:text-xl leading-relaxed mb-6">
              A one-of-a-kind interactive experience celebrating American history, space exploration,
              art, innovation, and the spirit of discovery.
            </p>

            <div class="text-white/80 text-base sm:text-lg leading-relaxed space-y-4 mb-6">
              <p>
                <a href={spaceBlueUrl} target="_blank" rel="noopener noreferrer" class="text-gold underline decoration-gold/40 hover:decoration-gold underline-offset-2">Space Blue</a>
                made history with the Lunaprise lunar time capsule that landed on the Moon. Now Space Blue
                brings that same spirit of exploration to the Official Countdown 250 Ball with hands-on
                activations celebrating American history, art, innovation, and discovery.
              </p>
              <p>
                You will explore the Lunaprise Lunar Museum curated by Space Blue, experience lifelike
                hologram-style exhibits, discover certified lunar art collectibles, and encounter iconic
                American moments brought to life.
              </p>
            </div>

            <p class="text-gold font-heading font-bold text-lg sm:text-xl mb-8">
              Walk through it. Experience it. Photograph it. Remember it.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={ticketUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-8 py-4 text-sm sm:text-base font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
              >
                Get Tickets
              </a>
              <a
                href={spaceBlueUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block text-center border-2 border-gold text-gold hover:bg-gold hover:text-navy-dark px-8 py-4 text-sm sm:text-base font-bold tracking-wider uppercase transition-all rounded"
              >
                Visit Space Blue
              </a>
            </div>
          </div>

          <!-- RIGHT — visual card -->
          <div class="bg-navy-dark/70 border border-gold/40 rounded-2xl p-6 sm:p-8 shadow-[0_18px_40px_-16px_rgba(0,0,0,0.65)] backdrop-blur-sm">
            <!-- Space Blue / Lunaprise lander poster (approved asset) -->
            <div class="rounded-xl border border-gold/25 overflow-hidden mb-6 shadow-[0_14px_34px_-12px_rgba(0,0,0,0.6)]">
              <img
                src="/images/space-blue/lunaprise-lander.jpg"
                alt="Lunaprise — First Art Museum on the Moon: the IM-1 lunar lander with American flags above Earth, presented by Space Blue"
                class="w-full h-auto block"
                loading="lazy"
                decoding="async"
              />
            </div>

            <h2 class="text-gold font-heading font-bold text-xl sm:text-2xl mb-3">From the Moon to Countdown 250</h2>
            <p class="text-white/80 text-sm sm:text-base leading-relaxed mb-6">
              Space Blue brings together lunar history, American icons, immersive exhibits, certified art
              collectibles, and interactive experiences for a celebration worthy of America&rsquo;s 250th
              birthday.
            </p>
            <div class="flex flex-wrap gap-2">
              {heroChips.map((chip) => (
                <span class="inline-block bg-white/[0.07] border border-gold/30 text-white/85 text-xs sm:text-sm rounded-full px-3 py-1.5">{chip}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. MADE HISTORY — centered intro + 3 fact cards               -->
    <!-- ============================================================ -->
    <section class="py-16 sm:py-20 bg-navy-dark border-y border-gold/25">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
            From the Moon to America&rsquo;s 250th
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
            A historic lunar story comes to Washington, D.C.
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <!-- Commemorative mission emblems (approved Space Blue assets) -->
        <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 mb-12">
          <img
            src="/images/space-blue/usa250-seal.jpg"
            alt="U.S.A. 250 · Lunaprise · Space Blue commemorative seal"
            class="w-28 sm:w-36 h-28 sm:h-36 rounded-full object-cover ring-2 ring-gold/40 shadow-[0_12px_30px_-8px_rgba(0,0,0,0.65)]"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/images/space-blue/lunaprise-emblem.jpg"
            alt="Lunaprise lunar south pole mission emblem, landed February 22, 2024"
            class="w-28 sm:w-36 h-28 sm:h-36 rounded-full object-cover ring-2 ring-gold/40 shadow-[0_12px_30px_-8px_rgba(0,0,0,0.65)]"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="text-white/80 text-base sm:text-lg leading-relaxed space-y-5 max-w-3xl mx-auto mb-12">
          <p>
            The Lunaprise Lunar Museum curated by Space Blue is connected to one of the most remarkable
            space-history moments of the modern era: a lunar time capsule that landed on the Moon.
          </p>
          <p>
            The IM-1 mission landed near the Moon&rsquo;s south polar region on February 22, 2024, marking
            the first U.S. soft lunar landing since 1972. Space Blue&rsquo;s Lunaprise experience brings
            that historic spirit of exploration, preservation, creativity, and discovery to Countdown 250.
          </p>
          <p>
            At the Official Countdown 250 Ball, that story becomes part of a larger celebration of
            America&rsquo;s past, present, and future.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-5 sm:gap-6">
          {historyFacts.map((f) => (
            <div class="bg-white/[0.05] border border-gold/30 rounded-xl p-6 text-center">
              <p class="text-gold font-heading font-bold text-lg sm:text-xl mb-2">{f.title}</p>
              <p class="text-white/75 text-sm sm:text-base leading-relaxed" set:html={f.copy} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. FEATURED ACTIVATIONS — 4-card grid                          -->
    <!-- ============================================================ -->
    <section class="py-16 sm:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
            Featured Space Blue Activations
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
            Explore, create, remember, and imagine.
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto mb-6"></div>
          <p class="text-white/80 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto">
            Space Blue will be on site with multiple interactive activations designed to give guests a
            hands-on, visually rich, and unforgettable experience.
          </p>
        </div>

        <!-- Lunaprise overview banner (approved Space Blue asset) -->
        <div class="mb-10 sm:mb-12 rounded-2xl overflow-hidden border border-gold/30 shadow-[0_18px_40px_-16px_rgba(0,0,0,0.6)]">
          <img
            src="/images/space-blue/lunaprise-overview.jpg"
            alt="Lunaprise — First Art Museum on the Moon: lunar landing and iconic moments in American art history, presented by Space Blue"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="grid sm:grid-cols-2 gap-5 sm:gap-6">
          {activations.map((a) => (
            <div class="bg-white/[0.05] border border-gold/30 rounded-xl p-6 sm:p-7">
              <h3 class="text-gold font-heading font-bold text-lg sm:text-xl mb-2">{a.title}</h3>
              <p class="text-white/80 text-sm sm:text-base leading-relaxed" set:html={a.copy} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 4. HISTORIC MOMENTS BROUGHT TO LIFE — 2-col                    -->
    <!-- ============================================================ -->
    <section class="py-16 sm:py-20 bg-navy-dark border-y border-gold/25">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
          <div>
            <p class="text-gold font-bold tracking-[0.22em] uppercase text-xs sm:text-sm mb-4">
              Historic Voices. Pivotal Moments. Brought to Life.
            </p>
            <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
              You will see, hear, and feel America&rsquo;s story come alive.
            </h2>
            <div class="w-16 h-1 bg-gold mb-7"></div>
            <div class="text-white/80 text-base sm:text-lg leading-relaxed space-y-5">
              <p>
                Some moments in American history are remembered not only because of what happened, but
                because of what was said, what was achieved, and who had the courage to move the nation
                forward.
              </p>
              <p>
                Through lifelike hologram-style exhibits and immersive storytelling, Space Blue will help
                guests encounter pivotal American moments in a powerful new way.
              </p>
              <p>
                Featured moments are expected to include tributes inspired by JFK&rsquo;s Moon Speech,
                Abraham Lincoln, Dr. Martin Luther King Jr., the Apollo 11 landing, Elvis, iconic U.S.
                sports moments, and more of America&rsquo;s greatest cultural and historic milestones.
              </p>
            </div>
            <p class="text-gold font-heading font-bold text-lg sm:text-xl mt-7">
              History won&rsquo;t just be remembered. It will be experienced.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:gap-5">
            {holograms.map((h) => (
              <figure class="rounded-xl overflow-hidden border border-gold/30 bg-navy-dark shadow-[0_14px_30px_-12px_rgba(0,0,0,0.6)]">
                <img
                  src={h.img}
                  alt={`Hologram-style display of ${h.name}`}
                  class="w-full aspect-[3/4] object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="text-center text-white/75 text-xs sm:text-sm font-semibold tracking-wide py-2.5 px-1">{h.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 5. LUNAR ART COLLECTIBLES — split text / item list            -->
    <!-- ============================================================ -->
    <section class="py-16 sm:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
          <div>
            <p class="text-gold font-bold tracking-[0.22em] uppercase text-xs sm:text-sm mb-4">
              Own a Piece of Space-History Storytelling
            </p>
            <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
              Certified lunar art collectibles connected to the Moon.
            </h2>
            <div class="w-16 h-1 bg-gold mb-7"></div>
            <div class="text-white/80 text-base sm:text-lg leading-relaxed space-y-5">
              <p>
                Space Blue&rsquo;s Countdown 250 presence is expected to include certified lunar art
                collectibles, including prints, canvas works, and digital art tied to reproductions sent
                to the Moon.
              </p>
              <p>
                These pieces connect guests to a remarkable story at the intersection of art, technology,
                space exploration, and American history.
              </p>
              <p>
                This is not just art inspired by space. It is art connected to a lunar time capsule and a
                new chapter in America&rsquo;s space story.
              </p>
            </div>
            <!-- Iconic-art auction poster (approved Space Blue asset) -->
            <div class="mt-8 rounded-2xl overflow-hidden border border-gold/30 shadow-[0_18px_40px_-16px_rgba(0,0,0,0.6)]">
              <img
                src="/images/space-blue/lunaprise-art-auction.jpg"
                alt="Lunaprise lunar art silent charity auction — iconic moments in American art history, certified rare reproductions connected to the Moon landing"
                class="w-full h-auto block"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div>
            <div class="space-y-5">
              {lunarItems.map((item) => (
                <div class="bg-white/[0.05] border border-gold/30 rounded-xl p-6">
                  <h3 class="text-gold font-heading font-bold text-lg mb-1.5">{item.title}</h3>
                  <p class="text-white/80 text-sm sm:text-base leading-relaxed" set:html={item.copy} />
                </div>
              ))}
            </div>
            <p class="text-white/45 text-xs sm:text-sm leading-relaxed mt-5">
              Additional details about available items, pricing, and online purchase options may be added
              as they are finalized.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 6. SUPPORT AMERICAN HEROES — mission section + 3 cards        -->
    <!-- ============================================================ -->
    <section class="py-16 sm:py-20 bg-navy-dark border-y border-gold/25">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
            Art, History, and Purpose
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
            Supporting American heroes through a celebration of creativity and service.
          </h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-white/80 text-base sm:text-lg leading-relaxed space-y-5 max-w-3xl mx-auto mb-12">
          <p>
            The Space Blue experience at Countdown 250 is also connected to a broader patriotic purpose:
            celebrating American heroes and honoring the spirit of service, sacrifice, courage, and
            creativity.
          </p>
          <p>
            Through art, history, immersive exhibits, and guest engagement, Space Blue helps add a
            meaningful mission-driven layer to the evening.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-5 sm:gap-6">
          {heroesCards.map((c) => (
            <div class="bg-white/[0.05] border border-gold/30 rounded-xl p-6 text-center">
              <h3 class="text-gold font-heading font-bold text-lg sm:text-xl mb-2">{c.title}</h3>
              <p class="text-white/75 text-sm sm:text-base leading-relaxed">{c.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 7. VIDEO PREVIEW — self-hosted Space Blue video (live)         -->
    <!-- ============================================================ -->
    <section class="py-16 sm:py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
          Video Preview
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white font-heading leading-tight mb-5">
          See the Space Blue experience before event night.
        </h2>
        <div class="w-16 h-1 bg-gold mx-auto mb-8"></div>

        <div class="text-white/80 text-base sm:text-lg leading-relaxed space-y-5 max-w-3xl mx-auto mb-10">
          <p>
            A short preview of the Space Blue experience &mdash; the Lunaprise Lunar Museum,
            hologram-style exhibits, lunar art collectibles, and immersive activations planned
            for the Countdown 250 Ball.
          </p>
        </div>

        <!-- Self-hosted Space Blue video. preload="none" so the 37 MB file
             only downloads when a visitor presses play. -->
        <div class="relative aspect-video rounded-2xl border border-gold/40 bg-navy-dark/70 overflow-hidden mb-8 shadow-[0_18px_40px_-16px_rgba(0,0,0,0.65)]">
          <video
            class="absolute inset-0 w-full h-full"
            controls
            playsinline
            preload="none"
            poster="/videos/space-blue-poster.jpg"
          >
            <source src="/videos/space-blue.mp4" type="video/mp4" />
          </video>
        </div>

        <a
          href={spaceBlueUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-center border-2 border-gold text-gold hover:bg-gold hover:text-navy-dark px-8 py-4 text-sm sm:text-base font-bold tracking-wider uppercase transition-all rounded"
        >
          Visit Space Blue
        </a>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 8. FINAL CTA                                                   -->
    <!-- ============================================================ -->
    <section class="py-16 sm:py-20 bg-navy-dark border-t border-gold/25">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-gold font-bold tracking-[0.25em] uppercase text-xs sm:text-sm mb-4">
          Experience It at Countdown 250
        </p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white font-heading leading-tight mb-5">
          Be there when history, innovation, and celebration come to life.
        </h2>
        <div class="w-16 h-1 bg-gold mx-auto mb-8"></div>

        <div class="text-white/80 text-base sm:text-lg leading-relaxed space-y-5 max-w-3xl mx-auto mb-8">
          <p>
            On July 3, 2026, the Official Countdown 250 Ball will bring together elegance, entertainment,
            patriotism, history, innovation, and immersive experiences for one unforgettable Independence
            Eve celebration.
          </p>
          <p>
            Space Blue will help make the evening more than a ball. It will be a walk-through, hands-on,
            photo-worthy experience connecting guests to the Moon, American icons, historic moments, art,
            and the spirit of discovery.
          </p>
        </div>

        <p class="text-gold font-heading font-bold text-xl sm:text-2xl leading-snug mb-9">
          America&rsquo;s 250th birthday deserves more than a celebration. It deserves an experience.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={ticketUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-center bg-gradient-to-b from-gold to-[#B8954A] hover:from-[#D9B864] hover:to-gold text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
          >
            Get Tickets
          </a>
          <a
            href="/"
            class="inline-block text-center border-2 border-gold text-gold hover:bg-gold hover:text-navy-dark px-10 py-4 text-base sm:text-lg font-bold tracking-wider uppercase transition-all rounded"
          >
            Return to Homepage
          </a>
        </div>
      </div>
    </section>
  </main>
  <!-- CHANGE 10: clear vertical separation so the global footer      -->
  <!-- "Be in the Room When It Happens" CTA below reads as distinct    -->
  <!-- from this page's own Space Blue final CTA above (rather than as  -->
  <!-- two stacked closing CTAs). Global footer is left fully intact.  -->
  <div class="h-1.5 w-full bg-gradient-to-r from-gold/70 via-gold to-gold/70"></div>
  <div class="bg-navy-dark py-10 sm:py-14">
    <div class="h-1 w-28 mx-auto rounded-full bg-gradient-to-r from-gold/50 via-gold to-gold/50"></div>
  </div>
  <Footer />
</BaseLayout>
