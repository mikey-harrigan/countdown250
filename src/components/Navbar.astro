---
// `enhancedTopBar={true}` swaps the existing event-identity bar for the
// "name + date + city + live countdown" variant (used by the
// /homepage-news-bar-preview/ preview). Default false so all other pages
// stay exactly as they were.
//
// `awardsLabel` prop kept for backward compatibility with preview
// callers — now a no-op since "Awards" -> /#awards is the live default.
interface Props {
  enhancedTopBar?: boolean;
  awardsLabel?: boolean;
}
const { enhancedTopBar = false } = Astro.props;

const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
const base = "";

// Primary nav restructured 2026-06-17 per Mike for clearer, more
// sales-focused navigation. Six top-level items, three of which open
// dropdowns. Two plain anchor links (Tickets, Hosted Groups, Partners).
//
// Items with `items` render as dropdown menus; items with `href` render
// as plain top-level links. All dropdown trigger/menu pairs share the
// same `.nav-dropdown` wrapper + `.nav-dropdown-trigger` /
// `.nav-dropdown-menu` classes so a single generic click handler can
// toggle any of them with proper mutual exclusivity (one open closes
// the rest).
const primaryNav: Array<
  | { label: string; href: string }
  | { label: string; items: { label: string; href: string }[] }
> = [
  {
    label: "Experiences",
    items: [
      { label: "Experience Overview", href: "/#experience" },
      { label: "Space Blue Interactive Zone", href: `${base}/space-blue/` },
      { label: "America’s Freedom Bell", href: `${base}/freedom-bell/` },
    ],
  },
  { label: "Lineup", href: `${base}/entertainment/` },
  { label: "Tickets", href: "/#tickets" },
  {
    label: "Awards",
    items: [
      { label: "Awards Overview", href: "/#awards" },
      { label: "All-American Heroes", href: `${base}/honorees/` },
      { label: "All-American Icons", href: `${base}/icons/` },
    ],
  },
  {
    label: "More",
    items: [
      { label: "Know Before You Go", href: `${base}/guest-guide/` },
      { label: "Hosted Groups", href: `${base}/hosted-group-tables/` },
      { label: "Partners", href: `${base}/partners/` },
      { label: "Venue", href: `${base}/venue/` },
      { label: "News & Updates", href: `${base}/updates/` },
      { label: "Press", href: `${base}/press/` },
      { label: "FAQ", href: `${base}/faq/` },
    ],
  },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-navy-dark/70 backdrop-blur-sm" style="overflow: visible;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" style="overflow: visible;">
    <div class="flex items-center justify-between h-20" style="overflow: visible;">
      <!-- Logo — oval-framed horizontal wordmark. Fits cleanly in nav bar at small sizes. -->
      <a href="/" class="flex-shrink-0 relative z-10" style="overflow: visible; align-self: center;">
        <picture>
          <source srcset="/images/logos/countdown250-wordmark-navbar-blue.webp" type="image/webp" />
          <img
            id="nav-logo"
            src="/images/logos/countdown250-wordmark-navbar-blue.png"
            alt="The Official Countdown 250 Ball"
            class="drop-shadow-lg transition-all duration-500 ease-out nav-logo-img"
          />
        </picture>
      </a>

      <!-- Desktop Nav — 6 top-level items, three with dropdowns -->
      <div class="hidden lg:flex items-center gap-5">
        {primaryNav.map((item) => (
          'items' in item ? (
            <div class="nav-dropdown relative">
              <button
                type="button"
                aria-expanded="false"
                aria-haspopup="true"
                class="nav-dropdown-trigger text-white/90 hover:text-white text-sm font-medium tracking-wide uppercase transition-colors flex items-center gap-1"
              >
                {item.label}
                <svg class="w-3.5 h-3.5 mt-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="nav-dropdown-menu hidden absolute right-0 top-full pt-2">
                <div class="bg-navy-dark/95 backdrop-blur-sm rounded-lg shadow-xl border border-white/10 py-2 min-w-[220px]">
                  {item.items.map((sub) => (
                    <a href={sub.href} class="block px-4 py-2 text-white/80 hover:text-white hover:bg-white/10 text-sm font-medium tracking-wide transition-colors">{sub.label}</a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={item.href} class="text-white/90 hover:text-white text-sm font-medium tracking-wide uppercase transition-colors">{item.label}</a>
          )
        ))}

        <a
          href="/#tickets"
          class="navbar-get-tickets-pulse px-9 py-2.5 text-sm font-bold tracking-wider uppercase rounded"
        >
          <span class="navbar-get-tickets-text">Get Tickets</span>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="lg:hidden text-white p-2" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu — same hierarchy as desktop, but always-expanded
       nested groups (no accordion). Headers are non-clickable section
       labels above their nested sub-links. Plain top-level items
       remain ordinary links. -->
  <div id="mobile-menu" class="hidden lg:hidden bg-navy-dark/95 backdrop-blur-sm">
    <div class="px-4 py-6 space-y-4">
      {primaryNav.map((item) => (
        'items' in item ? (
          <div class="border-t border-white/10 pt-3 first:border-t-0 first:pt-0">
            <p class="text-gold text-xs font-bold uppercase tracking-[0.18em] mb-2">{item.label}</p>
            <div class="pl-3 space-y-1.5">
              {item.items.map((sub) => (
                <a href={sub.href} class="block text-white/85 hover:text-white text-sm font-medium tracking-wide py-1">{sub.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class="block text-white/90 hover:text-white text-sm font-medium tracking-wide uppercase">{item.label}</a>
        )
      ))}
      <a
        href="/#tickets"
        class="block bg-red text-white px-6 py-3 text-sm font-semibold tracking-wider uppercase text-center hover:bg-red-light transition-colors rounded mt-4"
      >
        Get Tickets
      </a>
    </div>
  </div>

  {enhancedTopBar ? (
    <!-- Enhanced top bar (preview variant): name + date + city on the left,
         live "Countdown: Xd Yh Zm" on the right. Mobile collapses to a
         shortened title + "X days to go". -->
    <div class="bg-navy-dark/95 border-t border-gold/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-1.5 sm:py-2">
        <div class="flex items-center justify-center flex-wrap gap-x-4 sm:gap-x-6 md:gap-x-8 gap-y-1 text-[11px] sm:text-xs md:text-sm leading-tight">
          <h1 class="min-w-0">
            <span class="hidden sm:inline">
              <span class="font-heading italic font-bold text-gold tracking-wide">The Official Countdown 250 Ball</span>
              <span class="mx-2 text-gold/60">&#10022;</span>
              <span class="text-white/90 tracking-[0.1em] uppercase">July 3, 2026</span>
              <span class="mx-2 text-gold/60">&#10022;</span>
              <span class="text-white/90 tracking-[0.1em] uppercase">Washington, D.C.</span>
            </span>
            <span class="sm:hidden">
              <span class="font-heading italic font-bold text-gold tracking-wide">Countdown 250 Ball</span>
              <span class="mx-1 text-gold/60">&#10022;</span>
              <span class="text-white/90 tracking-[0.08em] uppercase">July 3, 2026</span>
              <span class="mx-1 text-gold/60">&#10022;</span>
              <span class="text-white/90 tracking-[0.08em] uppercase">Washington, D.C.</span>
            </span>
          </h1>
          <div class="flex-shrink-0 whitespace-nowrap">
            <span class="hidden sm:inline-flex items-baseline gap-3 md:gap-4">
              <span class="text-gold uppercase tracking-[0.15em] font-bold">Countdown to the Countdown 250 Ball</span>
              <span class="inline-flex items-baseline gap-2.5 md:gap-3 tabular-nums">
                <span><span class="text-white" data-cd-d>—</span><span class="text-gold/70 ml-0.5 text-[0.78em] uppercase">d</span></span>
                <span><span class="text-white" data-cd-h>—</span><span class="text-gold/70 ml-0.5 text-[0.78em] uppercase">h</span></span>
                <span><span class="text-white" data-cd-m>—</span><span class="text-gold/70 ml-0.5 text-[0.78em] uppercase">m</span></span>
                <span><span class="text-white" data-cd-s>—</span><span class="text-gold/70 ml-0.5 text-[0.78em] uppercase">s</span></span>
              </span>
            </span>
            <span class="sm:hidden">
              <span class="text-white/90 tabular-nums" data-topbar-cd-mobile>—</span>
              <span class="text-gold/80 ml-1">to go</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <!-- Event identity bar — thin band directly below the nav row.
         Coded as <h1> per Mike: name + date + city + venue, single
         line on sm+, stacks on mobile. Brand colors (navy-dark bg,
         gold accents on white text). -->
    <div class="bg-navy-dark/95 border-t border-gold/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-1.5 sm:py-2 text-center">
        <h1 class="text-[11px] sm:text-xs md:text-sm leading-tight">
          <span class="font-heading italic font-bold text-gold tracking-wide">The Official Countdown 250 Ball</span>
          <span class="hidden sm:inline mx-2 text-gold/60">&#10022;</span>
          <span class="block sm:inline text-white/90 tracking-[0.1em] uppercase">July 3, 2026</span>
          <span class="hidden sm:inline mx-2 text-gold/60">&#10022;</span>
          <span class="block sm:inline text-white/90 tracking-[0.1em] uppercase">Washington Hilton &middot; Washington, D.C.</span>
        </h1>
      </div>
    </div>
  )}
</nav>

{enhancedTopBar && (
  <script is:inline>
    (function () {
      var target = new Date('2026-07-03T19:00:00-04:00').getTime();
      var dDays = document.querySelectorAll('[data-cd-d]');
      var dHours = document.querySelectorAll('[data-cd-h]');
      var dMin = document.querySelectorAll('[data-cd-m]');
      var dSec = document.querySelectorAll('[data-cd-s]');
      var mEls = document.querySelectorAll('[data-topbar-cd-mobile]');
      function pad(n) { return n < 10 ? '0' + n : String(n); }
      function tick() {
        var diff = target - Date.now();
        if (diff <= 0) {
          dDays.forEach(function (el) { el.textContent = '0'; });
          dHours.forEach(function (el) { el.textContent = '00'; });
          dMin.forEach(function (el) { el.textContent = '00'; });
          dSec.forEach(function (el) { el.textContent = '00'; });
          mEls.forEach(function (el) { el.textContent = '0 days'; });
          return;
        }
        var days = Math.floor(diff / 86400000);
        var hours = Math.floor((diff / 3600000) % 24);
        var minutes = Math.floor((diff / 60000) % 60);
        var seconds = Math.floor((diff / 1000) % 60);
        dDays.forEach(function (el) { el.textContent = days; });
        dHours.forEach(function (el) { el.textContent = pad(hours); });
        dMin.forEach(function (el) { el.textContent = pad(minutes); });
        dSec.forEach(function (el) { el.textContent = pad(seconds); });
        mEls.forEach(function (el) { el.textContent = days + ' days'; });
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>
)}

<script>
  // Navbar scroll effect with logo resize
  // The new blue banner wordmark is ~4.66:1 aspect (much wider than the
  // previous gold-frame wordmark which was 1.5:1 with whitespace padding).
  // Reduced these constants accordingly so the rendered banner sits at a
  // reasonable size in the 80px-tall navbar instead of 4-5x too wide.
  const navbar = document.getElementById('navbar');
  const navLogo = document.getElementById('nav-logo');
  const LOGO_BIG = 43;    // px height when at top (mobile)
  const LOGO_SMALL = 32;  // px height when scrolled (mobile)
  const SCROLL_RANGE = 150; // px of scroll over which the transition happens

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;

    // Background change — darken more on scroll
    if (scrollY > 80) {
      navbar?.classList.add('bg-navy-dark/95', 'shadow-lg');
      navbar?.classList.remove('bg-navy-dark/70');
    } else {
      navbar?.classList.remove('bg-navy-dark/95', 'shadow-lg');
      navbar?.classList.add('bg-navy-dark/70');
    }

    // Logo resize — only shrink on mobile, desktop stays fixed
    if (navLogo) {
      const isMobile = window.innerWidth < 1024;
      if (isMobile) {
        const t = Math.min(scrollY / SCROLL_RANGE, 1);
        const size = LOGO_BIG - (LOGO_BIG - LOGO_SMALL) * t;
        navLogo.style.height = size + 'px';
      }
      navLogo.style.width = 'auto';
    }
  });

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Close mobile menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => menu?.classList.add('hidden'));
  });

  // ===== Precise smooth scroll for any navbar link that targets an in-page anchor =====
  // Browser native anchor scroll uses scroll-margin-top, but the navbar logo
  // overflows the navbar (renders 117px / 80px tall while the navbar itself is
  // 80px), and the logo height also animates on scroll, so the static CSS offset
  // can land slightly off. This handler computes the exact position at click
  // time and scrolls there.
  function getNavbarOffset(): number {
    const nav = document.getElementById('navbar');
    if (!nav) return 80;
    // Use the visible bottom of the navbar including any overflowing logo.
    // The logo is the tallest child; measure from nav top to logo bottom.
    const navRect = nav.getBoundingClientRect();
    const logo = document.getElementById('nav-logo');
    if (!logo) return navRect.height;
    const logoRect = logo.getBoundingClientRect();
    const logoBottomBelowNavTop = (logoRect.bottom - navRect.top);
    // Add a comfortable cushion (16px) below the navbar/logo
    return Math.max(navRect.height, logoBottomBelowNavTop) + 16;
  }

  function smoothScrollToHash(hash: string) {
    if (!hash || hash === '#') return false;
    const target = document.querySelector(hash);
    if (!target) return false;

    // Re-measureable: the navbar logo shrinks during scroll on mobile,
    // and lazy-loaded images can shift content during a long smooth scroll.
    // So we (a) start a smooth scroll using the click-time estimate, then
    // (b) snap-correct twice after the scroll likely settles.
    function targetY(): number {
      return target.getBoundingClientRect().top + window.pageYOffset - getNavbarOffset();
    }

    window.scrollTo({ top: targetY(), behavior: 'smooth' });

    // Snap-correct after smooth scroll typically settles. Two checks because
    // smooth-scroll duration varies by browser and content height.
    setTimeout(() => {
      const drift = Math.abs(window.pageYOffset - targetY());
      if (drift > 4) window.scrollTo({ top: targetY(), behavior: 'auto' });
    }, 700);
    setTimeout(() => {
      const drift = Math.abs(window.pageYOffset - targetY());
      if (drift > 4) window.scrollTo({ top: targetY(), behavior: 'auto' });
    }, 1100);

    // Update the URL hash without triggering another scroll
    if (history.pushState) {
      history.pushState(null, '', hash);
    }
    return true;
  }

  // Wire up every navbar anchor link (desktop + mobile) that points to an
  // in-page anchor on this page. External page links are left alone.
  document.querySelectorAll<HTMLAnchorElement>('#navbar a[href*="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href') || '';
      // Same-page anchor: starts with '#' or '/#'
      if (!href.startsWith('#') && !href.startsWith('/#')) return;
      // If we're on the home page, intercept and do precise smooth scroll
      if (location.pathname === '/' || location.pathname === '/index.html') {
        const hash = href.includes('#') ? '#' + href.split('#')[1] : '';
        if (hash && document.querySelector(hash)) {
          e.preventDefault();
          smoothScrollToHash(hash);
        }
      }
      // Otherwise let the browser navigate to /#hash; the page-load handler below
      // will scroll precisely once the page is loaded.
    });
  });

  // After a fresh page load that arrived with a hash, run the precise scroll
  // once the layout has settled so we land in the right spot.
  window.addEventListener('load', () => {
    if (location.hash) {
      // small delay so any post-load layout shifts (font load, etc.) settle
      setTimeout(() => smoothScrollToHash(location.hash), 60);
    }
  });

  // ===== Generic dropdown menus — click-toggle, keyboard-accessible, =====
  // ===== mutually exclusive (opening one closes the others), and    =====
  // ===== close on outside click / Escape / link click.              =====
  //
  // Markup pattern (rendered by primaryNav above): each dropdown is a
  // `.nav-dropdown` wrapper containing a `.nav-dropdown-trigger` button
  // and a `.nav-dropdown-menu` panel. This wires them up generically so
  // adding more dropdowns later "just works."
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('.nav-dropdown'));

  function closeAllDropdowns() {
    dropdowns.forEach((dd) => {
      dd.querySelector<HTMLElement>('.nav-dropdown-menu')?.classList.add('hidden');
      const t = dd.querySelector<HTMLElement>('.nav-dropdown-trigger');
      t?.setAttribute('aria-expanded', 'false');
      t?.querySelector('svg')?.classList.remove('rotate-180');
    });
  }

  dropdowns.forEach((dd) => {
    const trigger = dd.querySelector<HTMLElement>('.nav-dropdown-trigger');
    const dropdownMenu = dd.querySelector<HTMLElement>('.nav-dropdown-menu');
    const chevron = trigger?.querySelector('svg');

    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = !dropdownMenu?.classList.contains('hidden');
      // Mutual exclusivity: close all first.
      closeAllDropdowns();
      if (!wasOpen) {
        dropdownMenu?.classList.remove('hidden');
        trigger?.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('rotate-180');
      }
    });

    // Close after clicking any link inside the dropdown so it doesn't
    // linger after a same-page-anchor click.
    dropdownMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeAllDropdowns());
    });
  });

  // Close any open dropdown when the user clicks outside the navbar dropdowns.
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    const clickedInside = dropdowns.some((dd) => dd.contains(target));
    if (!clickedInside) closeAllDropdowns();
  });

  // Close all dropdowns on Escape.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });
</script>

<style>
  /* Navbar logo — horizontal wordmark sizing.
     The new blue banner wordmark is ~4.66:1 aspect, so the heights here
     are deliberately small. At 64px desktop the banner renders ~298px
     wide; at 56px mobile it renders ~261px wide — comfortably inside
     the 80px navbar without dominating it. */
  .nav-logo-img {
    height: 49px;
    width: auto;
  }
  /* Smaller on mobile */
  @media (max-width: 1024px) {
    .nav-logo-img {
      height: 43px;
    }
  }

  /* ============================================================ */
  /* Navbar Get Tickets button — gold pill with navy-dark print,   */
  /* gentle pulse (scale + glow). 2.6s cycle, ease-in-out.        */
  /* Pauses on hover so the visitor doesn't feel like they're     */
  /* chasing a moving target. Respects prefers-reduced-motion.    */
  /* ============================================================ */
  /* Box scale + glow */
  @keyframes navbar-get-tickets-pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 4px 14px rgba(253, 216, 53, 0.35);
    }
    50% {
      transform: scale(1.06);
      box-shadow: 0 6px 22px rgba(253, 216, 53, 0.65);
    }
  }
  /* Inner text scale — peaks BIGGER than the box at the same moment, */
  /* so the "Get Tickets" words briefly punch above the box growth.   */
  /* Net visible scale at peak: 1.06 (box) x 1.12 (text) = ~1.19      */
  @keyframes navbar-get-tickets-text-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.12); }
  }
  .navbar-get-tickets-pulse {
    background-color: #fdd835;   /* brand gold */
    color: #001a45;              /* navy-dark print */
    transition: background-color 0.2s ease-out, transform 0.2s ease-out;
    animation: navbar-get-tickets-pulse 2.6s ease-in-out infinite;
    transform-origin: center;
    will-change: transform;
  }
  .navbar-get-tickets-text {
    display: inline-block;       /* required for transform on inline elements */
    animation: navbar-get-tickets-text-pulse 2.6s ease-in-out infinite;
    transform-origin: center;
    will-change: transform;
  }
  .navbar-get-tickets-pulse:hover {
    animation-play-state: paused;
    transform: translateY(-1px);
    background-color: #ffd400 !important;
  }
  .navbar-get-tickets-pulse:hover .navbar-get-tickets-text {
    animation-play-state: paused;
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .navbar-get-tickets-pulse,
    .navbar-get-tickets-text {
      animation: none;
    }
  }
</style>
