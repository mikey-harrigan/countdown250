---
const ticketUrl = "https://www.eventbrite.com/e/the-official-countdown-250-ball-washington-dc-tickets-1982528927390?aff=websitemain";
const base = "";

// Primary nav synced to homepage scroll order: Experience -> Heroes -> Tickets -> Hosted Tables.
// Venue stays at the end as the only deep-page link in primary.
const navLinks = [
  { label: "Experience", href: "/#experience" },
  { label: "Our Heroes", href: "/#heroes" },
  { label: "Tickets", href: "/#tickets" },
  { label: "Hosted Groups", href: "/#hosted-tables" },
  { label: "Venue", href: "/venue" },
];

const moreLinks = [
  { label: "About", href: `${base}/about/` },
  { label: "Entertainment", href: `${base}/entertainment/` },
  { label: "Honorees", href: `${base}/honorees/` },
  { label: "Schedule", href: `${base}/schedule/` },
  { label: "Partners", href: `${base}/partners/` },
  { label: "News & Updates", href: `${base}/updates/` },
  { label: "Press", href: `${base}/press/` },
  { label: "FAQ", href: `${base}/faq/` },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-navy-dark/70 backdrop-blur-sm" style="overflow: visible;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" style="overflow: visible;">
    <div class="flex items-center justify-between h-20" style="overflow: visible;">
      <!-- Logo — oval-framed horizontal wordmark. Fits cleanly in nav bar at small sizes. -->
      <a href="/" class="flex-shrink-0 relative z-10" style="overflow: visible; align-self: center;">
        <img
          id="nav-logo"
          src="/images/logos/countdown250-wordmark-gold-frame.png"
          alt="The Official Countdown 250 Ball"
          class="drop-shadow-lg transition-all duration-500 ease-out nav-logo-img"
        />
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-6">
        {navLinks.map((link) => (
          <a href={link.href} class="text-white/90 hover:text-white text-sm font-medium tracking-wide uppercase transition-colors">{link.label}</a>
        ))}

        <!-- More dropdown — click-toggle (works on touch + keyboard, not just mouse hover) -->
        <div class="relative">
          <button
            id="more-btn"
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="more-menu"
            class="text-white/90 hover:text-white text-sm font-medium tracking-wide uppercase transition-colors flex items-center gap-1"
          >
            More
            <svg class="w-3.5 h-3.5 mt-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="more-menu" class="hidden absolute right-0 top-full pt-2">
            <div class="bg-navy-dark/95 backdrop-blur-sm rounded-lg shadow-xl border border-white/10 py-2 min-w-[180px]">
              {moreLinks.map((link) => (
                <a href={link.href} class="block px-4 py-2 text-white/80 hover:text-white hover:bg-white/10 text-sm font-medium tracking-wide transition-colors">{link.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a
          href="/#tickets"
          class="navbar-get-tickets-pulse px-9 py-2.5 text-sm font-bold tracking-wider uppercase rounded"
        >
          Get Tickets
        </a>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="lg:hidden text-white p-2" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-navy-dark/95 backdrop-blur-sm">
    <div class="px-4 py-6 space-y-4">
      {navLinks.map((link) => (
        <a href={link.href} class="block text-white/90 hover:text-white text-sm font-medium tracking-wide uppercase">{link.label}</a>
      ))}
      <div class="border-t border-white/10 pt-4 mt-4">
        <p class="text-white/40 text-xs uppercase tracking-wider mb-3">More</p>
        {moreLinks.map((link) => (
          <a href={link.href} class="block text-white/80 hover:text-white text-sm font-medium tracking-wide py-1.5">{link.label}</a>
        ))}
      </div>
      <a
        href="/#tickets"
        class="block bg-red text-white px-6 py-3 text-sm font-semibold tracking-wider uppercase text-center hover:bg-red-light transition-colors rounded mt-4"
      >
        Get Tickets
      </a>
    </div>
  </div>
</nav>

<script>
  // Navbar scroll effect with logo resize
  const navbar = document.getElementById('navbar');
  const navLogo = document.getElementById('nav-logo');
  const LOGO_BIG = 109;   // px height when at top (mobile)
  const LOGO_SMALL = 73;  // px height when scrolled (mobile)
  const SCROLL_RANGE = 150; // px of scroll over which the transition happens

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;

    // Background change — darken more on scroll
    if (scrollY > 80) {
      navbar?.classList.add('bg-navy-dark/95', 'shadow-lg');
      navbar?.classList.remove('bg-navy-dark/70');
    } else {
      navbar?.classList.remove('bg-navy-dark/95', 'shadow-lg');
      navbar?.classList.add('bg-navy-dark/70');
    }

    // Logo resize — only shrink on mobile, desktop stays fixed
    if (navLogo) {
      const isMobile = window.innerWidth < 1024;
      if (isMobile) {
        const t = Math.min(scrollY / SCROLL_RANGE, 1);
        const size = LOGO_BIG - (LOGO_BIG - LOGO_SMALL) * t;
        navLogo.style.height = size + 'px';
      }
      navLogo.style.width = 'auto';
    }
  });

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Close mobile menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => menu?.classList.add('hidden'));
  });

  // ===== "More" dropdown — click-toggle, keyboard-accessible, closes on outside click =====
  const moreBtn = document.getElementById('more-btn');
  const moreMenu = document.getElementById('more-menu');
  const moreChevron = moreBtn?.querySelector('svg');

  function closeMoreMenu() {
    moreMenu?.classList.add('hidden');
    moreBtn?.setAttribute('aria-expanded', 'false');
    moreChevron?.classList.remove('rotate-180');
  }

  moreBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const wasOpen = !moreMenu?.classList.contains('hidden');
    if (wasOpen) {
      closeMoreMenu();
    } else {
      moreMenu?.classList.remove('hidden');
      moreBtn?.setAttribute('aria-expanded', 'true');
      moreChevron?.classList.add('rotate-180');
    }
  });

  // Close on click outside
  document.addEventListener('click', (e) => {
    if (!moreMenu) return;
    const target = e.target as Node;
    if (!moreMenu.contains(target) && !moreBtn?.contains(target)) {
      closeMoreMenu();
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMoreMenu();
  });

  // Close after clicking any link inside the More menu (so the dropdown
  // doesn't stay open after navigating to the same page anchor)
  moreMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeMoreMenu());
  });
</script>

<style>
  /* Navbar logo — horizontal wordmark sizing.
     Logo is 2x prior size and intentionally overflows the 80px navbar.
     Parent has overflow:visible to allow this. Vertical center stays
     anchored to the navbar's items-center axis. */
  .nav-logo-img {
    height: 117px;
    width: auto;
  }
  /* Smaller on mobile */
  @media (max-width: 1024px) {
    .nav-logo-img {
      height: 80px;
    }
  }

  /* ============================================================ */
  /* Navbar Get Tickets button — gold pill with navy-dark print,   */
  /* gentle pulse (scale + glow). 2.6s cycle, ease-in-out.        */
  /* Pauses on hover so the visitor doesn't feel like they're     */
  /* chasing a moving target. Respects prefers-reduced-motion.    */
  /* ============================================================ */
  @keyframes navbar-get-tickets-pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 4px 14px rgba(253, 216, 53, 0.35);
    }
    50% {
      transform: scale(1.06);
      box-shadow: 0 6px 22px rgba(253, 216, 53, 0.65);
    }
  }
  .navbar-get-tickets-pulse {
    background-color: #fdd835;   /* brand gold */
    color: #001a45;              /* navy-dark print */
    transition: background-color 0.2s ease-out, transform 0.2s ease-out;
    animation: navbar-get-tickets-pulse 2.6s ease-in-out infinite;
    transform-origin: center;
    will-change: transform;
  }
  .navbar-get-tickets-pulse:hover {
    animation-play-state: paused;
    transform: translateY(-1px);
    background-color: #ffd400 !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .navbar-get-tickets-pulse {
      animation: none;
    }
  }
</style>
